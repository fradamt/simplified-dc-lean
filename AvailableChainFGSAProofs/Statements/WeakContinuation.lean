/-! WC J1; DC bounded weak continuation, blueprint 23 §§2–8.
These are proof-side interfaces. Later-job statements are propositions to prove;
their presence does not supply a proof. All historical fields use original indices.
Private carriers enter run scope only through a delivered or honest-held named body.
An emitted-only body does not obtain run scope from its emission. -/

namespace AvailableChain.FGSA.Run

open AvailableChain.SimplexFG KitFG

variable (p : Params) {In V : Type} (c : AppCodec In) [DecidableEq V]
    (E : Generic.Env V) (rho : V2.D.Run V (fgsa p c))

/-- WC J1; DC signed-occurrence provenance: the historical view carrier and exact key.
Scope alone gives no bound on the emission index at an arbitrary held read. -/
structure WCFinalizedOccurrence (D X : FGBlock (Fin p.n)) (h : Height) : Prop where
  value : (finalityView p D).F = X
  height : (finalityView p D).h_F = h
  scope : RootBlockInRun p c E rho (eraseFG D)
  zero : h = 0 → X = .genesis
  positive : h ≠ 0 → ∃ C D₀,
    StrictPrefix C D₀ ∧ FGBlock.Preceq D₀ D ∧
    JustificationBirth p.E (heightView p) C h X ∧
    (finalityView p D₀.parent).h_F < (finalityView p D₀).h_F ∧
    finalityView p D₀ = finalityView p D ∧ FinalityQCAfter p.E C D₀ h X
  rows : ∀ a ∈ chainRows D, rho.seatOf (.base .fg) a.signer ∈ rho.honest →
    ∃ j r wire, HonestRowAt p c E rho j (rho.seatOf (.base .fg) a.signer) r wire ∧
      wire.toRow? = some a ∧ wire.auth = .seat .fg a.signer
  noSlash : ∀ z ∈ rho.honest, EmittedRowsNoSlash p c E rho z

/-- WC J1; DC receipt provenance: original acceptance times remain relay triggers. -/
structure WCReceiptOrigins (i : Nat) (x : V) (st : State p.n) : Prop where
  blocks : ∀ B stamp, (B, stamp) ∈ st.base.blockStamp →
    (B = .genesis ∧ stamp = 0) ∨ ∃ j < i, ∃ t o,
      blockOf? p o = some B ∧ rho.acceptsAt E j x o t ∧
      stamp = (storeAt p c E rho j x).base.now
  votes : ∀ s k b stamp,
    ((⟨.seat s k, .head b⟩ : GridCO.Wire p.n .root), stamp) ∈ st.base.voteStamp →
    ∃ j < i, ∃ t, rho.acceptsAt E j x (ofHead p ⟨.seat (.head s) k, b⟩) t ∧
      stamp = (storeAt p c E rho j x).base.now

/-- WC J1; DC retrospective transfer: actual deterministic HEAD, including sleepers.
The full input preserves raw pools, carried support, equivocation data and stamps. -/
structure WCHeadRead (i : Nat) (x : V) (s : Slot) (B : Block) : Prop where
  event : rho.events[i]? = some (.tick x (SA.voteTime p.toParams s))
  covers : Block.Preceq B (headAtIdx p c E rho i s)
  path : ∀ A, Block.Preceq A B →
    A ∈ (FGSA.clock p (storeAt p c E rho i x) (SA.voteTime p.toParams s)).base.blocks
  receipts : WCReceiptOrigins p c E rho i x
    (FGSA.clock p (storeAt p c E rho i x) (SA.voteTime p.toParams s))

/-- WC J1; DC lease origin: the exact write, release equality, and last-write clause. -/
structure WCLeaseOrigin (i : Nat) (x : V) (row : Block × Nat × Time) : Prop where
  origin : ∃ j < i, ∃ s B, IsGateTick p c rho j x s ∧ gatePassedAt p c E rho j ∧
    gateResultAt p c E rho j = some (some B) ∧ Block.Preceq row.1 B ∧
    (row.1, row.2.1) ∈
      (let wcView := actView (clockPre p (storeAt p c E rho j x) (SA.gateTime p.toParams s));
        (wcView.blocks.filter (fun b => b != .genesis && Block.preceq b B)).flatMap
          (fun b => (@GridCO.admissionLevels GridCO.slowLeasePolicy
            p.toParams.engine p.n .root wcView s b).map (fun g => (b, g)))) ∧
    row.2.2 = SA.gateTime p.toParams s + SA.lifetime p.toParams ∧
    row.2.2 = SA.releaseTime p.toParams (s + p.k) ∧
    ∀ k v C, j < k → k < i → IsGateTick p c rho k x v →
      let pre := clockPre p (storeAt p c E rho k x) (SA.gateTime p.toParams v)
      GridCO.savedGenuine pre.base v = none →
      SA.Root.confirmationFrom p.toParams (eraseFG pre.fg.F) (actView pre) v = some C →
      (actView pre).obligations.any (fun r => !Block.compatible r.1 C) = false →
      (row.1, row.2.1) ∉ (let wcView := actView pre;
        (wcView.blocks.filter (fun b => b != .genesis && Block.preceq b C)).flatMap
          (fun b => (@GridCO.admissionLevels GridCO.slowLeasePolicy
            p.toParams.engine p.n .root wcView v b).map (fun g => (b, g))))

/-- WC J1; DC finite source certificate evidence: exact target row and source gate. -/
structure WCTargetOrigin (i : Nat) (X : FGBlock (Fin p.n)) (h : Height) : Prop where
  origin : ∃ j y r wire K B, j < i ∧ HonestRowAt p c E rho j y r wire ∧
    namedEntry wire.payload.height_pair = some (h, X.root) ∧
    actionSourceFG p c E rho y r = some (some K) ∧ FGBlock.Preceq X K ∧
    gateResult p c E rho y (r * p.R) = some (some B) ∧ Block.Preceq (eraseFG K) B

/-- WC J1; DC finite structural seed: origins refer only to earlier events.
No all-run client or certificate premise is transferred by prefix replay. -/
structure WCFiniteFacts (i : Nat) : Prop where
  store : ∀ x ∈ rho.honest, CStoreInv p (storeAt p c E rho i x)
  nesting : ∀ x ∈ rho.honest, NestOK (storeAt p c E rho i x)
  metadata : ∀ x ∈ rho.honest, MetaInv p (storeAt p c E rho i x)
  receipts : ∀ x ∈ rho.honest, WCReceiptOrigins p c E rho i x (storeAt p c E rho i x)
  leases : ∀ x ∈ rho.honest, ∀ row ∈ (storeAt p c E rho i x).base.obligations,
    WCLeaseOrigin p c E rho i x row
  deadlines : ∀ x ∈ rho.honest, ∀ K g deadline,
    (K, g, deadline) ∈ (storeAt p c E rho i x).base.obligations →
    ∀ B, B ≠ .genesis → Block.Preceq B K →
      Gen.AC.Root.ProtectsUntil (storeAt p c E rho i x).base B g deadline
  fastWrites : ∀ x ∈ rho.honest, ∀ s X,
    X ∈ (FGSA.fastWriteAt (storeAt p c E rho i x) s).getD [] →
    ∃ j < i, IsGateTick p c rho j x s ∧ gatePassedAt p c E rho j ∧
      ∃ B, gateResultAt p c E rho j = some (some B) ∧
        Block.Preceq X B ∧ fastAt p c E rho x s X
  saved : ∀ x ∈ rho.honest, ∀ s C,
    GridCO.savedGenuine (storeAt p c E rho i x).base s = some (some C) →
    ∃ j < i, IsGateTick p c rho j x s ∧ gateResultAt p c E rho j = some (some C)
  certified : ∀ x ∈ rho.honest, ∀ W ∈ (storeAt p c E rho i x).fg.TF,
    ∀ X ∈ certified p W, X ≠ .genesis →
      WCTargetOrigin p c E rho i X (heightView p X).h
  client : ∀ j k x r r' a b u v, j < i → k < i →
    HonestRowAt p c E rho j x r a → HonestRowAt p c E rho k x r' b →
    a.toRow? = some u → b.toRow? = some v → ¬ Slashable u v

/-- WC J1; DC height seed: finite HS facts at the selected source gate.
Old saved results and low cached J have no global chain bound. -/
structure WCSeed (w : HealingWitness) (iStar : Nat) : Prop where
  cut : iStar = afterTicksIdx rho (SA.gateTime p.toParams w.u)
  within : iStar ≤ rho.events.length
  afterGST : E.t_GST ≤ SA.gateTime p.toParams w.u
  firstVoteAfterGST : E.t_GST ≤ SA.voteTime p.toParams (w.u + 1)
  carrier : ∃ WStar : FGBlock (Fin p.n), eraseFG WStar = w.CStar ∧
    (heightView p WStar).h = w.M + 1 ∧
    RootBlockInRun p c E rho (eraseFG WStar) ∧
    ∀ x ∈ rho.honest, WStar ∈ (storeAt p c E rho iStar x).fg.TF
  sourcePrefix : Block.Preceq w.CStar w.QStar
  gates : ∀ x ∈ rho.honest, ∃ j < iStar, IsGateTick p c rho j x w.u ∧
    gateResultAt p c E rho j = some (some w.QStar) ∧ gatePassedAt p c E rho j
  refreshed : ∀ x ∈ rho.honest, S_at p c E rho iStar x = w.QStar
  nextHeads : ∀ x ∈ rho.honest, ∃ k < iStar,
    WCHeadRead p c E rho k x (w.u + 1) w.QStar
  highSources : ∀ j x r a e, j < iStar → HonestRowAt p c E rho j x r a →
    namedEntry a.payload.height_pair = some e → w.M + 1 ≤ e.1 →
    ∃ K B, actionSourceFG p c E rho x r = some (some K) ∧
      e = (hOf p.E p.cfg K, (derive p.E p.cfg K).T_h.root) ∧
      FGBlock.Preceq (derive p.E p.cfg K).T_h K ∧
      gateResult p c E rho x (r * p.R) = some (some B) ∧
      Block.Preceq (eraseFG K) B ∧ Block.Preceq (eraseFG K) w.QStar
  height : ∀ x ∈ rho.honest, w.M + 1 ≤ (storeAt p c E rho iStar x).fg.h_max
  finalBelow : ∀ x ∈ rho.honest, Block.Preceq (F_at p c E rho iStar x) w.QStar
  liveTargets : ∀ x ∈ rho.honest,
    ∀ row ∈ (storeAt p c E rho iStar x).base.obligations,
      (storeAt p c E rho iStar x).base.now < row.2.2 → Block.Preceq row.1 w.QStar
  finite : WCFiniteFacts p c E rho iStar

/-- WC J1; DC seeded history: an actual completed honest suffix result. -/
structure WCResult (w : HealingWitness) (iStar i j : Nat) (x : V)
    (s : Slot) (B : Block) : Prop where
  honest : x ∈ rho.honest
  afterCut : iStar ≤ j
  completed : j < i
  label : w.u < s
  event : IsGateTick p c rho j x s
  value : gateResultAt p c E rho j = some (some B)

/-- WC J1; DC seeded origins: a prefix of the seed or a completed suffix result. -/
structure WCBelowHistory (w : HealingWitness) (iStar i : Nat) (X : Block) : Prop where
  origin : Block.Preceq X w.QStar ∨ ∃ j x s B,
    WCResult p c E rho w iStar i j x s B ∧ Block.Preceq X B

/-- WC J1; DC joint event induction: I1–I5 with bounded history and state ranges. -/
structure WCInv (w : HealingWitness) (iStar i : Nat) : Prop where
  interval : iStar ≤ i ∧ i ≤ rho.events.length
  nonempty : ∀ j x s, iStar ≤ j → j < i → x ∈ rho.honest →
    IsGateTick p c rho j x s → w.u < s →
    ∃ B, gateResultAt p c E rho j = some (some B) ∧
      Block.Preceq w.QStar B ∧ gatePassedAt p c E rho j
  ordered : ∀ j k x y s r B C, WCResult p c E rho w iStar i j x s B →
    WCResult p c E rho w iStar i k y r C → s < r → Block.Preceq B C
  sameLabel : ∀ j k x y s B C, WCResult p c E rho w iStar i j x s B →
    WCResult p c E rho w iStar i k y s C → Block.Compatible B C
  retrospective : ∀ j x s B, WCResult p c E rho w iStar i j x s B →
    ∀ y ∈ rho.honest, ∃ k < j, WCHeadRead p c E rho k y (s + 1) B
  preCutHigh : ∀ j x r a e, j < iStar → HonestRowAt p c E rho j x r a →
    namedEntry a.payload.height_pair = some e → w.M + 1 ≤ e.1 →
    ∃ K, actionSourceFG p c E rho x r = some (some K) ∧
      e = (hOf p.E p.cfg K, (derive p.E p.cfg K).T_h.root) ∧
      Block.Preceq (eraseFG K) w.QStar
  suffixSources : ∀ j x r K, iStar ≤ j → j < i → x ∈ rho.honest →
    rho.events[j]? = some (.tick x (p.actionTime r)) →
    actionSourceFG p c E rho x r = some (some K) →
    ∃ B, WCResult p c E rho w iStar i j x (r * p.R) B ∧ Block.Preceq (eraseFG K) B
  highCertificates : ∀ k x W X, iStar ≤ k → k ≤ i → x ∈ rho.honest →
    W ∈ (storeAt p c E rho k x).fg.TF → X ∈ certified p W → X ≠ .genesis →
    w.M + 1 ≤ (heightView p X).h →
    WCTargetOrigin p c E rho k X (heightView p X).h ∧
      WCBelowHistory p c E rho w iStar k (eraseFG X)
  lowFinalized : ∀ k x D X h, iStar ≤ k → k ≤ i → HeldAt p c E rho k x D →
    (finalityView p D).F = X → (finalityView p D).h_F = h → h ≤ w.M →
    Block.Preceq (eraseFG X) w.CStar
  liveTargets : ∀ k x row, iStar ≤ k → k ≤ i → x ∈ rho.honest →
    row ∈ (storeAt p c E rho k x).base.obligations →
    (storeAt p c E rho k x).base.now < row.2.2 →
    WCBelowHistory p c E rho w iStar k row.1
  oldLiveTargets : ∀ k x row, iStar ≤ k → k ≤ i → x ∈ rho.honest →
    row ∈ (storeAt p c E rho iStar x).base.obligations →
    row ∈ (storeAt p c E rho k x).base.obligations →
    (storeAt p c E rho k x).base.now < row.2.2 → Block.Preceq row.1 w.QStar
  suffixSaved : ∀ k x s B, iStar ≤ k → k ≤ i → x ∈ rho.honest → w.u < s →
    GridCO.savedGenuine (storeAt p c E rho k x).base s = some (some B) →
    ∃ j, WCResult p c E rho w iStar k j x s B
  suffixFast : ∀ k x s X, iStar ≤ k → k ≤ i → x ∈ rho.honest → w.u < s →
    X ∈ (FGSA.fastWriteAt (storeAt p c E rho k x) s).getD [] →
    ∃ j B, WCResult p c E rho w iStar k j x s B ∧ Block.Preceq X B
  outputOrigin : ∀ k x, iStar ≤ k → k ≤ i → x ∈ rho.honest →
    S_at p c E rho k x = w.QStar ∨
    (∃ j y s, WCResult p c E rho w iStar k j y s (S_at p c E rho k x)) ∨
    (∃ l, iStar ≤ l ∧ l ≤ k ∧ S_at p c E rho k x = F_at p c E rho l x ∧
      ∀ j y s B, WCResult p c E rho w iStar i j y s B →
        Block.Compatible (F_at p c E rho l x) B)
  served : ∀ k x, iStar ≤ k → k ≤ i → x ∈ rho.honest →
    Block.Preceq w.QStar (S_at p c E rho k x)
  transitions : ∀ k x, iStar ≤ k → k < i → x ∈ rho.honest →
    Block.Preceq (S_at p c E rho k x) (S_at p c E rho (k + 1) x)
  finite : ∀ k, iStar ≤ k → k ≤ i → WCFiniteFacts p c E rho k
  carrier : ∃ WStar : FGBlock (Fin p.n), eraseFG WStar = w.CStar ∧
    (heightView p WStar).h = w.M + 1 ∧
    ∀ k x, iStar ≤ k → k ≤ i → x ∈ rho.honest →
      WStar ∈ (storeAt p c E rho k x).fg.TF

/-- WC J1; DC handler order: the input position inside a real tick. -/
inductive WCDutyPhase where
  | proposal (s : Slot)
  | head (s : Slot)
  | gate (s : Slot)
  | action (r : Nat)

/-- WC J1; DC handler order: an exact intermediate input, with no chain assumption. -/
structure WCDutyInput (i : Nat) (x : V) (phase : WCDutyPhase)
    (st : State p.n) : Prop where
  within : i < rho.events.length
  input : ∃ t, rho.events[i]? = some (.tick x t) ∧
    ((∃ s, phase = .proposal s ∧ t = SA.proposalTime p.toParams s ∧
        st = FGSA.clock p (storeAt p c E rho i x) t) ∨
     (∃ s, phase = .head s ∧ t = SA.voteTime p.toParams s ∧
        st = FGSA.clock p (storeAt p c E rho i x) t) ∨
     (∃ s, phase = .gate s ∧ t = SA.gateTime p.toParams s ∧
        st = clockPre p (storeAt p c E rho i x) t) ∨
     (∃ r, phase = .action r ∧ t = p.actionTime r ∧
        st = FGSA.clock p (storeAt p c E rho i x) t))

/-- WC J1; DC exact certificate use: target justifications, finality targets and crossings.
The carrier need not be active or on the current J chain. -/
structure WCControllingRow (st : State p.n) (a : Row (Fin p.n)) : Prop where
  witness : ∃ D ∈ st.fg.TF, ∃ C, FGBlock.Preceq C D ∧ a ∈ chainRows C ∧
    ((∃ h X, h = (heightView p C).h_j ∧ X = (heightView p C).J ∧
        TargetQCAt p.E C h X ∧ a.height_pair = .vote h X.root false) ∨
     (∃ birth event h X, StrictPrefix birth event ∧ FGBlock.Preceq event C ∧
        JustificationBirth p.E (heightView p) birth h X ∧
        FinalityQCAfter p.E birth event h X ∧ a ∈ chainRows birth ∧
        a.height_pair = .vote h X.root false) ∨
     (∃ h X, ∃ Q : Finset (Fin p.n), 1 ≤ h ∧ h < (heightView p C).h ∧
        FGBlock.Preceq X C ∧ (heightView p X).h = h ∧ p.E.IsQuorum Q ∧
        a.signer ∈ Q ∧ a.height_pair.matchesEntry h X.root = true ∧
        ∀ k ∈ Q, ∃ b ∈ chainRows C, b.signer = k ∧
          b.height_pair.matchesEntry h X.root = true))

/-- WC J1; DC conditional frame input: every usable high source retains its original read. -/
structure WCUsableHighSourcesBelow (w : HealingWitness) (i : Nat) (x : V)
    (st : State p.n) (B : Block) : Prop where
  honest : x ∈ rho.honest
  below : ∀ a, WCControllingRow p st a →
    ∀ j y r wire e K, j < i → HonestRowAt p c E rho j y r wire →
    wire.toRow? = some a → namedEntry wire.payload.height_pair = some e →
    w.M + 1 ≤ e.1 → actionSourceFG p c E rho y r = some (some K) →
    Block.Preceq (eraseFG K) B

/-- WC J1; DC conditional frame: contests are allowed. -/
structure WCFrameBelow (st : State p.n) (B : Block) : Prop where
  finalRoot : Block.Preceq (eraseFG st.fg.F) (eraseFG (frameR p st).Z)
  rootBelow : Block.Preceq (eraseFG (frameR p st).Z) B
  floor : ∃ Bfg : FGBlock (Fin p.n), eraseFG Bfg = B ∧
    (frameR p st).lo ≤ (heightView p Bfg).h

/-- WC J1; DC duty view: the HEAD uses its frozen voter tree; other duties use T. -/
structure WCDutyView (st : State p.n) (phase : WCDutyPhase)
    (view : Finset (FGBlock (Fin p.n))) : Prop where
  identity : (∃ s, phase = .head s ∧ view = voterBlocks p st s) ∨
    ((∃ s, phase = .proposal s ∨ phase = .gate s ∨ phase = .action s) ∧ view = st.fg.TF)

/-- WC J1; DC live start: the same duty view supplies its path. -/
structure WCFrameLiveBelow (st : State p.n) (phase : WCDutyPhase)
    (Bfg : FGBlock (Fin p.n))
    (view : Finset (FGBlock (Fin p.n))) : Prop where
  dutyView : WCDutyView p st phase view
  frame : WCFrameBelow p st (eraseFG Bfg)
  targets : ∀ row ∈ st.base.obligations, st.base.now < row.2.2 →
    Block.Preceq row.1 (eraseFG Bfg)
  viewSubset : view ⊆ st.fg.TF
  startAbove : Block.Preceq (eraseFG (frameR p st).Z) (liveRoot p st)
  startBelow : Block.Preceq (liveRoot p st) (eraseFG Bfg)

/-- WC J1; DC filtered path: membership is in this duty's parent-closed input view. -/
structure WCFramePathBelow (st : State p.n) (phase : WCDutyPhase)
    (Bfg : FGBlock (Fin p.n))
    (view : Finset (FGBlock (Fin p.n))) : Prop where
  live : WCFrameLiveBelow p st phase Bfg view
  member : Bfg ∈ view
  closed : ∀ X ∈ view, X.parent ∈ view
  path : ∀ X, FGBlock.Preceq (frameR p st).Z X → FGBlock.Preceq X Bfg →
    X ∈ domainR p st view

/-- WC J1; DC proposal pivot: only labels through s−2 enter the maximum. -/
structure WCProposalPivot (w : HealingWitness) (iStar : Nat) (pt : PtSP)
    (D : Block) : Prop where
  member : D = w.QStar ∨ ∃ j x s,
    WCResult p c E rho w iStar rho.events.length j x s D ∧ s ≤ pt.s - 2
  greatestSeed : Block.Preceq w.QStar D
  greatest : ∀ j x s B,
    WCResult p c E rho w iStar rho.events.length j x s B →
    s ≤ pt.s - 2 → Block.Preceq B D
  proposalFrame : ∀ i x st, WCDutyInput p c E rho i x (.proposal pt.s) st →
    x = V2.D.proposerOf rho (fgsaInterface p c) pt.s →
    WCFrameBelow p st D ∧ Block.Preceq (liveRoot p st) D
  headFrame : ∀ i x st, x ∈ rho.honest →
    WCDutyInput p c E rho i x (.head pt.s) st →
    WCFrameBelow p st D ∧ Block.Preceq (liveRoot p st) D
  previousHeads : ∀ x ∈ rho.honest, ∃ k,
    WCHeadRead p c E rho k x (pt.s - 1) D
  proposalPath : ∀ i x st, WCDutyInput p c E rho i x (.proposal pt.s) st →
    x = V2.D.proposerOf rho (fgsaInterface p c) pt.s →
    ∃ Dfg ∈ fullTree p st, eraseFG Dfg = D ∧
      ∀ A, Block.Preceq A D → A ∈ st.base.blocks ∧
        GridCO.stampBlock st.base A < SA.proposalTime p.toParams pt.s
  headPath : ∀ i x st, x ∈ rho.honest →
    WCDutyInput p c E rho i x (.head pt.s) st →
    ∃ Dfg ∈ KitFG.treeStoreFrameView (heightView p) st.fg (voterBlocks p st pt.s),
      eraseFG Dfg = D ∧
      ∀ A, Block.Preceq A D → A ∈ st.base.blocks ∧
        GridCO.stampBlock st.base A < SA.freezeTime p.toParams (pt.s - 1)
  headWalk : ∀ x ∈ rho.honest, ∀ H,
    headAtLabel p c E rho x pt.s = some H → Block.Preceq D H
  parent : Block.Preceq D pt.P.parent

/-- WC J1; DC full proposal admission: exact named content, also at sleeping readers. -/
structure WCProposalAdmittedBeforeVote (x : V) (pt : PtSP) : Prop where
  admission : ∃ N : NamedProposal p.n, ∃ j o t,
    o.payload = .proposal N ∧ N.erase = pt.P ∧
    rho.events[j]? = some (.deliver x o t) ∧ t < SA.voteTime p.toParams pt.s ∧
    (rho.acceptsAt E j x o t ∨ N ∈ (storeAt p c E rho j x).namedBodies) ∧
    (∃ y k, y = V2.D.proposerOf rho (fgsaInterface p c) pt.s ∧
      rho.events[k]? = some (.tick y (SA.proposalTime p.toParams pt.s)) ∧
      o ∈ rho.emitsAt E k) ∧
    ∀ i st, WCDutyInput p c E rho i x (.head pt.s) st →
      j < i ∧ N ∈ st.namedBodies ∧
      (∀ A, Block.Preceq A pt.P → A ∈ st.base.blocks) ∧
      GridCO.stampBlock st.base pt.P < SA.voteTime p.toParams pt.s

/-- WC J1; DC causal finality: the target source and finality signer's source are distinct.
The strict time bound serves the target before the finality action. -/
structure WCFinalityTargetEarlier (i : Nat) (D X : FGBlock (Fin p.n))
    (h : Height) : Prop where
  finalityRow : ∃ jf z rf af uf H jt y rt aT ut K B,
    jf < i ∧ HonestRowAt p c E rho jf z rf af ∧ RowSigner p c rho af z ∧
    af.toRow? = some uf ∧ uf ∈ chainRows D ∧
    uf.finality_pair = some ⟨h, X.root⟩ ∧
    HeldAt p c E rho jf z H ∧ (heightView p H).h_j = h ∧
    (heightView p H).J = X ∧ TargetQCAt p.E H h X ∧
    jt < jf ∧ HonestRowAt p c E rho jt y rt aT ∧
    aT.toRow? = some ut ∧ ut ∈ chainRows H ∧
    ut.height_pair = .vote h X.root false ∧
    actionSourceFG p c E rho y rt = some (some K) ∧ FGBlock.Preceq X K ∧
    gateResult p c E rho y (rt * p.R) = some (some B) ∧ Block.Preceq (eraseFG K) B ∧
    SA.gateTime p.toParams (rt * p.R) + 4 * p.Δ < p.actionTime rf

