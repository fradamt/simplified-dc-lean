  Gen.Pure.ServedOn (· ∈ rho.honest) (S_at p c E rho) w.QStar
    (fun i => iStar ≤ i ∧ i ≤ rho.events.length) ∧
  ∀ g ∈ [(fgsaInterface p c).stable, (fgsaInterface p c).confirmed],
    Gen.Pure.CompatOn (· ∈ rho.honest) (fun t x => V2.D.outputAt E rho g x t)
      (fun t => iStar ≤ timeIdx rho t) ∧
    Gen.Pure.MonoOn (· ∈ rho.honest) (fun t x => V2.D.outputAt E rho g x t)
      (fun t => iStar ≤ timeIdx rho t)

/-- WC J1; DC public read: the inclusive read includes same-time deliveries after the cut. -/
abbrev WCCutPublicReadStatement (w : HealingWitness) (iStar : Nat) : Prop :=
  V2.D.ScheduleWellFormed E rho → iStar = afterTicksIdx rho (SA.gateTime p.toParams w.u) →
  ∀ t, SA.gateTime p.toParams w.u ≤ t →
    iStar ≤ timeIdx rho t ∧ timeIdx rho t ≤ rho.events.length

/-- WC J1; DC growth: G' is quantified inside one already fixed continuation. -/
abbrev WCGrowthStatement (ΔF : Time) (u : Slot) (Q : Block) (iStar : Nat) : Prop :=
  Base₂ p c E rho → iStar = afterTicksIdx rho (SA.gateTime p.toParams u) →
  SSafeFromCut₂ p c E rho iStar Q ΔF →
  (∀ pt : PtSP, u + 2 ≤ pt.s → HonestProposal E rho (fgsaInterface p c) pt.s pt.P →
    SA.gateTime p.toParams pt.s ≤ rho.horizon → ServedFromGateAt p c E rho pt) →
  SA.gateTime p.toParams u ≤ rho.horizon → ∀ G' : Time, 4 * p.Δ ≤ G' →
  AwakeProposerRecurrenceFrom p c E rho (SA.gateTime p.toParams u) G' →
  ∀ t, SA.gateTime p.toParams u ≤ t → t + G' + 6 * p.Δ ≤ rho.horizon →
    JointGrowthAt p c E rho t (t + G' + 6 * p.Δ)

/-- WC J1; DC original selected source: the lane consumes the exact emitted-name result. -/
abbrev WCSourceOriginStatement : Prop :=
  (∀ j x r a e, HonestRowAt p c E rho j x r a →
    namedEntry a.payload.height_pair = some e →
    ∃ C B, actionSourceFG p c E rho x r = some (some C) ∧
      e = (hOf p.E p.cfg C, (derive p.E p.cfg C).T_h.root) ∧
      FGBlock.Preceq (derive p.E p.cfg C).T_h C ∧
      gateResult p c E rho x (r * p.R) = some (some B) ∧
      Block.Preceq (eraseFG C) B ∧ fastAt p c E rho x (r * p.R) (eraseFG C)) →
  ∀ j x r a e, HonestRowAt p c E rho j x r a →
    namedEntry a.payload.height_pair = some e →
    ∃ C B, actionSourceFG p c E rho x r = some (some C) ∧
      e = (hOf p.E p.cfg C, (derive p.E p.cfg C).T_h.root) ∧
      FGBlock.Preceq (derive p.E p.cfg C).T_h C ∧
      gateResult p c E rho x (r * p.R) = some (some B) ∧
      Block.Preceq (eraseFG C) B ∧ fastAt p c E rho x (r * p.R) (eraseFG C)

/-- WC J1; DC duty labels: the original occurrence determines the source-label bound. -/
abbrev WCSourceLabelStatement : Prop :=
  LabelBound p c E rho →
  ∀ i x y r a t, x ∈ rho.honest →
  rho.events[i]? = some (.tick x t) → HonestRowBefore p c E rho i y r a →
  r * p.R ≤ labelBoundAt p c rho i ∧
  (∀ s, t = SA.releaseTime p.toParams s → r * p.R ≤ s - 1) ∧
  (∀ s, 1 ≤ s → (t = SA.proposalTime p.toParams s ∨ t = SA.voteTime p.toParams s) →
    r * p.R ≤ s - 2)

end AvailableChain.FGSA.Run
end
