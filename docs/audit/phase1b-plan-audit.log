    12	/-- The chain of height `k`: a fixed block for every height. -/
    13	def chain : Nat → Block
    14	  | 0 => .genesis
    15	  | k + 1 => .node (chain k) k ⟨k + 1⟩
    16	
    17	/-- Each proposer proposes the next height; a node accepts exactly the next
    18	height. Payload `k` depends on height `k - 1`. -/
    19	def counter : ProtocolSpec 1 where
    20	  State := Nat
    21	  Label := Empty
    22	  Payload := Nat
    23	  init := 0
    24	  clock := fun st _ => st
    25	  actTime := fun ℓ => ℓ.elim
    26	  duties := fun _ => []
    27	  duties_spec := fun ℓ _ => ℓ.elim
    28	  duties_nodup := fun _ => List.nodup_nil
    29	  act := fun _ ℓ => ℓ.elim
    30	  proposalTime := fun s => s
    31	  slotsAt := fun t => if 0 ≤ t then [t.toNat] else []
    32	  slotsAt_spec := by
    33	    intro s t
    34	    change (s ∈ if 0 ≤ t then [t.toNat] else []) ↔ (s : Int) = t
    35	    by_cases h : 0 ≤ t
    36	    · simp only [if_pos h, List.mem_singleton]
    37	      have hc : (t.toNat : Int) = t := Int.toNat_of_nonneg h
    38	      constructor
    39	      · intro he
    40	        rw [he]
    41	        exact hc
    42	      · intro he
    43	        exact_mod_cast (hc.trans he.symm).symm
    44	    · simp only [if_neg h, List.not_mem_nil, false_iff]
    45	      intro he
    46	      exact h (he ▸ Int.natCast_nonneg s)
    47	  slotsAt_nodup := by intro t; split_ifs <;> simp
    48	  propose := fun st _ => some (st + 1)
    49	  gossip := fun _ _ => []
    50	  process := fun st o => if o.payload = st + 1 then st + 1 else st
    51	  wellFormed := fun _ => true
    52	  depsPresent := fun st o => decide (o.payload ≤ st + 1)
    53	  processed := fun st o => decide (o.payload ≤ st)
    54	  excludes := fun _ _ => false
    55	  handles := fun _ o o' => o = o'
    56	  carries := fun _ _ => False
    57	
    58	def counterIface : Interface counter where
    59	  confirmed := fun st => chain st
    60	  stable := fun st => chain st
    61	  block := fun k => some (chain k)
    62	  opening := fun _ => True
    63	
    64	section Mono
    65	
    66	variable {V : Type} [DecidableEq V]
    67	
    68	/-- The height of a node in a world: its state, as a number. -/
    69	def height (w : World V counter) (v : V) : Nat := w v
    70	
    71	/-- `process` returns the state or the state plus one. -/
    72	theorem process_ge (a : Nat) (o : counter.Object) : a ≤ counter.process a o := by
    73	  simp only [counter]
    74	  split_ifs <;> omega
    75	
    76	/-- A step does not decrease the height of a node. -/
    77	theorem step_mono (w : World V counter) (e : Event V counter.Object) (u : V) :
    78	    height w u ≤ height (World.step w e) u := by
    79	  unfold height
    80	  cases e with
    81	  | tick v t =>
    82	    by_cases h : u = v
    83	    · subst h
    84	      simp only [World.step, Function.update_self]
    85	      exact le_refl _
    86	    · simp only [World.step, Function.update_of_ne h]
    87	      exact le_refl _
    88	  | deliver v o t =>
    89	    by_cases h : u = v
    90	    · subst h
    91	      simp only [World.step, Function.update_self]
    92	      exact process_ge _ o
    93	    · simp only [World.step, Function.update_of_ne h]
    94	      exact le_refl _
    95	
    96	/-- A step is monotone in the world. -/
    97	theorem step_le {w w' : World V counter} (h : ∀ u, height w u ≤ height w' u)
    98	    (e : Event V counter.Object) (u : V) :
    99	    height (World.step w e) u ≤ height (World.step w' e) u := by
   100	  unfold height at h ⊢
   101	  cases e with
   102	  | tick v t =>
   103	    by_cases hu : u = v
   104	    · subst hu
   105	      simp only [World.step, Function.update_self]
   106	      exact h u
   107	    · simp only [World.step, Function.update_of_ne hu]
   108	      exact h u
   109	  | deliver v o t =>
   110	    by_cases hu : u = v
   111	    · subst hu
   112	      have hu := h u
   113	      simp only [World.step, Function.update_self, counter]
   114	      split_ifs <;> omega
   115	    · simp only [World.step, Function.update_of_ne hu]
   116	      exact h u
   117	
   118	/-- The fold over a sublist gives a smaller height at every node. -/
   119	theorem foldl_sublist {l₁ l₂ : List (Event V counter.Object)} (hl : l₁.Sublist l₂) :
   120	    ∀ w w' : World V counter, (∀ u, height w u ≤ height w' u) →
   121	      ∀ u, height (l₁.foldl World.step w) u ≤ height (l₂.foldl World.step w') u := by
   122	  induction hl with
   123	  | slnil => intro w w' h; exact h
   124	  | cons a _ ih =>
   125	    intro w w' h
   126	    exact ih w (World.step w' a) (fun u => le_trans (h u) (step_mono w' a u))
   127	  | cons_cons a _ ih =>
   128	    intro w w' h
   129	    exact ih (World.step w a) (World.step w' a) (step_le h a)
   130	
   131	/-- The height of a node only grows along the event list. -/
   132	theorem stateBefore_mono (rho : Run V counter) {i j : Nat} (hij : i ≤ j) (v : V) :
   133	    height (Run.stateBefore counter rho i) v ≤ height (Run.stateBefore counter rho j) v :=
   134	  foldl_sublist (List.take_sublist_take_left hij) _ _ (fun _ => le_refl _) v
   135	
   136	end Mono
   137	
   138	theorem counter_hooks : HooksSound counter := by
   139	  refine ⟨fun _ _ h => by simp [counter] at h, ?_, ?_, ?_, fun _ _ _ h => Or.inl h⟩
   140	  · intro V _ _ E rho _ v o i j _ h; simp [counter] at h
   141	  · intro V _ _ E rho _ v o i j hij h
   142	    exact decide_eq_true (Nat.le_trans (of_decide_eq_true h) (stateBefore_mono rho hij v))
   143	  · intro V _ _ E rho _ v o i j hij h
   144	    exact decide_eq_true
   145	      (Nat.le_trans (of_decide_eq_true h) (Nat.add_le_add_right (stateBefore_mono rho hij v) 1))
   146	
   147	def counterInst : Instance where
   148	  n := 1
   149	  P := counter
   150	  Δ := 1
   151	  Δ_pos := by decide
   152	  iface := counterIface
   153	  hooks := counter_hooks
   154	
   155	end AvailableChain.Registry.Counter
