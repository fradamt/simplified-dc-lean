    87	/-- Every early HEAD settles in each honest late pool as that vote or
    88	equivocation evidence for its seat. -/
    89	theorem synchronous_early_vote_late {V : Type} [DecidableEq V] [Fintype V]
    90	    (p : Params) (E : Env V) (rho : Run V (gridCO p)) (hΔ : E.Δ = p.Δ)
    91	    (r : Slot) (hsync : SynchronousLabel p E rho r)
    92	    (source reader : V) (hs : source ∈ rho.honest) (hr : reader ∈ rho.honest)
    93	    (o : Wire p.n) (ho : o ∈ earlyVotes p (gateInput p rho r source) r) :
    94	    ∀ i, headSeat? o = some i →
    95	      o ∈ lateVotes p (gateInput p rho r reader) r ∨
    96	      equivocates (lateVotes p (gateInput p rho r reader) r) i = true := by
    97	  obtain ⟨hraw, hres⟩ := List.mem_filter.mp ho
    98	  obtain ⟨hm, hl⟩ := List.mem_filter.mp hraw
    99	  have hhead : ∃ B, o.payload = .head B := by
   100	    cases ho : o.payload <;> simp_all [headLabel?]
   101	  obtain ⟨B, hb⟩ := hhead
   102	  have ht : stampVote (gateInput p rho r source) o < earlyTime p r := by
   103	    simp only [resolvedBefore, headTarget?, hb, Bool.and_eq_true, decide_eq_true_eq] at hres
   104	    exact hres.1.2
   105	  have hpub : PublicTime E (earlyTime p r) := by
   106	    refine ⟨4 * r + 2, ?_⟩
   107	    simp only [earlyTime, proposalTime, hΔ, Nat.cast_add, Nat.cast_mul, Nat.cast_ofNat]
   108	    ring
   109	  have hz : 0 ≤ earlyTime p r := by
   110	    dsimp [earlyTime, proposalTime]
   111	    nlinarith [p.deltaPos, Int.natCast_nonneg r]
   112	  change o ∈ (Run.stateBeforeTime (gridCO p) rho (gateTime p r) source).votes at hm
   113	  change stampVote (Run.stateBeforeTime (gridCO p) rho (gateTime p r) source) o < _ at ht
   114	  rw [time_input_eq_event_prefix p E rho hsync.1.toScheduleWellFormed] at hm ht
   115	  obtain ⟨index, _, t, ha, ht⟩ := stored_head_accepted_before p E rho
   116	    hsync.1.toScheduleWellFormed _ source o (earlyTime p r) hpub hz hm ht
   117	  have hc : freezeTime p r ≤ gateTime p r := by
   118	    dsimp [freezeTime, gateTime]; linarith [p.deltaPos]
   119	  have hg : proposalTime p r + E.Δ ≤ freezeTime p r := by
   120	    rw [hΔ]; dsimp [freezeTime]; linarith [p.deltaPos]
   121	  have hsettle := synchronous_accepted_head_before p E rho hΔ r hsync source reader hs hr
   122	    index o B t (freezeTime p r) (gateTime p r) hb (by simpa using hl) ha
   123	    (by rw [hΔ]; dsimp [earlyTime, freezeTime] at *; linarith) hg hc hc
   124	  intro i hi
   125	  have hsub : stampedVotes (gateInput p rho r reader) r (freezeTime p r) ⊆
   126	      lateVotes p (gateInput p rho r reader) r := by
   127	    intro q hq
   128	    obtain ⟨hm, ht⟩ := List.mem_filter.mp hq
   129	    exact List.mem_filter.mpr ⟨hm, by simpa using (of_decide_eq_true ht).trans_le hc⟩
   130	  rcases hsettle i hi with hm | he
   131	  · exact Or.inl (hsub hm)
   132	  · exact Or.inr (equivocates_mono _ _ i hsub he)
   133	
