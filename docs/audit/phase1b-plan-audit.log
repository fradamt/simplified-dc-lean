   437	def savedGenuine {n : Nat} (st : State n) (r : Slot) : Option (Option Block) :=
   438	  (st.genuine.find? (fun row => row.1 == r)).map Prod.snd
   439	
   440	/-- Save the raw result before the local guard. A saved label is immutable. -/
   441	def recordGenuine [LeasePolicy] {n : Nat} (st : State n) (r : Slot)
   442	    (result : Option Block) : List (Slot × Option Block) :=
   443	  if LeasePolicy.slowArming && !(savedGenuine st r).isSome then
   444	    st.genuine ++ [(r, result)] else st.genuine
   445	
   446	/-- The current genuine result is supplied separately. The preceding `m-1`
   447	labels must all exist and cover the same prefix. No negative label is used. -/
   448	def slowEligible (p : Params) {n : Nat} (st : State n) (r : Slot) (b : Block) : Bool :=
   449	  p.m ≤ r + 1 && (List.range (p.m - 1)).all (fun j =>
   450	    match savedGenuine st (r - (j + 1)) with
   451	    | some (some C) => Block.preceq b C
   452	    | _ => false)
