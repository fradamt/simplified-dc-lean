   140	    (p : Params) (E : Env V) (rho : Run V (gridCO p)) (hΔ : E.Δ = p.Δ)
   141	    (r : Slot) (hsync : EarlyDelivery p E rho r)
   142	    (source reader : V) (hs : source ∈ rho.honest) (hr : reader ∈ rho.honest)
   143	    (o : Wire p.n) (he : Run.emits (gridCO p) E rho source o (voteTime p r)) :
   144	    ∃ index t, voteTime p r ≤ t ∧ t < earlyTime p r ∧
   145	      Run.handlesAt (gridCO p) rho index reader o t := by
   146	  have hdeadline : voteTime p r + E.Δ = earlyTime p r := by
   147	    simp only [voteTime, earlyTime, hΔ]
   148	    ring
   149	  rcases hsync.delivery with ⟨hgst, hnet⟩ | ⟨cut, hcut, hnet⟩
   150	  · have hg : E.t_GST ≤ voteTime p r := by
   151	      dsimp [voteTime]
   152	      linarith [p.deltaPos]
   153	    have hmax : max (voteTime p r) E.t_GST = voteTime p r := max_eq_left hg
   154	    obtain ⟨t, ht, hd, index, hh⟩ := hnet.broadcast source hs o _ he reader hr
   155	      (by rw [hmax, hdeadline]; exact hsync.horizon) rfl
   156	    exact ⟨index, t, ht, by simpa [hmax, hdeadline] using hd, hh⟩
   157	  · obtain ⟨t, ht, hd, index, hh⟩ := hnet.broadcast source hs o _ he reader hr
   158	      (by rw [hdeadline]; exact hcut) rfl
   159	    exact ⟨index, t, ht, by simpa [hdeadline] using hd, hh⟩
   160	
   161	/-- A synchronous honest HEAD is stored before the early cutoff at every
   162	honest reader. Target-path receipt is a separate obligation. -/
   163	theorem synchronous_honest_head_stored_early
   164	    {V : Type} [DecidableEq V]
   165	    (p : Params) (E : Env V) (rho : Run V (gridCO p)) (hΔ : E.Δ = p.Δ)
   166	    (r : Slot) (hsync : EarlyDelivery p E rho r)
   167	    (i : Fin p.n) (B : Block) (hh : rho.seatOf r i ∈ rho.honest)
   168	    (he : Run.emits (gridCO p) E rho (rho.seatOf r i)
   169	      ⟨.seat r i, .head B⟩ (voteTime p r))
   170	    (reader : V) (hr : reader ∈ rho.honest) :
   171	    ∃ index t, voteTime p r ≤ t ∧ t < earlyTime p r ∧
   172	      Run.handlesAt (gridCO p) rho index reader ⟨.seat r i, .head B⟩ t ∧
   173	      (⟨.seat r i, .head B⟩ : Wire p.n) ∈
   174	        (Run.stateBefore (gridCO p) rho (index + 1) reader).votes := by
   175	  obtain ⟨index, t, hlo, hhi, hhandle⟩ :=
   176	    synchronous_head_handled_early p E rho hΔ r hsync (rho.seatOf r i) reader hh hr _ he
   177	  exact ⟨index, t, hlo, hhi, hhandle,
   178	    early_handled_honest_head_stored p E rho hsync.execution hΔ index reader r i B t
   179	      hh hlo hhi hhandle⟩
