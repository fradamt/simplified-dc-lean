    21	private theorem member_le_max (xs : List Nat) (acc g : Nat) (h : g ∈ xs) :
    22	    g ≤ xs.foldl max acc := by
    23	  have hacc (ys : List Nat) (a : Nat) : a ≤ ys.foldl max a := by
    24	    induction ys generalizing a with
    25	    | nil => exact le_refl _
    26	    | cons y ys ih => exact (le_max_left _ _).trans (ih _)
    27	  induction xs generalizing acc with
    28	  | nil => simp at h
    29	  | cons x xs ih =>
    30	    rcases List.mem_cons.mp h with he | ht
    31	    · subst x; exact (le_max_right _ _).trans (hacc _ _)
    32	    · exact ih _ ht
    33	
    34	/-- Adapter for the shared Goldfish engine. The dense grid is unused by
    35	SA admission. It provides the existing engine parameter type without
    36	adding a parameter or premise to SA. -/
