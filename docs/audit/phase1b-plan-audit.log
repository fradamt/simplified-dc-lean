   155	  let mut stack := #[n]
   156	  let mut out := #[]
   157	  while h : stack.size > 0 do
   158	    let m := stack[stack.size - 1]
   159	    stack := stack.pop
   160	    out := out.push m
   161	    for d in (← node env m).deps do
   162	      unless seen.contains d do
   163	        seen := seen.insert d
   164	        stack := stack.push d
