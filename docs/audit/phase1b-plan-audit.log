    18	    ClaimSpec ClaimDomain.v1 where
    19	  id := id
    20	  Const := Unit
    21	  valid := fun _ => True
    22	  le := fun _ _ => true
    23	  le_refl := fun _ => rfl
    24	  le_trans := fun _ _ _ _ _ => rfl
    25	  Point := Time
    26	  regime := fun I _ W x t₀ => sleepy I W x.E x.rho t₀
    27	  conclusion := fun I _ _ x t₀ => SafeFrom I.P x.rho (g I) t₀
    28	  trigger := fun _ _ _ _ _ _ => True
    29	  transport := by
    30	    intro I k k' _ _ _ h
    31	    cases k; cases k'; exact h
    32	  refutable := .run
    33	
    34	def safeConfirmed : ClaimSpec ClaimDomain.v1 :=
    35	  safeOf `core.safe.confirmed.v1 (fun I => I.iface.confirmed)
    36	
    37	def safeStable : ClaimSpec ClaimDomain.v1 :=
    38	  safeOf `core.safe.stable.v1 (fun I => I.iface.stable)
    39	
    40	/-- `stable ⪯ confirmed` at every honest node and time, in every run. -/
    41	def prefixOrder : ClaimSpec ClaimDomain.v1 where
    42	  id := `core.prefix.stableConfirmed.v1
    43	  Const := Unit
    44	  valid := fun _ => True
    45	  le := fun _ _ => true
    46	  le_refl := fun _ => rfl
    47	  le_trans := fun _ _ _ _ _ => rfl
    48	  Point := Unit
    49	  regime := fun _ _ _ _ _ => True
    50	  conclusion := fun I _ _ x _ => OutputOrder I.P I.iface x.rho
    51	  trigger := fun _ _ _ _ _ _ => True
    52	  transport := by
    53	    intro I k k' _ _ _ h
    54	    cases k; cases k'; exact h
    55	  refutable := .run
    56	
    57	/-- Exact-time inclusion of honest proposals in `confirmed`, Sleepy regime.
    58	`D` is fixed: `le` is equality (design §4). -/
    59	def includedConfirmed : ClaimSpec ClaimDomain.v1 where
    60	  id := `core.included.confirmed.v1
    61	  Const := Time
