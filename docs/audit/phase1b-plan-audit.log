   153	/-- Relay of an accepted object to acceptance at every honest reader. -/
   154	def AcceptedObjectRelay (P : AvailableChain.Generic.ProtocolSpec n)
   155	    (E : AvailableChain.Generic.Env V)
   156	    (rho : AvailableChain.Generic.Run V P) : Prop :=
   157	  ∀ v ∈ rho.honest, ∀ i o t,
   158	    AvailableChain.Generic.Run.acceptsAt P rho i v o t →
   159	    ∀ w ∈ rho.honest,
   160	      P.processed (AvailableChain.Generic.Run.stateBefore P rho (i + 1) w) o = false →
   161	      max t E.t_GST + E.Δ ≤ rho.horizon →
   162	      ∃ t', t ≤ t' ∧ t' < max t E.t_GST + E.Δ ∧
   163	        ∃ j, AvailableChain.Generic.Run.acceptsAt P rho j w o t'
   164	
   165	/-- Accepted-object relay on a healthy finite prefix. -/
   166	def HealthyAcceptedObjectRelay (P : AvailableChain.Generic.ProtocolSpec n)
   167	    (E : AvailableChain.Generic.Env V)
   168	    (rho : AvailableChain.Generic.Run V P) (cut : Time) : Prop :=
   169	  ∀ v ∈ rho.honest, ∀ i o t,
   170	    AvailableChain.Generic.Run.acceptsAt P rho i v o t →
   171	    ∀ w ∈ rho.honest,
   172	      P.processed (AvailableChain.Generic.Run.stateBefore P rho (i + 1) w) o = false →
   173	      t + E.Δ ≤ cut →
   174	      ∃ t', t ≤ t' ∧ t' < t + E.Δ ∧
   175	        ∃ j, AvailableChain.Generic.Run.acceptsAt P rho j w o t'
   176	
   177	/-- Honest validators awake at `t`. -/
   178	def awakeAt (E : AvailableChain.Generic.Env V) (H : Finset V)
   179	    (t : Time) : Finset V :=
   180	  H.filter (fun v => E.awake v t = true)
   181	
   182	/-- Honest validators awake at some time in the closed window `[a,b]`. -/
   183	noncomputable def awakeInClosed (E : AvailableChain.Generic.Env V) (H : Finset V)
   184	    (a b : Time) : Finset V := by
   185	  classical
   186	  exact H.filter (fun v => ∃ u, a ≤ u ∧ u ≤ b ∧ E.awake v u = true)
   187	
   188	/-- Faulty membership is the complement of the run's fixed honest set. -/
   189	def faulty (rho : AvailableChain.Generic.Run V P) : Finset V :=
   190	  Finset.univ \ rho.honest
   191	
   192	/-- More honest validators are awake than there are faulty validators. -/
   193	def AwakeMajority (E : AvailableChain.Generic.Env V)
   194	    (rho : AvailableChain.Generic.Run V P) (t : Time) : Prop :=
   195	  (faulty rho).card < (awakeAt E rho.honest t).card
   196	
   197	/-- `|H_t| > θ · |H_[t−η,t] ∪ A|`. -/
   198	def EtaSleepy (E : AvailableChain.Generic.Env V)
   199	    (C : Constants) (rho : AvailableChain.Generic.Run V P)
   200	    (t : Time) : Prop :=
   201	  C.θ * ((awakeInClosed E rho.honest (t - C.η) t ∪ faulty rho).card : ℚ) <
   202	  ((awakeAt E rho.honest t).card : ℚ)
   203	
   204	/-- Honest validators remain awake over the stated interval. -/
   205	def FullParticipation (E : AvailableChain.Generic.Env V)
   206	    (rho : AvailableChain.Generic.Run V P) (start : Time) : Prop :=
   207	  ∀ v ∈ rho.honest, ∀ t, start ≤ t → t ≤ rho.horizon → E.awake v t = true
   208	
   209	/-- Fewer than a quarter of the validators are faulty. -/
   210	def BelowQuarter (rho : AvailableChain.Generic.Run V P) : Prop :=
   211	  4 * (faulty rho).card < Fintype.card V
   212	
   213	/-- Every bounded window after `start` contains an opening slot whose proposer
   214	is honest and awake. -/
   215	def HonestProposerRecurrence (E : AvailableChain.Generic.Env V) (I : Interface P)
   216	    (rho : AvailableChain.Generic.Run V P)
   217	    (start gap : Time) : Prop :=
   218	  ∀ t, start ≤ t → t + gap ≤ rho.horizon →
   219	    ∃ s, t < P.proposalTime s ∧ P.proposalTime s ≤ t + gap ∧
   220	      I.opening s ∧ HonestAwakeProposer E rho s
   221	
   222	end AvailableChain.Statements.Generic
   223	end

