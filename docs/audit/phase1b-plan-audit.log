     7	namespace AvailableChain.Framework
     8	
     9	variable {K : ClaimDomain}
    10	
    11	/-- One claim of a profile, with the projection of the shared constants to the
    12	claim's own constant (design §4, profiles; PHASE0-REPORT §5.1 (g)). -/
    13	structure Profile.Entry (K : ClaimDomain) (S : Type) where
    14	  spec : ClaimSpec K
    15	  share : S → spec.Const
    16	
    17	/-- A named set of catalog claims with shared constants. `valid` holds the
    18	conditions that relate constants of different claims (for `ac-4.3`, all of
    19	`Constants.Valid`). -/
    20	structure Profile (K : ClaimDomain) where
    21	  id : Lean.Name
    22	  Shared : Type
    23	  valid : Shared → Prop
    24	  entries : List (Profile.Entry K Shared)
    25	
    26	/-- One certificate per claim of the profile, all for one instance, all at the
    27	projections of ONE shared constant. -/
    28	structure ProfileCert (p : Profile K) (I : K.Inst) : Type 1 where
    29	  shared : p.Shared
    30	  valid : p.valid shared
    31	  certs : ∀ e ∈ p.entries, {x : Cert e.spec I // x.const = e.share shared}
    32	
    33	/-- The claims of a profile hold at one shared constant (no inhabitation). -/
    34	def Profile.holdsAt (p : Profile K) (I : K.Inst) (C : p.Shared) : Prop :=
    35	  p.valid C ∧ ∀ e ∈ p.entries, e.spec.valid (e.share C) ∧ e.spec.holds I (e.share C)
    36	
    37	theorem ProfileCert.holdsAt {p : Profile K} {I : K.Inst} (pc : ProfileCert p I) :
    38	    p.holdsAt I pc.shared := by
    39	  refine ⟨pc.valid, fun e he => ?_⟩
    40	  obtain ⟨x, hx⟩ := pc.certs e he
    41	  exact ⟨hx ▸ x.valid, hx ▸ x.proof⟩
    42	
    43	end AvailableChain.Framework
    44	
    45	end
