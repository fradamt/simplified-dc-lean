    32	    (i : Nat) (e : Event V P.Object) :
    33	    (runPrefix rho cut).events[i]? = some e ↔
    34	      rho.events[i]? = some e ∧ e.time ≤ cut := by
    35	  simp only [runPrefix, List.getElem?_take]
    36	  split
    37	  · rename_i hi
    38	    exact ⟨fun he => ⟨he, (index_lt_read_length_iff hs cut he).mp hi⟩,
    39	      fun h => h.1⟩
    40	  · rename_i hi
    41	    constructor
    42	    · intro h; cases h
    43	    · intro ⟨he, ht⟩
    44	      exact (hi ((index_lt_read_length_iff hs cut he).mpr ht)).elim
    45	
    46	theorem runPrefix_stateBefore (cut : Time) (i : Nat)
    47	    (hi : i ≤ (rho.events.filter (fun e => decide (e.time ≤ cut))).length) :
    48	    Run.stateBefore P (runPrefix rho cut) i = Run.stateBefore P rho i := by
    49	  simp only [Run.stateBefore, runPrefix, List.take_take, Nat.min_eq_left hi]
    50	
    51	theorem runPrefix_readAt (hs : ScheduleWellFormed E rho) (cut t : Time)
    52	    (ht : t ≤ cut) : Run.readAt P (runPrefix rho cut) t = Run.readAt P rho t := by
    53	  simp only [Run.readAt, runPrefix_events hs, List.filter_filter]
    54	  congr 2
    55	  funext e
    56	  apply Bool.eq_iff_iff.mpr
    57	  simp only [Bool.and_eq_true, decide_eq_true_eq]
    58	  exact ⟨fun h => h.1, fun h => ⟨h, h.trans ht⟩⟩
    59	
    60	theorem runPrefix_stateBeforeTime (hs : ScheduleWellFormed E rho) (cut t : Time)
    61	    (ht : t ≤ cut) :
    62	    Run.stateBeforeTime P (runPrefix rho cut) t = Run.stateBeforeTime P rho t := by
    63	  simp only [Run.stateBeforeTime, runPrefix_events hs, List.filter_filter]
    64	  congr 2
    65	  funext e
    66	  apply Bool.eq_iff_iff.mpr
    67	  simp only [Bool.and_eq_true, decide_eq_true_eq]
    68	  exact ⟨fun h => h.1, fun h => ⟨h, h.le.trans ht⟩⟩
