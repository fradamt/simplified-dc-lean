    70	/-- A prefix event has the same input and output as the original event. -/
    71	theorem runPrefix_event_states (hs : ScheduleWellFormed E rho) (cut : Time)
    72	    {i : Nat} {e : Event V P.Object}
    73	    (he : (runPrefix rho cut).events[i]? = some e) :
    74	    Run.stateBefore P (runPrefix rho cut) i = Run.stateBefore P rho i ∧
    75	      Run.stateBefore P (runPrefix rho cut) (i + 1) = Run.stateBefore P rho (i + 1) := by
    76	  obtain ⟨orig, time⟩ := (runPrefix_event_iff hs cut i e).mp he
    77	  have hi := (index_lt_read_length_iff hs cut orig).mpr time
    78	  exact ⟨runPrefix_stateBefore cut i hi.le,
    79	    runPrefix_stateBefore cut (i + 1) (Nat.succ_le_of_lt hi)⟩
