   268	/-- The same complete-archive bridge holds on a healthy prefix. -/
   269	theorem receipt_healthyAcceptedRelay {V : Type} [DecidableEq V]
   270	    (p : Params) (E : Env V) (rho : Run V (sapc p))
   271	    (hx : ExecutionValid (sapc p) E rho) (cut : Time)
   272	    (hnet : HealthyPrefixDelivery (sapc p) E rho cut) :
   273	    HealthyAcceptedObjectRelay (sapc p) E rho cut := by
   274	  intro source hs i o t ha reader hr hm deadline
   275	  obtain ⟨t', htt, htD, j, hh⟩ := hnet.relay source hs i o t ha reader hr hm deadline rfl
   276	  exact accepted_receipt_accepts_before p E rho hx i j source reader o t t' _ ha hm hh htt htD
   277	
