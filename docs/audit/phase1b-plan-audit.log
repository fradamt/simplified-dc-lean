   208	    if ← locked n ci then found := found.push n
   209	  let names := found.qsort Name.lt
   210	  let mut problems := #[]
   211	  let mut ids : Std.HashMap Name Name := {}
   212	  let mut profileIds : Std.HashMap Name Name := {}
