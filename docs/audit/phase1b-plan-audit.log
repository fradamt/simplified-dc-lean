   454	/-- The shared gate changes only the selected lease levels. SA selects
   455	its one level after either admission test. The outer gate checks containment. -/
   456	def admissionLevels [LeasePolicy] (p : Params) {n : Nat} (st : State n)
   457	    (r : Slot) (b : Block) : List Nat :=
   458	  if LeasePolicy.slowArming then
   459	    if releaseThreshold p ≤ prefixSupport p st r b || slowEligible p st r b then
