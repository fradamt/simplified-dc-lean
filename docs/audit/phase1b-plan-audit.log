   135	/-- A surviving early HEAD excludes any different late HEAD from its seat. -/
   136	theorem cleanSupport_eq_of_late_same_seat (p : Params) {n : Nat} (st : State n)
   137	    (r : Slot) (i : Fin n) (a b : Wire n)
   138	    (ha : a ∈ cleanSupport p st r) (hb : b ∈ lateVotes p st r)
   139	    (hia : headSeat? a = some i) (hib : headSeat? b = some i) : a = b := by
   140	  obtain ⟨haearly, hclean⟩ := List.mem_filter.mp ha
