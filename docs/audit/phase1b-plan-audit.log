   200	
   201	/-- The locked names (sorted), and the problems that force exit 2. -/
   202	def scan : MetaM (Array Name × Array String) := do
   203	  let env ← getEnv
   204	  if (← findDeclarationRangesCore? claimSpecName).isNone then
   205	    return (#[], #[s!"no declaration range for {claimSpecName}: the .olean.server data is missing"])
