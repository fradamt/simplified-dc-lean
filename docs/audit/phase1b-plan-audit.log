   126	hp(empty)                    = 0
   127	hp(vote h entry timeout)     = 1 + P(h, P(entry.value, bool(timeout)))
   128	fp(none)                     = 0
   129	fp(some (h, target))          = 1 + P(h, target.value)
   130	row(a)                       = P(encV(a.signer), P(hp(a.height_pair),
   131	                                                 fp(a.finality_pair)))
   132	rows([])                     = 0
   133	rows(a :: as)                = 1 + P(row(a), rows(as))
   134	fgRoot(parentRoot, slot, rs)  = 1 + P(parentRoot.value, P(slot, rows(rs)))
   135	```
