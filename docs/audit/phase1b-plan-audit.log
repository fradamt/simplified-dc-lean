    10	/-- Proof environment for a closed healthy prefix. At the last instant,
    11	all nodes are awake. This cannot change any state or any earlier emission.
    12	The boundary must have no named proposal when transporting root scope. -/
    13	def prefixEnv (E : Env V) (cut : Time) : Env V :=
    14	  { E with t_GST := 0, t_GST_nonneg := le_refl 0
    15	           awake := fun v t => if t = cut then true else E.awake v t }
    16	
    17	variable {E : Env V} {rho : Run V P}
    18	
    19	theorem prefixEnv_emittedAt (cut : Time) (i : Nat) (v : V) (t : Time)
    20	    (ht : t ≠ cut) :
    21	    Run.emittedAt P (prefixEnv E cut) rho i v t = Run.emittedAt P E rho i v t := by
    22	  simp only [Run.emittedAt, prefixEnv, if_neg ht]
    23	
    24	theorem prefixEnv_emits_mono (cut : Time) (v : V) (o : P.Object) (t : Time)
    25	    (h : Run.emits P E rho v o t) : Run.emits P (prefixEnv E cut) rho v o t := by
    26	  obtain ⟨i, he, hm⟩ := h
    27	  refine ⟨i, he, ?_⟩
    28	  by_cases ht : t = cut
    29	  · have awake : E.awake v t = true := by
    30	      by_contra hn
    31	      simp [Run.emittedAt, hn] at hm
    32	    simpa only [Run.emittedAt, prefixEnv, if_pos ht, ↓reduceIte, awake] using hm
    33	  · rwa [prefixEnv_emittedAt cut i v t ht]
    34	
    35	theorem prefixEnv_emits_iff (cut : Time) (v : V) (o : P.Object) (t : Time)
    36	    (ht : t ≠ cut) :
    37	    Run.emits P (prefixEnv E cut) rho v o t ↔ Run.emits P E rho v o t := by
    38	  simp only [Run.emits, prefixEnv_emittedAt cut _ v t ht]
    39	
    40	omit [DecidableEq V] in
    41	theorem prefixEnv_schedule (hs : ScheduleWellFormed E rho) (cut : Time) :
    42	    ScheduleWellFormed (prefixEnv E cut) rho :=
    43	  ⟨hs.horizon_nonneg, hs.sorted, hs.nodup, hs.in_horizon, hs.honest_only,
    44	    hs.tick_public, hs.tick_total⟩
    45	
    46	theorem prefixEnv_execution (hx : ExecutionValid P E rho) (cut : Time) :
    47	    ExecutionValid P (prefixEnv E cut) rho := by
    48	  refine { prefixEnv_schedule hx.toScheduleWellFormed cut,
    49	    hx.toDeliveryWellFormed with unforgeable := ?_, carried := ?_ }
    50	  · intro v o t hp u hu holder
    51	    obtain ⟨t', ht', he⟩ := hx.unforgeable v o t hp u hu holder
    52	    exact ⟨t', ht', prefixEnv_emits_mono cut u o t' he⟩
    53	  · intro v o t hp obj carries u hu holder
    54	    obtain ⟨t', ht', he⟩ := hx.carried v o t hp obj carries u hu holder
    55	    exact ⟨t', ht', prefixEnv_emits_mono cut u obj t' he⟩
    56	
    57	/-- Healthy delivery supplies all synchronous deadlines in the closed
    58	prefix. A boundary emission has no deadline inside that prefix. -/
    59	theorem healthyPrefix_partialSynchrony (hx : ExecutionValid P E rho)
    60	    (cut : Time) (healthy : HealthyPrefixDelivery P E rho cut) :
    61	    PartialSynchrony P (prefixEnv E cut) (runPrefix rho cut) := by
    62	  have hs := hx.toScheduleWellFormed
    63	  have deadline (t : Time) (ht : 0 ≤ t) :
    64	      max t (prefixEnv E cut).t_GST + (prefixEnv E cut).Δ = t + E.Δ := by
    65	    exact congrArg (fun x => x + E.Δ) (max_eq_left ht)
    66	  constructor
    67	  · intro v hv o t he w hw bound excl
    68	    obtain ⟨emit, time⟩ := (runPrefix_emits_iff hs cut (prefixEnv E cut) v o t).mp he
    69	    obtain ⟨i, tick, _⟩ := emit
    70	    have nonneg := (hs.in_horizon _ (List.mem_of_getElem? tick)).1
    71	    change 0 ≤ t at nonneg
    72	    rw [deadline t nonneg] at bound excl
    73	    have before : t < cut := lt_of_lt_of_le (lt_add_of_pos_right t E.Δ_pos) bound
    74	    have orig := (prefixEnv_emits_iff cut v o t before.ne).mp
    75	      ((runPrefix_emits_iff hs cut (prefixEnv E cut) v o t).mp he).1
    76	    rw [runPrefix_stateBeforeTime hs cut _ bound] at excl
    77	    obtain ⟨t', lo, hi, j, handles⟩ := healthy.broadcast v hv o t orig w hw bound excl
    78	    exact ⟨t', lo, (deadline t nonneg).symm ▸ hi, j,
    79	      (runPrefix_handlesAt_iff hs cut j w o t').mpr ⟨handles, hi.le.trans bound⟩⟩
    80	  · intro v hv i o t accept w hw fresh bound excl
    81	    obtain ⟨orig, time⟩ := (runPrefix_acceptsAt_iff hs cut i v o t).mp accept
    82	    obtain ⟨obj, delivery, _⟩ := orig.1
    83	    have nonneg := (hs.in_horizon _ (List.mem_of_getElem? delivery)).1
    84	    change 0 ≤ t at nonneg
    85	    rw [deadline t nonneg] at bound excl
    86	    rw [runPrefix_stateBeforeTime hs cut _ bound] at excl
    87	    have hi := (index_lt_read_length_iff hs cut delivery).mpr time
    88	    rw [runPrefix_stateBefore cut (i + 1) (Nat.succ_le_of_lt hi)] at fresh
    89	    obtain ⟨t', lo, hi', j, handles⟩ := healthy.relay v hv i o t orig w hw fresh bound excl
    90	    exact ⟨t', lo, (deadline t nonneg).symm ▸ hi', j,
    91	      (runPrefix_handlesAt_iff hs cut j w o t').mpr ⟨handles, hi'.le.trans bound⟩⟩
    92	
    93	theorem healthyPrefix_acceptedRelay (hx : ExecutionValid P E rho)
    94	    (cut : Time) (relay : HealthyAcceptedObjectRelay P E rho cut) :
    95	    AcceptedObjectRelay P (prefixEnv E cut) (runPrefix rho cut) := by
    96	  have hs := hx.toScheduleWellFormed
    97	  intro v hv i o t accept w hw fresh bound
    98	  obtain ⟨orig, time⟩ := (runPrefix_acceptsAt_iff hs cut i v o t).mp accept
    99	  obtain ⟨obj, delivery, _⟩ := orig.1
   100	  have nonneg := (hs.in_horizon _ (List.mem_of_getElem? delivery)).1
   101	  change 0 ≤ t at nonneg
   102	  have deadline : max t (prefixEnv E cut).t_GST + (prefixEnv E cut).Δ = t + E.Δ := by
   103	    exact congrArg (fun x => x + E.Δ) (max_eq_left nonneg)
   104	  rw [deadline] at bound
   105	  have hi := (index_lt_read_length_iff hs cut delivery).mpr time
   106	  rw [runPrefix_stateBefore cut (i + 1) (Nat.succ_le_of_lt hi)] at fresh
   107	  obtain ⟨t', lo, hi', j, accepts⟩ := relay v hv i o t orig w hw fresh bound
   108	  exact ⟨t', lo, deadline.symm ▸ hi', j,
   109	    (runPrefix_acceptsAt_iff hs cut j w o t').mpr ⟨accepts, hi'.le.trans bound⟩⟩
   110	
   111	/-- There is no new root scope if boundary emissions contain no named
   112	block. Earlier emissions and every delivered object are unchanged. -/
   113	theorem healthyPrefix_rootInjective (hs : ScheduleWellFormed E rho)
   114	    (I : Interface P) (cut : Time) (roots : RootInjective E I rho)
   115	    (boundary : ∀ v o, Run.emits P (prefixEnv E cut) rho v o cut →
   116	      I.block o.payload = none) :
   117	    RootInjective (prefixEnv E cut) I (runPrefix rho cut) := by
   118	  have scope (b : Block) (hb : BlockInRun (prefixEnv E cut) I (runPrefix rho cut) b) :
   119	      BlockInRun E I rho b := by
   120	    rcases hb with hg | ⟨v, o, t, tip, hp | he, block, ancestor⟩
   121	    · exact Or.inl hg
   122	    · exact Or.inr ⟨v, o, t, tip,
   123	        Or.inl ((runPrefix_processes_iff hs cut v o t).mp hp).1, block, ancestor⟩
   124	    · obtain ⟨orig, time⟩ := (runPrefix_emits_iff hs cut (prefixEnv E cut) v o t).mp he
   125	      have ne : t ≠ cut := by
   126	        rintro rfl
   127	        rw [boundary v o orig] at block
   128	        cases block
   129	      exact Or.inr ⟨v, o, t, tip,
   130	        Or.inr ((prefixEnv_emits_iff cut v o t ne).mp orig), block, ancestor⟩
   131	  exact fun b c hb hc => roots b c (scope b hb) (scope c hc)
   132	
   133	/-- A finite healthy prefix is a Sleepy run in a proof environment.
   134	The only boundary side condition is that it emits no named block.
   135	No participation premise at the cutoff is added to the original run. -/
   136	theorem healthyPrefix_sleepy [Fintype V] (hx : ExecutionValid P E rho)
   137	    (I : Interface P) (cut : Time) (positive : 0 < cut) (hh : cut ≤ rho.horizon)
   138	    (roots : RootInjective E I rho)
   139	    (healthy : HealthyPrefixDelivery P E rho cut)
   140	    (majority : ∀ t, 0 ≤ t → t < cut → AwakeMajority E rho t)
   141	    (boundary : ∀ v o, Run.emits P (prefixEnv E cut) rho v o cut →
   142	      I.block o.payload = none) :
   143	    SleepyRegime P (prefixEnv E cut) I (runPrefix rho cut) 0 := by
   144	  refine ⟨runPrefix_execution (prefixEnv_execution hx cut) cut positive.le hh,
   145	    healthyPrefix_rootInjective hx.toScheduleWellFormed I cut roots boundary,
   146	    healthyPrefix_partialSynchrony hx cut healthy,
   147	    rfl, rfl, ?_⟩
   148	  intro t ht bound
   149	  change t ≤ cut at bound
   150	  by_cases eq : t = cut
   151	  · subst t
   152	    have hzero := majority 0 (le_refl _) positive
   153	    have sub : awakeAt E rho.honest 0 ⊆ rho.honest := Finset.filter_subset _ _
   154	    have count := lt_of_lt_of_le hzero (Finset.card_le_card sub)
   155	    simpa [AwakeMajority, awakeAt, prefixEnv, runPrefix, faulty] using count
   156	  · have before := lt_of_le_of_ne bound eq
   157	    simpa only [AwakeMajority, awakeAt, prefixEnv, runPrefix, if_neg eq, faulty]
   158	      using majority t ht before
   159	
   160	end AvailableChain.Engine
   161	end
