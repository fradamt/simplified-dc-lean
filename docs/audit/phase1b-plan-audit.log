   266	def admitVote (p : Params) {n : Nat} (st : State n) (o : Wire n) : State n :=
   267	  match o.auth, o.payload with
   268	  | .seat r i, .head _ =>
   269	      let current := (st.now / (4 * p.Δ)).toNat
