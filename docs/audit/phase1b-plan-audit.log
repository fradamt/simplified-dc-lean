    11	
    12	/-- A protocol instance (design §3): the protocol, bound once. Claim constants
    13	are not here; they belong to certificates. The v1 `Interface` is the one field
    14	facet. Another facet is a structure that extends `Instance`, with its own claim
    15	domain. -/
    16	structure Instance where
    17	  n : Nat
    18	  P : ProtocolSpec n
    19	  /-- Every certified environment has this Δ. -/
    20	  Δ : Time
    21	  /-- Without it, no environment has the instance's Δ, and every claim holds
    22	  vacuously. -/
    23	  Δ_pos : 0 < Δ
    24	  iface : Interface P
    25	  hooks : HooksSound P
    26	
    27	/-- A v1 run context: an environment and a run of the instance's protocol. -/
    28	structure V1Ctx (I : Instance) (W : Validators) where
    29	  E : Env W.V
    30	  rho : Run W.V I.P
    31	
    32	/-- The v1 claim domain: today's instances with an environment and a v1 run. -/
    33	@[reducible] def ClaimDomain.v1 : ClaimDomain where
    34	  id := `v1
    35	  Inst := Instance
    36	  Ctx := V1Ctx
    37	  admissible := fun I _ x => x.E.Δ = I.Δ
    38	  horizon := fun _ _ x => x.rho.horizon
    39	
    40	end AvailableChain.Framework
