   514	private theorem proposal_le_time (p : Params) (s : Slot) (t : Time)
   515	    (h : proposalTime p s = t) : s ≤ t.toNat := by
   516	  have hd : 1 ≤ p.Δ := by
   517	    simpa using (Int.add_one_le_iff.mpr p.deltaPos)
   518	  have hs : 0 ≤ (s : ℤ) := Int.natCast_nonneg s
   519	  have hprod := mul_nonneg hs (show 0 ≤ 4 * p.Δ - 1 by nlinarith [hd])
   520	  have ht : (s : ℤ) ≤ t := by
   521	    dsimp [proposalTime] at h
   522	    nlinarith [hprod]
   523	  have htn : 0 ≤ t := le_trans hs ht
   524	  have hcast := Int.toNat_of_nonneg htn
   525	  exact_mod_cast (show (s : ℤ) ≤ (t.toNat : ℤ) by simpa [hcast] using ht)
   526	
   527	private theorem vote_le_time (p : Params) (s : Slot) (t : Time)
   528	    (h : voteTime p s = t) : s ≤ t.toNat := by
   529	  have hd : 1 ≤ p.Δ := by
   530	    simpa using (Int.add_one_le_iff.mpr p.deltaPos)
