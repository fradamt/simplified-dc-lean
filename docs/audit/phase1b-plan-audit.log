   157	  · intro i v o t he
   158	    rw [(runPrefix_event_states hs cut he).1]
   159	    exact hx.deps i v o t ((runPrefix_event_iff hs cut i _).mp he).1
   160	  · intro i v o t he
   161	    rw [(runPrefix_event_states hs cut he).1]
   162	    exact hx.fresh i v o t ((runPrefix_event_iff hs cut i _).mp he).1
   163	  · intro v o t hp u hu holder
   164	    obtain ⟨orig, time⟩ := (runPrefix_processes_iff hs cut v o t).mp hp
   165	    obtain ⟨t', ht', emit⟩ := hx.unforgeable v o t orig u hu holder
