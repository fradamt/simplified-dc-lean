   142	    exact ⟨(hs.in_horizon e ((mem e).mp he).1).1, ((mem e).mp he).2⟩
   143	  · intro e he; exact hs.honest_only e ((mem e).mp he).1
   144	  · intro v t he; exact hs.tick_public v t ((mem _).mp he).1
