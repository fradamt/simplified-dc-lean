    16	/-- A synchronous label supplies actual calls before the requested cutoff. -/
    17	theorem synchronous_receipt_before {V : Type} [DecidableEq V] [Fintype V]
    18	    (p : Params) (E : Env V) (rho : Run V (gridCO p)) (r : Slot)
    19	    (hsync : SynchronousLabel p E rho r)
    20	    (source reader : V) (hs : source ∈ rho.honest) (hr : reader ∈ rho.honest)
    21	    (index : Nat) (o : Wire p.n) (t cut : Time)
    22	    (ha : Run.acceptsAt (gridCO p) rho index source o t)
    23	    (hm : processed (Run.stateBefore (gridCO p) rho (index + 1) reader) o = false)
    24	    (hd : t + E.Δ ≤ cut) (hg : proposalTime p r + E.Δ ≤ cut)
    25	    (hc : cut ≤ gateTime p r) :
    26	    ∃ t', t ≤ t' ∧ t' < cut ∧ ∃ j, Run.handlesAt (gridCO p) rho j reader o t' := by
    27	  rcases hsync.2.2.2 with ⟨hgst, relay⟩ | ⟨endTime, hend, relay⟩
    28	  · have hbound : max t E.t_GST + E.Δ ≤ cut := by
    29	      rw [← max_add_add_right]
    30	      exact max_le hd (by linarith)
    31	    obtain ⟨t', htt, ht', j, hj⟩ := relay.relay source hs index o t ha reader hr hm
    32	      (hbound.trans (hc.trans hsync.2.2.1)) rfl
    33	    exact ⟨t', htt, ht'.trans_le hbound, j, hj⟩
    34	  · obtain ⟨t', htt, ht', j, hj⟩ := relay.relay source hs index o t ha reader hr hm
    35	      (hd.trans (hc.trans hend)) rfl
    36	    exact ⟨t', htt, ht'.trans_le hd, j, hj⟩
