   214	    let axs ← collectAxioms n
   215	    let bad := (axs.filter (!allowedAxioms.contains ·)).qsort Name.lt
   216	    unless bad.isEmpty do
   217	      problems := problems.push s!"BAD AXIOMS {n}: {bad.toList}"
