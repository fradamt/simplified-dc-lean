    29	/-- Persistent inclusion follows from safety and exact-time inclusion with
    30	the same `D` (design §4, derived lemma; user decision 2026-09-28). -/
    31	theorem includedPersist_of_safe (E : Env V) (I : Interface P) (rho : Run V P)
    32	    (g : Output P) (t₀ D : Time) (hsafe : SafeFrom P rho g t₀)
    33	    (hinc : IncludedFrom P E I rho g t₀ D) :
    34	    ∀ s : Slot, t₀ < P.proposalTime s → HonestAwakeProposer E rho s →
    35	      P.proposalTime s + D ≤ rho.horizon → 0 ≤ D →
    36	      ∃ B, HonestProposalAt E I rho s B ∧
    37	        ∀ t, P.proposalTime s + D ≤ t → t ≤ rho.horizon → InBy P rho g B t := by
    38	  intro s hs hp hh hD
    39	  obtain ⟨B, hB, hin⟩ := hinc s hs hp hh
    40	  refine ⟨B, hB, fun t ht htH v hv => ?_⟩
    41	  exact block_preceq_trans _ _ _ (hin v hv)
    42	    (hsafe.monotone v hv _ _ (by linarith) ht htH)
