   387	The walk starts at genesis; proposals and HEADs start at the live root. -/
   388	def confirmation (p : Params) {n : Nat} (st : State n) (r : Slot) : Option Block :=
   389	  let support := cleanSupport p st r
   390	  let late := lateVotes p st r
