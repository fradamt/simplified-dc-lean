import tempfile
from pathlib import Path
p = Path(tempfile.mkdtemp(prefix='phase1b-audit-', dir='/private/tmp')) / 'Audit.lean'
p.write_text('''import AvailableChainLStar.Model.Protocol
import AvailableChainLStar.Statements.Contract
import AvailableChainGridCO.Proofs.Contract
import AvailableChainSA.Proofs.Contract
import AvailableChainSAPC.Proofs.Contract
import AvailableChainSAPC.Proofs.StrongContract
import AvailableChainFramework
import Lean

open AvailableChain AvailableChain.Generic AvailableChain.Statements.Generic
open AvailableChain.Framework AvailableChain.Framework.Catalog

namespace Audit
namespace DuplicateProposal
open AvailableChain.LStar
def p : Params := ⟨1, 5, 0, by decide, by decide, by decide, by decide⟩
def b : Block := .node .genesis 1 ⟨1⟩
def first : Wire 1 := ⟨.proposer 1, .proposal b [] []⟩
def second : Wire 1 := ⟨.proposer 1, .proposal b [⟨.seat 0 0, .genesis⟩] []⟩
def st : State 1 := process p (clock p (initial 1) 4) first
example : wellFormed first = true := by decide
example : wellFormed second = true := by decide
example : depsPresent st second = true := by decide
example : processed st first = true := by decide
example : processed st second = false := by decide
example : handles p st second second := Or.inl rfl
example : process p st second = st := by rfl
example (s : State 1) (hb : b ∈ s.blocks) : process p s second = s := by
  simp [second, process, admitProposal, hb]
end DuplicateProposal

def gridInst (p : GridCO.Params) (h : HooksSound (GridCO.gridCO p)) : Instance :=
  ⟨p.n, GridCO.gridCO p, p.Δ, p.deltaPos, GridCO.gridInterface p, h⟩
def saInst (p : SA.Params) (h : HooksSound (@GridCO.gridCO GridCO.slowLeasePolicy p.engine)) : Instance :=
  ⟨p.n, SA.sa p, p.Δ, p.deltaPos, SA.saInterface p, h⟩
def sapcInst (p : SA.Params) (h : HooksSound (SAPC.sapc p)) : StrongInstance :=
  { n := p.n, P := SAPC.sapc p, Δ := p.Δ, Δ_pos := p.deltaPos,
    iface := (SAPC.sapcInterface p).toInterface, hooks := h,
    strong := (SAPC.sapcInterface p).strong }
def lstarInst (p : LStar.Params) (n : Nat) (h : HooksSound (LStar.lstar p n)) : Instance :=
  ⟨n, LStar.lstar p n, p.Δ, p.deltaPos, LStar.lstarInterface p n, h⟩
example (p : SA.Params) : p.engine.Δ = p.Δ := rfl
example (p : SA.Params) (h : HooksSound (SAPC.sapc p)) :
    (sapcInst p h).sface = SAPC.sapcInterface p := rfl

theorem grid_holds (p : GridCO.Params) (h : HooksSound (GridCO.gridCO p))
    (G : Time) (hG : 0 < G) : ac43.holdsAt (gridInst p h) (GridCO.gridConstants p G) :=
  (ac43_iff _ _).1 fun W E hΔ => (GridCO.gridContract_from_engine p E G hG hΔ).2
example (p : SA.Params) (h : HooksSound (@GridCO.gridCO GridCO.slowLeasePolicy p.engine))
    (G : Time) (hG : 0 < G) : ac43.holdsAt (saInst p h) (SA.saConstants p G) :=
  (ac43_iff _ _).1 fun W E hΔ => (SA.saContract_from_engine p E G hG hΔ).2
example (p : SA.Params) (h : HooksSound (SAPC.sapc p)) (G : Time) (hG : 0 < G) :
    ac43.holdsAt (sapcInst p h).toInstance (SAPC.sapcConstants p G) :=
  (ac43_iff _ _).1 fun W E hΔ => (SAPC.sapcContract_from_engine p E G hG hΔ).2
example (p : SA.Params) (h : HooksSound (SAPC.sapc p)) (G : Time) (hG : 0 < G) :
    strong1.holdsAt (sapcInst p h) (SAPC.sapcConstants p G, SAPC.sapcStrongConstants p) :=
  (strong1_iff _ _ _).1 fun W E hΔ => (SAPC.sapcStrong_from_engine p E G hG hΔ).2

open Lean in
partial def scanHead (e : Expr) (binders : Bool := false) : Option Name × Bool :=
  match e with
  | .forallE _ _ b _ => scanHead b true
  | _ => (e.getAppFn.constName?, binders)
open Lean in
run_elab do
  let ci ← getConstInfo "'``grid_holds
  logInfo m!"registry head and conditional flag: {scanHead ci.type}"

#print axioms grid_holds
end Audit
'"''')
print(p)
