    61	/-- HEAD relay gives membership or equivocation within the admission window. -/
    62	theorem synchronous_accepted_head_before {V : Type} [DecidableEq V] [Fintype V]
    63	    (p : Params) (E : Env V) (rho : Run V (gridCO p)) (hΔ : E.Δ = p.Δ) (r : Slot)
    64	    (hsync : SynchronousLabel p E rho r)
    65	    (source reader : V) (hs : source ∈ rho.honest) (hr : reader ∈ rho.honest)
    66	    (index : Nat) (o : Wire p.n) (B : Block) (t cut read : Time)
    67	    (hb : o.payload = .head B) (hl : headLabel? o = some r)
    68	    (ha : Run.acceptsAt (gridCO p) rho index source o t)
    69	    (hd : t + E.Δ ≤ cut) (hg : proposalTime p r + E.Δ ≤ cut)
    70	    (hc : cut ≤ gateTime p r) (hread : cut ≤ read) :
    71	    ∀ i, headSeat? o = some i →
    72	      o ∈ stampedVotes (Run.stateBeforeTime (gridCO p) rho read reader) r cut ∨
    73	      equivocates (stampedVotes
    74	        (Run.stateBeforeTime (gridCO p) rho read reader) r cut) i = true := by
    75	  intro i hi
    76	  have he : o = ⟨.seat r i, .head B⟩ := by
    77	    cases o with
    78	    | mk auth payload => cases auth <;> cases payload <;> simp_all [headLabel?, headSeat?]
    79	  subst o
    80	  apply accepted_head_receipt_before p E rho hsync.1.toScheduleWellFormed hΔ
    81	    index source reader r i B t cut read ha (by linarith [E.Δ_pos]) hread
    82	    (hc.trans (by dsimp [gateTime, proposalTime]; nlinarith [p.deltaPos]))
    83	  intro hm
    84	  exact synchronous_receipt_before p E rho r hsync source reader hs hr index _ t cut
    85	    ha hm hd hg hc
