   142	    simpa using (List.mem_filter.mp (List.mem_filter.mp haearly).1).2
   143	  have hblabel : headLabel? b = some r := by
   144	    simpa using (List.mem_filter.mp (List.mem_filter.mp hb).1).2
   145	  have hsame : sameSeat b a = true := by

