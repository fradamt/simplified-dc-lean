   259	/-- Exact complete-object relay is derived from receipt relay for SA-PC. -/
   260	theorem receipt_acceptedRelay {V : Type} [DecidableEq V]
   261	    (p : Params) (E : Env V) (rho : Run V (sapc p))
   262	    (hx : ExecutionValid (sapc p) E rho) (hnet : PartialSynchrony (sapc p) E rho) :
