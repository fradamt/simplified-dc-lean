    81	theorem runPrefix_emits_iff (hs : ScheduleWellFormed E rho) (cut : Time)
    82	    (F : Env V) (v : V) (o : P.Object) (t : Time) :
    83	    Run.emits P F (runPrefix rho cut) v o t ↔ Run.emits P F rho v o t ∧ t ≤ cut := by
    84	  constructor
    85	  · rintro ⟨i, he, hm⟩
    86	    obtain ⟨orig, time⟩ := (runPrefix_event_iff hs cut i _).mp he
    87	    have states := (runPrefix_event_states hs cut he).1
    88	    refine ⟨⟨i, orig, ?_⟩, time⟩
    89	    simpa only [Run.emittedAt, states] using hm
    90	  · rintro ⟨⟨i, orig, hm⟩, time⟩
    91	    have he := (runPrefix_event_iff hs cut i _).mpr ⟨orig, time⟩
    92	    refine ⟨i, he, ?_⟩
    93	    simpa only [Run.emittedAt, (runPrefix_event_states hs cut he).1] using hm
