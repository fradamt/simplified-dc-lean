    95	  return (← typeHead? ci).any claimTypes.contains
    96	
    97	/-- Lean generated `n`: an internal name, an auxiliary recursor, a
    98	`noConfusion`, a matcher, a recursor, an equation lemma, or no declaration
    99	range. `isEqnThm?` knows only the equation lemmas of the current file; for an
   100	imported declaration, the missing declaration range finds them. -/
   101	def generated (n : Name) : CoreM Bool := do
   102	  let env ← getEnv
   103	  if n.isInternal || isAuxRecursor env n || isNoConfusion env n ||
   104	      Meta.isMatcherCore env n || (env.find? n matches some (.recInfo _)) then
   105	    return true
   106	  if (← Meta.isEqnThm? n).isSome then return true
