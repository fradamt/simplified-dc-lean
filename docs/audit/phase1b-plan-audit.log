   314	  · have hm : B ∈ (Run.stateBefore (gridCO p) rho (index + 1) reader).blocks := by
   315	      simpa [processed, hp, blockKnown] using hknown
   316	    exact stored_block_stamp_before_cut p E rho hsched hi hm
   317	      (ht.trans (by dsimp [voteTime, earlyTime]; linarith [p.deltaPos])) hearly
