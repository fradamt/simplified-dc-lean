    10	
    11	/-- The part of a v2 spec that E5 and E6 need. -/
    12	structure SpecV2 where
    13	  State : Type
    14	  Base : Type
    15	  Object : Type
    16	  Durable : Type
    17	  DBase : Type
    18	  base : State → Base
    19	  clock : State → Time → State
    20	  process : State → Object → State
    21	  recordOwn : State → Object → State
    22	  selfVisible : Object → Bool
    23	  durable : State → Durable
    24	  restore : Durable → State
    25	  /-- The base-visible part of durable data. -/
    26	  dbase : Durable → DBase
    27	  output : State → Block
    28	
    29	/-- E5 isolation laws. -/
    30	structure Isolated (S : SpecV2) : Prop where
    31	  clock_base : ∃ f : S.Base → Time → S.Base, ∀ st t, S.base (S.clock st t) = f (S.base st) t
    32	  process_base : ∃ g : S.Base → S.Object → S.Base,
    33	    ∀ st o, S.base (S.process st o) = g (S.base st) o
    34	  recordOwn_base : ∀ st o, S.base (S.recordOwn st o) = S.base st
    35	  output_base : ∃ h : S.Base → Block, ∀ st, S.output st = h (S.base st)
    36	
