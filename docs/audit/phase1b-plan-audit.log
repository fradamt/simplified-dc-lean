    85	theorem includedConfirmed_trigger_late {I : Instance} {D : Time} {H : Time}
    86	    (h : includedConfirmed.inhabited I D) :
    87	    ∃ (W : Validators) (x : ClaimDomain.v1.Ctx I W) (s : Slot),
    88	      H ≤ I.P.proposalTime s ∧ HonestAwakeProposer x.E x.rho s := by
    89	  obtain ⟨W, x, t₀, _, _, _, s, _, hH, hp, _⟩ := h H
    90	  exact ⟨W, x, s, hH, hp⟩
    91	
    92	/-- The core floor (design §4): every candidate certifies all four claims.
    93	The shared constant is the inclusion delay `D`. -/
    94	def core : Profile ClaimDomain.v1 where
    95	  id := `core.v1
    96	  Shared := Time
    97	  valid := fun D => 0 ≤ D
    98	  entries :=
    99	    [⟨safeConfirmed, fun _ => ()⟩, ⟨safeStable, fun _ => ()⟩,
   100	     ⟨prefixOrder, fun _ => ()⟩, ⟨includedConfirmed, fun D => D⟩]
   101	
   102	/-- A candidate protocol passes the core floor. -/
   103	def Candidate (I : Instance) : Type 1 := ProfileCert core I
   104	
   105	/-- A refutation family of a core claim rejects the instance. -/
   106	theorem not_candidate_of_family {I : Instance} {e : Profile.Entry ClaimDomain.v1 Time}
   107	    (he : e ∈ core.entries) (r : RefutationFamily e.spec I) : Candidate I → False := by
