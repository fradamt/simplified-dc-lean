     8	/-- The common first-loss induction for finite leases. The tick step may
     9	use protection after any earlier tick in the interval. This permits an
    10	instance to bound release counts from its actual authenticated emissions. -/
    11	theorem state_interval_induction {V : Type} [DecidableEq V] {n : Nat}
    12	    (P : ProtocolSpec n) (rho : Run V P) (Q : V → P.State → Prop)
    13	    (start finish : Nat) (hfinish : start ≤ finish)
    14	    (hbase : ∀ v ∈ rho.honest, Q v (Run.stateBefore P rho start v))
    15	    (hprocess : ∀ v ∈ rho.honest, ∀ st o, Q v st → Q v (P.process st o))
    16	    (hclock : ∀ i v t, start ≤ i → i < finish →
    17	      rho.events[i]? = some (.tick v t) → v ∈ rho.honest →
    18	      Q v (Run.stateBefore P rho i v) →
    19	      (∀ j, start ≤ j → j < i → ∀ u ∈ rho.honest,
    20	        Q u (Run.stateBefore P rho (j + 1) u)) →
    21	      Q v (P.clock (Run.stateBefore P rho i v) t)) :
    22	    ∀ v ∈ rho.honest, Q v (Run.stateBefore P rho finish v) := by
    23	  have all : ∀ i, start ≤ i → i ≤ finish →
    24	      ∀ v ∈ rho.honest, Q v (Run.stateBefore P rho i v) := by
    25	    intro i
    26	    induction i using Nat.strong_induction_on with
    27	    | h i ih =>
    28	      intro hlo hhi v hv
    29	      by_cases eq : i = start
    30	      · subst i; exact hbase v hv
    31	      obtain ⟨j, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : i ≠ 0)
    32	      have prev := ih j (by omega) (by omega) (by omega)
    33	      cases he : rho.events[j]? with
    34	      | none =>
    35	        have eq : Run.stateBefore P rho (j + 1) = Run.stateBefore P rho j := by
    36	          unfold Run.stateBefore
    37	          rw [List.take_add_one, List.foldl_append, he]
    38	          rfl
    39	        rw [eq]; exact prev v hv
    40	      | some e =>
    41	        rw [stateBefore_succ_event he]
    42	        cases e with
    43	        | deliver u o t =>
    44	          by_cases eq : v = u
    45	          · subst v
    46	            simpa only [World.step, Function.update_self] using hprocess u hv _ o (prev u hv)
    47	          · simpa [World.step, eq] using prev v hv
    48	        | tick u t =>
    49	          by_cases eq : v = u
    50	          · subst v
    51	            simp only [World.step, Function.update_self]
    52	            apply hclock j u t (by omega) (by omega) he hv (prev u hv)
    53	            intro k hk hkj w hw
    54	            exact ih (k + 1) (by omega) (by omega) (by omega) w hw
    55	          · simpa [World.step, eq] using prev v hv
    56	  exact all finish hfinish (le_refl _)
    57	
    58	/-- A field unchanged by delivery has its clock value at a public read.
    59	This uses only the common event schedule, so it applies to every instance. -/
    60	theorem read_field_eq_clock {α V : Type} [DecidableEq V] {n : Nat}
    61	    (P : ProtocolSpec n) (f : P.State → α)
    62	    (hf : ∀ st o, f (P.process st o) = f st)
    63	    (E : Env V) (rho : Run V P) (hs : ScheduleWellFormed E rho)
    64	    (reader : V) (t : Time) (htick : Event.tick reader t ∈ rho.events) :
    65	    f (Run.readAt P rho t reader) =
    66	      f (P.clock (Run.stateBeforeTime P rho t reader) t) := by
    67	  obtain ⟨i, hi⟩ := List.mem_iff_getElem?.mp htick
    68	  let k := (rho.events.filter (fun e => decide (e.time ≤ t))).length
    69	  have hik : i < k := (index_lt_read_length_iff hs t hi).mpr (le_refl _)
    70	  have hstep : Run.stateBefore P rho (i + 1) reader =
    71	      P.clock (Run.stateBeforeTime P rho t reader) t := by
    72	    rw [stateBefore_succ_event hi]
    73	    simp only [World.step, Function.update_self]
    74	    exact congrArg (fun st => P.clock st t) (stateBefore_tick_eq_stateBeforeTime hs hi)
    75	  have hstay : ∀ j, i + 1 ≤ j → j ≤ k →
    76	      f (Run.stateBefore P rho j reader) =
    77	        f (Run.stateBefore P rho (i + 1) reader) := by
    78	    intro j
    79	    induction j with
    80	    | zero => intro hj; exact (Nat.not_succ_le_zero i hj).elim
    81	    | succ j ih =>
    82	        intro hj hjk
    83	        rcases eq_or_lt_of_le hj with he | hlt
    84	        · rw [he]
    85	        · rw [← ih (by omega) (by omega)]
    86	          cases he : rho.events[j]? with
    87	          | none => simp [Run.stateBefore, List.take_add_one, he]
    88	          | some e =>
    89	              rw [stateBefore_succ_event he]
    90	              cases e with
    91	              | deliver v o t' =>
    92	                  by_cases hv : reader = v
    93	                  · subst v; simpa [World.step] using hf _ o
    94	                  · simp [World.step, hv]
    95	              | tick v t' =>
    96	                  have hv : reader ≠ v := by
    97	                    intro heq
    98	                    subst v
    99	                    have hu : t' ≤ t := (index_lt_read_length_iff hs t he).mp (by omega)
   100	                    have ht : t' = t := by
   101	                      apply le_antisymm hu
   102	                      by_contra hn
   103	                      have hji := eventIndex_lt_of_time_lt hs he hi (lt_of_not_ge hn)
   104	                      omega
   105	                    obtain ⟨hjl, hje⟩ := List.getElem?_eq_some_iff.mp he
   106	                    obtain ⟨hil, hie⟩ := List.getElem?_eq_some_iff.mp hi
   107	                    have hij : j = i := (List.Nodup.getElem_inj_iff hs.nodup).mp
   108	                      (by rw [hje, hie, ht])
   109	                    omega
   110	                  simp [World.step, hv]
   111	  rw [readAt_eq_stateBefore hs t]
   112	  exact (hstay k (by omega) (le_refl _)).trans (congrArg f hstep)
   113	
   114	end AvailableChain.Engine
   115	end
     1	module
     2	public import AvailableChainGridCO.Proofs.EngineClock
     3	
     4	@[expose] public section
     5	namespace AvailableChain.Engine
     6	open AvailableChain.Generic AvailableChain.Statements.Generic
     7	
     8	/-- From any event boundary, a clock-only field either retains its row
     9	or has a later clock source. The field need not grow monotonically. -/
    10	theorem clock_field_origin_since {V : Type} [DecidableEq V] {n : Nat} {P : ProtocolSpec n}
    11	    {α : Type} (field : P.State → List α)
    12	    (hprocess : ∀ st o, field (P.process st o) = field st)
    13	    (Q : P.State → Time → α → Prop)
    14	    (hclock : ∀ st t row, row ∈ field (P.clock st t) → row ∈ field st ∨ Q st t row)
    15	    (rho : Run V P) (start finish : Nat) (le : start ≤ finish) (v : V) (row : α)
    16	    (member : row ∈ field (Run.stateBefore P rho finish v)) :
    17	    row ∈ field (Run.stateBefore P rho start v) ∨
    18	      ∃ j, start ≤ j ∧ j < finish ∧ ∃ t, rho.events[j]? = some (.tick v t) ∧
    19	        Q (Run.stateBefore P rho j v) t row := by
    20	  induction finish with
    21	  | zero => exact Or.inl (Nat.le_zero.mp le ▸ member)
    22	  | succ finish ih =>
    23	    by_cases eq : start = finish + 1
    24	    · exact Or.inl (eq ▸ member)
    25	    have before : start ≤ finish := by omega
    26	    have old (h : row ∈ field (Run.stateBefore P rho finish v)) :
