     7	type head is in `kinds` is a row of `docs/REGISTRY.md`: `Cert c I`,
     8	`Refutation c I`, `RefutationFamily c I` (with the claim domain `K` of
     9	`c : ClaimSpec K` as the first, implicit argument), `ProfileCert p I` (with
    10	`K` of `p : Profile K` first) and `Candidate I`. A type `∀ …, Cert c I` is
    11	CONDITIONAL and is not a certificate; it is still written as a row, with
    12	status `CONDITIONAL (not a certificate)`.
    13	
    14	A row's status is `LEAN` only if every axiom the declaration transitively
    15	depends on (`Lean.collectAxioms`) is one of `propext`, `Classical.choice`,
    16	`Quot.sound`. Any other axiom (including `sorryAx`) gives status
    17	`UNSOUND(<axiom names>)`; a CONDITIONAL row is not checked, since it is not
    18	a certificate. A row's claim column keeps the claim's name and appends
    19	`NON-CATALOG` if the `ClaimSpec` it certifies is not declared in a module
    20	under `AvailableChainFramework.Catalog`.
    21	
    22	A certificate of a pulled claim `ClaimSpec.pull m c` shows the base claim
    23	`c` with the suffix `(pulled)`. A row of kind `profile-cert` (a `ProfileCert p
    24	I`, or a `Candidate I`, which is `ProfileCert core I`) shows the profile `id`
    25	in the claim column, for example `core.v1`.
    26	
    27	The libraries in `instanceLibraries` are imported, and only their modules
    28	give rows. A row of a module under `AvailableChainRegistry.Gaps` has status
    29	`KNOWN-GAP` in place of `LEAN`; `UNSOUND` and `CONDITIONAL` stay.
    30	
    31	Run: `lake env lean --run scripts/Registry.lean [--check]`. Without an
    32	argument, write `docs/REGISTRY.md`. With `--check`, compare the text with
    33	`docs/REGISTRY.md` and write nothing.
    34	Exit codes: 0 written, or the same; 1 different; 2 a usage error or an
    35	unreadable file. -/
    36	
    37	/-- The libraries that hold certificates and refutations. The script imports
    38	them and scans only their modules. -/
    39	def instanceLibraries : List Name := [`AvailableChainRegistry]
    40	
    41	/-- Rows of these modules are known gaps: a `LEAN` status becomes
    42	`KNOWN-GAP`. -/
    43	def gapsPrefix : Name := `AvailableChainRegistry.Gaps
    44	
    45	/-- The head constant after all leading binders, and whether binders exist. -/
    46	partial def headOf (e : Expr) (binders : Bool := false) : Option Name × Bool :=
    47	  match e with
    48	  | .forallE _ _ b _ => headOf b true
    49	  | _ => (e.getAppFn.constName?, binders)
    50	
    51	def kinds : List (Name × String) :=
    52	  [(``AvailableChain.Framework.Cert, "cert"),
    53	   (``AvailableChain.Framework.Refutation, "refutation"),
    54	   (``AvailableChain.Framework.RefutationFamily, "refutation-family"),
    55	   -- Arguments `K p I`.
    56	   (``AvailableChain.Framework.ProfileCert, "profile-cert"),
    57	   -- Argument `I`. `Candidate I` is a `def`, so its type head is `Candidate`.
    58	   (``AvailableChain.Framework.Catalog.Candidate, "profile-cert")]
    59	
    60	/-- Axioms allowed in a sound LEAN row. -/
    61	def allowedAxioms : List Name :=
    62	  [``propext, ``Classical.choice, ``Quot.sound]
    63	
    64	/-- The axioms `n` transitively depends on. -/
    65	def axiomsOf (env : Environment) (n : Name) : IO (Array Name) :=
    66	  Core.CoreM.toIO' (collectAxioms n) { fileName := "Registry", fileMap := .ofString "" }
    67	    { env := env }
    68	
    69	/-- `n`'s status column: `LEAN`, or `UNSOUND(ax1, ax2, …)` if it depends on
    70	an axiom outside `allowedAxioms`. -/
    71	def statusOf (env : Environment) (n : Name) : IO String := do
    72	  let axs ← axiomsOf env n
    73	  let bad := (axs.filter (fun a => !allowedAxioms.contains a)).qsort Name.lt
    74	  if bad.isEmpty then
    75	    return "LEAN"
    76	  else
    77	    return s!"UNSOUND({String.intercalate ", " (bad.toList.map toString)})"
    78	
    79	/-- Every catalog claim lives in a module under this prefix. -/
    80	def catalogPrefix : Name := `AvailableChainFramework.Catalog
    81	
    82	/-- `n`'s claim column: its name (or `shown`), with `NON-CATALOG` appended if
    83	`n` is not declared in a module under `catalogPrefix`. -/
    84	def claimOf (env : Environment) (n : Name) (shown : Name := n) : String :=
    85	  let s := toString shown
    86	  match env.getModuleIdxFor? n with
    87	  | some idx =>
    88	      if catalogPrefix.isPrefixOf env.header.moduleNames[idx.toNat]! then s
    89	      else s ++ " NON-CATALOG"
    90	  | none => s ++ " NON-CATALOG"
    91	
    92	/-- The base claim of `c` below all `ClaimSpec.pull` layers, and whether `c`
    93	has one. In `@ClaimSpec.pull K K' m c'`, the base claim `c'` is the last
    94	argument. -/
    95	partial def pullBase (c : Expr) : Expr × Bool :=
    96	  if c.isAppOfArity ``AvailableChain.Framework.ClaimSpec.pull 4 then
    97	    ((pullBase c.getAppArgs.back!).1, true)
    98	  else (c, false)
    99	
   100	/-- The claim column of a claim expression `c`. For a pulled claim, the
   101	innermost base claim with the suffix `(pulled)`. -/
   102	def claimColumn (env : Environment) (c : Expr) : String :=
   103	  let (b, pulled) := pullBase c
   104	  (b.getAppFn.constName?.map (claimOf env)).getD "?" ++ (if pulled then " (pulled)" else "")
   105	
   106	/-- The name that a closed `Name` expression in normal form denotes. -/
   107	partial def nameOfExpr? (e : Expr) : Option Name :=
   108	  if e.isConstOf ``Name.anonymous then some .anonymous
   109	  else match e.getAppFn.constName?, e.getAppArgs with
   110	    | some ``Name.str, #[p, .lit (.strVal s)] => (nameOfExpr? p).map (·.str s)
   111	    | some ``Name.num, #[p, .lit (.natVal k)] => (nameOfExpr? p).map (·.num k)
   112	    | _, _ => none
   113	
   114	/-- The claim column of a profile certificate: the `id` of the profile `p`
   115	over the claim domain `K`, by reduction of `Profile.id p`. If the reduction does not
   116	give a name, the name of the constant `p`. `NON-CATALOG` as for a claim. -/
   117	def profileColumn (env : Environment) (K p : Expr) : IO String := do
   118	  let e := mkApp2 (mkConst ``AvailableChain.Framework.Profile.id) K p
   119	  let some n := p.getAppFn.constName? | return "?"
   120	  let pid ← try
   121	      let r ← Core.CoreM.toIO' (Meta.MetaM.run' (Meta.reduce e))
   122	        { fileName := "Registry", fileMap := .ofString "" } { env := env }
   123	      pure (nameOfExpr? r)
   124	    catch _ => pure none
   125	  return claimOf env n (pid.getD n)
   126	
   127	/-- The text of `docs/REGISTRY.md`. -/
   128	def registryText : IO String := do
   129	  let env ← importModules (instanceLibraries.map ({ module := · })).toArray {}
   130	  let mut rows : Array String := #[]
   131	  for (n, ci) in env.constants.toList do
   132	    if n.isInternal then continue
   133	    -- Only declarations of `instanceLibraries` modules are rows.
   134	    let some idx := env.getModuleIdxFor? n | continue
   135	    let m := env.header.moduleNames[idx.toNat]!
   136	    unless instanceLibraries.any (·.isPrefixOf m) do continue
   137	    let (h, conditional) := headOf ci.type
   138	    match h.bind (fun h => kinds.lookup h) with
   139	    | some kind =>
   140	        let args := ci.type.getForallBody.getAppArgs
   141	        -- The claim (or profile) column and the instance argument.
   142	        let (claim, i) ← match h with
   143	          | some ``AvailableChain.Framework.ProfileCert =>
   144	              -- `K p I`: the claim domain, the profile, the instance.
   145	              pure (← profileColumn env args[0]! args[1]!, args[2]!)
   146	          | some ``AvailableChain.Framework.Catalog.Candidate =>
   147	              -- `I`: `Candidate I` is `ProfileCert core I` over `v1`. The two
   148	              -- constants are hard-coded here. A change to `Candidate` or `core`
   149	              -- changes their lines in `docs/catalog.lock`, so `CatalogLock
   150	              -- --check` fails until this path is checked again.
   151	              pure (← profileColumn env (mkConst ``AvailableChain.Framework.ClaimDomain.v1)
   152	                  (mkConst ``AvailableChain.Framework.Catalog.core), args[0]!)
   153	          | _ =>
   154	              -- `K c I`: the claim domain, the claim, the instance.
   155	              pure (claimColumn env args[1]!, args[2]!)
   156	        let inst := (i.getAppFn.constName?.map toString).getD "?"
   157	        let status ← if conditional then pure "CONDITIONAL (not a certificate)" else statusOf env n
   158	        let status := if status == "LEAN" && gapsPrefix.isPrefixOf m then "KNOWN-GAP" else status
   159	        rows := rows.push s!"│ {n} │ {kind} │ {claim} │ {inst} │ {status} │"
   160	    | none => pure ()
   161	  let sorted := rows.qsort (· < ·)
   162	  let libs := String.intercalate ", " (instanceLibraries.map (s!"`{·}`"))
   163	  return "# Registry (generated by scripts/Registry.lean; do not edit)\n\n" ++
   164	    s!"Scanned libraries: {libs}.\n\n```text\n" ++
   165	    "│ Declaration │ Kind │ Claim │ Instance │ Status │\n" ++
   166	    String.intercalate "\n" sorted.toList ++ "\n```\n"
   167	
   168	def registryPath : System.FilePath := "docs/REGISTRY.md"
   169	
   170	def main (args : List String) : IO UInt32 := do
   171	  initSearchPath (← findSysroot)
   172	  match args with
   173	  | [] =>
   174	      IO.FS.writeFile registryPath (← registryText)
   175	      return 0
   176	  | ["--check"] =>
   177	      let text ← registryText
   178	      match ← (IO.FS.readFile registryPath).toBaseIO with
   179	      | .error e => IO.eprintln s!"cannot read {registryPath}: {e}"; return 2
   180	      | .ok old =>
   181	          if old == text then return 0
   182	          IO.eprintln s!"{registryPath} differs: run scripts/Registry.lean to write it"
   183	          return 1
   184	  | _ =>
   185	      IO.eprintln "usage: lake env lean --run scripts/Registry.lean [--check]"
   186	      return 2

