     7	/-! The standard tier (design §4). Each claim restates one field of the v1
     8	bundle `AvailableChain` (`AvailableChainStatements/Generic/Claims.lean`). The
     9	constant of a claim holds exactly the constants that its regime and its
    10	conclusion read; the other fields of `Constants` come from `zeroConstants`.
    11	The `le_trans` and `transport` proofs are named theorems, so that the lock
    12	hashes their statements only. -/
    13	
    14	namespace AvailableChain.Framework.Catalog
    15	
    16	open AvailableChain AvailableChain.Generic AvailableChain.Statements.Generic
    17	
    18	/-- The constant of the Stable Sleepy inclusion claim. -/
    19	structure EtaConst where
    20	  η : Time
    21	  θ : ℚ
    22	  D : Time
    23	
    24	/-- The bounds of `Constants.Valid` on the fields of `EtaConst`. -/
    25	def EtaConst.Valid (k : EtaConst) : Prop :=
    26	  0 ≤ k.η ∧ (1 / 2 : ℚ) ≤ k.θ ∧ k.θ ≤ (3 / 4 : ℚ) ∧ 0 ≤ k.D
    27	
    28	/-- `b` is at least as weak as `a`: η ↑, θ ↑, the delay is fixed. -/
    29	def EtaConst.le (a b : EtaConst) : Bool :=
    30	  decide (a.η ≤ b.η ∧ a.θ ≤ b.θ ∧ a.D = b.D)
    31	
    32	/-- The constant of the two persistence claims. -/
    33	structure OutageConst where
    34	  η : Time
    35	  θ : ℚ
    36	  /-- The arming lag (`armingLag`, or `fastArmingLag` for the fast claim). -/
    37	  lag : Time
    38	  /-- Π, the outage budget. (`Π` is a Lean keyword, so the field is `budget`.) -/
    39	  budget : Time
    40	
    41	/-- The bounds of `Constants.Valid` on the fields of `OutageConst`. -/
    42	def OutageConst.Valid (k : OutageConst) : Prop :=
    43	  0 ≤ k.η ∧ (1 / 2 : ℚ) ≤ k.θ ∧ k.θ ≤ (3 / 4 : ℚ) ∧ 0 ≤ k.lag ∧ 0 ≤ k.budget ∧
    44	    k.budget ≤ k.η
    45	
    46	/-- `b` is at least as weak as `a`: η ↑, θ ↑, lag ↑, budget ↓. -/
    47	def OutageConst.le (a b : OutageConst) : Bool :=
    48	  decide (a.η ≤ b.η ∧ a.θ ≤ b.θ ∧ a.lag ≤ b.lag ∧ b.budget ≤ a.budget)
    49	
    50	/-- The constant of the recovery claim. -/
    51	structure RecoveryConst where
    52	  θrec : ℚ
    53	  full : Bool
    54	  G : Time
    55	  ρ : Time
    56	  D_c : Time
    57	  D_s : Time
    58	
    59	/-- The bounds of `Constants.Valid` on the fields of `RecoveryConst`. -/
    60	def RecoveryConst.Valid (k : RecoveryConst) : Prop :=
    61	  (1 / 2 : ℚ) ≤ k.θrec ∧ k.θrec ≤ (3 / 4 : ℚ) ∧ 0 < k.G ∧ 0 ≤ k.ρ ∧ 0 ≤ k.D_c ∧
    62	    0 ≤ k.D_s
    63	
    64	/-- `b` is at least as weak as `a`: θrec ↑, `full` false → true, G ↓, ρ ↑, the
    65	delays are fixed. -/
    66	def RecoveryConst.le (a b : RecoveryConst) : Bool :=
    67	  decide (a.θrec ≤ b.θrec ∧ (a.full = true → b.full = true) ∧ b.G ≤ a.G ∧ a.ρ ≤ b.ρ ∧
    68	    a.D_c = b.D_c ∧ a.D_s = b.D_s)
    69	
    70	/-! ### `includedStable`: the bundle field `stableIncluded` -/
    71	
    72	theorem includedStable_le_trans (a b c : EtaConst) (hab : a.le b = true)
    73	    (hbc : b.le c = true) : a.le c = true := by
    74	  obtain ⟨h₁, h₂, h₃⟩ := of_decide_eq_true hab
    75	  obtain ⟨h₄, h₅, h₆⟩ := of_decide_eq_true hbc
    76	  exact decide_eq_true ⟨h₁.trans h₄, h₂.trans h₅, h₃.trans h₆⟩
    77	
    78	theorem includedStable_transport (I : Instance) (k k' : EtaConst) (hk : k.Valid)
    79	    (_hk' : k'.Valid) (hle : k.le k' = true)
    80	    (h : ∀ (W : Validators) (x : V1Ctx I W), x.E.Δ = I.Δ → ∀ t₀ : Time,
    81	      StableSleepyRegime I.P x.E I.iface { zeroConstants with η := k.η, θ := k.θ } x.rho
    82	        t₀ →
    83	      IncludedFrom I.P x.E I.iface x.rho I.iface.stable t₀ k.D) :
    84	    ∀ (W : Validators) (x : V1Ctx I W), x.E.Δ = I.Δ → ∀ t₀ : Time,
    85	      StableSleepyRegime I.P x.E I.iface { zeroConstants with η := k'.η, θ := k'.θ } x.rho
    86	        t₀ →
    87	      IncludedFrom I.P x.E I.iface x.rho I.iface.stable t₀ k'.D := by
    88	  obtain ⟨hη, hθ, hD⟩ := of_decide_eq_true hle
    89	  intro W x hx t₀ hr
    90	  rw [← hD]
    91	  exact h W x hx t₀ (stableSleepyRegime_mono hθ hη (le_trans (by norm_num) hk.2.1) hr)
    92	
    93	/-- Exact-time inclusion of honest proposals in `stable`, Stable Sleepy regime. -/
    94	def includedStable : ClaimSpec ClaimDomain.v1 where
    95	  id := `std.included.stable.v1
    96	  Const := EtaConst
    97	  valid := EtaConst.Valid
    98	  le := EtaConst.le
    99	  le_refl := fun _ => decide_eq_true ⟨le_rfl, le_rfl, rfl⟩
   100	  le_trans := includedStable_le_trans

