    11	def sapcInterface (p : Params) : StrongInterface (sapc p) where
    12	  confirmed := confirmed
    13	  stable := stable
    14	  block := block
    15	  opening := fun _ => True
    16	  strong := strong
    17	
    18	/-- Only the two Recovery participation constants differ from SA. -/
    19	def sapcConstants (p : Params) (G : Time) : Constants :=
    20	  { SA.saConstants p G with θrec := 2 / 3, recoveryFull := true }
    21	
    22	def sapcStrongConstants (p : Params) : StrongConstants where
    23	  faultCap := pcFaultCap p
    24	  strongDelay := 6 * p.Δ
    25	
    26	/-- The complete Draft 4.3 bundle. No global cap premise. -/
    27	def SAPCContract {V : Type} [DecidableEq V] [Fintype V]
    28	    (p : Params) (G : Time) (E : Env V) : Prop :=
    29	  E.Δ = p.Δ ∧ AvailableChain (sapc p) E (sapcInterface p).toInterface (sapcConstants p G)
    30	
    31	def SAPCStrong {V : Type} [DecidableEq V] [Fintype V]
    32	    (p : Params) (G : Time) (E : Env V) : Prop :=
    33	  E.Δ = p.Δ ∧ StrongClaims (sapc p) E (sapcInterface p)
    34	    (sapcConstants p G) (sapcStrongConstants p)
    35	
    36	end AvailableChain.SAPC
    37	end
