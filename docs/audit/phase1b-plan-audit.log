   148	/-- Restricting a valid execution preserves authentication, including
   149	carried signatures. Their emitting ticks precede the delivered object. -/
   150	theorem runPrefix_execution (hx : ExecutionValid P E rho) (cut : Time)
   151	    (hc : 0 ≤ cut) (hh : cut ≤ rho.horizon) : ExecutionValid P E (runPrefix rho cut) := by
   152	  have hs := hx.toScheduleWellFormed
