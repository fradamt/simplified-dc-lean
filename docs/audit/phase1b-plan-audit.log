   169	    obtain ⟨t', ht', emit⟩ := hx.carried v o t orig obj carries u hu holder
   170	    exact ⟨t', ht', (runPrefix_emits_iff hs cut E u obj t').mpr ⟨emit, ht'.trans time⟩⟩
