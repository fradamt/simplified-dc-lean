     8	/-- A proof environment with the original awake schedule. Only GST is
     9	set to zero. Use a strict healthy cutoff to retain its count premise. -/
    10	def genesisEnv {V : Type} (E : Env V) : Env V :=
    11	  { E with t_GST := 0, t_GST_nonneg := le_refl 0 }
    12	
    13	/-- A closed prefix strictly before the healthy boundary is Sleepy.
    14	The cutoff may contain a proposal duty: no emission or root scope is
    15	added, since the original awake schedule is retained. -/
    16	theorem healthyInterior_sleepy {V : Type} [DecidableEq V] [Fintype V]
    17	    {n : Nat} {P : ProtocolSpec n} {E : Env V} {rho : Run V P}
    18	    (hx : ExecutionValid P E rho) (I : Interface P) (boundary cut : Time)
    19	    (nonneg : 0 ≤ cut) (before : cut < boundary) (hh : cut ≤ rho.horizon)
    20	    (roots : RootInjective E I rho)
    21	    (healthy : HealthyPrefixDelivery P E rho boundary)
    22	    (majority : ∀ t, 0 ≤ t → t < boundary → AwakeMajority E rho t) :
    23	    SleepyRegime P (genesisEnv E) I (runPrefix rho cut) 0 := by
    24	  have hs := hx.toScheduleWellFormed
    25	  have execution : ExecutionValid P (genesisEnv E) rho :=
    26	    { hx with }
    27	  have deadline (t : Time) (ht : 0 ≤ t) :
    28	      max t (genesisEnv E).t_GST + (genesisEnv E).Δ = t + E.Δ :=
    29	    congrArg (fun x => x + E.Δ) (max_eq_left ht)
    30	  refine ⟨runPrefix_execution execution cut nonneg hh, ?_, ?_, rfl, rfl, ?_⟩
    31	  · have scope (b : Block) (hb : BlockInRun (genesisEnv E) I (runPrefix rho cut) b) :
    32	        BlockInRun E I rho b := by
    33	      rcases hb with hg | ⟨v, o, t, tip, hp | he, block, ancestor⟩
    34	      · exact Or.inl hg
    35	      · exact Or.inr ⟨v, o, t, tip,
    36	          Or.inl ((runPrefix_processes_iff hs cut v o t).mp hp).1, block, ancestor⟩
    37	      · exact Or.inr ⟨v, o, t, tip,
    38	          Or.inr ((runPrefix_emits_iff hs cut (genesisEnv E) v o t).mp he).1,
    39	          block, ancestor⟩
    40	    exact fun b c hb hc => roots b c (scope b hb) (scope c hc)
    41	  · constructor
    42	    · intro v hv o t he w hw bound excl
    43	      obtain ⟨emit, _⟩ := (runPrefix_emits_iff hs cut (genesisEnv E) v o t).mp he
    44	      obtain ⟨i, tick, mem⟩ := emit
    45	      have ht : 0 ≤ t := (hs.in_horizon _ (List.mem_of_getElem? tick)).1
    46	      rw [deadline t ht] at bound excl
    47	      rw [runPrefix_stateBeforeTime hs cut _ bound] at excl
    48	      obtain ⟨t', lo, hi, j, handles⟩ :=
    49	        healthy.broadcast v hv o t ⟨i, tick, mem⟩ w hw (bound.trans before.le) excl
    50	      exact ⟨t', lo, (deadline t ht).symm ▸ hi, j,
    51	        (runPrefix_handlesAt_iff hs cut j w o t').mpr ⟨handles, hi.le.trans bound⟩⟩
    52	    · intro v hv i o t accept w hw fresh bound excl
    53	      obtain ⟨orig, time⟩ := (runPrefix_acceptsAt_iff hs cut i v o t).mp accept
    54	      obtain ⟨obj, delivery, _⟩ := orig.1
    55	      have ht : 0 ≤ t := (hs.in_horizon _ (List.mem_of_getElem? delivery)).1
    56	      rw [deadline t ht] at bound excl
    57	      rw [runPrefix_stateBeforeTime hs cut _ bound] at excl
    58	      have hi := (index_lt_read_length_iff hs cut delivery).mpr time
    59	      rw [runPrefix_stateBefore cut (i + 1) (Nat.succ_le_of_lt hi)] at fresh
    60	      obtain ⟨t', lo, hi', j, handles⟩ :=
    61	        healthy.relay v hv i o t orig w hw fresh (bound.trans before.le) excl
    62	      exact ⟨t', lo, (deadline t ht).symm ▸ hi', j,
    63	        (runPrefix_handlesAt_iff hs cut j w o t').mpr ⟨handles, hi'.le.trans bound⟩⟩
    64	  · intro t ht bound
    65	    exact majority t ht (bound.trans_lt before)
    66	
    67	end AvailableChain.Engine
    68	end
