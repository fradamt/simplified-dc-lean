    38	/-- Exact block transport follows from the checked causal handler bridge. -/
    39	theorem synchronous_accepted_block_before {V : Type} [DecidableEq V] [Fintype V]
    40	    (p : Params) (E : Env V) (rho : Run V (gridCO p)) (hΔ : E.Δ = p.Δ) (r : Slot)
    41	    (hsync : SynchronousLabel p E rho r)
    42	    (source reader : V) (hs : source ∈ rho.honest) (hr : reader ∈ rho.honest)
    43	    (index : Nat) (o : Wire p.n) (t cut : Time)
    44	    {B : Block} {raw support : List (HeadWire p.n)} (hp : o.payload = .proposal B raw support)
    45	    (ha : Run.acceptsAt (gridCO p) rho index source o t)
    46	    (hd : t + E.Δ ≤ cut) (hg : proposalTime p r + E.Δ ≤ cut)
    47	    (hc : cut ≤ gateTime p r) :
    48	    ∃ j e, rho.events[j]? = some e ∧ e.time < cut ∧
    49	      processed (Run.stateBefore (gridCO p) rho (j + 1) reader) o = true := by
    50	  have ht : t < cut := by linarith [E.Δ_pos]
    51	  obtain ⟨parent, hi, _⟩ := ha.1
    52	  by_cases hk : processed (Run.stateBefore (gridCO p) rho (index + 1) reader) o = true
    53	  · exact ⟨index, .deliver source parent t, hi, ht, hk⟩
    54	  obtain ⟨t', htt, ht', j, hh⟩ := synchronous_receipt_before p E rho r hsync
    55	    source reader hs hr index o t cut ha (Bool.eq_false_iff.mpr hk) hd hg hc
    56	  have hm := accepted_proposal_handled_stored p E rho hsync.1 hΔ index j source reader
    57	    o B raw support t t' hp ha hh htt
    58	  obtain ⟨parent', hj, _⟩ := hh
    59	  exact ⟨j, .deliver reader parent' t', hj, ht', by simpa [processed, hp, blockKnown] using hm⟩
