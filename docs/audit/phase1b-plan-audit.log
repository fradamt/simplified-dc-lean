    13	theorem block_preceq_trans (A B C : Block) :
    14	    Block.Preceq A B → Block.Preceq B C → Block.Preceq A C := by
    15	  intro hAB hBC
    16	  induction C with
    17	  | genesis =>
    18	      have hB : B = .genesis := by simpa [Block.Preceq, Block.preceq] using hBC
    19	      subst hB; exact hAB
    20	  | node p s r ih =>
    21	      unfold Block.Preceq Block.preceq at hBC
    22	      rcases Bool.or_eq_true_iff.mp hBC with h | h
    23	      · have : B = .node p s r := of_decide_eq_true h
    24	        subst this; exact hAB
    25	      · have := ih h
    26	        unfold Block.Preceq Block.preceq
    27	        exact Bool.or_eq_true_iff.mpr (Or.inr this)
