    38	  Δ := p.Δ
    39	  n := p.n
    40	  m := p.k
    41	  η := p.η
    42	  grid := (Finset.range (p.n + 1)).erase 0
    43	  θ_R := 1 / 2
    44	  deltaPos := p.deltaPos
    45	  mLarge := p.kLarge
    46	  one_mem := by have := p.nPos; simp; omega
    47	  levels_pos := by intro g hg; exact Nat.pos_of_ne_zero (Finset.mem_erase.mp hg).1
    48	  levels_le := by intro g hg; have := Finset.mem_range.mp (Finset.mem_erase.mp hg).2; omega
    49	  etaNonneg := p.etaNonneg
    50	  thetaLower := le_refl _
    51	  thetaUpper := by norm_num
    52	  gridMatchesTheta := by
    53	    intro a h ha hh hmajority
