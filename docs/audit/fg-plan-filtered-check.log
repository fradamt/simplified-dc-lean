   775	abbrev View (V : Type) := Finset (FGBlock V)
   776	
   777	variable {V : Type} [DecidableEq V] [Fintype V] (E : Electorate V) (cfg : FGConfig)
   778	
   779	def hOf (W : FGBlock V) : Height := (derive E cfg W).h
   780	
   781	/-- `H = max({1} ∪ {h(W) : W ∈ V})`. -/
   782	def frontier (Vw : View V) : Height := Vw.sup (hOf E cfg) ⊔ 1
   783	
   784	/-- Collision freedom on a view: roots identify the blocks of the view and their
   785	ancestors (the collision-free hash idealization; DC `RootInjectiveOnAncestors`).
   786	A hypothesis of every lemma that reads the selected pair; no definition assumes
   787	it. -/
   788	def ViewRootInj (Vw : View V) : Prop :=
   789	  ∀ X Y, (∃ W ∈ Vw, FGBlock.Preceq X W) → (∃ W ∈ Vw, FGBlock.Preceq Y W) →
   790	    X.root = Y.root → X = Y
   791	
   792	/-- The lex key `(h_j, J.root)`. -/
   793	def lexKey (p : Height × FGBlock V) : Lex (ℕ × ℕ) := toLex (p.1, p.2.root.value)
   794	
   795	/-- The frame controls (ALFS: DC's live caches). The root and the band floor
   796	are functions of them (r148 FJ_FRAME table). -/
   797	structure Controls (V : Type) where
   798	  F : FGBlock V
   799	  H : Height
   800	  j : Height
   801	  J : FGBlock V
   802	  contest : Bool
   803	
   804	namespace Controls
   805	/-- The uncontested phase: the root is J. -/
   806	def rootIsJ (c : Controls V) : Bool := decide (c.H = c.j + 1) && !c.contest
   807	def Z (c : Controls V) : FGBlock V := if c.rootIsJ then c.J else c.F
   808	def lo (c : Controls V) : Height := if c.contest then c.H else c.H - 1
   809	end Controls
   810	
   811	structure Frame (V : Type) where
   812	  F : FGBlock V
   813	  H : Height
   814	  j : Height
   815	  J : FGBlock V
   816	  Z : FGBlock V
   817	  lo : Height
   818	  D : Finset (FGBlock V)
   819	  contest : Bool
   820	```
