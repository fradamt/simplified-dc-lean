  2004	- [ ] **Step 2: Write `scripts/check-fg-pins.sh`.**
  2005	
  2006	```bash
  2007	#!/usr/bin/env bash
  2008	# Checks AvailableChainKitFG/Pins.lean against docs/FG-COMPOSITION.md:
  2009	# 1) each Src resolves to its REGISTERED version (tsc/: the archive copy by
  2010	#    hash; spec: the archived file; vc and dc: the registered Git commit), and
  2011	#    that version has the pinned hash;
  2012	# 2) each Src (key, path, hash) is exactly the row of its key in the §0.1
  2013	#    tables (a continuation line counts only when its key column is blank);
  2014	# 3) each pinned id is, literally, the id of an entry heading;
  2015	# 4) each pinned id has exactly one row in the "## Index" table, and its
  2016	#    status there does not start with SUPERSEDED. (The Index row is the one
  2017	#    status per id; an entry can hold several dated Status lines.)
  2018	# It fails (exit 2) on a missing or empty input and on a partial extraction.
  2019	set -euo pipefail
  2020	cd "$(dirname "$0")/.."
  2021	ETH=/Users/francesco/ethereum
  2022	REG=docs/FG-COMPOSITION.md
  2023	PINS=${PINS:-AvailableChainKitFG/Pins.lean}
  2024	resolve() {  # root path pinned-hash -> sha256 of the registered version
  2025	  local root=$1 path=$2 h=$3 f
  2026	  case $root in
  2027	    tsc) f="$ETH/research/async-resilient-committees/tip-stability/codex/archive/${path%.*}-${h:0:8}.${path##*.}"
  2028	         [ -f "$f" ] || return 1; shasum -a 256 "$f" | cut -c1-64 ;;
  2029	    spec) f="$ETH/research/async-resilient-committees/tip-stability/spec/$path"
  2030	          [ -f "$f" ] || return 1; shasum -a 256 "$f" | cut -c1-64 ;;
  2031	    vc@*) git -C "$ETH/lean/decoupled-consensus/verified-consensus" show "${root#vc@}:$path" 2>/dev/null |
  2032	            shasum -a 256 | cut -c1-64 ;;
  2033	    research@*) git -C "$ETH/research" show "${root#research@}:$path" 2>/dev/null |
  2034	            shasum -a 256 | cut -c1-64 ;;
  2035	    *) return 1 ;;
  2036	  esac
  2037	}
  2038	[ -s "$PINS" ] || { echo "MISSING OR EMPTY: $PINS"; exit 2; }
  2039	[ -s "$REG" ] || { echo "MISSING OR EMPTY: $REG"; exit 2; }
  2040	tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
  2041	tr '\n' ' ' < "$PINS" |
  2042	  { grep -o '⟨"[A-Za-z0-9]*", *"[a-z@0-9]*", *"[^"]*", *"[0-9a-f]\{64\}"⟩' || true; } |
  2043	  sed -E 's/⟨"([^"]*)", *"([^"]*)", *"([^"]*)", *"([0-9a-f]{64})"⟩/\1|\2|\3|\4/' > "$tmp/srcs"
  2044	{ grep -o 'id := "[^"]*"' "$PINS" || true; } | sed 's/id := //; s/"//g' > "$tmp/ids"
  2045	nsrc=$(grep -c ': Src :=' "$PINS" || true)
  2046	nid=$(grep -o 'id := "' "$PINS" | wc -l | tr -d ' ')
  2047	[ -s "$tmp/srcs" ] && [ "$(wc -l < "$tmp/srcs" | tr -d ' ')" -eq "$nsrc" ] ||
  2048	  { echo "PARTIAL SOURCE EXTRACTION: $nsrc declared"; exit 2; }
  2049	[ -s "$tmp/ids" ] && [ "$(wc -l < "$tmp/ids" | tr -d ' ')" -eq "$nid" ] ||
  2050	  { echo "PARTIAL ID EXTRACTION: $nid declared"; exit 2; }
  2051	[ -z "$(sort "$tmp/ids" | uniq -d)" ] || { echo "DUPLICATE IDS: $(sort "$tmp/ids" | uniq -d)"; exit 2; }
  2052	status=0
  2053	while IFS='|' read -r key root path pinned; do
  2054	  actual=$(resolve "$root" "$path" "$pinned") ||
  2055	    { echo "MISSING REGISTERED VERSION: $key $root $path"; status=1; continue; }
  2056	  [ "$pinned" = "$actual" ] ||
  2057	    { echo "CHANGED: $key $root/$path pinned $pinned actual $actual"; status=1; }
  2058	  # The exact §0.1 row of this key, plus a continuation line (blank key column).
  2059	  rows=$(awk -v k="$key" '/^### 0\.1 Sources/ { s = 1; next } /^### 0\.2/ { exit }
  2060	    s && index($0, "│ " k " ") == 1 { n++ } END { print n + 0 }' "$REG")
  2061	  [ "$rows" -eq 1 ] || { echo "KEY NOT EXACTLY ONCE IN §0.1: $key ($rows)"; status=1; continue; }
  2062	  row=$(awk -v k="$key" '/^### 0\.1 Sources/ { s = 1; next } !s { next }
  2063	    found { if ($0 ~ /^│ +│/) print; exit }
  2064	    index($0, "│ " k " ") == 1 { print; found = 1 }' "$REG")
  2065	  case $row in *"$(basename "$path")"*) ;; *) echo "PATH NOT IN §0.1 ROW: $key $path"; status=1 ;; esac
  2066	  case $row in *"${pinned:0:32}"*"${pinned:32:32}"*) ;; *) echo "HASH NOT IN §0.1 ROW: $key"; status=1 ;; esac
  2067	done < "$tmp/srcs"
  2068	while read -r id; do
  2069	  awk -v id="$id" 'index($0, "### `" id "` ") == 1 { f = 1 } END { exit !f }' "$REG" ||
  2070	    { echo "NO REGISTRY ENTRY: $id"; status=1; }
  2071	  # The id's row in the Index table (from "## Index" to the next "## ").
  2072	  idx=$(awk -v id="$id" '/^## Index/ { s = 1; next } /^## / { s = 0 }
  2073	    s && index($0, "│ " id " ") == 1' "$REG")
  2074	  n=$(printf '%s' "$idx" | grep -c '^│' || true)
  2075	  [ "$n" -eq 1 ] || { echo "ID NOT EXACTLY ONCE IN INDEX: $id ($n)"; status=1; continue; }
  2076	  st=$(printf '%s\n' "$idx" | awk -F'│' '{ gsub(/^ +| +$/, "", $4); print $4 }')
  2077	  case $st in SUPERSEDED*) echo "SUPERSEDED: $id ($st)"; status=1 ;; esac
  2078	done < "$tmp/ids"
  2079	echo "checked $(wc -l < "$tmp/srcs" | tr -d ' ') sources and $(wc -l < "$tmp/ids" | tr -d ' ') ids"
  2080	exit $status
  2081	```
