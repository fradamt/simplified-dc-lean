786:structure Controls (V : Type) where
793:namespace Controls
795:def rootIsJ (c : Controls V) : Bool := decide (c.H = c.j + 1) && !c.contest
796:def Z (c : Controls V) : FGBlock V := if c.rootIsJ then c.J else c.F
797:def lo (c : Controls V) : Height := if c.contest then c.H else c.H - 1
798:end Controls
