+    (COMPOSE + ".Statements.SafetyStore", KITFG + ".StoreSafetyDef"),
+    (COMPOSE + ".Statements.SafetyClient", SP + ".Quorum"),
+})
 COMPOSE_EDGES = frozenset(
-    [(PROOFS + ".Proofs.Shared.FGCompose", dep) for dep in COMPOSE_MODULES]
