   264	  nj : Bool
   265	  /-- §4 `target_participation` (PROTOCOL.md `def:chain-state`), as its
   266	  quorum set. -/
   267	  target_participation : Finset V
   268	  /-- §4 `progress` (PROTOCOL.md `def:chain-state`), as its quorum set. -/
   269	  progress : Finset V
   270	  /-- §4 `finalize` (PROTOCOL.md `def:chain-state`), as its quorum set. -/
   271	  finalize : Finset V
   272	  /-- §4 `J`: the latest justification on the chain (PROTOCOL.md
   273	  `def:chain-state`). -/
   274	  J : Block V
   275	  /-- §4 `h_j`: the height of that justification (PROTOCOL.md
   276	  `def:chain-state`). -/
   277	  h_j : Height
   278	  /-- §4 `F`: the latest finalization on the chain (PROTOCOL.md
   279	  `def:chain-state`). -/
   280	  F : Block V
   281	  /-- §4 `h_F`: the height of that finalization (PROTOCOL.md
   282	  `def:chain-state`). -/
   283	  h_F : Height
   284	deriving DecidableEq
   285	
   286	namespace ChainState
   287	
   288	variable {V : Type}
   289	
   290	/-- §4 the initial chain state: `L = T_h = J = F = B_gen`, `s = 0`, `h = 1`,
   291	`h_j = h_F = 0`, `nj = false`, every array entry false
   292	(PROTOCOL.md `def:chain-state`).
   293	
   294	This is the default of the total map `Σ.σ[·]`, so
   295	`σ[B_gen]` and `σ[B_gen.parent]` are both this state. `nj` is the document's
   296	literal `false`, not the `nj` formula evaluated at `h = 1`; with `K ≥ 2`
   297	the two agree. -/
   298	def initial : ChainState V :=
   299	  { L := .genesis
   300	    s := 0
   301	    h := 1
   302	    T_h := .genesis
   303	    nj := false
   304	    target_participation := ∅
   305	    progress := ∅
   306	    finalize := ∅
   307	    J := .genesis
   308	    h_j := 0
   309	    F := .genesis
   310	    h_F := 0 }
   311	
   312	/-- §4 `Q_target(σ) = {i: σ.target_participation[i]}` (PROTOCOL.md
   313	`def:chain-state`).
   314	Here the array *is* its quorum set, so the three derived
   315	sets are identities; they exist so that every name the document uses is
   316	spellable in Lean. -/
   317	def Q_target (σ : ChainState V) : Finset V :=
   318	  σ.target_participation
   319	
   320	/-- §4 `Q_prog(σ) = {i: σ.progress[i]}` (PROTOCOL.md `def:chain-state`). -/
   321	def Q_prog (σ : ChainState V) : Finset V :=
   322	  σ.progress
   323	
   324	/-- §4 `Q_finality(σ) = {i: σ.finalize[i]}` (PROTOCOL.md `def:chain-state`).
   325	-/
   326	def Q_finality (σ : ChainState V) : Finset V :=
