    58	
    59	/-- §3 `W = w(V)`: the total fixed validator weight (PROTOCOL.md `sec:sg-schedule`). -/
    60	def totalWeight (E : Electorate V) : Nat :=
    61	  ∑ i, E.weight i
    62	
    63	/-- §3 `w(S)`, counting each validator in a finite set once
    64	(PROTOCOL.md `sec:sg-schedule`). -/
    65	def weightOf (E : Electorate V) (S : Finset V) : Nat :=
    66	  ∑ i ∈ S, E.weight i
    67	
    68	/-- §4 `q = ⌈2W/3⌉` (PROTOCOL.md `sec:state-machine`). Natural-number ceiling
    69	division by three is written `(2W+2)/3`. -/
    70	def finalityThreshold (E : Electorate V) : Nat :=
    71	  (2 * E.totalWeight + 2) / 3
    72	
    73	/-- Executable quorum check. -/
    74	def quorumCheck (E : Electorate V) (S : Finset V) : Bool :=
    75	  decide (E.finalityThreshold ≤ E.weightOf S)
