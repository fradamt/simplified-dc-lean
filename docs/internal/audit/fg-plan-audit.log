    45	namespace DecoupledConsensusModel
    46	
    47	/-- §3 a finite electorate with fixed positive integer weights
    48	(PROTOCOL.md `sec:sg-schedule`). -/
    49	structure Electorate (V : Type) [Fintype V] where
    50	  /-- §3 `w(v)`: a fixed positive integer weight per validator. -/
    51	  weight : V → Nat
    52	  /-- §3 weights are positive (PROTOCOL.md `sec:sg-schedule`). -/
    53	  weight_pos : ∀ i, 0 < weight i
    54	
    55	namespace Electorate
    56	
    57	variable {V : Type} [Fintype V] [DecidableEq V]
    58	
    59	/-- §3 `W = w(V)`: the total fixed validator weight (PROTOCOL.md `sec:sg-schedule`). -/
    60	def totalWeight (E : Electorate V) : Nat :=
    61	  ∑ i, E.weight i
    62	
    63	/-- §3 `w(S)`, counting each validator in a finite set once
    64	(PROTOCOL.md `sec:sg-schedule`). -/
    65	def weightOf (E : Electorate V) (S : Finset V) : Nat :=
    66	  ∑ i ∈ S, E.weight i
    67	
    68	/-- §4 `q = ⌈2W/3⌉` (PROTOCOL.md `sec:state-machine`). Natural-number ceiling
    69	division by three is written `(2W+2)/3`. -/
    70	def finalityThreshold (E : Electorate V) : Nat :=
    71	  (2 * E.totalWeight + 2) / 3
    72	
    73	/-- Executable quorum check. -/
    74	def quorumCheck (E : Electorate V) (S : Finset V) : Bool :=
    75	  decide (E.finalityThreshold ≤ E.weightOf S)
    76	
    77	end Electorate
    78	
    79	/-- §1 the fixed slot committees `K_s ⊆ V` (PROTOCOL.md `sec:substrate`).
    80	
    81	Membership is protocol data. This structure states no nonemptiness, size,
    82	weight, honesty, overlap, sampling, fairness, or cross-slot law, and in
    83	particular attaches **no weight** to committee members: Goldfish counts
    84	cardinalities. -/
    85	structure Committees (V : Type) where
    86	  /-- §1 `K_s`: the committee of slot `s` (PROTOCOL.md `sec:substrate`). -/
    87	  members : Slot → Finset V
    88	
    89	end DecoupledConsensusModel
