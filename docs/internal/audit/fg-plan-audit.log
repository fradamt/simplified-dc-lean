    50	theorem finalized_preceq_of_height_lt
    51	    (S : Setup V) (rho : NamedRun V) (C D : NamedBlock V)
    52	    (hsb : Internal.NamedOutageEntry.SlashableBound S rho)
    53	    (hroot : NamedRootCollisionFree S rho)
    54	    (hC : NamedRun.blockInRun S rho C) (hD : NamedRun.blockInRun S rho D)
    55	    (hlt : (derive_named S.E S.cfg D).h_F < (derive_named S.E S.cfg C).h) :
    56	    Block.Preceq (derive_named S.E S.cfg D).F C.erase := by
    57	  by_cases hz : (derive_named S.E S.cfg D).h_F = 0
    58	  · rw [NamedFinalityCertificates.finalized_zero_is_genesis S.E S.cfg D hz]
    59	    exact Protocol.preceq_genesis C.erase
    60	  · obtain ⟨F, hFD, hFE, Qf, hQf, hwf⟩ :=
    61	      NamedFinalityCertificates.finality_certificate S.E S.cfg D hz
    62	    obtain ⟨X, hXC, _hXheight, Qc, hQc, hwc⟩ :=
    63	      NamedFinalityCertificates.height_crossing S.E S.cfg C
    64	        (derive_named S.E S.cfg D).h_F (Nat.one_le_iff_ne_zero.mpr hz) hlt
    65	    by_cases hroots : X.root = F.root
    66	    · have hXF : X = F :=
    67	        hroot.root_injective C D hC hD X F (Or.inl hXC) (Or.inr hFD) hroots
    68	      rw [← hFE, ← hXF]
    69	      exact Proofs.NamedWire.erase_preceq hXC
    70	    · exfalso
    71	      apply hsb C D hC hD
    72	      refine ⟨Qc ∩ Qf, quorum_intersection S.E hQc hQf, ?_⟩
    73	      intro signer hsigner
    74	      obtain ⟨hc, hf⟩ := Finset.mem_inter.mp hsigner
    75	      obtain ⟨carrierA, a, hcarrierA, ha, hav, hamatch⟩ := hwc signer hc
    76	      obtain ⟨carrierB, b, hcarrierB, hb, hbv, hbfinal⟩ := hwf signer hf
    77	      refine ⟨a.erase, on_chain_erase_mem hcarrierA ha,
    78	        b.erase, on_chain_erase_mem hcarrierB hb, ?_, ?_, ?_⟩
    79	      · exact hav
    80	      · exact hbv
    81	      · exact matching_finality_e1 a b (derive_named S.E S.cfg D).h_F X.root F.root
    82	          (hav.trans hbv.symm) hamatch hbfinal hroots
