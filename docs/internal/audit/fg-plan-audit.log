   269	def preceq (A : FGBlock V) : FGBlock V → Bool
   270	  | .genesis => decide (A = .genesis)
   271	  | B@(.node p _ _ _) => decide (A = B) || preceq A p
   272	def Preceq (A B : FGBlock V) : Prop := preceq A B = true
   273	instance (A B : FGBlock V) : Decidable (Preceq A B) :=
   274	  inferInstanceAs (Decidable (preceq A B = true))
   275	def compatible (A B : FGBlock V) : Bool := preceq A B || preceq B A
   276	end FGBlock
