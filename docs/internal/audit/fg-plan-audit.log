   590	candidate membership and viability witnesses to that set; `Σ.σ`, `Σ.F`,
   591	`Σ.h_max`, and `get_fg_root(Σ)` keep their ordinary full-store values. -/
   592	def get_filtered_block_tree_from (st : FGStore V) (blocks : Finset (Block V)) :
   593	    Finset (Block V) :=
   594	  let root := get_fg_root st
   595	  (viable_tree st.σ st.F st.h_max blocks).filter (fun B =>
