   279	def chainRows {V : Type} [DecidableEq V] : FGBlock V → Finset (Row V)
   280	  | .genesis => ∅
   281	  | .node p _ _ rs => rs.toFinset ∪ chainRows p
   282	
   283	/-- Fixed positive weights (port: DC/DecoupledConsensusModel/Objects/Weights.lean:49–78). FG-SA uses weight 1. -/
   284	structure Electorate (V : Type) [Fintype V] where
   285	  weight : V → Nat
   286	  weight_pos : ∀ i, 0 < weight i
   287	
   288	namespace Electorate
   289	variable {V : Type} [Fintype V] [DecidableEq V]
   290	def totalWeight (E : Electorate V) : Nat := ∑ i, E.weight i
   291	def weightOf (E : Electorate V) (S : Finset V) : Nat := ∑ i ∈ S, E.weight i
   292	/-- `q = ⌈2W/3⌉`; with unit weights this is FG-SA's `q_F = (2n+2) div 3`. -/
   293	def q (E : Electorate V) : Nat := (2 * E.totalWeight + 2) / 3
   294	def IsQuorum (E : Electorate V) (S : Finset V) : Prop := E.q ≤ E.weightOf S
   295	end Electorate
