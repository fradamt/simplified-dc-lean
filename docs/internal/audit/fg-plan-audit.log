    54	/-- §5.3 `height_pair` emits one of exactly three things, and the two nonempty
    55	ones both read the caller's own height fields (PROTOCOL.md#the-complete-protocol).
    56	
    57	**This is Lemma G1's whole content.** All seven rows of the figure's table
    58	produce `(⊥,⊥)`, `(h_c, ⊥)` or `(h_c, T_c)`; no row invents a height and no row
    59	invents a target. Everything else about G1 is bookkeeping about where the caller
    60	got `(h_c, T_c)` from, and that is what the two duties below settle.
    61	
    62	The fields arrive as one `Option`, so the `none` row — §6's "no fresh quorum, no
    63	height pair" (PROTOCOL.md#the-complete-protocol) — is the first disjunct. -/
    64	theorem height_pair_cases (fields : Option (Height × BlockId × Bool))
    65	    (fp : Option FinalityPair) :
    66	    Protocol.height_pair Λ fields fp = .empty ∨
    67	      ∃ (h : Height) (T : BlockId) (ν : Bool), fields = some (h, T, ν) ∧
    68	        (Protocol.height_pair Λ fields fp = .timeout h ∨
    69	          Protocol.height_pair Λ fields fp = .target h T) := by
    70	  cases fields with
    71	  | none => exact Or.inl rfl
    72	  | some f =>
    73	    obtain ⟨h, T, ν⟩ := f
    74	    have key : Protocol.height_pair Λ (some (h, T, ν)) fp = .empty ∨
    75	        Protocol.height_pair Λ (some (h, T, ν)) fp = .timeout h ∨
    76	        Protocol.height_pair Λ (some (h, T, ν)) fp = .target h T := by
    77	      dsimp only [Protocol.height_pair]
    78	      repeat' split
    79	      all_goals
    80	        first
    81	          | exact Or.inl rfl
    82	          | exact Or.inr (Or.inl rfl)
    83	          | exact Or.inr (Or.inr rfl)
    84	    rcases key with h0 | h0
    85	    · exact Or.inl h0
    86	    · exact Or.inr ⟨h, T, ν, rfl, h0⟩
