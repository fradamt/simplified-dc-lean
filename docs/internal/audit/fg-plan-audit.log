   343	/-- §4 `w(Q_finality(σ)) ≥ q` (PROTOCOL.md `alg:state-transition`). -/
   344	def finalityQuorum (E : Env V) (σ : ChainState V) : Bool :=
   345	  E.electorate.quorumCheck σ.Q_finality
