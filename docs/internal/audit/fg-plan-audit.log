    41	namespace DecoupledConsensusModel
    42	
    43	open Protocol
    44	
    45	variable {V : Type} [DecidableEq V] [Fintype V]
    46	
    47	/-- The attestations carried by `B`'s chain: `⋃_{C ⪯ B} C.attestations`
    48	(`sec:complete-store`, with the finality evidence relation in
    49	`sec:state-machine`).
    50	
    51	Every attestation any transition on this chain folds is a member, and no other
    52	attestation can move `derived_state E cfg B`, so this is the evidence set the
    53	accountability relation quantifies over. Duplicates across blocks collapse:
    54	the fold is idempotent. -/
    55	def chain_attestations : Block V → Finset (CombinedAttestation V)
    56	  | .genesis => ∅
    57	  | .node p _ _ _ _ ats _ => ats.toFinset ∪ chain_attestations p
    58	
    59	/-- The evidence a store holds: the carried attestations of every processed
    60	block (`sec:complete-store`).
    61	
    62	`Σ.T` is never pruned, and `Σ.F` moves only through
    63	`update_finality`, which is called only from `on_block` with `σ = Σ.σ[B]`
    64	for a `B` this set covers. Block-carried attestations enter the SG pool through
    65	the row-admission fold; this set remains the chain-attestation evidence used by
    66	the accountability relation. -/
    67	def store_attestations (st : Protocol.Store V) : Finset (CombinedAttestation V) :=
    68	  st.T.biUnion chain_attestations
    69	
    70	/-- A validator `i` is slashable **between** two evidence sets: one occurrence
    71	from each, both `i`'s, satisfying E1 or E2 (`sec:state-machine`).
    72	
    73	`a` and `b` are chosen independently, so `A₁ = A₂` and `a = b` are both
    74	permitted — "the conflicting occurrences can be in one attestation", which at
    75	`a = b` is `Protocol.selfSlashable a`.
    76	`b.val_index = i` is stated explicitly so both occurrences expose the
    77	validator identity at the binding site, although `Slashable` already carries
    78	the `sameValidator` conjunct.
    79	
    80	This is the accountability **conclusion** form: it names the histories exposing
    81	the evidence. -/
    82	def SlashableBetween (A₁ A₂ : Finset (CombinedAttestation V)) (i : V) : Prop :=
    83	  ∃ a ∈ A₁, ∃ b ∈ A₂, a.val_index = i ∧ b.val_index = i ∧ Protocol.Slashable a b
    84	
    85	/-- The weight floor `w(S) ≥ 2q − W` for an intersection of two quorums
    86	(`sec:state-machine`).
    87	
    88	Written additively as `2q ≤ W + w(S)` so that no natural-number subtraction
    89	appears in the headline: `Height`, `Slot` and every weight are `Nat`, and `2q −
    90	W` would truncate silently if `q` were ever re-defined below `W/2`. -/
    91	def HasIntersectionWeight (E : Env V) (S : Finset V) : Prop :=
    92	  2 * E.q ≤ E.W + E.electorate.weightOf S
    93	
    94	/-- Slashable weight `2q − W` **between** two evidence sets. This is the
    95	accountability conclusion form in `sec:state-machine`. -/
    96	def HasSlashableWeightBetween (E : Env V)
    97	    (A₁ A₂ : Finset (CombinedAttestation V)) : Prop :=
    98	  ∃ S : Finset V, HasIntersectionWeight E S ∧ ∀ i ∈ S, SlashableBetween A₁ A₂ i
    99	
   100	end DecoupledConsensusModel
   101	
   102	end

