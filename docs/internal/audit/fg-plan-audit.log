   354	-- ── from FinalityGadget/Transition.lean ──
   355	section
   356	/-!
   357	# §4 The deterministic state transition (PROTOCOL.md `alg:state-transition`)
   358	
   359	`alg:state-transition`, line for line. The section is pure: there is no store
   360	here. `σ[B] = state_transition(σ[B.parent], B)` is a deterministic function of
   361	the chain ending at `B` (PROTOCOL.md `sec:state-machine`), so these
   362	functions take a chain
   363	state, a block, and the fixed parameters — nothing else. §5 owns the store map
   364	`Σ.σ[·]` and calls `state_transition` from `on_block`.
   365	
   366	The transition runs per block; an empty slot triggers no height event. `T_h`
   367	is always a block set by `advance_height`. Progress requires the exact pair
   368	`(h, T_h)` or `(h, ⊥)`. `process_height_events` updates `(J, h_j)` and clears
   369	the finality set. The transition has no failure result.
   370	
   371	The document gives `B.attestations` no validity conditions at all — no round
   372	constraint, no duplicate rule, no length bound — and this fold applies
   373	every element as written.
   374	-/
   375	
   376	namespace DecoupledConsensusModel
   377	
   378	namespace Protocol
   379	
   380	/-- §4 the nonjustifiability rule `nj ← (K | h) ∧ (h − h_F > D)`
   381	(PROTOCOL.md `sec:state-machine`, `alg:state-transition`). Both the prose and
   382	`advance_height` state it,
   383	and both read the *already-updated* `h_F`, so a finalization applied by the same
   384	transition is visible here.
   385	
   386	`Height` is `Nat`, so `h − h_F` truncates at zero; with `D ≥ 1` a state with
   387	`h < h_F` gives `false` either way. -/
   388	def nonjustifiable (cfg : HeightConfig) (h h_F : Height) : Bool :=
   389	  decide (cfg.K ∣ h) && decide (cfg.D < h - h_F)
   390	
   391	section Attestations
   392	
   393	variable {V : Type} [DecidableEq V]
   394	
   395	/-- §4 `process_attestation(σ, a)` (PROTOCOL.md `alg:state-transition`).
   396	
   397	The two tests are independent guarded `if`s: one call can set the finality bit
   398	*and* a height bit. The height branch is an `if`/`elif`, so a target vote sets
   399	both height bits and a timeout vote sets only `progress`; any other pair — a
   400	different height, or the empty pair — sets neither.
   401	
   402	Equality of pairs is equality of roots: a
   403	carried `target` is a `BlockId`, and `σ.T_h`, `σ.J` are blocks, so the tests
   404	compare `σ.T_h.root` and `σ.J.root`. Nothing here requires the target block
   405	itself to be in the store; the document states a dependency only for the
   406	attestation's head (PROTOCOL.md `sec:fg-fork-choice`, "the head's finality
   407	fields").
   408	
   409	The function reads `σ.h, σ.T_h, σ.h_j, σ.J, σ.h_F` and writes none of them, so
   410	the fold in `state_transition` is order-independent and idempotent.
   411	
   412	The finality guard omits `σ.F ⪯ σ.J`
   413	(PROTOCOL.md `alg:state-transition`). It is redundant: in a chain state `J`
   414	is only ever assigned `σ.T_h` and `F` only ever assigned `σ.J`, so the two are
   415	ordered by ancestry at every reachable state and the guard's remaining
   416	`h_F < h_j` carries the rest. The redundancy is **not** taken on trust — it is
   417	`Protocol.ChainOrder.finalized_preceq_justified`, which
   418	`chainOrder_derived_state` establishes for every derived state, and
   419	`Protocol.process_attestation_eq_guarded` proves the prior guard and this one
   420	agree there. Store-level thinking is what put it here; §5's own `Σ.F ⪯ σ.J`
   421	guard in `update_finality` is a different claim about a different object and
   422	stays. -/
   423	def process_attestation (σ : ChainState V) (a : CombinedAttestation V) :
   424	    ChainState V :=
   425	  let i := a.val_index
   426	  let afterFinality :=
   427	    if decide (σ.h_F < σ.h_j) &&
   428	        decide (a.finality_pair = some ⟨σ.h_j, σ.J.root⟩) then
   429	      { σ with finalize := insert i σ.finalize }
   430	    else σ
   431	  if a.height_pair = .target σ.h σ.T_h.root then
   432	    { afterFinality with
   433	      target_participation := insert i afterFinality.target_participation
   434	      progress := insert i afterFinality.progress }
   435	  else if a.height_pair = .timeout σ.h then
   436	    { afterFinality with progress := insert i afterFinality.progress }
   437	  else afterFinality
   438	
   439	end Attestations
   440	
   441	section Transition
   442	
   443	variable {V : Type} [DecidableEq V] [Fintype V]
   444	
   445	/-- §4 the finality guard of `process_height_events`
   446	(PROTOCOL.md `alg:state-transition`): `h_j > h_F`, and `Q_finality` is a
   447	quorum. The first
   448	clause is the guard of `process_attestation`'s finality branch as well
   449	(PROTOCOL.md `alg:state-transition`); the document states it as a runtime
   450	guard, not as an invariant of the chain state.
   451	
   452	The guard omits `F ⪯ J` (PROTOCOL.md `alg:state-transition`) because `process_attestation` records: it is implied at every reachable chain
   453	state by the ancestry the assignments already force, and the tripwire
   454	`Protocol.finalityReady_eq_guarded` proves the prior guard and this one agree
   455	under `ChainOrder`. §5's store-side `Σ.F ⪯ σ.J` in `update_finality` is
   456	untouched and remains load-bearing — it compares a *store* field with an
   457	incoming block's chain state, which is a genuinely different test. -/
   458	def finalityReady (E : Env V) (σ : ChainState V) : Bool :=
   459	  decide (σ.h_F < σ.h_j) && σ.finalityQuorum E
   460	
   461	/-- §4 the justification guard (PROTOCOL.md `alg:state-transition`): `¬nj`,
   462	and `Q_target` is a quorum. There is no "`T_h` is set" clause — `T_h` is
   463	always a block. -/
   464	def targetReady (E : Env V) (σ : ChainState V) : Bool :=
   465	  !σ.nj && σ.targetQuorum E
   466	
   467	/-- §4 the progress guard (PROTOCOL.md `sec:state-machine`, "an exact target
   468	quorum is consumed immediately"). An exact target quorum is
   469	consumed immediately. A progress quorum that can contain timeout rows is
   470	consumed only at or after `T_h.slot + timeoutDelay`. Timeout rows remain in
   471	`progress` while this gate is closed. -/
   472	def progReady (E : Env V) (cfg : HeightConfig) (σ : ChainState V) : Bool :=
   473	  σ.targetQuorum E ||
   474	    (decide (σ.T_h.slot + cfg.timeoutDelay ≤ σ.s) && σ.progQuorum E)
   475	
   476	/-- §4 `advance_height(σ)` (PROTOCOL.md `alg:state-transition`). It
   477	increments the height,
   478	carries the latest block into `T_h`, recomputes the `nj` flag from the new
   479	height and the already-updated `h_F`, and clears the target and progress sets.
   480	
   481	`σ.finalize` is deliberately **not** cleared here: only the justification branch
   482	clears it (PROTOCOL.md `alg:state-transition`), so a finality bit set at
   483	height `h` can still
   484	trigger finalization several progress advances later, as long as `(J, h_j)` has
   485	not moved.
   486	
   487	The document's `advance_height` takes only `σ`; the justification write lives in
   488	the caller, so there is no `justify` argument. -/
   489	def advance_height (cfg : HeightConfig) (σ : ChainState V) : ChainState V :=
   490	  let next := σ.h + 1
   491	  { σ with
   492	    h := next
   493	    T_h := σ.L
   494	    nj := nonjustifiable cfg next σ.h_F
   495	    target_participation := ∅
   496	    progress := ∅ }
   497	
   498	/-- §4 `process_height_events(σ)` (PROTOCOL.md `alg:state-transition`).
   499	
   500	Three branches in the document's order. The finality branch falls through — it
   501	mutates `(F, h_F)` and the two height branches then read the mutated state, so a
   502	finalization applied here is what `advance_height`'s `nj` latch sees. The
   503	justification branch has priority over progress: whenever both height thresholds
   504	hold, target wins.
   505	
   506	The justification write `(J, h_j) ← (T_h, h)` uses the height being *left*, so
   507	the new height is `h_j + 1`; §5's `get_fg_root` depends on it. -/
   508	def process_height_events (E : Env V) (cfg : HeightConfig) (σ : ChainState V) :
   509	    ChainState V :=
   510	  let afterFinality :=
   511	    if finalityReady E σ then { σ with F := σ.J, h_F := σ.h_j } else σ
   512	  if targetReady E afterFinality then
   513	    advance_height cfg
   514	      { afterFinality with
   515	        J := afterFinality.T_h
   516	        h_j := afterFinality.h
   517	        finalize := ∅ }
   518	  else if progReady E cfg afterFinality then
   519	    advance_height cfg afterFinality
   520	  else afterFinality
   521	
   522	end Transition
   523	
   524	end Protocol
   525	
   526	end DecoupledConsensusModel
   527	end
   528	
   529	-- ── from FinalityGadget/TimeoutBinding.lean ──
   530	section
     1	module
     2	public import DecoupledConsensusProofs.Execution.ModelVocabulary
     3	public import DecoupledConsensusProofs.Protocol.ChainState.MatchingProgress
     4	public import DecoupledConsensusProofs.Protocol.ChainState.EntryHeight
     5	
     6	@[expose] public section
     7	
     8	namespace DecoupledConsensusModel.Proofs.NamedFinalityCertificates
     9	open Protocol
    10	variable {V : Type} [DecidableEq V] [Fintype V]
    11	
    12	omit [Fintype V] in
    13	private theorem named_self (B : NamedBlock V) : NamedBlock.Preceq B B := by
    14	  cases B <;> simp [NamedBlock.Preceq, NamedBlock.preceq]
    15	
    16	omit [Fintype V] in
    17	private theorem named_extend {A parent : NamedBlock V} (s : Slot) (root : BlockId)
    18	    (votes support : List (GoldfishVote V)) (rows : List (NamedAttestation V)) (proposer : V)
    19	    (h : NamedBlock.Preceq A parent) :
    20	    NamedBlock.Preceq A (.node parent s root votes support rows proposer) := by
    21	  simp only [NamedBlock.Preceq, NamedBlock.preceq, Bool.or_eq_true]
    22	  exact Or.inr h
    23	
    24	-- Existence inside this full recursive chain, not injectivity of erase.
    25	omit [Fintype V] in
    26	private theorem erased_ancestor_lift (B : NamedBlock V) {raw : Block V}
    27	    (h : Block.Preceq raw B.erase) :
    28	    ∃ A : NamedBlock V, NamedBlock.Preceq A B ∧ A.erase = raw := by
    29	  induction B with
    30	  | genesis =>
    31	    have hr : raw = Block.genesis := by
    32	      simpa only [Block.Preceq, Block.preceq, NamedBlock.erase, decide_eq_true_eq] using h
    33	    subst raw
    34	    exact ⟨.genesis, named_self _, rfl⟩
    35	  | node parent s root votes support rows proposer ih =>
    36	    let B := NamedBlock.node parent s root votes support rows proposer
    37	    have hcases : raw = B.erase ∨ Block.Preceq raw parent.erase := by
    38	      simpa only [B, NamedBlock.erase, Block.Preceq, Block.preceq,
    39	        Bool.or_eq_true, decide_eq_true_eq] using h
    40	    rcases hcases with heq | hp
    41	    · exact ⟨B, named_self B, heq.symm⟩
    42	    · obtain ⟨A, hA, hErase⟩ := ih hp
    43	      exact ⟨A, named_extend s root votes support rows proposer hA, hErase⟩
    44	
    45	omit [Fintype V] in
    46	private theorem chain_parent_subset (parent : NamedBlock V) (slot : Slot) (root : BlockId)
    47	    (votes support : List (GoldfishVote V)) (rows : List (NamedAttestation V)) (proposer : V)
    48	    (a : NamedAttestation V) (ha : NamedMatchingProgress.OnNamedChain parent a) :
    49	    NamedMatchingProgress.OnNamedChain
    50	      (.node parent slot root votes support rows proposer) a := by
    51	  obtain ⟨carrier, hc, hrow⟩ := ha
    52	  exact ⟨carrier, named_extend slot root votes support rows proposer hc, hrow⟩
    53	
    54	omit [Fintype V] in
    55	private theorem own_rows (B : NamedBlock V) (a : NamedAttestation V)
    56	    (ha : a ∈ B.attestations) : NamedMatchingProgress.OnNamedChain B a :=
    57	  ⟨B, named_self B, ha⟩
    58	
    59	-- The pair is the current J/h_j, not the current entry T_h/h.
    60	private def FinalizeRows (pool : NamedAttestation V → Prop) (st : ChainState V) : Prop :=
    61	  ∀ signer ∈ st.finalize, ∃ a : NamedAttestation V, pool a ∧
    62	    a.val_index = signer ∧ a.finality_pair = some ⟨st.h_j, st.J.root⟩
    63	
    64	omit [DecidableEq V] [Fintype V] in
    65	private theorem rows_empty (pool : NamedAttestation V → Prop) (st : ChainState V)
    66	    (hEmpty : st.finalize = ∅) : FinalizeRows pool st := by
    67	  intro signer hs
    68	  rw [hEmpty] at hs
    69	  simp at hs
    70	
    71	omit [DecidableEq V] [Fintype V] in
    72	private theorem rows_mono (pool next : NamedAttestation V → Prop) (st : ChainState V)
    73	    (h : FinalizeRows pool st) (hsub : ∀ a, pool a → next a) : FinalizeRows next st := by
    74	  intro signer hs
    75	  obtain ⟨a, ha, hv, hp⟩ := h signer hs
    76	  exact ⟨a, hsub a ha, hv, hp⟩
    77	
    78	omit [DecidableEq V] [Fintype V] in
    79	private theorem rows_congr (pool : NamedAttestation V → Prop) (st next : ChainState V)
    80	    (h : FinalizeRows pool st) (hJ : next.J = st.J) (hhj : next.h_j = st.h_j)
    81	    (hFinalize : next.finalize = st.finalize) : FinalizeRows pool next := by
    82	  intro signer hs
    83	  rw [hFinalize] at hs
    84	  rw [hhj, hJ]
    85	  exact h signer hs
    86	
    87	omit [Fintype V] in
    88	private theorem rows_process (pool : NamedAttestation V → Prop)
    89	    (st : ChainState V) (a : NamedAttestation V) (ha : pool a) (h : FinalizeRows pool st) :
    90	    FinalizeRows pool (process_attestation_with (TimeoutBinding.targeted V) st a) := by
    91	  intro signer hs
    92	  have fields := TimeoutBindingDefaults.process_context_fields (TimeoutBinding.targeted V) st a
    93	  rw [fields.2.2.2.2.1, fields.2.2.2.1]
    94	  rw [TargetedTimeoutBinding.process_finality_eq] at hs
    95	  rcases Protocol.mem_finalize_process_attestation hs with hold | ⟨hSigner, hPair⟩
    96	  · exact h signer hold
    97	  · exact ⟨a, ha, by simpa only [NamedAttestation.erase] using hSigner.symm,
    98	      by simpa only [NamedAttestation.erase] using hPair⟩
    99	
   100	omit [Fintype V] in
   101	private theorem rows_fold (pool : NamedAttestation V → Prop)
   102	    (rows : List (NamedAttestation V)) (st : ChainState V)
   103	    (hrows : ∀ a ∈ rows, pool a) (h : FinalizeRows pool st) :
   104	    FinalizeRows pool
   105	      (rows.foldl (process_attestation_with (TimeoutBinding.targeted V)) st) := by
   106	  induction rows generalizing st with
   107	  | nil => exact h
   108	  | cons a rows ih =>
   109	    exact ih _ (fun b hb => hrows b (List.mem_cons_of_mem a hb))
   110	      (rows_process pool st a (hrows a (List.mem_cons_self ..)) h)
   111	
   112	omit [Fintype V] in
   113	private theorem rows_fold_block (pool : NamedAttestation V → Prop)
   114	    (st : ChainState V) (B : NamedBlock V)
   115	    (hrows : ∀ a ∈ B.attestations, pool a) (h : FinalizeRows pool st) :
   116	    FinalizeRows pool
   117	      (fold_rows (TimeoutBinding.targeted V) st B.erase B.attestations) := by
   118	  have hf := rows_fold pool B.attestations { st with s := B.erase.slot } hrows
   119	    (rows_congr pool st _ h rfl rfl rfl)
   120	  exact rows_congr pool _ _ hf rfl rfl rfl
   121	
   122	private theorem rows_height_events (E : Env V) (cfg : HeightConfig)
   123	    (pool : NamedAttestation V → Prop) (st : ChainState V) (h : FinalizeRows pool st) :
   124	    FinalizeRows pool (process_height_events E cfg st) := by
   125	  have hAfter := rows_congr pool st (Protocol.afterFin E st) h
   126	    (Protocol.afterFin_J E) (Protocol.afterFin_h_j E) (Protocol.afterFin_finalize E)
   127	  rw [Protocol.process_height_events_eq]
   128	  split_ifs
   129	  · exact rows_empty pool _ rfl
   130	  · exact rows_congr pool _ _ hAfter rfl rfl rfl
   131	  · exact hAfter
   132	
   133	private theorem derive_finalize_rows (E : Env V) (cfg : HeightConfig) (B : NamedBlock V) :
   134	    FinalizeRows (NamedMatchingProgress.OnNamedChain B) (derive_named E cfg B) := by
   135	  induction B with
   136	  | genesis => exact rows_empty _ _ rfl
   137	  | node parent slot root votes support rows proposer ih =>
   138	    change FinalizeRows _ (process_height_events E cfg
   139	      (fold_rows (TimeoutBinding.targeted V) (derive_named E cfg parent)
   140	        (NamedBlock.node parent slot root votes support rows proposer).erase rows))
   141	    apply rows_height_events
   142	    apply rows_fold_block
   143	    · exact own_rows _
   144	    · exact rows_mono _ _ _ ih
   145	        (chain_parent_subset parent slot root votes support rows proposer)
   146	
   147	private theorem folded_finalize_rows (E : Env V) (cfg : HeightConfig)
   148	    (parent : NamedBlock V) (slot : Slot) (root : BlockId)
   149	    (votes support : List (GoldfishVote V)) (rows : List (NamedAttestation V)) (proposer : V) :
   150	    let B := NamedBlock.node parent slot root votes support rows proposer
   151	    FinalizeRows (NamedMatchingProgress.OnNamedChain B)
   152	      (fold_rows (TimeoutBinding.targeted V) (derive_named E cfg parent) B.erase rows) := by
   153	  apply rows_fold_block
   154	  · exact own_rows _
   155	  · exact rows_mono _ _ _ (derive_finalize_rows E cfg parent)
   156	      (chain_parent_subset parent slot root votes support rows proposer)
   157	
   158	omit [Fintype V] in
   159	private theorem fold_finality_fields (st : ChainState V) (B : NamedBlock V) :
   160	    (fold_rows (TimeoutBinding.targeted V) st B.erase B.attestations).F = st.F ∧
   161	    (fold_rows (TimeoutBinding.targeted V) st B.erase B.attestations).h_F = st.h_F := by
   162	  have fields := Proofs.NamedStoreRoots.fold_context_fields (TimeoutBinding.targeted V)
   163	    B.attestations { st with s := B.erase.slot }
   164	  exact ⟨fields.2.2.2.2.2.1, fields.2.2.2.2.2.2⟩
   165	
   166	private def RowQuorum (E : Env V) (pool : NamedAttestation V → Prop)
   167	    (pair : FinalityPair) : Prop :=
   168	  ∃ Q : Finset V, E.electorate.IsQuorum Q ∧
   169	    ∀ signer ∈ Q, ∃ a : NamedAttestation V, pool a ∧
   170	      a.val_index = signer ∧ a.finality_pair = some pair
   171	
   172	private theorem quorum_mono (E : Env V) (pool next : NamedAttestation V → Prop)
   173	    (pair : FinalityPair) (h : RowQuorum E pool pair)
   174	    (hsub : ∀ a, pool a → next a) : RowQuorum E next pair := by
   175	  obtain ⟨Q, hQ, hw⟩ := h
   176	  refine ⟨Q, hQ, ?_⟩
   177	  intro signer hs
   178	  obtain ⟨a, ha, hv, hp⟩ := hw signer hs
   179	  exact ⟨a, hsub a ha, hv, hp⟩
   180	
   181	private theorem certificate_step (E : Env V) (cfg : HeightConfig)
   182	    (pool : NamedAttestation V → Prop) (st : ChainState V) (h : FinalizeRows pool st) :
   183	    ((process_height_events E cfg st).F = st.F ∧
   184	      (process_height_events E cfg st).h_F = st.h_F) ∨
   185	    RowQuorum E pool
   186	      ⟨(process_height_events E cfg st).h_F, (process_height_events E cfg st).F.root⟩ := by
   187	  by_cases hf : finalityReady E st = true
   188	  · right
   189	    refine ⟨st.finalize, Protocol.isQuorum_of_finalityReady E hf, ?_⟩
   190	    intro signer hs
   191	    obtain ⟨a, ha, hv, hp⟩ := h signer hs
   192	    refine ⟨a, ha, hv, ?_⟩
   193	    rw [Protocol.process_height_events_h_F, Protocol.process_height_events_F,
   194	      Protocol.afterFin_h_F, Protocol.afterFin_F, if_pos hf, if_pos hf]
   195	    exact hp
   196	  · left
   197	    constructor
   198	    · rw [Protocol.process_height_events_F, Protocol.afterFin_F, if_neg hf]
   199	    · rw [Protocol.process_height_events_h_F, Protocol.afterFin_h_F, if_neg hf]
   200	
   201	theorem finalized_zero_is_genesis (E : Env V) (cfg : HeightConfig) (D : NamedBlock V)
   202	    (hz : (derive_named E cfg D).h_F = 0) :
   203	    (derive_named E cfg D).F = Block.genesis := by
   204	  induction D with
   205	  | genesis => rfl
   206	  | node parent slot root votes support rows proposer ih =>
   207	    let B := NamedBlock.node parent slot root votes support rows proposer
   208	    let folded := fold_rows (TimeoutBinding.targeted V)
   209	      (derive_named E cfg parent) B.erase B.attestations
   210	    change (process_height_events E cfg folded).h_F = 0 at hz
   211	    change (process_height_events E cfg folded).F = Block.genesis
   212	    rw [Protocol.process_height_events_h_F, Protocol.afterFin_h_F] at hz
   213	    rw [Protocol.process_height_events_F, Protocol.afterFin_F]
   214	    split_ifs at hz ⊢ with hf
   215	    · have hlt := Protocol.lt_of_finalityReady E hf
   216	      rw [hz] at hlt
   217	      exact False.elim (Nat.not_lt_zero _ hlt)
   218	    · have hFields := fold_finality_fields (derive_named E cfg parent) B
   219	      change folded.F = Block.genesis
   220	      rw [hFields.1]
   221	      exact ih (hFields.2.symm.trans hz)
   222	
   223	private theorem nonzero_rows_certificate (E : Env V) (cfg : HeightConfig) (D : NamedBlock V)
   224	    (hnz : (derive_named E cfg D).h_F ≠ 0) :
   225	    RowQuorum E (NamedMatchingProgress.OnNamedChain D)
   226	      ⟨(derive_named E cfg D).h_F, (derive_named E cfg D).F.root⟩ := by
   227	  induction D with
   228	  | genesis => exact False.elim (hnz rfl)
   229	  | node parent slot root votes support rows proposer ih =>
   230	    let B := NamedBlock.node parent slot root votes support rows proposer
   231	    let folded := fold_rows (TimeoutBinding.targeted V)
   232	      (derive_named E cfg parent) B.erase B.attestations
   233	    have hRows := folded_finalize_rows E cfg parent slot root votes support rows proposer
   234	    have hFields := fold_finality_fields (derive_named E cfg parent) B
   235	    change (process_height_events E cfg folded).h_F ≠ 0 at hnz
   236	    change RowQuorum E (NamedMatchingProgress.OnNamedChain B)
   237	      ⟨(process_height_events E cfg folded).h_F, (process_height_events E cfg folded).F.root⟩
   238	    rcases certificate_step E cfg _ folded hRows with ⟨hF, hhF⟩ | hCert
   239	    · rw [hhF, hF, hFields.2, hFields.1]
   240	      have hParent : (derive_named E cfg parent).h_F ≠ 0 := by
   241	        intro hz
   242	        exact hnz (hhF.trans (hFields.2.trans hz))
   243	      exact quorum_mono E _ _ _ (ih hParent)
   244	        (chain_parent_subset parent slot root votes support rows proposer)
   245	    · exact hCert
   246	
   247	theorem finality_certificate (E : Env V) (cfg : HeightConfig) (D : NamedBlock V)
   248	    (hnz : (derive_named E cfg D).h_F ≠ 0) :
   249	    ∃ F : NamedBlock V, NamedBlock.Preceq F D ∧
   250	      F.erase = (derive_named E cfg D).F ∧
   251	      ∃ Q : Finset V, E.electorate.IsQuorum Q ∧
   252	        ∀ signer ∈ Q, ∃ carrier : NamedBlock V, ∃ a : NamedAttestation V,
   253	          NamedBlock.Preceq carrier D ∧ a ∈ carrier.attestations ∧
   254	          a.val_index = signer ∧
   255	          a.finality_pair = some ⟨(derive_named E cfg D).h_F, F.root⟩ := by
   256	  obtain ⟨F, hFD, hErase⟩ := erased_ancestor_lift D
   257	    (Proofs.NamedStoreRoots.derive_named_anchors_preceq E cfg D).1
   258	  have hRoot : (derive_named E cfg D).F.root = F.root :=
   259	    (congrArg Block.root hErase).symm.trans (Proofs.NamedWire.erase_root F)
   260	  obtain ⟨Q, hQ, hw⟩ := nonzero_rows_certificate E cfg D hnz
   261	  refine ⟨F, hFD, hErase, Q, hQ, ?_⟩
   262	  intro signer hs
   263	  obtain ⟨a, ⟨carrier, hcarrier, hrow⟩, hv, hp⟩ := hw signer hs
   264	  exact ⟨carrier, a, hcarrier, hrow, hv, by simpa only [hRoot] using hp⟩
   265	
   266	theorem height_crossing (E : Env V) (cfg : HeightConfig) (C : NamedBlock V)
   267	    (h : Height) (hpos : 1 ≤ h) (hlt : h < (derive_named E cfg C).h) :
   268	    ∃ X : NamedBlock V, NamedBlock.Preceq X C ∧
   269	      (derive_named E cfg X).h = h ∧
   270	      ∃ Q : Finset V, E.electorate.IsQuorum Q ∧
   271	        ∀ signer ∈ Q, ∃ carrier : NamedBlock V, ∃ a : NamedAttestation V,
   272	          NamedBlock.Preceq carrier C ∧ a ∈ carrier.attestations ∧
