   857	  \Comment{this view's own maximum}
   858	  \State $(j,J)\gets$ the lex-greatest $(\Sigma.\sigma[W].h_j,
   859	    \Sigma.\sigma[W].J.\rootf)$ over $W\in V$ with $F\preceq\Sigma.\sigma[W].J$
   860	  \State $\mathit{contest}\gets(H=j+1)$ \textbf{and} some $W\in V$
   861	    has $\Sigma.\sigma[W].h=H$ and $J\not\preceq W$
   862	  \If{$H=j+1$ and not $\mathit{contest}$}
   863	    \State $(Z,\lo)\gets(J,H-1)$
   864	    \Comment{\cite{DC}: root $J$, band $\{H-1,H\}$}
   865	  \ElsIf{$\mathit{contest}$}
