    91	  (PROTOCOL.md `def:antislashing`). -/
    92	  target : Height → Option BlockId
    93	  /-- §5.3 `Λ.timeout[h]`: whether it emitted an empty-target vote at height `h`
    94	  (PROTOCOL.md `def:antislashing`). -/
    95	  timeout : Height → Bool
    96	  /-- §5.3 `Λ.lock[h]`: the target of its first finality pair at height `h`
    97	  (PROTOCOL.md `def:antislashing`). -/
    98	  lock : Height → Option BlockId
    99	
   100	namespace Record
   101	
   102	/-- §5.3 the initial record: `(⊥, false, ⊥)` at every height
   103	(PROTOCOL.md `def:antislashing`). -/
   104	def initial : Record where
   105	  target := fun _ => none
   106	  timeout := fun _ => false
   107	  lock := fun _ => none
   108	
   109	/-- §5.3 `Λ.target[h] ← T` (PROTOCOL.md `alg:pair-rules`, "record_attestation"). -/
   110	def with_target (Λ : Record) (h : Height) (T : BlockId) : Record :=
   111	  { Λ with target := fun k => if k = h then some T else Λ.target k }
   112	
   113	/-- §5.3 `Λ.timeout[h] ← true` (PROTOCOL.md `alg:pair-rules`, "record_attestation"). -/
   114	def with_timeout (Λ : Record) (h : Height) : Record :=
   115	  { Λ with timeout := fun k => if k = h then true else Λ.timeout k }
   116	
   117	/-- §5.3 `Λ.lock[h] ← J` (PROTOCOL.md `alg:pair-rules`, "record_attestation"). -/
   118	def with_lock (Λ : Record) (h : Height) (J : BlockId) : Record :=
   119	  { Λ with lock := fun k => if k = h then some J else Λ.lock k }
   120	
   121	end Record
   122	
   123	variable {V : Type} [DecidableEq V] [Fintype V]
   124	
   125	/-! ## The pair rules and the record interface
   126	(PROTOCOL.md `def:antislashing`, `alg:pair-rules`)
   127	
   128	This module structures the two pair rules separately. They take plain fields and return a
   129	pair. `create_attestation` is the record's whole interface — "it takes the record
   130	and the vote information, produces the attestation, and updates the record before
   131	releasing it; it never reads the store" (PROTOCOL.md `def:antislashing`) — and
   132	`record_attestation` is the only writer.
   133	
   134	Two consequences, and both are semantic rather than cosmetic.
   135	
   136	* **`height_pair` sees its own attestation's lock.** It receives the finality
   137	  pair and overrides the lock at that height, so one attestation cannot form
   138	  E1 evidence (PROTOCOL.md `alg:pair-rules`).
   139	* **`target[h]` is written whenever a nonempty target is emitted at a fresh
   140	  height**, not only on the "no history" row. `record_attestation` folds the
   141	  emitted attestation, so the lock-repeat and target-repeat rows also write
   142	  `target[h]` if it was empty.
   143	-/
   144	
   145	/-- §5.3 `finality_pair(Λ, h_j, J, h_F)` (PROTOCOL.md `alg:pair-rules`). **Final.**
   146	
   147	Reads the finality fields the caller took from the head's chain state — "its
   148	subject is already justified, so it may read an unconfirmed chain, and the head
   149	chain state carries the freshest justification" (PROTOCOL.md `alg:pair-rules`). Emits
   150	`(h_j, J)` exactly when a justification is not yet finalized *and* the record
   151	allows it; otherwise the empty pair, which is `none` of an `Option FinalityPair`.
   152	
   153	**This action does not write the lock.** `record_attestation` does, from the emitted
   154	attestation.
   155	
   156	The record test allows `Λ.target[h_j]` to be empty or equal to `J`. A validator
   157	that never voted at `h_j` can therefore emit the finality pair. The emitted pair
   158	writes `Λ.lock[h_j] = J`, so later height pairs at that height can only target
   159	`J` or abstain. A recorded timeout or a different target still blocks the pair. -/
   160	def finality_pair (Λ : Record) (h_j : Height) (J : BlockId) (h_F : Height) :
   161	    Option FinalityPair :=
   162	  if h_F < h_j then
   163	    if (Λ.target h_j = none ∨ Λ.target h_j = some J) ∧
   164	        Λ.timeout h_j = false ∧
   165	        (Λ.lock h_j = none ∨ Λ.lock h_j = some J) then
   166	      some ⟨h_j, J⟩
   167	    else
   168	      none
   169	  else
   170	    none
   171	
   172	/-- §5.3 the lock `height_pair` reads: the record's lock at `h_c`, overridden by
   173	this attestation's own finality pair when the two heights agree
   174	(PROTOCOL.md `alg:pair-rules`, "this attestation's own lock").
   175	
   176	"`height_pair` receives the same attestation's finality pair as the lock at its
   177	height, so one attestation never forms E1 evidence" (PROTOCOL.md `alg:pair-rules`).
   178	The helper makes the same-attestation lock explicit for `height_pair`'s branch
   179	analysis. -/
   180	def own_lock (Λ : Record) (h_c : Height) (fp : Option FinalityPair) :
   181	    Option BlockId :=
   182	  match fp with
   183	  | some p => if p.height = h_c then some p.target else Λ.lock h_c
   184	  | none => Λ.lock h_c
   185	
   186	/-- §5.3 `height_pair(Λ, h_c, T_c, ν, h_f, T_f)` (PROTOCOL.md `alg:pair-rules`).
   187	**Final.**
   188	
   189	Reads the height fields the caller took from a confirmed block's chain state —
   190	"a target vote can create a justification, and only confirmed blocks may be
   191	justified" (PROTOCOL.md `alg:pair-rules`).
   192	
   193	The three height fields arrive as one `Option`: `(⊥, ⊥, ⊥)` is what §6 passes
   194	when there is no fresh quorum (PROTOCOL.md `alg:round-action`, "no fresh
   195	quorum"), and the document's
   196	`h_c = ⊥` guard tests exactly that. The finality pair arrives whole, and the lock
   197	at `h_c` is overridden by it when the two heights agree.
   198	
   199	The branches, in the document's order, with its fall-through:
   200	
   201	| `timeout[h_c]` | `lock` | `target[h_c]` | `ν` | Result |
   202	|---|---|---|---|---|
   203	| true | — | — | — | `(h_c, ⊥)` |
   204	| false | `= T_c` | — | — | `(h_c, T_c)` |
   205	| false | `≠ ⊥`, `≠ T_c` | — | — | `(⊥, ⊥)` |
   206	| false | `⊥` | `= T_c` | — | `(h_c, T_c)` |
   207	| false | `⊥` | `≠ ⊥`, `≠ T_c` | — | `(h_c, ⊥)` |
   208	| false | `⊥` | `⊥` | false | `(h_c, T_c)` |
   209	| false | `⊥` | `⊥` | true | `(h_c, ⊥)` |
   210	
   211	The asymmetry between rows 3 and 5 is the subtle part and is written as stated: a
   212	validator **locked elsewhere** returns the *empty pair* and so abstains from the
   213	height entirely ("wait out the height"), while a validator whose **recorded**
   214	target disagrees falls through to a timeout at `h_c` and keeps participating in
   215	progress. Both target tests are equalities, not ancestry. -/
   216	def height_pair (Λ : Record) (fields : Option (Height × BlockId × Bool))
   217	    (fp : Option FinalityPair) : HeightPair :=
   218	  match fields with
   219	  | none => .empty
   220	  | some (h_c, T_c, ν) =>
   221	    if Λ.timeout h_c then
   222	      .timeout h_c
   223	    else
   224	      match own_lock Λ h_c fp with
   225	      | some locked => if locked = T_c then .target h_c T_c else .empty
   226	      | none =>
   227	        match Λ.target h_c with
   228	        | some recorded => if recorded = T_c then .target h_c T_c else .timeout h_c
   229	        | none => if ν then .timeout h_c else .target h_c T_c
   230	
   231	/-- §5.3 `record_attestation(Λ, a)` (PROTOCOL.md `alg:pair-rules`): the **only**
   232	writer of `Λ`, folding the attestation about to be released.
   233	
   234	`target[h]` is write-once, as the guard `Λ.target[h] = ⊥` says; `timeout[h]` and
   235	`lock[h_f]` are idempotent at the values the pair rules can emit. -/
   236	def record_attestation (Λ : Record) (a : CombinedAttestation V) : Record :=
   237	  let afterLock :=
   238	    match a.finality_pair with
   239	    | some p => Λ.with_lock p.height p.target
   240	    | none => Λ
   241	  match a.height_pair with
   242	  | .empty => afterLock
   243	  | .timeout h => afterLock.with_timeout h
   244	  | .target h T => if afterLock.target h = none then afterLock.with_target h T else afterLock
   245	
   246	/-- §5.3 `create_attestation(Λ, r, confirmed, h_c, T_c, ν, h_j, J, h_F)`
   247	(PROTOCOL.md `alg:pair-rules`): the validator-client side, with
   248	**no store access**.
   249	
   250	The two pair rules, then the attestation, then the record — "record, then
   251	release". Returns the updated record beside the attestation, because `Λ` is not a
   252	store field (PROTOCOL.md `def:antislashing`). -/
   253	def create_attestation (Λ : Record) (val_index : V) (r : Round)
   254	    (confirmed : Option BlockId) (fields : Option (Height × BlockId × Bool))
   255	    (h_j : Height) (J : BlockId) (h_F : Height) :
   256	    Record × CombinedAttestation V :=
   257	  let fp := finality_pair Λ h_j J h_F
   258	  let hp := height_pair Λ fields fp
   259	  let a : CombinedAttestation V := ⟨val_index, r, confirmed, hp, fp⟩
   260	  (record_attestation Λ a, a)
   261	
   262	end Protocol
   263	end DecoupledConsensusModel
   264	end
   265	
   266	-- ── from FGForkChoice/NamedRecord.lean ──
   267	section
   268	/-! Named-row signing state. `Record` contains the target, timeout, and lock maps;
   269	`NamedRecord` adds the active timeout-history set. The history records timeout
   270	annotations; it never suppresses a repeated transmission or replaces a
   271	height-wide target/finality lock. -/
   272	namespace DecoupledConsensusModel.Protocol
   273	
   274	structure NamedRecord where
   275	  legacy : Record
   276	  timeoutHistory : Finset (Height × BlockId)
   277	
   278	namespace NamedRecord
   279	
   280	/-- Exact input fields supplied to the existing signing client. -/
   281	structure Input (V : Type) where
   282	  val_index : V
   283	  round : Round
   284	  confirmed : Option BlockId
   285	  fields : Option (Height × BlockId × Bool)
   286	  h_j : Height
   287	  J : BlockId
   288	  h_F : Height
   289	
   290	def initial : NamedRecord := ⟨Record.initial, ∅⟩
   291	
   292	/-- A fixed codec. The creator proves its old output agrees with these actual
   293	source fields; no receiver state or context callback participates. -/
   294	def encodeHeight (fields : Option (Height × BlockId × Bool))
   295	    (pair : HeightPair) : NamedHeightPair :=
   296	  match pair, fields with
   297	  | .empty, _ => .empty
   298	  | .target _ _, some (h, entry, _) => .vote h entry false
   299	  | .timeout _, some (h, entry, _) => .vote h entry true
   300	  | _, none => .empty
   301	
   302	def encodeRow {V : Type} (fields : Option (Height × BlockId × Bool))
   303	    (row : CombinedAttestation V) : NamedAttestation V :=
   304	  ⟨row.val_index, row.round, row.confirmed, encodeHeight fields row.height_pair,
   305	    row.finality_pair⟩
   306	
   307	/-- Set insertion is idempotent; membership is not an emission guard. -/
   308	def rememberTimeout (history : Finset (Height × BlockId)) : NamedHeightPair →
   309	    Finset (Height × BlockId)
   310	  | .vote h entry true => insert (h, entry) history
   311	  | _ => history
   312	
   313	def legacyCreate {V : Type} (record : Record) (input : Input V) :
   314	    Record × CombinedAttestation V :=
   315	  create_attestation record input.val_index input.round input.confirmed input.fields
   316	    input.h_j input.J input.h_F
   317	
   318	/-- The base client makes all pair decisions and updates its record once.
   319	The extra history records exactly the resulting named timeout pair. -/
   320	def create {V : Type} (record : NamedRecord) (input : Input V) :
   321	    NamedRecord × NamedAttestation V :=
   322	  let old := legacyCreate record.legacy input
   323	  let row := encodeRow input.fields old.2
   324	  (⟨old.1, rememberTimeout record.timeoutHistory row.height_pair⟩, row)
   325	
   326	end NamedRecord
   327	end DecoupledConsensusModel.Protocol
   328	end
   329	
   330	end
   280	end Block
   281	
   282	section Pick
   283	
   284	variable {α : Type} [DecidableEq α]
   285	
   286	instance decidableExistsUniqueMem (T : Finset α) (p : α → Prop)
   287	    [DecidablePred p] : Decidable (∃! a, a ∈ T ∧ p a) :=
   288	  decidable_of_iff (∃ a ∈ T, p a ∧ ∀ b ∈ T, p b → b = a) <| by
   289	    constructor
   290	    · rintro ⟨a, haT, hpa, huniq⟩
   291	      exact ⟨a, ⟨haT, hpa⟩, fun b hb => huniq b hb.1 hb.2⟩
   292	    · rintro ⟨a, ⟨haT, hpa⟩, huniq⟩
   293	      exact ⟨a, haT, hpa, fun b hbT hpb => huniq b ⟨hbT, hpb⟩⟩
   294	
   295	/-- The unique member of `T` satisfying `p`, or `none` when there is no such
   296	member or more than one. Computable, and total without a choice principle. -/
   297	def pickUnique? (T : Finset α) (p : α → Bool) : Option α :=
   298	  if h : ∃! a, a ∈ T ∧ p a = true then
   299	    some (T.choose (fun a => p a = true) h)
   300	  else
   301	    none
   302	
   303	end Pick
   304	
   305	namespace Block
   306	
   307	variable {V : Type} [DecidableEq V]
   308	
   309	/-- §1 root → block resolution in a processed tree (PROTOCOL.md `sec:substrate`). A root
   310	is a block's identity, so a tree that holds two blocks with one root resolves it
   311	to neither. -/
   312	def find? (T : Finset (Block V)) (r : BlockId) : Option (Block V) :=
   313	  pickUnique? T (fun B => decide (B.root = r))
   314	
   315	/-- Whether no block of `T` beats `B` in the `deeper` order. -/
   316	def isDeepestIn (T : Finset (Block V)) (B : Block V) : Bool :=
   317	  decide (∀ C ∈ T, deeper C B = false)
   318	
   319	/-- §1 "deepest": maximum depth, ties by the fixed root order
   320	(PROTOCOL.md `sec:substrate`). `none` on an empty tree, and on the degenerate tie where two
   321	distinct blocks share a depth *and* a root. -/
   322	def deepest? (T : Finset (Block V)) : Option (Block V) :=
   323	  pickUnique? T (isDeepestIn T)
   324	
   325	end Block
   326	
   327	@[inherit_doc] scoped infix:50 " ⪯ " => Block.Preceq
   328	@[inherit_doc] scoped infix:50 " ≺ " => Block.Prec
   329	
   330	end DecoupledConsensusModel
   331	end
