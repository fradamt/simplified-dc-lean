   248	/-- §4 a chain state `σ` (PROTOCOL.md `def:chain-state`, `def:chain-state`).
   249	The fields are in the document's tuple order. -/
   250	structure ChainState (V : Type) where
   251	  /-- §4 `L`: the latest block (PROTOCOL.md `def:chain-state`). -/
   252	  L : Block V
   253	  /-- §4 `s = L.slot` (PROTOCOL.md `def:chain-state`). Held as a field
