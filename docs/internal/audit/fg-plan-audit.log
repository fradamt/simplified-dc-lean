name = "available-chain"
version = "0.1.0"
keywords = ["lean", "consensus", "model"]
defaultTargets = [
  "AvailableChainModel",
  "AvailableChainStatements",
  "AvailableChainLStar",
  "AvailableChainGridCO",
  "AvailableChainSA",
  "AvailableChainSAPC",
  "AvailableChainWitnesses",
  "AvailableChainFramework",
  "AvailableChainRegistry",
]

[leanOptions]
pp.unicode.fun = true
relaxedAutoImplicit = false
weak.linter.mathlibStandardSet = true
weak.linter.flexible = false
maxSynthPendingDepth = 3

[[require]]
name = "mathlib"
scope = "leanprover-community"
rev = "v4.30.0-rc2"

# Generic execution engine and objects. No protocol.
[[lean_lib]]
name = "AvailableChainModel"

# The contract: interface, conditions, regimes, constants, properties, claims.
[[lean_lib]]
name = "AvailableChainStatements"

# Instance: Goldfish with L* locks (model, statements, proofs).
[[lean_lib]]
name = "AvailableChainLStar"

# Grid counted-obligations instance of the common contract.
[[lean_lib]]
name = "AvailableChainGridCO"

# Non-vacuity: sanity instance, regime witnesses, accumulation run.
[[lean_lib]]
name = "AvailableChainWitnesses"

# Slow arming with one release level.
[[lean_lib]]
name = "AvailableChainSA"

# Slow arming with persistent TA certificates.
[[lean_lib]]
name = "AvailableChainSAPC"

# Framework prototype (Phase 0): hooks, instances, claim catalog, certificates.
[[lean_lib]]
name = "AvailableChainFramework"

# Instances with certificates and refutations over the framework (L4), and tests.
[[lean_lib]]
name = "AvailableChainRegistry"
lean/available-chain/AvailableChainFramework/Instance.lean
lean/available-chain/AvailableChainFramework/Cert.lean
lean/available-chain/AvailableChainFramework/Profile.lean
lean/available-chain/AvailableChainFramework/Kit/Core.lean
lean/available-chain/AvailableChainFramework/Catalog/Core.lean
lean/available-chain/AvailableChainFramework/Hooks.lean
lean/available-chain/AvailableChainFramework/Pareto.lean
lean/available-chain/AvailableChainFramework/Claim.lean
