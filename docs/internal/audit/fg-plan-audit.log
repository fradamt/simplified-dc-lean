#!/usr/bin/env python3
"""Render terminal tables with Unicode box-drawing characters.

Supports CSV, JSON, or delimited stdin input.
"""

from __future__ import annotations

import argparse
import csv
import json
import sys
import textwrap
from pathlib import Path


def parse_headers(raw: str | None) -> list[str] | None:
    if raw is None:
        return None
    return [h.strip() for h in raw.split(",")]


def str_cell(value: object) -> str:
    if value is None:
        return ""
    return str(value)


def normalize_rows(headers: list[str], rows: list[list[object]]) -> tuple[list[str], list[list[str]]]:
    max_len = max([len(headers)] + [len(r) for r in rows] if rows else [len(headers)])
    if len(headers) < max_len:
        for i in range(len(headers), max_len):
            headers.append(f"col{i + 1}")

    norm: list[list[str]] = []
    for row in rows:
        cur = [str_cell(v) for v in row]
        if len(cur) < len(headers):
            cur.extend([""] * (len(headers) - len(cur)))
        elif len(cur) > len(headers):
            for i in range(len(headers), len(cur)):
                headers.append(f"col{i + 1}")
        norm.append(cur)

    # Re-pad in case headers grew while iterating.
    padded: list[list[str]] = []
    for row in norm:
        if len(row) < len(headers):
            row = row + [""] * (len(headers) - len(row))
        padded.append(row)

    return headers, padded


def load_csv(path: Path, delimiter: str, no_header: bool, headers_arg: list[str] | None) -> tuple[list[str], list[list[str]]]:
    with path.open("r", encoding="utf-8", newline="") as f:
        data = list(csv.reader(f, delimiter=delimiter))

    if not data:
        return headers_arg or [], []

    if no_header:
        headers = headers_arg or [f"col{i + 1}" for i in range(max(len(r) for r in data))]
        rows = data
    else:
        headers = headers_arg or data[0]
        rows = data[1:]

    return normalize_rows(headers, rows)


def load_json(path: Path, headers_arg: list[str] | None) -> tuple[list[str], list[list[str]]]:
    with path.open("r", encoding="utf-8") as f:
        data = json.load(f)

    if isinstance(data, list):
        if not data:
            return headers_arg or [], []

        first = data[0]
        if isinstance(first, dict):
            headers = headers_arg or list(first.keys())
            rows = []
            for item in data:
                if not isinstance(item, dict):
                    raise ValueError("Mixed JSON array types are not supported.")
                rows.append([item.get(h, "") for h in headers])
            return normalize_rows(headers, rows)

        if isinstance(first, list):
            headers = headers_arg or [f"col{i + 1}" for i in range(max(len(r) for r in data if isinstance(r, list)))]
            rows = []
            for item in data:
                if not isinstance(item, list):
                    raise ValueError("Mixed JSON array types are not supported.")
                rows.append(item)
            return normalize_rows(headers, rows)

        raise ValueError("JSON array must contain objects or arrays.")

    if isinstance(data, dict):
        headers = headers_arg or ["key", "value"]
        rows = [[k, v] for k, v in data.items()]
        return normalize_rows(headers, rows)

    raise ValueError("Unsupported JSON structure. Use list or object.")


def load_stdin(delimiter: str, no_header: bool, headers_arg: list[str] | None) -> tuple[list[str], list[list[str]]]:
    raw = sys.stdin.read()
    lines = [ln for ln in raw.splitlines() if ln.strip()]
    if not lines:
        return headers_arg or [], []

    data = [line.split(delimiter) for line in lines]
    if no_header:
        headers = headers_arg or [f"col{i + 1}" for i in range(max(len(r) for r in data))]
        rows = data
    else:
        headers = headers_arg or data[0]
        rows = data[1:]

    return normalize_rows(headers, rows)


def wrap_text(value: str, width: int) -> list[str]:
    value = value.replace("\r\n", "\n")
    parts = value.split("\n")
    out: list[str] = []
    for p in parts:
        wrapped = textwrap.wrap(p, width=width, break_long_words=True, break_on_hyphens=False)
        out.extend(wrapped or [""])
    return out or [""]


def render_table(headers: list[str], rows: list[list[str]], max_col_width: int) -> str:
    if not headers:
        return "(empty table)"

    widths: list[int] = []
    for i, h in enumerate(headers):
        col_vals = [h]
        for r in rows:
            if i < len(r):
                col_vals.append(r[i])
        width = min(max(len(v) for v in col_vals), max_col_width)
        widths.append(max(width, 1))

    def border(left: str, mid: str, right: str) -> str:
        return left + mid.join("─" * (w + 2) for w in widths) + right

    top = border("┌", "┬", "┐")
    sep = border("├", "┼", "┤")
    bottom = border("└", "┴", "┘")

    lines: list[str] = [top]

    # Header row
    header_wrapped = [wrap_text(headers[i], widths[i]) for i in range(len(headers))]
    h_height = max(len(x) for x in header_wrapped)
    for ln in range(h_height):
        cells = []
        for i in range(len(headers)):
            txt = header_wrapped[i][ln] if ln < len(header_wrapped[i]) else ""
            cells.append(txt.ljust(widths[i]))
        lines.append("│ " + " │ ".join(cells) + " │")

    lines.append(sep)

    for row in rows:
        wrapped_cells = [wrap_text(row[i] if i < len(row) else "", widths[i]) for i in range(len(headers))]
        r_height = max(len(x) for x in wrapped_cells)
        for ln in range(r_height):
            cells = []
            for i in range(len(headers)):
                txt = wrapped_cells[i][ln] if ln < len(wrapped_cells[i]) else ""
                cells.append(txt.ljust(widths[i]))
            lines.append("│ " + " │ ".join(cells) + " │")

    lines.append(bottom)
    return "\n".join(lines)


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(description="Render Unicode terminal tables")
    source = p.add_mutually_exclusive_group(required=True)
    source.add_argument("--csv", dest="csv_path", type=Path, help="Path to CSV file")
    source.add_argument("--json", dest="json_path", type=Path, help="Path to JSON file")
    source.add_argument("--stdin", action="store_true", help="Read delimited data from stdin")

    p.add_argument("--delimiter", default=",", help="Field delimiter for CSV/stdin (default: ',')")
    p.add_argument("--no-header", action="store_true", help="Treat input as data-only (no header row)")
    p.add_argument("--headers", help="Comma-separated headers override")
    p.add_argument("--max-col-width", type=int, default=40, help="Maximum width per column")
    return p


def main() -> int:
    args = build_parser().parse_args()
    headers_arg = parse_headers(args.headers)

    try:
        if args.csv_path:
            headers, rows = load_csv(args.csv_path, args.delimiter, args.no_header, headers_arg)
        elif args.json_path:
            headers, rows = load_json(args.json_path, headers_arg)
        else:
            headers, rows = load_stdin(args.delimiter, args.no_header, headers_arg)

        print(render_table(headers, rows, args.max_col_width))
        return 0
    except Exception as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
