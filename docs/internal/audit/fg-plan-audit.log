   545	
   546	```lean
   547	abbrev View (V : Type) := Finset (FGBlock V)
   548	
   549	variable {V : Type} [DecidableEq V] [Fintype V] (E : Electorate V) (cfg : FGConfig)
   550	
   551	def hOf (W : FGBlock V) : Height := (derive E cfg W).h
   552	
   553	/-- `H = max({1} ∪ {h(W) : W ∈ V})`. -/
   554	def frontier (Vw : View V) : Height := Vw.sup (hOf E cfg) ⊔ 1
   555	
   556	/-- The lex key `(h_j, J.root)`. -/
   557	def lexKey (p : Height × FGBlock V) : Lex (ℕ × ℕ) := toLex (p.1, p.2.root.value)
   558	
   559	structure Frame (V : Type) where
   560	  F : FGBlock V
   561	  H : Height
   562	  j : Height
   563	  J : FGBlock V
   564	  Z : FGBlock V
   565	  lo : Height
   566	  D : Finset (FGBlock V)
   567	  contest : Bool
   568	```
   569	
   570	  `lexMax E cfg F Vw` returns the lex-greatest `(h_j, J)` over `W ∈ Vw` with `F ⪯ (derive W).J`, or `(0, genesis)` if there is none:
   571	  - Compute the greatest key with `Finset.sup` over `Lex (ℕ × ℕ)`.
   572	  - Take a pair with that key through `pickPair`, a port of DC's `pickUnique?`/`find?` (`DC/DecoupledConsensusModel/Objects/Blocks.lean:290–333`), with `(0, genesis)` as the default.
   573	  - Keep `lexMax` computable, so that the `decide` examples reduce.
   574	  - With root injectivity, two pairs with one key are one block. Without it, `pickPair` returns one of them.
   575	
   576	  The fallback `(0, genesis)`: if `F ≠ genesis` and no pair in the view extends F, then `J = genesis`, and `F ⪯ J` fails. The spec keeps the F basis in every duty view (spec lines 361–365 and 494), so this case does not occur in a spec duty. Task 7's `fBasis_lexMax` (pinned to `fg.frameCompat.v1`, part (ii)) proves that the fallback is not used when the view holds a block whose J extends F. Keep the fallback; do not change it to `(h_F, F)`, because the spec does not say so.
   577	
   578	```lean
   579	/-- [pin fj.frame.v1] The FJ frame (r148 §2; spec `fg_frame`): `F ⪯ J`; a
   580	contest at `H = j+1` when a height-`H` block does not extend `J`; in a contest
   581	the root is `F` and the band is `{H}`. Frame only: head selection and eligibility are AP data. -/
   582	def fjFrame (F : FGBlock V) (Vw : View V) : Frame V :=
   583	  let H := frontier E cfg Vw
   584	  let p := lexMax E cfg F Vw
   585	  let contest := decide (H = p.1 + 1) &&
   586	    decide (∃ W ∈ Vw, hOf E cfg W = H ∧ ¬ FGBlock.Preceq p.2 W)
   587	  let Z := if H = p.1 + 1 ∧ contest = false then p.2 else F
   588	  let lo := if contest then H else H - 1
   589	  let D := Vw.filter (fun B => FGBlock.preceq F B && FGBlock.preceq Z B &&
   590	    decide (∃ W ∈ Vw, FGBlock.Preceq B W ∧ lo ≤ hOf E cfg W))
   591	  ⟨F, H, p.1, p.2, Z, lo, D, contest⟩
   592	```
