  1768	
  1769	```bash
  1770	#!/usr/bin/env bash
  1771	# Prints the axioms of every public theorem of AvailableChainKitFG and fails on
  1772	# an axiom other than propext, Classical.choice and Quot.sound.
  1773	set -euo pipefail
  1774	cd "$(dirname "$0")/.."
  1775	out=.lake/fg-axioms
  1776	mkdir -p "$out"
  1777	{ echo "import AvailableChainKitFG"
  1778	  grep -h '^theorem ' AvailableChainKitFG/*.lean | awk '{print "#print axioms AvailableChain.KitFG." $2}'
  1779	} > "$out/Check.lean"
  1780	n=$(grep -c '^#print' "$out/Check.lean" || true)
  1781	[ "$n" -gt 0 ] || { echo "NO THEOREMS FOUND"; exit 2; }
  1782	lake env lean "$out/Check.lean" > "$out/result.txt" 2>&1
  1783	m=$(grep -c "depends on axioms\|does not depend on any axioms" "$out/result.txt" || true)
  1784	[ "$m" -eq "$n" ] || { echo "EXPECTED $n RESULTS, GOT $m"; cat "$out/result.txt"; exit 1; }
  1785	if grep "depends on axioms" "$out/result.txt" |
  1786	    sed 's/.*\[//; s/\].*//' | tr ',' '\n' | sed 's/^ *//' |
  1787	    grep -v -x -e propext -e Classical.choice -e Quot.sound | grep -q .; then
  1788	  echo "UNEXPECTED AXIOM"; grep "depends on axioms" "$out/result.txt"; exit 1
  1789	fi
  1790	echo "checked $n theorems"
  1791	```
