   237	  simp only [create_attestation] at hlock ⊢
   238	  let fp := finality_pair Λ h_j J h_F
   239	  let hp := height_pair Λ fields fp
   240	  let a : CombinedAttestation V := ⟨val_index, r, confirmed, hp, fp⟩
   241	  change (record_attestation Λ a).lock g = some X at hlock
   242	  change (record_attestation Λ a).timeout g = false ∧
   243	    ((record_attestation Λ a).target g = none ∨
   244	      (record_attestation Λ a).target g = some X)
   245	  have hol : own_lock Λ g fp = some X := by
   246	    rw [← record_attestation_lock_eq_own_lock Λ a g]
