    64	theorem derive_node_height_cases (E : Env V) (cfg : HeightConfig)
    65	    (parent : NamedBlock V) (s : Slot) (root : BlockId)
    66	    (votes support : List (GoldfishVote V)) (rows : List (NamedAttestation V)) (proposer : V) :
    67	    let B := NamedBlock.node parent s root votes support rows proposer
    68	    (derive_named E cfg B).h = (derive_named E cfg parent).h ∨
    69	      (derive_named E cfg B).h = (derive_named E cfg parent).h + 1 := by
    70	  rcases transition_height_entry_cases E cfg (derive_named E cfg parent)
    71	    (.node parent s root votes support rows proposer) with h | h
    72	  · exact Or.inl h.1
    73	  · exact Or.inr h.1
    74	
    75	/-- Heights are monotone along full named ancestry; erasure injectivity is
    76	not assumed and the previous derived_state function is not used. -/
    77	theorem derive_height_mono (E : Env V) (cfg : HeightConfig) {A B : NamedBlock V}
    78	    (hAB : NamedBlock.Preceq A B) : (derive_named E cfg A).h ≤ (derive_named E cfg B).h := by
    79	  induction B with
    80	  | genesis =>
    81	    simp only [NamedBlock.Preceq, NamedBlock.preceq, decide_eq_true_eq] at hAB
    82	    subst A
    83	    exact le_refl _
    84	  | node parent s root votes support rows proposer ih =>
    85	    simp only [NamedBlock.Preceq, NamedBlock.preceq, Bool.or_eq_true, decide_eq_true_eq] at hAB
    86	    rcases hAB with rfl | hparent
    87	    · exact le_refl _
    88	    · have hle := ih hparent
    89	      rcases derive_node_height_cases E cfg parent s root votes support rows proposer with h | h
    90	      · rw [h]; exact hle
    91	      · rw [h]; exact hle.trans (Nat.le_succ _)
    92	
    93	/-- Each geometry entry is the erasure of an actual full named ancestor at
    94	the same derived height. This avoids applying derive_named to an erased block. -/
    95	theorem entry_ancestor_same_height (E : Env V) (cfg : HeightConfig) (B : NamedBlock V) :
    96	    ∃ entry : NamedBlock V, NamedBlock.Preceq entry B ∧
    97	      entry.erase = (derive_named E cfg B).T_h ∧
    98	      (derive_named E cfg entry).h = (derive_named E cfg B).h := by
    99	  induction B with
   100	  | genesis => exact ⟨.genesis, named_self _, rfl, rfl⟩
   101	  | node parent s root votes support rows proposer ih =>
   102	    rcases transition_height_entry_cases E cfg (derive_named E cfg parent)
   103	      (.node parent s root votes support rows proposer) with hstay | hnew
   104	    · obtain ⟨entry, he, hentry, hheight⟩ := ih
   105	      exact ⟨entry, named_extend s root votes support rows proposer he,
   106	        hentry.trans hstay.2.symm, hheight.trans hstay.1.symm⟩
   107	    · exact ⟨.node parent s root votes support rows proposer, named_self _, hnew.2.symm, rfl⟩
   108	
   109	theorem entry_geometry_ancestor (E : Env V) (cfg : HeightConfig) (B : NamedBlock V) :
   110	    Block.Preceq (derive_named E cfg B).T_h B.erase := by
   111	  obtain ⟨entry, hentry, he, _⟩ := entry_ancestor_same_height E cfg B
   112	  rw [← he]
   113	  exact Proofs.NamedWire.erase_preceq hentry
   114	
   115	/-- Equality of child and parent height forces equality of their entries. -/
   116	theorem node_entry_eq_of_height_eq (E : Env V) (cfg : HeightConfig)
   117	    (parent : NamedBlock V) (s : Slot) (root : BlockId)
   118	    (votes support : List (GoldfishVote V)) (rows : List (NamedAttestation V)) (proposer : V)
   119	    (hh : (derive_named E cfg (.node parent s root votes support rows proposer)).h =
   120	      (derive_named E cfg parent).h) :
   121	    (derive_named E cfg (.node parent s root votes support rows proposer)).T_h =
   122	      (derive_named E cfg parent).T_h := by
   123	  rcases transition_height_entry_cases E cfg (derive_named E cfg parent)
   124	    (.node parent s root votes support rows proposer) with hstay | hnew
   125	  · exact hstay.2
   126	  · have hstep := hnew.1
   127	    change (derive_named E cfg (.node parent s root votes support rows proposer)).h =
   128	      (derive_named E cfg parent).h + 1 at hstep
   129	    exact False.elim (Nat.succ_ne_self _ (hstep.symm.trans hh))
   130	
   131	theorem entry_eq_on_plateau (E : Env V) (cfg : HeightConfig) {A B : NamedBlock V}
   132	    (hAB : NamedBlock.Preceq A B) (hh : (derive_named E cfg A).h = (derive_named E cfg B).h) :
   133	    (derive_named E cfg A).T_h = (derive_named E cfg B).T_h := by
   134	  induction B with
   135	  | genesis =>
   136	    simp only [NamedBlock.Preceq, NamedBlock.preceq, decide_eq_true_eq] at hAB
   137	    subst A
   138	    rfl
   139	  | node parent s root votes support rows proposer ih =>
   140	    simp only [NamedBlock.Preceq, NamedBlock.preceq, Bool.or_eq_true, decide_eq_true_eq] at hAB
   141	    rcases hAB with rfl | hparent
   142	    · rfl
   143	    · have hlow := derive_height_mono E cfg hparent
   144	      have hhigh := derive_height_mono E cfg
   145	        (named_extend s root votes support rows proposer (named_self parent))
   146	      have hparentHeight : (derive_named E cfg parent).h =
   147	          (derive_named E cfg (.node parent s root votes support rows proposer)).h := by
   148	        exact le_antisymm hhigh (hh ▸ hlow)
   149	      exact (ih hparent (hh.trans hparentHeight.symm)).trans
   150	        (node_entry_eq_of_height_eq E cfg parent s root votes support rows proposer
   151	          hparentHeight.symm).symm
