   771	`viable_tree_from` and `viable_tree`, lines 840–850, "acceptance only"): the
   772	band start is `h_max − 1`. -/
   773	def acceptViable (st : Store V) : Finset (FGBlock V) :=
   774	  st.TF.filter (fun B => FGBlock.preceq st.F B &&
   775	    decide (∃ W ∈ st.TF, FGBlock.Preceq B W ∧ st.h_max - 1 ≤ hOf E cfg W))
   776	
   777	/-- `update_finality` (spec Fig. alg:fc-full, lines 731–750). -/
   778	def update_finality (st : Store V) (B : FGBlock V) : Store V :=
   779	  let σ := derive E cfg B
   780	  let st := { st with h_max := max st.h_max σ.h }
   781	  let st := if FGBlock.preceq st.F σ.J && decide (lexKey (st.h_j, st.J) < lexKey (σ.h_j, σ.J))
   782	    then { st with J := σ.J, h_j := σ.h_j, jCarrier := B } else st
   783	  if FGBlock.preceq st.F σ.F && decide (st.F ≠ σ.F) && FGBlock.preceq σ.F st.J &&
   784	      decide (σ.F ∈ acceptViable E cfg st)
   785	    then { st with F := σ.F, fBasis := {B, st.jCarrier, witness E cfg st σ.F} }
   786	    else st
