  1192	\vspace{1pt}
  1193	\Function{height\_pair}{$\Lambda,h_c,T_c,\nu,h_f,T_f$}
  1194	  \Comment{\DC{7}, adapted: flag $\chi$}
  1195	  \If{$h_c=\bot$} \State \Return $(\bot,\bot,\bot)$
  1196	    \Comment{no fresh source}
  1197	  \EndIf
  1198	  \State $\mathit{lock}\gets\Lambda.\mathsf{lock}[h_c]$;\quad
  1199	    \textbf{if} $h_c=h_f$ \textbf{then} $\mathit{lock}\gets T_f$
  1200	  \Comment{this row's own lock}
  1201	  \If{$\Lambda.\mathsf{timeout}[h_c]$}
  1202	    \State \Return $(h_c,T_c,\mathsf{true})$
  1203	    \Comment{a timeout repeats, naming the current entry}
  1204	  \EndIf
  1205	  \If{$\mathit{lock}\neq\bot$}
  1206	    \If{$\mathit{lock}=T_c$}
  1207	      \State \Return $(h_c,T_c,\mathsf{false})$
  1208	    \EndIf
  1209	    \State \Return $(\bot,\bot,\bot)$
  1210	    \Comment{locked elsewhere: wait out the height}
  1211	  \EndIf
  1212	  \If{$\Lambda.\mathsf{target}[h_c]\neq\bot$}
  1213	    \If{$\Lambda.\mathsf{target}[h_c]=T_c$}
  1214	      \State \Return $(h_c,T_c,\mathsf{false})$
  1215	      \Comment{a recorded target repeats}
  1216	    \EndIf
  1217	  \ElsIf{not $\nu$}
  1218	    \State \Return $(h_c,T_c,\mathsf{false})$
  1219	    \Comment{no history: adopt the source's entry}
  1220	  \EndIf
  1221	  \State \Return $(h_c,T_c,\mathsf{true})$
  1222	  \Comment{otherwise time out at $h_c$}
