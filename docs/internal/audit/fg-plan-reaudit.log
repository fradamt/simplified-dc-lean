  1704	```bash
  1705	#!/usr/bin/env bash
  1706	# Checks AvailableChainKitFG/Pins.lean against docs/FG-COMPOSITION.md:
  1707	# 1) each Src hash matches its file (vc files at the pinned revision);
  1708	# 2) each Src (key, path, hash) matches the row of its key in §0.1;
  1709	# 3) each pinned id has an entry heading.
  1710	# It fails on a missing or empty input and on an empty extraction.
  1711	set -euo pipefail
  1712	cd "$(dirname "$0")/.."
  1713	ETH=/Users/francesco/ethereum
  1714	VC=$ETH/lean/decoupled-consensus/verified-consensus
  1715	REG=docs/FG-COMPOSITION.md
  1716	PINS=AvailableChainKitFG/Pins.lean
  1717	rootdir() {
  1718	  case $1 in
  1719	    tsc) echo "$ETH/research/async-resilient-committees/tip-stability/codex" ;;
  1720	    spec) echo "$ETH/research/async-resilient-committees/tip-stability/spec" ;;
  1721	    dc) echo "$ETH/research/healing/rewrite" ;;
  1722	    *) return 1 ;;
  1723	  esac
  1724	}
  1725	[ -s "$PINS" ] || { echo "MISSING OR EMPTY: $PINS"; exit 2; }
  1726	[ -s "$REG" ] || { echo "MISSING OR EMPTY: $REG"; exit 2; }
  1727	tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
  1728	tr '\n' ' ' < "$PINS" |
  1729	  { grep -o '⟨"[A-Za-z0-9]*", *"[a-z@0-9]*", *"[^"]*", *"[0-9a-f]\{64\}"⟩' || true; } |
  1730	  sed -E 's/⟨"([^"]*)", *"([^"]*)", *"([^"]*)", *"([0-9a-f]{64})"⟩/\1|\2|\3|\4/' |
  1731	  sort -u > "$tmp/srcs"
  1732	{ grep -o 'id := "[^"]*"' "$PINS" || true; } | sed 's/id := //; s/"//g' | sort -u > "$tmp/ids"
  1733	[ -s "$tmp/srcs" ] || { echo "NO SOURCES EXTRACTED"; exit 2; }
  1734	[ -s "$tmp/ids" ] || { echo "NO IDS EXTRACTED"; exit 2; }
  1735	status=0
  1736	while IFS='|' read -r key root path pinned; do
  1737	  if [[ $root == vc@* ]]; then
  1738	    actual=$(git -C "$VC" show "${root#vc@}:$path" 2>/dev/null | shasum -a 256 | cut -c1-64) ||
  1739	      { echo "MISSING FILE: $root/$path"; status=1; continue; }
  1740	  else
  1741	    dir=$(rootdir "$root") || { echo "UNKNOWN ROOT: $root"; status=1; continue; }
  1742	    [ -f "$dir/$path" ] || { echo "MISSING FILE: $root/$path"; status=1; continue; }
  1743	    actual=$(shasum -a 256 "$dir/$path" | cut -c1-64)
  1744	  fi
  1745	  [ "$pinned" = "$actual" ] ||
  1746	    { echo "CHANGED: $key $root/$path pinned $pinned actual $actual"; status=1; }
  1747	  # The row of this key in the §0.1 tables, and its continuation line.
  1748	  row=$(awk -v k="$key" '/^### 0\.1 Sources/ { s = 1 }
  1749	    s && index($0, "│ " k " ") == 1 { print; getline; print; exit }' "$REG")
  1750	  [ -n "$row" ] || { echo "KEY NOT IN §0.1: $key"; status=1; continue; }
  1751	  case $row in *"$(basename "$path")"*) ;; *) echo "PATH NOT IN §0.1 ROW: $key $path"; status=1 ;; esac
  1752	  case $row in *"${pinned:0:32}"*"${pinned:32:32}"*) ;; *) echo "HASH NOT IN §0.1 ROW: $key"; status=1 ;; esac
  1753	done < "$tmp/srcs"
  1754	while read -r id; do
  1755	  grep -q "^### \`$id\`" "$REG" || { echo "NO REGISTRY ENTRY: $id"; status=1; }
  1756	done < "$tmp/ids"
  1757	echo "checked $(wc -l < "$tmp/srcs" | tr -d ' ') sources and $(wc -l < "$tmp/ids" | tr -d ' ') ids"
  1758	exit $status
  1759	```
