   237	abbrev Height := Nat
   238	
   239	/-- The height pair of a row, bound to an entry (port: DC/DecoupledConsensusModel/Objects/NamedBlocks.lean:31–48). -/
   240	inductive NamedHeightPair where
   241	  | empty
   242	  | vote (height : Height) (entry : BlockId) (timeout : Bool)
   243	  deriving DecidableEq, Repr
   244	
   245	namespace NamedHeightPair
   246	/-- Targets and timeouts use the same height and entry match. -/
   247	def matchesEntry (height : Height) (entry : BlockId) : NamedHeightPair → Bool
   248	  | .empty => false
   249	  | .vote h target _ => decide (h = height ∧ target = entry)
   250	end NamedHeightPair
   251	
   252	/-- The finality pair `(h_f, T_f)` (port: DC/DecoupledConsensusModel/Objects/Blocks.lean:60–66). -/
   253	structure FinalityPair where
   254	  height : Height
   255	  target : BlockId
   256	  deriving DecidableEq, Repr
   257	
   258	/-- One FG row: signer, height pair, finality pair. No SG field. -/
   259	structure Row (V : Type) where
   260	  signer : V
   261	  height_pair : NamedHeightPair
   262	  finality_pair : Option FinalityPair
   263	  deriving DecidableEq, Repr
   264	
   265	/-- A block as the FG reads it. The AP maps its blocks to this type later. -/
   266	inductive FGBlock (V : Type) where
   267	  | genesis
   268	  | node (parent : FGBlock V) (slot : Slot) (root : BlockId) (rows : List (Row V))
   269	  deriving DecidableEq, Repr
   270	
   271	namespace FGBlock
   272	variable {V : Type}
   273	def slot : FGBlock V → Slot
   274	  | .genesis => 0
   275	  | .node _ s _ _ => s
   276	def root : FGBlock V → BlockId
   277	  | .genesis => genesisRoot
   278	  | .node _ _ r _ => r
   279	def parent : FGBlock V → FGBlock V
   280	  | .genesis => .genesis
   281	  | .node p _ _ _ => p
   282	def rows : FGBlock V → List (Row V)
   283	  | .genesis => []
   284	  | .node _ _ _ rs => rs
   285	
   286	variable [DecidableEq V]
   287	def preceq (A : FGBlock V) : FGBlock V → Bool
   288	  | .genesis => decide (A = .genesis)
   289	  | B@(.node p _ _ _) => decide (A = B) || preceq A p
   290	def Preceq (A B : FGBlock V) : Prop := preceq A B = true
   291	instance (A B : FGBlock V) : Decidable (Preceq A B) :=
   292	  inferInstanceAs (Decidable (preceq A B = true))
   293	def compatible (A B : FGBlock V) : Bool := preceq A B || preceq B A
   294	end FGBlock
   295	
   296	/-- The rows carried by the chain that ends at `B` (port: DC/DecoupledConsensusModel/Protocol/Evidence.lean `chain_attestations`). -/
   297	def chainRows {V : Type} [DecidableEq V] : FGBlock V → Finset (Row V)
   298	  | .genesis => ∅
   299	  | .node p _ _ rs => rs.toFinset ∪ chainRows p
   300	
   301	/-- Fixed positive weights (port: DC/DecoupledConsensusModel/Objects/Weights.lean:49–78). FG-SA uses weight 1. -/
   302	structure Electorate (V : Type) [Fintype V] where
   303	  weight : V → Nat
   304	  weight_pos : ∀ i, 0 < weight i
   305	
   306	namespace Electorate
   307	variable {V : Type} [Fintype V] [DecidableEq V]
   308	def totalWeight (E : Electorate V) : Nat := ∑ i, E.weight i
   309	def weightOf (E : Electorate V) (S : Finset V) : Nat := ∑ i ∈ S, E.weight i
   310	/-- `q = ⌈2W/3⌉`; with unit weights this is FG-SA's `q_F = (2n+2) div 3`. -/
   311	def q (E : Electorate V) : Nat := (2 * E.totalWeight + 2) / 3
   312	def IsQuorum (E : Electorate V) (S : Finset V) : Prop := E.q ≤ E.weightOf S
   313	end Electorate
   314	```
