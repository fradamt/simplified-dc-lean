    73	/-- §5.3 `Λ.lock[h] ← J` leaves every other height alone (PROTOCOL.md#the-complete-protocol). -/
    74	theorem with_lock_ne {Λ : Record} {h k : Height} {T : BlockId} (hk : k ≠ h) :
    75	    (Λ.with_lock h T).lock k = Λ.lock k := by
    76	  simp [Protocol.Record.with_lock, hk]
