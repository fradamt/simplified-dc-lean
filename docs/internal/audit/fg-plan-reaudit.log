   242	  | .empty => afterLock
   243	  | .timeout h => afterLock.with_timeout h
   244	  | .target h T => if afterLock.target h = none then afterLock.with_target h T else afterLock
   245	
   246	/-- §5.3 `create_attestation(Λ, r, confirmed, h_c, T_c, ν, h_j, J, h_F)`
   247	(PROTOCOL.md `alg:pair-rules`): the validator-client side, with
   248	**no store access**.
   249	
   250	The two pair rules, then the attestation, then the record — "record, then
   251	release". Returns the updated record beside the attestation, because `Λ` is not a
   252	store field (PROTOCOL.md `def:antislashing`). -/
   253	def create_attestation (Λ : Record) (val_index : V) (r : Round)
   254	    (confirmed : Option BlockId) (fields : Option (Height × BlockId × Bool))
   255	    (h_j : Height) (J : BlockId) (h_F : Height) :
   256	    Record × CombinedAttestation V :=
   257	  let fp := finality_pair Λ h_j J h_F
   258	  let hp := height_pair Λ fields fp
   259	  let a : CombinedAttestation V := ⟨val_index, r, confirmed, hp, fp⟩
   260	  (record_attestation Λ a, a)
   261	
   262	end Protocol
   263	end DecoupledConsensusModel
   264	end
