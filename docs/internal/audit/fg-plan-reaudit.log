   267	section
   268	/-! Named-row signing state. `Record` contains the target, timeout, and lock maps;
   269	`NamedRecord` adds the active timeout-history set. The history records timeout
   270	annotations; it never suppresses a repeated transmission or replaces a
   271	height-wide target/finality lock. -/
   272	namespace DecoupledConsensusModel.Protocol
   273	
   274	structure NamedRecord where
   275	  legacy : Record
   276	  timeoutHistory : Finset (Height × BlockId)
   277	
   278	namespace NamedRecord
   279	
   280	/-- Exact input fields supplied to the existing signing client. -/
   281	structure Input (V : Type) where
   282	  val_index : V
   283	  round : Round
   284	  confirmed : Option BlockId
   285	  fields : Option (Height × BlockId × Bool)
   286	  h_j : Height
   287	  J : BlockId
   288	  h_F : Height
   289	
   290	def initial : NamedRecord := ⟨Record.initial, ∅⟩
   291	
   292	/-- A fixed codec. The creator proves its old output agrees with these actual
   293	source fields; no receiver state or context callback participates. -/
   294	def encodeHeight (fields : Option (Height × BlockId × Bool))
   295	    (pair : HeightPair) : NamedHeightPair :=
   296	  match pair, fields with
   297	  | .empty, _ => .empty
   298	  | .target _ _, some (h, entry, _) => .vote h entry false
   299	  | .timeout _, some (h, entry, _) => .vote h entry true
   300	  | _, none => .empty
   301	
   302	def encodeRow {V : Type} (fields : Option (Height × BlockId × Bool))
   303	    (row : CombinedAttestation V) : NamedAttestation V :=
   304	  ⟨row.val_index, row.round, row.confirmed, encodeHeight fields row.height_pair,
   305	    row.finality_pair⟩
   306	
   307	/-- Set insertion is idempotent; membership is not an emission guard. -/
   308	def rememberTimeout (history : Finset (Height × BlockId)) : NamedHeightPair →
   309	    Finset (Height × BlockId)
   310	  | .vote h entry true => insert (h, entry) history
   311	  | _ => history
   312	
   313	def legacyCreate {V : Type} (record : Record) (input : Input V) :
   314	    Record × CombinedAttestation V :=
   315	  create_attestation record input.val_index input.round input.confirmed input.fields
   316	    input.h_j input.J input.h_F
   317	
   318	/-- The base client makes all pair decisions and updates its record once.
   319	The extra history records exactly the resulting named timeout pair. -/
   320	def create {V : Type} (record : NamedRecord) (input : Input V) :
   321	    NamedRecord × NamedAttestation V :=
   322	  let old := legacyCreate record.legacy input
   323	  let row := encodeRow input.fields old.2
   324	  (⟨old.1, rememberTimeout record.timeoutHistory row.height_pair⟩, row)
   325	
   326	end NamedRecord
   327	end DecoupledConsensusModel.Protocol
   328	end
