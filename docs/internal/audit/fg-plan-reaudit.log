   230	/-- `LockCompatible` is preserved by the single record writer. -/
   231	theorem lockCompatible_create_attestation {Λ : Record} (hla : LockCompatible Λ)
   232	    (val_index : V) (r : Round) (confirmed : Option BlockId)
   233	    (fields : Option (Height × BlockId × Bool)) (h_j : Height) (J : BlockId)
