   256	        · have hcond := finality_pair_record_conditions hfp
   257	          have hpX : p.target = X := by
   258	            have hol' : some p.target = some X := by
   259	              simpa [fp, hfp, own_lock, hpg] using hol
   260	            exact Option.some_inj.mp hol'
   261	          subst X
   262	          exact ⟨by simpa [hpg] using hcond.1,
   263	            by simpa [hpg] using hcond.2.1⟩
   264	        · have hol' : Λ.lock g = some X := by
   265	            simpa [fp, hfp, own_lock, hpg] using hol
   266	          exact hla g X hol'
   267	  have hne : hp ≠ HeightPair.timeout g :=
   268	    height_pair_ne_timeout_of_own_lock hpre.1 hol
