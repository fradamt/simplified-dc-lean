    68	/-- §5.3 `Λ.lock[h] ← J` reads back at `h` (PROTOCOL.md#the-complete-protocol). -/
    69	theorem with_lock_self (Λ : Record) (h : Height) (T : BlockId) :
    70	    (Λ.with_lock h T).lock h = some T := by
    71	  simp [Protocol.Record.with_lock]
