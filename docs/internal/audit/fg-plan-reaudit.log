    80	/-- **F3** as a predicate on one record (check doc §1 F3, §5.4): a lock rules
    81	out a timeout and is compatible with an empty or matching target entry.
    82	
    83	Not true of an arbitrary `Record`: the type admits a lock together with a
    84	timeout or a different target. It therefore travels as an invariant rather
    85	than as a theorem about `Record`. -/
    86	def LockCompatible (Λ : Record) : Prop :=
    87	  ∀ (h : Height) (T : BlockId), Λ.lock h = some T →
    88	    Λ.timeout h = false ∧ (Λ.target h = none ∨ Λ.target h = some T)
    89	
    90	/-- §5.3 the initial record satisfies it vacuously (PROTOCOL.md#the-complete-protocol). -/
    91	theorem lockCompatible_initial : LockCompatible Record.initial := by
    92	  intro h T hl
    93	  simp [Protocol.Record.initial] at hl
