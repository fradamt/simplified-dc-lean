   207	/-- E2 evidence at a pinned height is scoped slashability
   208	(PROTOCOL.md#the-complete-protocol): the height and the two roots are forgotten. The
   209	analogue of `Proofs.slashableBetween_of_e1EvidenceForPair`. -/
   210	theorem slashableBetween_of_e2EvidenceAtHeight {h : Height} {T₁ T₂ : BlockId}
   211	    {A₁ A₂ : Finset (CombinedAttestation V)} {i : V} (hne : T₁ ≠ T₂)
   212	    (hev : E2EvidenceAtHeight h T₁ T₂ A₁ A₂ i) : SlashableBetween A₁ A₂ i := by
   213	  obtain ⟨a, ha, b, hb, hav, hbv, hpa, hpb⟩ := hev
   214	  refine ⟨a, ha, b, hb, hav, hbv, ?_⟩
   215	  have hv : a.val_index = b.val_index := by rw [hav, hbv]
   216	  have h2 : Protocol.e2Slashable a b = true := by
   217	    simp [Protocol.e2Slashable, Protocol.sameValidator,
   218	      Protocol.e2Fields, hpa, hpb, hv, hne]
   219	  change Protocol.slashable a b = true
   220	  simp only [Protocol.slashable, h2, Bool.or_true]
   221	
   222	/-- The aggregated conversion (PROTOCOL.md#the-complete-protocol). -/
   223	theorem hasSlashableWeightBetween_of_hasE2WeightAt {E : Env V} {h : Height}
   224	    {T₁ T₂ : BlockId} {A₁ A₂ : Finset (CombinedAttestation V)} (hne : T₁ ≠ T₂)
   225	    (hev : HasE2WeightAt E h T₁ T₂ A₁ A₂) : HasSlashableWeightBetween E A₁ A₂ := by
   226	  obtain ⟨S, hw, hE⟩ := hev
   227	  exact ⟨S, hw, fun i hi => slashableBetween_of_e2EvidenceAtHeight hne (hE i hi)⟩
   228	
   229	/-- **Lemma U** (rev. 3 §1.3; PROTOCOL.md#the-complete-protocol): two target quorums at one
   230	height for **different** roots expose `2q − W` of E2 weight, at that height,
   231	against those two roots.
   232	
   233	Hence *"absent `2q − W` of E2-slashable weight, at most one target is justified
   234	at any height, on any chain, anywhere in the run"* — and hence the lex tiebreak
   235	on `(h_j, J.root)` never arbitrates between two real certificates
   236	(`Finality.lean:52–70`, rev. 3 §1.3): the root component separates only events
   237	at the same height, and by this lemma two real justifications never share one.
   238	
   239	Nothing about chains, stores or reachability enters. The quorums are abstract
   240	sets with per-member witnesses drawn one from each attestation pool, which is the
   241	same evidence discipline `SlashableBetween` uses — the pool a witness comes
   242	from is named, never existentially closed. -/
   243	theorem justification_unique_per_height (E : Env V)
   244	    {A₁ A₂ : Finset (CombinedAttestation V)} {Q₁ Q₂ : Finset V} {h : Height}
   245	    {T₁ T₂ : BlockId}
   246	    (hQ₁ : E.electorate.IsQuorum Q₁) (hQ₂ : E.electorate.IsQuorum Q₂)
   247	    (hw₁ : ∀ i ∈ Q₁, ∃ a ∈ A₁, a.val_index = i ∧ a.height_pair = .target h T₁)
   248	    (hw₂ : ∀ i ∈ Q₂, ∃ b ∈ A₂, b.val_index = i ∧ b.height_pair = .target h T₂) :
   249	    HasE2WeightAt E h T₁ T₂ A₁ A₂ := by
   250	  refine ⟨Q₁ ∩ Q₂, quorum_intersection E hQ₁ hQ₂, ?_⟩
   251	  intro i hi
   252	  obtain ⟨hi₁, hi₂⟩ := Finset.mem_inter.mp hi
   253	  obtain ⟨a, ha, hav, hpa⟩ := hw₁ i hi₁
   254	  obtain ⟨b, hb, hbv, hpb⟩ := hw₂ i hi₂
   255	  exact ⟨a, ha, b, hb, hav, hbv, hpa, hpb⟩
   256	
   257	/-- **Lemma U**, in `Props`' own evidence vocabulary (PROTOCOL.md#the-complete-protocol):
   258	two conflicting justifications at one height are `2q − W` of slashable weight
   259	between the two pools. This is the form P5's lex-tiebreak argument (rev. 3 §1.3,
   260	scenario S4) cites. -/
   261	theorem justification_unique_per_height_slashable (E : Env V)
   262	    {A₁ A₂ : Finset (CombinedAttestation V)} {Q₁ Q₂ : Finset V} {h : Height}
   263	    {T₁ T₂ : BlockId} (hne : T₁ ≠ T₂)
   264	    (hQ₁ : E.electorate.IsQuorum Q₁) (hQ₂ : E.electorate.IsQuorum Q₂)
   265	    (hw₁ : ∀ i ∈ Q₁, ∃ a ∈ A₁, a.val_index = i ∧ a.height_pair = .target h T₁)
   266	    (hw₂ : ∀ i ∈ Q₂, ∃ b ∈ A₂, b.val_index = i ∧ b.height_pair = .target h T₂) :
   267	    HasSlashableWeightBetween E A₁ A₂ :=
   268	  hasSlashableWeightBetween_of_hasE2WeightAt hne
   269	    (justification_unique_per_height E hQ₁ hQ₂ hw₁ hw₂)
   270	
   271	end Engine
   272	end Proofs
   273	end DecoupledConsensusModel
