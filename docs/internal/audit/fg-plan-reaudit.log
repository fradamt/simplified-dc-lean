   788	/-- `on_block`, FG part (spec lines 675–700). The block enters the raw tree.
   789	It enters the admitted tree, and `update_finality` runs, only if `F ⪯ B` (FG
   790	admission, spec line 695). Block validity (signature, parent in `T`, slot
   791	order, row rounds) is the AP's. -/
   792	def on_block (st : Store V) (B : FGBlock V) : Store V :=
   793	  let st := { st with T := insert B st.T }
   794	  if FGBlock.preceq st.F B then update_finality E cfg { st with TF := insert B st.TF } B
   795	  else st
   796	
   797	/-- COMPARISON OBJECT, not a spec object: the fj rule on the cached J, h_j and
   798	h_max over TF. Only `cacheFrame_eq_fjFrame` uses it. -/
   799	def cacheFrame (st : Store V) : Frame V :=
   800	  let H := st.h_max
   801	  let contest := decide (H = st.h_j + 1) &&
   802	    decide (∃ W ∈ st.TF, hOf E cfg W = H ∧ ¬ FGBlock.Preceq st.J W)
   803	  let Z := if H = st.h_j + 1 ∧ contest = false then st.J else st.F
   804	  let lo := if contest then H else H - 1
   805	  let D := st.TF.filter (fun B => FGBlock.preceq st.F B && FGBlock.preceq Z B &&
   806	    decide (∃ W ∈ st.TF, FGBlock.Preceq B W ∧ lo ≤ hOf E cfg W))
   807	  ⟨st.F, H, st.h_j, st.J, Z, lo, D, contest⟩
