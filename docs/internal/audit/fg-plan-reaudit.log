# Client safety for one height. State=(target,timeout,lock); sources are entry fields.
def create(rec,source,head):
    target,timeout,lock=rec
    fp=head if head is not None and target in (None,head) and not timeout and lock in (None,head) else None
    own=fp if fp is not None else lock
    if source is None:hp=None
    elif timeout:hp=(source,True)
    elif own is not None:hp=(source,False) if own==source else None
    elif target is not None:hp=(source,target"'!=source)
    else:hp=(source,False)
    new=(target if target is not None else (hp[0] if hp is not None and not hp[1] else None), timeout or (hp is not None and hp[1]), fp if fp is not None else lock)
    return new,(hp,fp)
def inv(rec):
    target,timeout,lock=rec
    return lock is None or (not timeout and target in (None,lock))
def slash(a,b):
    ah,af=a;bh,bf=b
    def conflict(fp,hp):return fp is not None and hp is not None and (hp[1] or fp!=hp[0])
    return conflict(af,bh) or conflict(bf,ah) or (ah is not None and bh is not None and not ah[1] and not bh[1] and ah[0]!=bh[0])
vals=[None,0,7]
cases=0
for rec in product(vals,[False,True],vals):
    if not inv(rec):continue
    for src,head in product(vals,vals):
        nr,row=create(rec,src,head)
        assert inv(nr) and not slash(row,row)
        cases+=1
print('"'\\''client per-height preservation/self-slash cases:'\\'',cases)
