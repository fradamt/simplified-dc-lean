    if b.p is None:return St()
    st=derive(b.p,delay)
    tar=set(st.targets); pro=set(st.progress); fin=set(st.finals)
    for a in b.rows:
        if st.j>st.f and a.fp==(st.j,st.J.root):fin.add(a.signer)
        if a.hp is not None and a.hp[:2]==(st.h,st.entry.root):
            pro.add(a.signer)
            if not a.hp[2]:tar.add(a.signer)
    st=replace(st,targets=frozenset(tar),progress=frozenset(pro),finals=frozenset(fin))
    if st.j>st.f and len(fin)>=3:st=replace(st,f=st.j,F=st.J)
    if len(tar)>=3:
        return replace(st,j=st.h,J=st.entry,finals=frozenset(),h=st.h+1,entry=b,targets=frozenset(),progress=frozenset())
    if len(pro)>=3 and b.slot>=st.entry.slot+delay:
        return replace(st,h=st.h+1,entry=b,targets=frozenset(),progress=frozenset())
    return st
def frame(f,view):
    H=max([1]+[derive(b).h for b in view])
    candidates={(derive(b).j,derive(b).J) for b in view if pre(f,derive(b).J)}
    top=max([(j,J.root) for j,J in candidates],default=(0,0))
    winners=[(j,J) for j,J in candidates if (j,J.root)==top]
    j,J=winners[0] if len(winners)==1 else (0,g)
    contest=H==j+1 and any(derive(b).h==H and not pre(J,b) for b in view)
    z=J if H==j+1 and not contest else f
    lo=H if contest else H-1
    D={b for b in view if pre(f,b) and pre(z,b) and any(pre(b,w) and derive(w).h>=lo for w in view)}
    return H,j,J,contest,z,lo,D
def rows(h,entry,timeout=False,fp=None):return tuple(Row(i,(h,entry,timeout),fp) for i in range(3))
b1=Block(g,1,1,rows(1,0))
