   206	theorem record_attestation_timeout_false_of_ne {Λ : Record}
   207	    (a : CombinedAttestation V) {h : Height}
   208	    (hpre : Λ.timeout h = false)
   209	    (hne : a.height_pair ≠ HeightPair.timeout h) :
   210	    (record_attestation Λ a).timeout h = false := by
   211	  cases hhp : a.height_pair with
   212	  | empty =>
   213	      cases hfp : a.finality_pair <;>
   214	        simpa [record_attestation, hhp, hfp, Record.with_lock] using hpre
   215	  | timeout g =>
   216	      have hgh : g ≠ h := by
   217	        intro heq
   218	        subst g
   219	        exact hne hhp
   220	      have hhg : h ≠ g := Ne.symm hgh
   221	      cases hfp : a.finality_pair <;>
   222	        simpa [record_attestation, hhp, hfp, Record.with_lock,
   223	          Record.with_timeout, hhg] using hpre
   224	  | target g X =>
   225	      cases hfp : a.finality_pair <;>
   226	        simp only [record_attestation, hhp, hfp] <;> split <;>
   227	          simpa [Record.with_lock, Record.with_target] using hpre
