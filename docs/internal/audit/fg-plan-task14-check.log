     1	import AvailableChainSimplexFG
     2	import AvailableChainKitFG
     3	import Lean.Util.CollectAxioms
     4	open Lean
     5	
     6	/-! FG axiom check. Every compiled constant of the modules of
     7	`AvailableChainSimplexFG` and `AvailableChainKitFG` may depend only on
     8	`propext`, `Classical.choice` and `Quot.sound`. This rejects `sorryAx`,
     9	`Lean.ofReduceBool` (from `native_decide`) and project axioms.
    10	
    11	Run: `lake env lean --run scripts/CheckFGAxioms.lean [--expect N …]`.
    12	With `--expect`, each named constant must be a checked constant (a short
    13	name matches a qualified one by suffix).
    14	Exit codes: 0 clean; 1 a bad axiom; 2 nothing found or an expected name
    15	missing. -/
    16	
    17	def allowed : List Name := [``propext, ``Classical.choice, ``Quot.sound]
    18	
    19	def inFG (env : Environment) (n : Name) : Bool :=
    20	  match env.getModuleIdxFor? n with
    21	  | some idx =>
    22	      let m := env.header.moduleNames[idx.toNat]!
    23	      (`AvailableChainSimplexFG).isPrefixOf m || (`AvailableChainKitFG).isPrefixOf m
    24	  | none => false
    25	
    26	/-- The axioms `n` transitively depends on. Uses the `Core.CoreM.toIO'`
    27	pattern of `scripts/Registry.lean`: the toolchain's `CollectAxioms` API is
    28	called through `Lean.Util.CollectAxioms`'s `collectAxioms` in `CoreM`. -/
    29	def axiomsOf (env : Environment) (n : Name) : IO (Array Name) :=
    30	  Core.CoreM.toIO' (collectAxioms n)
    31	    { fileName := "CheckFGAxioms", fileMap := .ofString "" } { env := env }
    32	
    33	def main (args : List String) : IO UInt32 := do
    34	  initSearchPath (← findSysroot)
    35	  let env ← importModules
    36	    #[{ module := `AvailableChainSimplexFG }, { module := `AvailableChainKitFG }] {}
    37	  let cs := env.constants.toList.filter (fun (n, _) => inFG env n)
    38	  if cs.isEmpty then
    39	    IO.eprintln "NO CONSTANTS FOUND"
    40	    return 2
    41	  let thms := cs.filterMap fun (n, ci) => if ci matches .thmInfo _ then some n else none
    42	  let mut status : UInt32 := 0
    43	  for (n, _) in cs do
    44	    let axs ← axiomsOf env n
    45	    let bad := axs.filter (fun a => !allowed.contains a)
    46	    unless bad.isEmpty do
    47	      IO.println s!"BAD AXIOMS {n}: {bad}"
    48	      status := 1
    49	  if let "--expect" :: names := args then
    50	    for s in names do
    51	      unless cs.any (fun (n, _) => s.toName.isSuffixOf n) do
    52	        IO.println s!"NOT CHECKED: {s}"
    53	        status := 2
    54	  IO.println s!"checked {cs.length} constants, {thms.length} theorems"
    55	  return status
