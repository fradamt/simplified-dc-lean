  2059	/-- The manifest that `scripts/check-fg-pins.sh` checks, from the elaborated
  2060	values (Astra P01, Q01–Q03), one item per line: `src <key> <root> <path>
  2061	<sha256>` for each source of the pins and `defPins` (without duplicates),
  2062	`pin <id>`, `ap <id>` and `external <id>` for each active reference, and
  2063	`notFormalized <id>` for each historical entry. The last line is the trailer
  2064	`END src=<n> pin=<n> ap=<n> external=<n> notFormalized=<n>`. -/
  2065	def emitManifest (ps : List Pin) (ds : List DefPin) (nf : List (String × String)) :
  2066	    IO Unit := do
  2067	  let srcs := (ps.flatMap (·.sources) ++ ds.map (·.src)).eraseDups
  2068	  let refs := ps.flatMap fun p => p.clauses.filterMap fun c =>
  2069	    match c.cov with
  2070	    | .ap i _ => some ("ap", i)
  2071	    | .external i _ => some ("external", i)
  2072	    | _ => none
  2073	  for s in srcs do IO.println s!"src {s.key} {s.root} {s.path} {s.sha256}"
  2074	  for p in ps do IO.println s!"pin {p.id}"
  2075	  for (t, i) in refs do IO.println s!"{t} {i}"
  2076	  for (i, _) in nf do IO.println s!"notFormalized {i}"
  2077	  let n (t : String) := (refs.filter (·.1 == t)).length
  2078	  IO.println (s!"END src={srcs.length} pin={ps.length} ap={n "ap"} " ++
  2079	    s!"external={n "external"} notFormalized={nf.length}")
  2080	
  2081	/-- Every Lean name of the table (the pins, `defPins` and `helpers`), without
  2082	duplicates, for the axiom check of Step 3. -/
  2083	def pinNames (ps : List Pin) (ds : List DefPin) (hs : List Lean.Name) : List Lean.Name :=
  2084	  (ps.flatMap fun p => p.clauses.flatMap fun c =>
  2085	    match c.cov with
  2086	    | .lean ns => ns
  2087	    | .leanHyp ns _ => ns
  2088	    | _ => []) ++ ds.map (·.lean) ++ hs |>.eraseDups
  2089	```
