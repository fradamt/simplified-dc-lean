  2110	```bash
  2111	#!/usr/bin/env bash
  2112	# Checks the ELABORATED pin table of AvailableChainKitFG/Pins.lean against
  2113	# docs/FG-COMPOSITION.md. It reads only the manifest that
  2114	# scripts/FGPinIds.lean prints (never the Lean text):
  2115	#   src <key> <root> <path> <sha256>, pin <id>, ap <id>, external <id>,
  2116	#   notFormalized <id>, and the last line
  2117	#   END src=<n> pin=<n> ap=<n> external=<n> notFormalized=<n>.
  2118	# 0) the manifest is complete: every line is well formed, the trailer is the
  2119	#    last line and occurs once, each count equals the number of lines with
  2120	#    its tag, and there is at least one src and one pin (else exit 2);
  2121	# 1) each src resolves to its REGISTERED version (tsc/: the archive copy by
  2122	#    hash; spec: the archived file; vc and dc: the registered Git commit), and
  2123	#    that version has the pinned hash;
  2124	# 2) each src (key, path, hash) is exactly the row of its key in the §0.1
  2125	#    tables (a continuation line counts only when its key column is blank);
  2126	# 3) each id is, literally, the id of an entry heading;
  2127	# 4) each id has exactly one row in the "## Index" table, and for pin, ap and
  2128	#    external ids the status there does not start with SUPERSEDED.
  2129	#    notFormalized ids are historical and are exempt from the status test.
  2130	# OUT=<file> reads a saved manifest instead of running FGPinIds (tests).
  2131	set -euo pipefail
  2132	cd "$(dirname "$0")/.."
  2133	ETH=/Users/francesco/ethereum
  2134	REG=docs/FG-COMPOSITION.md
  2135	resolve() {  # root path pinned-hash -> sha256 of the registered version
  2136	  local root=$1 path=$2 h=$3 f
  2137	  case $root in
  2138	    tsc) f="$ETH/research/async-resilient-committees/tip-stability/codex/archive/${path%.*}-${h:0:8}.${path##*.}"
  2139	         [ -f "$f" ] || return 1; shasum -a 256 "$f" | cut -c1-64 ;;
  2140	    spec) f="$ETH/research/async-resilient-committees/tip-stability/spec/$path"
  2141	          [ -f "$f" ] || return 1; shasum -a 256 "$f" | cut -c1-64 ;;
  2142	    vc@*) git -C "$ETH/lean/decoupled-consensus/verified-consensus" show "${root#vc@}:$path" 2>/dev/null |
  2143	            shasum -a 256 | cut -c1-64 ;;
  2144	    research@*) git -C "$ETH/research" show "${root#research@}:$path" 2>/dev/null |
  2145	            shasum -a 256 | cut -c1-64 ;;
  2146	    *) return 1 ;;
  2147	  esac
  2148	}
  2149	[ -s "$REG" ] || { echo "MISSING OR EMPTY: $REG"; exit 2; }
  2150	tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
  2151	if [ -n "${OUT:-}" ]; then
  2152	  [ -s "$OUT" ] || { echo "MISSING OR EMPTY: $OUT"; exit 2; }
  2153	  cp "$OUT" "$tmp/out"
  2154	else
  2155	  lake env lean --run scripts/FGPinIds.lean > "$tmp/out" ||
  2156	    { echo "FGPinIds FAILED (build AvailableChainKitFG first)"; exit 2; }
  2157	fi
  2158	# 0) Completeness: the trailer and the counts.
  2159	last=$(tail -n 1 "$tmp/out")
  2160	printf '%s\n' "$last" |
  2161	  grep -Eq '^END src=[0-9]+ pin=[0-9]+ ap=[0-9]+ external=[0-9]+ notFormalized=[0-9]+$' ||
  2162	  { echo "NO END TRAILER (truncated manifest)"; exit 2; }
  2163	[ "$(grep -c '^END' "$tmp/out")" -eq 1 ] || { echo "MORE THAN ONE END LINE"; exit 2; }
  2164	sed '$d' "$tmp/out" > "$tmp/body"
  2165	bad=$(grep -Ev '^(src [A-Za-z0-9]+ [^ ]+ [^ ]+ [0-9a-f]{64}|(pin|ap|external|notFormalized) [^ ]+)$' \
  2166	  "$tmp/body" || true)
  2167	[ -z "$bad" ] || { echo "MALFORMED LINE: $(printf '%s\n' "$bad" | head -1)"; exit 2; }
  2168	for tag in src pin ap external notFormalized; do
  2169	  want=$(printf '%s\n' "$last" | tr ' ' '\n' | awk -F= -v t="$tag" '$1 == t { print $2 }')
  2170	  have=$(grep -c "^$tag " "$tmp/body" || true)
  2171	  [ "$want" -eq "$have" ] || { echo "COUNT MISMATCH: $tag trailer $want lines $have"; exit 2; }
  2172	done
  2173	nsrc=$(grep -c '^src ' "$tmp/body" || true)
  2174	npin=$(grep -c '^pin ' "$tmp/body" || true)
  2175	[ "$nsrc" -gt 0 ] && [ "$npin" -gt 0 ] || { echo "EMPTY TABLE: $nsrc sources, $npin pins"; exit 2; }
  2176	dup=$(awk '$1 == "pin" { print $2 }' "$tmp/body" | sort | uniq -d)
  2177	[ -z "$dup" ] || { echo "DUPLICATE PIN IDS: $dup"; exit 2; }
  2178	awk '$1 == "src" { print $2 "|" $3 "|" $4 "|" $5 }' "$tmp/body" > "$tmp/srcs"
  2179	awk '$1 != "src"' "$tmp/body" | sort -u > "$tmp/ids"
  2180	status=0

exec
/bin/zsh -lc "nl -ba docs/plans/2026-09-28-fg-module.md | sed -n '2180,2350p'; git diff fc63dc7 HEAD -- docs/plans/2026-09-28-fg-module.md | sed -n '90,360p'" in /Users/francesco/ethereum/lean/available-chain
 succeeded in 0ms:
  2180	status=0
  2181	while IFS='|' read -r key root path pinned; do
  2182	  actual=$(resolve "$root" "$path" "$pinned") ||
  2183	    { echo "MISSING REGISTERED VERSION: $key $root $path"; status=1; continue; }
  2184	  [ "$pinned" = "$actual" ] ||
  2185	    { echo "CHANGED: $key $root/$path pinned $pinned actual $actual"; status=1; }
  2186	  # The exact §0.1 row of this key, plus a continuation line (blank key column).
  2187	  rows=$(awk -v k="$key" '/^### 0\.1 Sources/ { s = 1; next } /^### 0\.2/ { exit }
  2188	    s && index($0, "│ " k " ") == 1 { n++ } END { print n + 0 }' "$REG")
  2189	  [ "$rows" -eq 1 ] || { echo "KEY NOT EXACTLY ONCE IN §0.1: $key ($rows)"; status=1; continue; }
  2190	  row=$(awk -v k="$key" '/^### 0\.1 Sources/ { s = 1; next } !s { next }
  2191	    found { if ($0 ~ /^│ +│/) print; exit }
  2192	    index($0, "│ " k " ") == 1 { print; found = 1 }' "$REG")
  2193	  case $row in *"$(basename "$path")"*) ;; *) echo "PATH NOT IN §0.1 ROW: $key $path"; status=1 ;; esac
  2194	  case $row in *"${pinned:0:32}"*"${pinned:32:32}"*) ;; *) echo "HASH NOT IN §0.1 ROW: $key"; status=1 ;; esac
  2195	done < "$tmp/srcs"
  2196	while read -r tag id; do
  2197	  awk -v id="$id" 'index($0, "### `" id "` ") == 1 { f = 1 } END { exit !f }' "$REG" ||
  2198	    { echo "NO REGISTRY ENTRY: $tag $id"; status=1; }
  2199	  # The id's row in the Index table (from "## Index" to the next "## ").
  2200	  idx=$(awk -v id="$id" '/^## Index/ { s = 1; next } /^## / { s = 0 }
  2201	    s && index($0, "│ " id " ") == 1' "$REG")
  2202	  n=$(printf '%s' "$idx" | grep -c '^│' || true)
  2203	  [ "$n" -eq 1 ] || { echo "ID NOT EXACTLY ONCE IN INDEX: $tag $id ($n)"; status=1; continue; }
  2204	  [ "$tag" != notFormalized ] || continue
  2205	  st=$(printf '%s\n' "$idx" | awk -F'│' '{ gsub(/^ +| +$/, "", $4); print $4 }')
  2206	  case $st in SUPERSEDED*) echo "SUPERSEDED: $tag $id ($st)"; status=1 ;; esac
  2207	done < "$tmp/ids"
  2208	nref=$(grep -Ec '^(ap|external) ' "$tmp/ids" || true)
  2209	nhist=$(grep -c '^notFormalized ' "$tmp/ids" || true)
  2210	echo "checked $nsrc sources, $npin pin ids, $nref active references and $nhist historical ids"
  2211	exit $status
  2212	```
