    13	/-- A scheduler event at a node: its local clock tick, or the delivery of one object. -/
    14	inductive Event (V Object : Type) where
    15	  | tick (v : V) (t : Time)
    16	  | deliver (v : V) (object : Object) (t : Time)
    17	  deriving DecidableEq
    18	
    19	namespace Event
    20	variable {V Object : Type}
    21	def time : Event V Object → Time
    22	  | .tick _ t => t
    23	  | .deliver _ _ t => t
    24	def node : Event V Object → V
    25	  | .tick v _ => v
    26	  | .deliver v _ _ => v
    27	def object? : Event V Object → Option Object
    28	  | .tick _ _ => none
    29	  | .deliver _ object _ => some object
    30	def phase : Event V Object → Nat
    31	  | .tick _ _ => 0
    32	  | .deliver _ _ _ => 1
    33	/-- Event order is lexicographic by time and phase. Ticks therefore precede
    34	deliveries at the same time; equal-phase deliveries keep their list order. -/
    35	def key (e : Event V Object) : Lex (Time × Nat) := toLex (e.time, e.phase)
    36	end Event
