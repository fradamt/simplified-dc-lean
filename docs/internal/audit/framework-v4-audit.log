    38	/-- A committee protocol with `n` seats per label.
    39	
    40	The type mentions no validator, so honest code has no identity, no key, and
    41	one shared initial state. Honest code decides payloads; the engine signs them
    42	(`Run.emittedAt`). The state changes only through `clock` and `process`:
    43	emitting never changes the state, and a node receives its own objects only by
    44	delivery. So a node does not know its seats, and it can use only what a node
    45	that was not sampled can also compute. -/
    46	structure ProtocolSpec (n : Nat) where
    47	  State : Type
    48	  /-- Duty labels. Every label has its own committee of `n` seats. -/
    49	  Label : Type
    50	  /-- What honest code sends. A payload can carry signed objects. -/
    51	  Payload : Type
    52	  init : State
    53	  /-- The local clock update, at every tick, awake or asleep. -/
    54	  clock : State → Time → State
    55	  /-- The act time of a label. A seat of the label signs only at this time.
    56	  Duties at the same instant can share one label and one payload. -/
    57	  actTime : Label → Time
    58	  /-- The labels due at a time: those with that act time, each once. -/
    59	  duties : Time → List Label
    60	  duties_spec : ∀ ℓ t, ℓ ∈ duties t ↔ actTime ℓ = t
    61	  duties_nodup : ∀ t, (duties t).Nodup
    62	  /-- The payload of every seat of label `ℓ` in this state. It does not
    63	  depend on the seat. -/
    64	  act : State → Label → Option Payload
    65	  /-- The proposal schedule. The proposer of a slot is run data. -/
    66	  proposalTime : Slot → Time
    67	  /-- The slots whose proposal time is a time, each once. -/
    68	  slotsAt : Time → List Slot
