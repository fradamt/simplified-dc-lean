     3	public import DecoupledConsensusStatements.Generic.Regimes
     4	
     5	@[expose] public section
     6	
     7	/-!
     8	# Generic claims
     9	
    10	Purpose: bundle the public output-order, safety, liveness, finality, and outage
    11	claims into the review contract.
    12	An auditor checks the unconditional fields, the premise-to-field mapping, and
    13	the exact conclusion record for each protocol result.
    14	
    15	Defines: `AvailableAt`, `FinalizedAt`, and `Consensus`.
    16	Read after: `Properties` and `Regimes`.
    17	Read next: `DecoupledConsensusStatements.Instantiation`.
    18	-/
    19	
    20	namespace DecoupledConsensusModel.Statements.Generic
    21	
    22	open DecoupledConsensusModel
    23	
    24	variable {V : Type} {P : DecoupledConsensusModel.Generic.ProtocolSpec V}
    25	  [DecidableEq V] [_root_.Fintype V]
    26	
    27	/-- Available outputs from `t₀`; inclusion needs no recurrence: an honest
    28	proposal is confirmed by everyone within `confirmationDelay`, and is in
    29	everyone's stable chain within `stableInclusionDelay`. -/
    30	structure AvailableAt (P : DecoupledConsensusModel.Generic.ProtocolSpec V)
    31	    (I : Interface P) (C : Constants)
    32	    (rho : DecoupledConsensusModel.Generic.Run V P.Object) (t₀ : Time) : Prop where
    33	  confirmedSafe : SafeFrom P rho I.confirmed t₀
    34	  confirmedIncluded : IncludedFrom P I rho I.confirmed t₀ C.confirmationDelay
    35	  stableSafe : SafeFrom P rho I.stable t₀
    36	  stableIncluded : IncludedFrom P I rho I.stable t₀ C.stableInclusionDelay
    37	
    38	/-- The finalized output from the end of the startup. -/
    39	structure FinalizedAt (P : DecoupledConsensusModel.Generic.ProtocolSpec V)
    40	    (I : Interface P) (C : Constants)
    41	    (rho : DecoupledConsensusModel.Generic.Run V P.Object) (t₁ : Time) (gap : Nat) : Prop where
    42	  finalizedIncluded : IncludedFrom P I rho I.finalized t₁ (C.finalityDeadline gap)
    43	  finalizedLive : LiveFrom P I rho I.finalized t₁
    44	    ((gap : Time) * C.period + C.finalityDeadline gap)
    45	
    46	/-- The generic consensus bundle: each field has one named regime premise and one named
    47	conclusion record or output predicate. -/
    48	structure Consensus
    49	    (P : DecoupledConsensusModel.Generic.ProtocolSpec V)
    50	    (E : DecoupledConsensusModel.Generic.Env V) (I : Interface P) (C : Constants) : Prop where
    51	  /-- The constants satisfy the stated timing and bound constraints. -/
    52	  constants : C.Valid
    53	  /-- No premise. -/
    54	  nested : ∀ rho, OutputOrder P I rho
    55	  /-- No run premise. -/
    56	  certificatesAccountable : ∀ c c' T T', I.collisionFree c c' → I.finalizes c T → I.finalizes c' T' →
    57	    Block.Compatible T T' ∨ I.evidence c c'
    58	  /-- Well-formed run. -/
    59	  finalizedAccountable : ∀ rho, RunWellFormed E I rho → AccountablySafeFrom P I rho I.finalized 0
    60	  /-- Well-formed run: each honest node's finalized reads only extend. -/
    61	  finalizedMonotone : ∀ rho, RunWellFormed E I rho → MonotoneFrom P rho I.finalized 0
    62	  /-- Unforgeable run. -/
    63	  honestNeverSlashed : ∀ rho, UnforgeableRun P E I rho → ∀ v ∈ rho.honest, ¬ I.slashes rho v
    64	  /-- Accountable regime. -/
    65	  finalizedSafe : ∀ rho, AccountableRegime E I rho → AgreeFrom P rho I.finalized 0
    66	  /-- Sleepy regime. -/
    67	  available : ∀ rho t₀, SleepyRegime P E I C rho t₀ → AvailableAt P I C rho t₀
    68	  confirmedLive : ∀ rho t₀ gap, LiveSleepyRegime P E I C rho t₀ gap →
    69	    LiveFrom P I rho I.confirmed t₀ (C.growthDelay gap)
    70	  stableLive : ∀ rho t₀ gap, LiveSleepyRegime P E I C rho t₀ gap →
    71	    LiveFrom P I rho I.stable t₀ (C.stableGrowthDelay gap)
    72	  /-- Fresh sleepy regime: stable inclusion without the window lag. -/
    73	  stableIncludedFast : ∀ rho t₀, FreshSleepyRegime P E I C rho t₀ →
    74	    IncludedFrom P I rho I.stable t₀ C.fastStableInclusionDelay
    75	  /-- Finality regime. -/
    76	  finalized : ∀ rho t₀ gap, FinalityRegime P E I C rho t₀ gap →
    77	    FinalizedAt P I C rho (t₀ + C.finalityStartup gap) gap
    78	  /-- Outage regime. -/
    79	  stableAsynchronyResilient : ∀ rho T b₀ b₁, OutageRegime P E I C rho T b₀ b₁ →
    80	    PersistsFrom P rho I.stable T b₀
    81	
    82	end DecoupledConsensusModel.Statements.Generic
    83	
    84	end
   180	def BelowOneThird (E : DecoupledConsensusModel.Generic.Env V) (H : Finset V) : Prop :=
   181	  3 * E.electorate.weightOf (Finset.univ \ H) < E.electorate.totalWeight
   182	
   183	/-- Fresh majority (outage participation, time form): the honest weight awake
   184	at `t − lag` (the fresh validators) outweighs the faulty weight plus the stale
   185	honest weight, i.e. honest validators awake somewhere in `[t − window,
   186	t − lag)` but not at `t − lag`. -/
   187	def FreshMajority (E : DecoupledConsensusModel.Generic.Env V) (H : Finset V)
   188	    (C : Constants) (t : Time) : Prop :=
   189	  E.electorate.weightOf
   190	      ((Finset.univ \ H) ∪
   191	        (awakeIn E H (t - C.participationWindow) (t - C.participationLag) \
   192	          awakeAt E H (t - C.participationLag))) <
   193	    E.electorate.weightOf (awakeAt E H (t - C.participationLag))
   194	
   195	/-- Every slot committee has a strict honest majority by count. -/
   196	def HonestCommittees (I : Interface P) (H : Finset V) : Prop :=
   197	  ∀ s : Slot, (I.committee s).card < 2 * ((I.committee s) ∩ H).card
   198	
   199	/-- The opening slot `s` and the following `proposerSlots − 1` slots all have
   200	honest proposers. -/
   201	def MultiProposerAt (I : Interface P) (C : Constants) (H : Finset V) (s : Slot) : Prop :=
   202	  I.opening s ∧ ∀ k < C.proposerSlots, I.proposer (s + k) ∈ H
   203	
   204	/-- Tier 1, single-proposer recurrence: from `t₀`, every trigger time whose `gap`-period
   205	window ends inside the run sees an honest proposal strictly after it and within
   206	the window. Confirmed growth needs nothing more. -/
   207	def SingleProposerRecurrence (I : Interface P) (C : Constants)
   208	    (rho : DecoupledConsensusModel.Generic.Run V P.Object) (t₀ : Time) (gap : Nat) : Prop :=
   209	  ∀ t : Time, t₀ ≤ t → t + gap * C.period ≤ rho.horizon →
   210	    ∃ s, t < I.proposalTime s ∧ I.proposalTime s ≤ t + gap * C.period ∧
   211	      I.proposer s ∈ rho.honest
   212	
   213	/-- Tier 2, multi-proposer recurrence: within `gap` periods of every time from
   214	`start` a multi-proposer window starts: an opening slot and the following
   215	`proposerSlots − 1` slots all have honest proposers; recovery uses it.
   216	Only windows from `start` that end inside the run count. -/
   217	def MultiProposerRecurrence (I : Interface P) (C : Constants)
   218	    (rho : DecoupledConsensusModel.Generic.Run V P.Object) (start : Time) (gap : Nat) : Prop :=
   219	  ∀ t : Time, start ≤ t → t + gap * C.period ≤ rho.horizon → ∃ s, t < I.proposalTime s ∧
   220	    I.proposalTime s ≤ t + gap * C.period ∧
