     5	
     6	/-!
     7	# Generic regimes
     8	
     9	Purpose: bundle the atomic conditions into the named regimes used by the
    10	generic result claims.
    11	An auditor checks that each regime exposes its exact premises and that no
    12	proof theorem is hidden in a regime constructor.
    13	
    14	Defines: `AgreesUntil`, `Continues`, `BFTRegime`, `RecoveryRegime`,
    15	`RecoveredBy`, `AccountableRegime`, `SleepyRegime`, `LiveSleepyRegime`,
    16	`FreshSleepyRegime`, `FinalityRegime`, and `OutageRegime`.
    17	Read after: `Conditions`.
    18	Read next: `Claims`.
    19	-/
    20	
    21	namespace DecoupledConsensusModel.Statements.Generic
    22	
    23	open DecoupledConsensusModel
    24	
    25	variable {V : Type} {P : DecoupledConsensusModel.Generic.ProtocolSpec V}
    26	  [DecidableEq V] [_root_.Fintype V]
    27	
    28	/-- A continuation preserves retained honest validators' event prefixes. -/
    29	structure AgreesUntil
    30	    (rho rho' : DecoupledConsensusModel.Generic.Run V P.Object)
    31	    (cutoff : Time) : Prop where
    32	  honest_subset : rho'.honest ⊆ rho.honest
    33	  events : ∀ v ∈ rho'.honest,
    34	    rho'.events.filter (fun e => decide (e.node = v ∧ e.time < cutoff)) =
    35	      rho.events.filter (fun e => decide (e.node = v ∧ e.time < cutoff))
    36	
    37	/-- A continuation agrees before `cut` and reaches `upto`. The event comparison
    38	uses the half-open prefix `time < cut`. -/
    39	structure Continues
    40	    (source rho : DecoupledConsensusModel.Generic.Run V P.Object)
    41	    (cut upto : Time) : Prop where
    42	  agrees : AgreesUntil source rho cut
    43	  covered : upto ≤ rho.horizon
    44	
    45	/-- Execution and partial synchrony with a below-one-third, fully awake electorate. -/
    46	structure BFTRegime
    47	    (P : DecoupledConsensusModel.Generic.ProtocolSpec V)
    48	    (E : DecoupledConsensusModel.Generic.Env V) (I : Interface P)
    49	    (rho : DecoupledConsensusModel.Generic.Run V P.Object) (t₀ : Time) : Prop where
    50	  execution : ExecutionValid P E I rho
    51	  partialSynchrony : PartialSynchrony P E rho
    52	  gst : E.t_GST ≤ t₀
    53	  committees : HonestCommittees I rho.honest
    54	  belowThird : BelowOneThird E rho.honest
    55	  allAwake : FullParticipation E rho
    56	
    57	/-- A bounded recovery prefix with proposer recurrence and a protocol-specific
    58	horizon. -/
    59	structure RecoveryRegime
    60	    (P : DecoupledConsensusModel.Generic.ProtocolSpec V)
    61	    (E : DecoupledConsensusModel.Generic.Env V) (I : Interface P) (C : Constants)
    62	    (rho : DecoupledConsensusModel.Generic.Run V P.Object) (t₀ : Time)
    63	    (gap : Nat) : Prop
    64	    extends BFTRegime P E I rho t₀ where
    65	  recurrence : MultiProposerRecurrence I C rho E.t_GST gap
    66	  horizon : rho.horizon = C.prefixEnd t₀ gap
    67	
    68	/-- The run is recovered at genesis or after a bounded recovery prefix. -/
    69	inductive RecoveredBy
    70	    (P : DecoupledConsensusModel.Generic.ProtocolSpec V)
    71	    (E : DecoupledConsensusModel.Generic.Env V) (I : Interface P) (C : Constants)
    72	    (rho : DecoupledConsensusModel.Generic.Run V P.Object) : Time → Prop
    73	  | genesis : RecoveredBy P E I C rho 0
    74	  | recovered {source : DecoupledConsensusModel.Generic.Run V P.Object}
    75	      {t₀ : Time} {gap : Nat} :
    76	      RecoveryRegime P E I C source t₀ gap →
    77	      Continues source rho (C.prefixEnd t₀ gap) (C.recoveryEnd t₀ gap) →
    78	      SlashableBound I rho →
    79	      RecoveredBy P E I C rho (C.recoveryEnd t₀ gap)
    80	
    81	/-- The accountable regime: a well-formed run without one-third-slashable
    82	evidence. -/
    83	structure AccountableRegime
    84	    (E : DecoupledConsensusModel.Generic.Env V) (I : Interface P)
    85	    (rho : DecoupledConsensusModel.Generic.Run V P.Object) : Prop extends
    86	  RunWellFormed E I rho where
    87	  slashableBound : SlashableBound I rho
    88	
    89	/-- The sleepy regime from `t₀`: validity, partial synchrony after GST ≤ t₀,
    90	honest committees, a fresh-window majority at every time from `t₀`, and a
    91	sound start (genesis or a completed recovery). -/
    92	structure SleepyRegime
    93	    (P : DecoupledConsensusModel.Generic.ProtocolSpec V)
    94	    (E : DecoupledConsensusModel.Generic.Env V) (I : Interface P) (C : Constants)
    95	    (rho : DecoupledConsensusModel.Generic.Run V P.Object) (t₀ : Time) : Prop where
    96	  execution : ExecutionValid P E I rho
    97	  partialSynchrony : PartialSynchrony P E rho
    98	  gst : E.t_GST ≤ t₀
    99	  committees : HonestCommittees I rho.honest
   100	  windows : ∀ t, t₀ ≤ t → C.participationLag ≤ t →
   101	    t - C.participationLag ≤ rho.horizon →
   102	    WindowMajority E rho.honest C.participationWindow t
   103	  start : RecoveredBy P E I C rho t₀
   104	
   105	/-- A live sleepy regime with tier-1 single-proposer recurrence from `t₀`. -/
   106	structure LiveSleepyRegime
   107	    (P : DecoupledConsensusModel.Generic.ProtocolSpec V)
   108	    (E : DecoupledConsensusModel.Generic.Env V) (I : Interface P) (C : Constants)
   109	    (rho : DecoupledConsensusModel.Generic.Run V P.Object) (t₀ : Time) (gap : Nat) : Prop
   110	    extends SleepyRegime P E I C rho t₀ where
   111	  recurrence : SingleProposerRecurrence I C rho t₀ gap
   112	
   113	/-- A fresh sleepy regime from `t₀`: the sleepy regime, and a fresh majority at
   114	every time from `t₀` whose reference sample is in the run. -/
   115	structure FreshSleepyRegime
   116	    (P : DecoupledConsensusModel.Generic.ProtocolSpec V)
   117	    (E : DecoupledConsensusModel.Generic.Env V) (I : Interface P) (C : Constants)
   118	    (rho : DecoupledConsensusModel.Generic.Run V P.Object) (t₀ : Time) : Prop
   119	    extends SleepyRegime P E I C rho t₀ where
   120	  fresh : ∀ t, t₀ ≤ t → C.participationLag ≤ t →
   121	    t - C.participationLag ≤ rho.horizon →
   122	    FreshMajority E rho.honest C t
   123	
   124	/-- The finality regime from `t₀`: BFT premises, strong recurrence from GST within
   125	`gap ≤ maxGap − 2` periods, and a run long enough to contain the startup. -/
   126	structure FinalityRegime
   127	    (P : DecoupledConsensusModel.Generic.ProtocolSpec V)
   128	    (E : DecoupledConsensusModel.Generic.Env V) (I : Interface P) (C : Constants)
   129	    (rho : DecoupledConsensusModel.Generic.Run V P.Object) (t₀ : Time)
   130	    (gap : Nat) : Prop
   131	    extends BFTRegime P E I rho t₀ where
   132	  recurrence : StrongMultiProposerRecurrence I C rho E.t_GST gap
   133	  gapBound : gap + 2 ≤ C.maxGap
   134	  longEnough : t₀ + C.finalityStartup gap ≤ rho.horizon
   135	
   136	/-- The outage regime for a stable read at `T` and the half-open outage window
   137	`[b₀, b₁)`. The interval fields also record the boundary needed for delivery
   138	after the window. -/
   139	structure OutageRegime
   140	    (P : DecoupledConsensusModel.Generic.ProtocolSpec V)
   141	    (E : DecoupledConsensusModel.Generic.Env V) (I : Interface P) (C : Constants)
   142	    (rho : DecoupledConsensusModel.Generic.Run V P.Object)
   143	    (T b₀ b₁ : Time) : Prop where
   144	  execution : ExecutionValid P E I rho
   145	  partialSynchrony : PartialSynchrony P E rho
   146	  gst : E.t_GST ≤ b₁
   147	  committees : HonestCommittees I rho.honest
   148	  healthy : HealthyPrefixDelivery P E rho b₀
   149	  interval : 0 ≤ b₀ ∧ b₀ ≤ b₁ ∧ b₁ ≤ rho.horizon
   150	  boundaryPublic : PublicTime E b₀
   151	  participation : ∀ t, C.participationLag ≤ t →
   152	    t ≤ rho.horizon + C.participationLag →
   153	    FreshMajority E rho.honest C t
   154	  slashableBound : SlashableBound I rho
   155	  window : C.outageStart T ≤ b₀ ∧ b₁ + E.Δ ≤ C.expiry T ∧ b₁ + E.Δ ≤ rho.horizon
   156	
   157	end DecoupledConsensusModel.Statements.Generic
   158	
   159	end
