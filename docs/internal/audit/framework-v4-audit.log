   850	\section{Finality gadget in the fork-choice}\label{sec:fg-fork-choice}
   851	
   852	\subsection{Stored states and finality updates}
   853	
   854	The store adds a block state map $\Sigma.\sigma[\cdot]$ and finality state
   855	$(\Sigma.F,\Sigma.J,\Sigma.h_j,\Sigma.\hmax)$.
   856	Figure~\ref{alg:fg-store} extends the block handler: it admits only
   857	descendants of the finalized block, computes and stores
   858	the post-state, then folds it into the finality caches with
   859	$\Call{update\_finality}{\Sigma,\sigma}$.  The pair
   860	$(\Sigma.J,\Sigma.h_j)$ tracks the lex-greatest justification event
   861	compatible with the finalized block.  $\Sigma.F$ advances
   862	only to a viable proper descendant of itself below~$\Sigma.J$, so
   863	$\Sigma.F\preceq\Sigma.J$ always holds and finalization never reverts.
   864	$\Sigma.\hmax$ only grows, and every block that raises it descends the
   865	finalized block at that moment.  When $\Sigma.F$ advances, an admitted
   866	block can stop descending it and its branch freezes: its children now
   867	fail admission.  The viability guard on the advance then keeps
   868	$\Sigma.\hmax$ at most one above the largest state height among the
   869	finalized block's descendants, so $\Sigma.F$ itself is always viable.
   870	The figure follows the viability definitions it uses.
   871	
   872	\subsection{Fork choice}
   873	
   874	\begin{definition}[Viability]
   875	\label{def:fg-candidate-tree}
   876	A descendant of the finalized block is viable when one of its
   877	descendants has state height at most one below the current maximum.
   878	Figure~\ref{alg:fg-store} defines
   879	$\Call{viable\_tree\_from}{\Sigma,\mathit{blocks}}$ over an explicit
   880	processed-block view.  The ordinary
   881	$\Call{viable\_tree}{\Sigma}$ uses $\Sigma.\T$, and in prose
   882	$\viableTree(\Sigma)$ abbreviates it.
   883	\end{definition}
   884	
   885	Fork choice uses two derived views (Figure~\ref{alg:fg-store}):
   886	$\Call{get\_fg\_root}{\Sigma}$, the FG root --- the block the walk
   887	starts from --- and
   888	$\Call{get\_filtered\_block\_tree\_from}{\Sigma,\mathit{blocks}}$,
   889	the viable blocks below it in an explicit processed-block view.
   890	$\Call{get\_filtered\_block\_tree}{\Sigma}$ uses the full
   891	$\Sigma.\T$.  Goldfish starts at the root even if the root is not in
   892	the filtered tree.
   893	
   894	At this layer $\Call{goldfish\_eligible}{}$ gains one clause: a child
   895	of a block whose state height is below $\Sigma.\hmax-1$ is eligible
   896	without a majority.  The majority gate thus applies exactly while the walk
   897	stands inside the band $\{\Sigma.\hmax-1,\Sigma.\hmax\}$: every viable
   898	block below the band has a viable child, so the walk always reaches
   899	height $\Sigma.\hmax-1$, and it never passes through the band without a
   900	majority.  Figure~\ref{alg:fg-store} shows the extended store handler, the
   901	extended eligibility condition, and the redefined $\Call{get\_sg\_root}{}$
   902	and $\Call{get\_head}{}$: the SG root is now the deepest block of the
   903	filtered tree holding a relative majority, and the FG root when none does.  Available confirmation is unchanged at
   904	this layer; the complete protocol re-anchors it at the SG root over the
   905	filtered block tree, with the FG root as the fallback value.
   906	
   907	\captionof{figure}{FG store and fork choice}\label{alg:fg-store}
   908	\nopagebreak
   909	{\footnotesize
   910	\begin{algorithmic}[1]
   911	\Function{viable\_tree\_from}{$\Sigma,\mathit{blocks}$}
   912	  \State \Return $\{B\in\mathit{blocks}:\Sigma.F\preceq B,\
   913	    \exists B'\in\mathit{blocks},\ B\preceq B',\
   914	    \Sigma.\sigma[B'].h\geq\Sigma.\hmax-1\}$
   915	\EndFunction
   916	\vspace{1pt}
   917	\Function{viable\_tree}{$\Sigma$}
   918	  \State \Return $\Call{viable\_tree\_from}{\Sigma,\Sigma.\T}$
   919	\EndFunction
   920	\vspace{1pt}
   921	\Function{on\_block}{$\Sigma,B$}
   922	  \If{$B.\slot>\Sigma.s$ or $B\in\Sigma.\T$ or
   923	      $B.\parent\notin\Sigma.\T$} \State \Return \EndIf
   924	  \If{$\Sigma.F\not\preceq B$} \State \Return
   925	    \Comment{new at this layer: only descendants of $\Sigma.F$} \EndIf
   926	  \State $\Sigma.\sigma[B]\gets
   927	    \Call{state\_transition}{\Sigma.\sigma[B.\parent],B}$
   928	  \Comment{new at this layer}
   929	  \State add $B$ to $\Sigma.\T$; $\Sigma.\timestamp(B)\gets\Sigma.t$
   930	  \ForAll{$\mathit{vote}\in B.\mathsf{votes}$}
   931	    \State \Call{on\_goldfish\_vote}{$\Sigma,\mathit{vote}$}
   932	  \EndFor
   933	  \State \Call{update\_finality}{$\Sigma,\Sigma.\sigma[B]$}
   934	  \Comment{new at this layer}
   935	\EndFunction
   936	\vspace{1pt}
   937	\Function{update\_finality}{$\Sigma,\sigma$}
   938	  \State $\Sigma.\hmax\gets\max(\Sigma.\hmax,\sigma.h)$
   939	  \If{$\Sigma.F\preceq\sigma.J$ \textbf{and}
   940	      $(\sigma.h_j,\sigma.J.\rootf)>(\Sigma.h_j,\Sigma.J.\rootf)$}
   941	    \Comment{lex order}
   942	    \State $(\Sigma.J,\Sigma.h_j)\gets(\sigma.J,\sigma.h_j)$
   943	  \EndIf
   944	  \If{$\Sigma.F\prec\sigma.F$ \textbf{and} $\sigma.F\preceq\Sigma.J$
   945	      \textbf{and} $\sigma.F\in\Call{viable\_tree}{\Sigma}$}
   946	    \State $\Sigma.F\gets\sigma.F$
   947	  \EndIf
   948	\EndFunction
   949	\vspace{1pt}
   950	\Function{get\_fg\_root}{$\Sigma$}
   951	  \If{$\Sigma.\hmax=\Sigma.h_j+1$} \State \Return $\Sigma.J$ \EndIf
   952	  \State \Return $\Sigma.F$
   953	\EndFunction
   954	\vspace{1pt}
   955	\Function{get\_filtered\_block\_tree\_from}{$\Sigma,\mathit{blocks}$}
   956	  \State $\mathit{root}\gets\Call{get\_fg\_root}{\Sigma}$
   957	  \State \Return
   958	    $\{B\in\Call{viable\_tree\_from}{\Sigma,\mathit{blocks}}:
   959	      \mathit{root}\preceq B\}$
   960	\EndFunction
   961	\vspace{1pt}
   962	\Function{get\_filtered\_block\_tree}{$\Sigma$}
   963	  \State \Return
   964	    $\Call{get\_filtered\_block\_tree\_from}{\Sigma,\Sigma.\T}$
   965	\EndFunction
   966	\vspace{1pt}
   967	\Function{goldfish\_eligible}{$\Sigma,\mathit{votes},
   968	  \mathit{support\_votes},s,B$}
   969	  \State $\mathit{voters\_count}\gets
   970	    |\{v:\mathit{votes}\text{ holds a vote by }v\}|$
   971	  \State \Return $\Sigma.\sigma[B.\parent].h<\Sigma.\hmax-1$
   972	    or $2\,\Call{goldfish\_score}{\mathit{votes},
   973	      \mathit{support\_votes},s,B}>\mathit{voters\_count}$
   974	    or $B.\slot=\Sigma.s$
   975	\EndFunction
   976	\vspace{1pt}
   977	\Function{get\_sg\_root}{$\Sigma$}
   978	  \Comment{redefines the \S\ref{sec:majority-sg} majority root over the filtered tree}
   979	  \State $r\gets\round(\Sigma.s)$;\quad
   980	    $\mathit{tree}\gets\Call{get\_filtered\_block\_tree}{\Sigma}$
   981	  \State $\mathit{graded}\gets\{B\in\mathit{tree}:
   982	    \Call{relative\_majority}{\Sigma,r,\Sigma.t,\Sigma.t,B}\}$
   983	  \State \Return the deepest $B\in\mathit{graded}$, or
   984	    $\Call{get\_fg\_root}{\Sigma}$ if $\mathit{graded}=\emptyset$
   985	\EndFunction
   986	\vspace{1pt}
   987	\Function{get\_head\_in\_tree}{$\Sigma,\mathit{tree},
   988	  \mathit{votes},\mathit{support\_votes},k$}
   989	  \State $A\gets\Call{get\_sg\_root}{\Sigma}$
   990	  \State \Return $\Call{goldfish\_fork\_choice}{\Sigma,A,
   991	    \mathit{tree},\mathit{votes},\mathit{support\_votes},k}$
   992	\EndFunction
   993	\vspace{1pt}
   994	\Function{get\_head}{$\Sigma,\mathit{votes},\mathit{support\_votes},k$}
   995	  \State $\mathit{tree}\gets\Call{get\_filtered\_block\_tree}{\Sigma}$
   996	  \State \Return $\Call{get\_head\_in\_tree}{\Sigma,\mathit{tree},
   997	    \mathit{votes},\mathit{support\_votes},k}$
   998	\EndFunction
   999	\end{algorithmic}
  1000	}
