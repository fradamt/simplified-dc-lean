    15	deriving DecidableEq, Repr
    16	
    17	namespace Block
    18	def slot : Block → Slot
    19	  | .genesis => 0
    20	  | .node _ s _ => s
    21	
    22	def root : Block → BlockId
    23	  | .genesis => genesisRoot
    24	  | .node _ _ r => r
    25	
