    27	  | .genesis => none
    28	  | .node p _ _ => some p
    29	
    30	def parent : Block → Block
    31	  | .genesis => .genesis
    32	  | .node p _ _ => p
    33	
    34	def depth : Block → Nat
    35	  | .genesis => 0
    36	  | .node p _ _ => p.depth + 1
    37	
    38	section Ancestry
    39	
    40	/-- `B ⪯ C`, by walking from `C` to genesis. -/
    41	def preceq (B : Block) : Block → Bool
    42	  | .genesis => decide (B = Block.genesis)
    43	  | C@(.node p _ _) => decide (B = C) || preceq B p
    44	
    45	def prec (B C : Block) : Bool :=
    46	  !decide (B = C) && preceq B C
    47	
    48	def Preceq (B C : Block) : Prop := preceq B C = true
    49	
    50	def Prec (B C : Block) : Prop := prec B C = true
    51	
    52	instance (B C : Block) : Decidable (Preceq B C) :=
    53	  inferInstanceAs (Decidable (preceq B C = true))
    54	
    55	instance (B C : Block) : Decidable (Prec B C) :=
    56	  inferInstanceAs (Decidable (prec B C = true))
    57	
    58	def compatible (B C : Block) : Bool :=
    59	  preceq B C || preceq C B
    60	
    61	def Compatible (B C : Block) : Prop := compatible B C = true
