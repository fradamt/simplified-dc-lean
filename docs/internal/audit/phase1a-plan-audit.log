def hashes (env : Environment) (names : Array Name) (seed : Option Name := none) : Except String (Array (Name × UInt64)) := do
  let mut memo : Std.HashMap Name UInt64 := {}
  if let some n := seed then
    let (_, m) ← closureHash env n memo
    memo := m
  let mut out := #[]
  for n in names do
    let (h, m) ← closureHash env n memo
    out := out.push (n, h)
    memo := m
  return out

def main : IO Unit := do
  initSearchPath (← findSysroot)
  let env ← importModules #[{module := "'`AvailableChainFramework}] {}
  let names := ((env.constants.toList.map (·.1)).filter (fun n => !n.isInternal && locked env n)).toArray.qsort Name.lt
  let .ok baseline := hashes env names | throw (IO.userError "baseline failed")
  IO.println s!"roots: {names.size}; first: {names[0]!}"
  for seed in [`AvailableChain.Framework.ClaimSpec, `AvailableChain.Framework.ClaimSpec.mk, `AvailableChain.Framework.Catalog.safeConfirmed, `Nat, `Nat.succ, `List] do
    let .ok changed := hashes env names (some seed) | throw (IO.userError "seed failed")
    let diffs := (baseline.zip changed).filter (fun (a,b) => a.2 != b.2)
    IO.println s!"seed {seed}: {diffs.size} existing hashes change"
    for (a,b) in diffs.toList.take 3 do IO.println s!"  {a.1}: {hex a.2} -> {hex b.2}"
'"'''
(b/'LockOrder.lean').write_text(s)
print('Lock order probe prepared.')
