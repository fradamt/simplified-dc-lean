   160	```lean
   161	variable {K : Carrier}
   162	
   163	structure ClaimSpec (K : Carrier) where
   164	  id : Lean.Name
   165	  Const : Type
   166	  valid : Const → Prop
   167	  le : Const → Const → Bool
   168	  le_refl : ∀ k, le k k = true
   169	  le_trans : ∀ a b c, le a b = true → le b c = true → le a c = true
   170	  Point : Type
   171	  /-- The runs that the claim speaks about. -/
   172	  regime : (I : K.Inst) → Const → (W : Validators) → K.Ctx I W → Point → Prop
   173	  /-- What the claim states about such a run. -/
   174	  conclusion : (I : K.Inst) → Const → (W : Validators) → K.Ctx I W → Point → Prop
   175	  /-- `trigger I k W x p H`: the event that makes the claim non-vacuous occurs
   176	  in the run at a time at least `H`, with its deadline inside the run
   177	  (design §5; PHASE0-REPORT §6, I2). -/
   178	  trigger : (I : K.Inst) → Const → (W : Validators) → K.Ctx I W → Point → Time → Prop
   179	  /-- A weaker constant keeps the claim. A proof, not metadata. -/
   180	  transport : ∀ (I : K.Inst) (k k' : Const), valid k → valid k' → le k k' = true →
   181	    (∀ (W : Validators) (x : K.Ctx I W), K.admissible I W x → ∀ p,
   182	      regime I k W x p → conclusion I k W x p) →
   183	    (∀ (W : Validators) (x : K.Ctx I W), K.admissible I W x → ∀ p,
   184	      regime I k' W x p → conclusion I k' W x p)
   185	  refutable : RefutationKind
   186	
   187	namespace ClaimSpec
   188	
   189	/-- The claim holds for an instance at a constant. -/
   190	def holds (c : ClaimSpec K) (I : K.Inst) (k : c.Const) : Prop :=
   191	  ∀ (W : Validators) (x : K.Ctx I W), K.admissible I W x → ∀ p,
   192	    c.regime I k W x p → c.conclusion I k W x p
   193	
   194	/-- For every time `H`, the regime has an admissible run of the instance with
   195	a horizon of at least `H`, in which the trigger occurs at a time of at least
   196	`H` (design §5; I2). -/
   197	def inhabited (c : ClaimSpec K) (I : K.Inst) (k : c.Const) : Prop :=
   198	  ∀ H : Time, ∃ (W : Validators) (x : K.Ctx I W) (p : c.Point),
   199	    K.admissible I W x ∧ H ≤ K.horizon I W x ∧ c.regime I k W x p ∧
   200	      c.trigger I k W x p H
   201	
   202	end ClaimSpec
   203	```
