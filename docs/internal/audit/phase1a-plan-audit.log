   465	- [ ] **Step 1: Write the protocol.** It reads no delivered object. Its state is the time of its last tick. Its outputs are the chain of all slots up to that time. Its proposal for slot `s` is the block of slot `s`, which every node can compute.
   466	
   467	```lean
   468	/-- The block of slot `k` on the clock chain. -/
   469	def clockBlock : Nat → Block
   470	  | 0 => .genesis
   471	  | k + 1 => .node (clockBlock k) (k + 1) ⟨k + 1⟩
   472	
   473	/-- A protocol that reads no input (design §12, I1): it excludes every
   474	object, and its outputs depend on the clock only. -/
   475	def clockChain : ProtocolSpec 1 where
   476	  State := Time
   477	  Label := Empty
   478	  Payload := Nat
   479	  init := 0
   480	  clock := fun _ t => t
   481	  actTime := fun ℓ => ℓ.elim
   482	  duties := fun _ => []
   483	  duties_spec := fun ℓ _ => ℓ.elim
   484	  duties_nodup := fun _ => List.nodup_nil
   485	  act := fun _ ℓ => ℓ.elim
   486	  proposalTime := fun s => s
   487	  slotsAt := fun t => if 0 ≤ t then [t.toNat] else []
   488	  slotsAt_spec := sorry
   489	  slotsAt_nodup := sorry
   490	  propose := fun _ s => some s
   491	  gossip := fun _ _ => []
   492	  process := fun st _ => st
   493	  wellFormed := fun _ => true
   494	  depsPresent := fun _ _ => true
   495	  processed := fun _ _ => false
   496	  excludes := fun _ _ => true
   497	  handles := fun _ o o' => o = o'
   498	  carries := fun _ _ => False
   499	
   500	def clockIface : Interface clockChain where
   501	  confirmed := fun st => clockBlock st.toNat
   502	  stable := fun st => clockBlock st.toNat
   503	  block := fun k => some (clockBlock k)
   504	  opening := fun _ => True
   505	```
