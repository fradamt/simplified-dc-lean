   135	/-! ### Inclusion at `D = 1` -/
   136	
   137	/-- In the Sleepy regime with `Δ = 1`, the proposal of an honest awake
   138	proposer at `s` is in every honest `confirmed` read at `s + 1`. The proposer
   139	proposes its height plus one. Every honest node has that height before the
   140	proposal arrives, by checked receipt relay, so it accepts the proposal. -/
   141	theorem counter_included (W : Validators) (E : Env W.V) (hΔ : E.Δ = 1)
   142	    (rho : Run W.V counter) (t₀ : Time)
   143	    (hs : SleepyRegime counter E counterIface rho t₀) :
   144	    IncludedFrom counter E counterIface rho counterIface.confirmed t₀ 1 := by
   145	  classical
   146	  intro s _ hprop hsh
   147	  obtain ⟨hph, hpa⟩ := hprop
   148	  have hsched := hs.execution.toScheduleWellFormed
   149	  have hs0 : (0 : Time) ≤ s := Int.natCast_nonneg s
   150	  change (s : Time) + 1 ≤ rho.horizon at hsh
   151	  have hsH : (s : Time) ≤ rho.horizon := by linarith
   152	  have htick : Event.tick (rho.proposerOf s) (s : Time) ∈ rho.events :=
   153	    hsched.tick_total _ hph s ⟨s, by rw [hΔ, mul_one]⟩ hs0 hsH
   154	  obtain ⟨i, hi⟩ := List.mem_iff_getElem?.mp htick
   155	  obtain ⟨a, ha⟩ : ∃ a, a = height (Run.stateBefore counter rho i) (rho.proposerOf s) :=
   156	    ⟨_, rfl⟩
   157	  obtain ⟨o, ho⟩ : ∃ o : counter.Object, o = ⟨.proposer s, a + 1⟩ := ⟨_, rfl⟩
   158	  have hemit : Run.emits counter E rho (rho.proposerOf s) o s := by
   159	    refine ⟨i, hi, ?_⟩
   160	    change E.awake (rho.proposerOf s) (s : Time) = true at hpa
   161	    rw [ho, ha]
   162	    simp [Run.emittedAt, hpa, counter, height]
   163	    exact List.mem_append_left _ (List.mem_append_right _ (List.mem_singleton_self _))
   164	  refine ⟨chain (a + 1), ⟨hph, a + 1, rfl, ho ▸ hemit⟩, ?_⟩
   165	  intro w hw
   166	  have hdl : max (s : Time) E.t_GST + E.Δ = (s : Time) + 1 := by
   167	    rw [hs.gst_zero, hΔ, max_eq_left hs0]
   168	  obtain ⟨t', ht1, ht2, j, o', hj, ho'⟩ :=
   169	    hs.partialSynchrony.broadcast _ hph o s hemit w hw (by rw [hdl]; exact hsh) rfl
   170	  have ho'o : o' = o := ho'
   171	  subst ho'o
   172	  rw [hdl] at ht2
   173	  -- `w` has height at least `a` before the delivery at `j`.
   174	  have hge : a ≤ height (Run.stateBefore counter rho j) w := by
   175	    rcases Nat.eq_zero_or_pos a with h0 | hpos
   176	    · omega
   177	    · rw [ha] at hpos
   178	      obtain ⟨i', hi'i, o₁, t'', hi', hpay, hlt, hle⟩ := accept_source rho _ i hpos
   179	      rw [← ha] at hpay hlt hle
   180	      have ht''s : t'' < s := deliver_time_lt_tick hsched hi' hi hi'i
   181	      have hi'j : i' < j :=
   182	        index_lt_of_time_lt hsched hi' hj (show t'' < t' from lt_of_lt_of_le ht''s ht1)
   183	      by_cases hproc : counter.processed (Run.stateBefore counter rho (i' + 1) w) o₁ = true
   184	      · have h1 := of_decide_eq_true hproc
   185	        rw [hpay] at h1
   186	        exact le_trans h1 (stateBefore_mono rho hi'j w)
   187	      · have hacc : Run.acceptsAt counter rho i' (rho.proposerOf s) o₁ t'' :=
   188	          ⟨⟨o₁, hi', rfl⟩, decide_eq_false (by rw [hpay]; exact not_le.mpr hlt),
   189	            decide_eq_true (by rw [hpay]; exact hle)⟩
   190	        have ht''0 : 0 ≤ t'' := (hsched.in_horizon _ (List.mem_of_getElem? hi')).1
   191	        have hdl' : max t'' E.t_GST + E.Δ = t'' + 1 := by
   192	          rw [hs.gst_zero, hΔ, max_eq_left ht''0]
   193	        obtain ⟨t₃, _, h32, j', hacc'⟩ :=
   194	          hs.partialSynchrony.relay _ hph i' o₁ t'' hacc w hw (by simpa using hproc)
   195	            (by rw [hdl']; linarith) rfl
   196	        rw [hdl'] at h32
   197	        obtain ⟨o₂, hj', ho₂⟩ := hacc'
   198	        have ho₂' : o₂ = o₁ := ho₂
   199	        subst ho₂'
   200	        have hj'j : j' < j :=
   201	          index_lt_of_time_lt hsched hj' hj
   202	            (show t₃ < t' by have := Int.add_one_le_iff.mpr ht''s; linarith)
   203	        have hd : a ≤ height (Run.stateBefore counter rho j') w + 1 := by
   204	          have hdep := hs.execution.deps j' w o₂ t₃ hj'
   205	          simp only [counter, decide_eq_true_eq] at hdep
   206	          rw [hpay] at hdep
   207	          exact hdep
   208	        have h1 : a ≤ height (Run.stateBefore counter rho (j' + 1)) w := by
   209	          have hval : height (Run.stateBefore counter rho (j' + 1)) w =
   210	              counter.process (height (Run.stateBefore counter rho j') w) o₂ := by
   211	            unfold height
   212	            rw [stateBefore_succ hj', step_deliver_self]
   213	          by_cases he : o₂.payload = height (Run.stateBefore counter rho j') w + 1
   214	          · rw [hval, process_of_eq he]
   215	            exact hd
   216	          · rw [hval, process_of_ne he]
   217	            rw [hpay] at he
   218	            exact Nat.lt_succ_iff.mp (lt_of_le_of_ne hd he)
   219	        exact le_trans h1 (stateBefore_mono rho hj'j w)
   220	  -- The delivery at `j` moves `w` to at least `a + 1`.
   221	  have hafter : a + 1 ≤ height (Run.stateBefore counter rho (j + 1)) w := by
   222	    have hpay : o'.payload = a + 1 := by rw [ho]
   223	    have hval : height (Run.stateBefore counter rho (j + 1)) w =
   224	        counter.process (height (Run.stateBefore counter rho j) w) o' := by
   225	      unfold height
   226	      rw [stateBefore_succ hj, step_deliver_self]
   227	    rw [hval]
   228	    rcases Nat.eq_or_lt_of_le hge with heq | hlt
   229	    · rw [← heq, process_of_eq hpay]
   230	    · exact le_trans hlt (process_ge _ o')
   231	  have hread := stateBefore_le_readAt hsched hj (show t' ≤ (s : Time) + 1 by linarith) w
   232	  exact chain_preceq (le_trans hafter hread)
   233	
   234	/-- A horizon of `max H 2` covers `H` and the trigger at slot 1. -/
   235	private theorem horizon_ge (H : Time) : H ≤ ((max H 2).toNat : Time) ∧
   236	    (2 : Time) ≤ ((max H 2).toNat : Time) :=
   237	  ⟨le_trans (le_max_left _ _) (Int.self_le_toNat _),
   238	    le_trans (le_max_right _ _) (Int.self_le_toNat _)⟩
   239	
   240	def certIncluded : Cert includedConfirmed counterInst where
   241	  const := (1 : Time)
   242	  valid := zero_le_one
   243	  inhabited := by
   244	    intro H
   245	    refine ⟨⟨Fin (Nat.succ 0), inferInstance, inferInstance⟩, counterEnv 0,
   246	      canonical 0 (max H 2).toNat, (0 : Time), rfl, (horizon_ge H).1,
   247	      canonical_sleepy 0 (max H 2).toNat, 1, ?_, ⟨Finset.mem_univ _, rfl⟩, ?_⟩
   248	    · change (0 : Time) < ((1 : Nat) : Time)
   249	      exact Int.natCast_pos.mpr Nat.one_pos
   250	    · change ((1 : Nat) : Time) + 1 ≤ ((max H 2).toNat : Time)
   251	      calc ((1 : Nat) : Time) + 1 = 2 := by norm_num
   252	        _ ≤ _ := (horizon_ge H).2
   253	  proof := by
   254	    intro W E hΔ rho t₀ hs
   255	    exact counter_included W E hΔ rho t₀ hs
   256	
   257	/-- Counter passes the core floor: it is the first candidate. -/
   258	noncomputable def candidate : Candidate counterInst := by
   259	  classical
   260	  intro c hc
   261	  exact if h1 : c = safeConfirmed then (by rw [h1]; exact certSafeConfirmed)
   262	    else if h2 : c = safeStable then (by rw [h2]; exact certSafeStable)
   263	    else if h3 : c = prefixOrder then (by rw [h3]; exact certPrefix)
   264	    else (by
   265	      have h4 : c = includedConfirmed := by
   266	        simp only [core, List.mem_cons, List.not_mem_nil, or_false] at hc
   267	        tauto
   268	      rw [h4]
   269	      exact certIncluded)
   270	
   271	end AvailableChain.Registry.Counter
