    82	/-- If node `p` has height `a > 0` before index `i`, an earlier delivery to `p`
    83	made `p` accept height `a`. -/
    84	theorem accept_source (rho : Run V counter) (p : V) :
    85	    ∀ i, 0 < height (Run.stateBefore counter rho i) p →
    86	      ∃ i' < i, ∃ o t, rho.events[i']? = some (.deliver p o t) ∧
    87	        o.payload = height (Run.stateBefore counter rho i) p ∧
    88	        height (Run.stateBefore counter rho i') p < height (Run.stateBefore counter rho i) p ∧
    89	        height (Run.stateBefore counter rho i) p ≤ height (Run.stateBefore counter rho (i' + 1)) p
    90	  | 0, h => by simp [Run.stateBefore, World.init, height, counter] at h
    91	  | i + 1, h => by
    92	    have hsame : height (Run.stateBefore counter rho (i + 1)) p =
    93	        height (Run.stateBefore counter rho i) p →
    94	        ∃ i' < i + 1, ∃ o t, rho.events[i']? = some (.deliver p o t) ∧
    95	          o.payload = height (Run.stateBefore counter rho (i + 1)) p ∧
    96	          height (Run.stateBefore counter rho i') p <
    97	            height (Run.stateBefore counter rho (i + 1)) p ∧
    98	          height (Run.stateBefore counter rho (i + 1)) p ≤
    99	            height (Run.stateBefore counter rho (i' + 1)) p := by
   100	      intro heq
   101	      obtain ⟨i', hi', o, t, h1, h2, h3, h4⟩ :=
   102	        accept_source rho p i (by rw [heq] at h; exact h)
   103	      rw [heq]
   104	      exact ⟨i', by omega, o, t, h1, h2, h3, h4⟩
   105	    cases he : rho.events[i]? with
   106	    | none =>
   107	      apply hsame
   108	      unfold height Run.stateBefore
   109	      rw [List.take_add_one, he]
   110	      simp
   111	    | some e =>
   112	      have hstep := stateBefore_succ he
   113	      by_cases heq : height (Run.stateBefore counter rho (i + 1)) p =
   114	          height (Run.stateBefore counter rho i) p
   115	      · exact hsame heq
   116	      · cases e with
   117	        | tick v t =>
   118	          exact absurd (by unfold height; rw [hstep, step_tick]) heq
   119	        | deliver v o t =>
   120	          by_cases hv : p = v
   121	          · subst hv
   122	            have hval : height (Run.stateBefore counter rho (i + 1)) p =
   123	                counter.process (height (Run.stateBefore counter rho i) p) o := by
   124	              unfold height
   125	              rw [hstep, step_deliver_self]
   126	            by_cases hpay : o.payload = height (Run.stateBefore counter rho i) p + 1
   127	            · have hval' := hval.trans (process_of_eq hpay)
   128	              refine ⟨i, by omega, o, t, he, hpay.trans hval'.symm, ?_, le_refl _⟩
   129	              omega
   130	            · exact absurd (hval.trans (process_of_ne hpay)) heq
   131	          · exact absurd (by unfold height; rw [hstep, step_deliver_ne _ hv]) heq
   132	
   133	end Schedule
