    23	    I.block o.payload = some tip ∧ Block.Preceq B tip
    24	
    25	/-- Collision resistance of block roots, idealized as injectivity on
    26	genesis and the ancestors of all blocks named by this run. The raw `Block`
    27	type stays unrestricted; only the run's named scope must be collision-free. -/
    28	def RootInjective (E : AvailableChain.Generic.Env V) (I : Interface P)
    29	    (rho : AvailableChain.Generic.Run V P) : Prop :=
