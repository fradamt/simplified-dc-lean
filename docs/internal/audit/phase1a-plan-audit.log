   416	
   417	```lean
   418	/-- An instance with the strong output (`StrongInterface`): the facet is a
   419	field, so it is bound once (design §3). -/
   420	structure StrongInstance extends Instance where
   421	  strong : P.State → Block
   422	
   423	/-- The strong interface of a strong instance. -/
   424	def StrongInstance.sface (I : StrongInstance) : StrongInterface I.P :=
   425	  { I.iface with strong := I.strong }
   426	
   427	/-- The carrier of strong instances. Its contexts are the v1 contexts of the
   428	base instance. -/
   429	@[reducible] def Carrier.strong : Carrier where
   430	  Inst := StrongInstance
   431	  Ctx := fun I W => V1Ctx I.toInstance W
   432	  admissible := fun I _ x => x.E.Δ = I.Δ
   433	  horizon := fun _ _ x => x.rho.horizon
   434	
   435	/-- Base claims pull back to strong instances. -/
   436	def CarrierMap.strongV1 : CarrierMap Carrier.strong Carrier.v1 where
   437	  inst := StrongInstance.toInstance
   438	  ctx := fun _ _ => Equiv.refl _
   439	  admissible := fun _ _ _ => Iff.rfl
   440	  horizon := fun _ _ _ => rfl
