     1	import AvailableChainFramework
     2	open Lean
     3	
     4	/-! Catalog lock. Each locked declaration gets a hash of its own statement
     5	(and body, for a definition) and of every declaration that it uses,
     6	transitively. `docs/catalog.lock` has one line `<name> <16 hex digits>` per
     7	declaration, sorted by name.
     8	
     9	Run: `lake env lean --run scripts/CatalogLock.lean --write | --check`.
    10	Exit codes: 0 same, 1 different, 2 usage or a missing declaration. -/
    11	
    12	/-- Every declaration of these modules is locked (L1–L3). The LM/L0
    13	definitions that they use are reached through the closure. `Kit` (L5) is
    14	not locked. -/
    15	def lockedModules : List Name :=
    16	  [`AvailableChainFramework.Hooks, `AvailableChainFramework.Instance,
    17	   `AvailableChainFramework.Claim, `AvailableChainFramework.Cert,
    18	   `AvailableChainFramework.Profile, `AvailableChainFramework.Pareto]
    19	
    20	/-- Every declaration of the modules under this prefix is locked (L3). -/
    21	def lockedModulePrefix : Name := `AvailableChainFramework.Catalog
    22	
    23	def locked (env : Environment) (n : Name) : Bool :=
    24	  match env.getModuleIdxFor? n with
    25	  | some idx =>
    26	      let m := env.header.moduleNames[idx.toNat]!
    27	      lockedModules.contains m || lockedModulePrefix.isPrefixOf m
    28	  | none => false
    29	
    30	def ownHash (ci : ConstantInfo) : UInt64 :=
    31	  let base := mixHash (hash ci.name) (hash ci.type)
    32	  match ci with
    33	  | .defnInfo d => mixHash base (hash d.value)
    34	  | .opaqueInfo d => mixHash base (hash d.value)
    35	  | .inductInfo d => d.ctors.foldl (fun h c => mixHash h (hash c)) base
    36	  | _ => base  -- theorems: the statement only; a new proof keeps the hash
    37	
    38	/-- The declarations that `ci` uses. A theorem uses only the constants of its
    39	statement, so that a new proof keeps the hash. -/
    40	def deps (ci : ConstantInfo) : NameSet :=
    41	  match ci with
    42	  | .thmInfo _ => ci.type.getUsedConstantsAsSet
    43	  | _ => ci.getUsedConstantsAsSet
    44	
    45	partial def closureHash (env : Environment) (n : Name)
    46	    (memo : Std.HashMap Name UInt64) : Except String (UInt64 × Std.HashMap Name UInt64) := do
    47	  if let some h := memo[n]? then return (h, memo)
    48	  let some ci := env.find? n | throw s!"missing body: {n}"
    49	  let memo := memo.insert n (ownHash ci)  -- breaks cycles through recursors
    50	  let ds := ((deps ci).toList.filter (· != n)).toArray.qsort Name.lt
    51	  let mut h := ownHash ci
    52	  let mut memo := memo
    53	  for d in ds do
    54	    let (hd, m) ← closureHash env d memo
    55	    memo := m
    56	    h := mixHash h hd
    57	  return (h, memo.insert n h)
    58	
    59	def hex (u : UInt64) : String :=
    60	  let s := String.ofList (Nat.toDigits 16 u.toNat)
    61	  "".pushn '0' (16 - s.length) ++ s
    62	
    63	def main (args : List String) : IO UInt32 := do
    64	  initSearchPath (← findSysroot)
    65	  let env ← importModules #[{ module := `AvailableChainFramework }] {}
    66	  let names := (env.constants.toList.map (·.1)).filter (fun n =>
    67	    !n.isInternal && locked env n)
    68	  let names := names.toArray.qsort Name.lt
    69	  let mut memo : Std.HashMap Name UInt64 := {}
    70	  let mut lines : Array String := #[]
    71	  for n in names do
    72	    match closureHash env n memo with
    73	    | .ok (h, m) => memo := m; lines := lines.push s!"{n} {hex h}"
    74	    | .error e => IO.eprintln e; return 2
    75	  let text := String.intercalate "\n" lines.toList ++ "\n"
    76	  match args with
    77	  | ["--write"] => IO.FS.writeFile "docs/catalog.lock" text; return 0
    78	  | ["--check"] =>
