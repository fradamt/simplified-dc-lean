   576	/-- A larger θ or η makes the η-sleepy inequality harder. -/
   577	theorem etaSleepy_mono {V : Type} [DecidableEq V] [Fintype V] {n : Nat}
   578	    {P : ProtocolSpec n} {E : Env V} {C C' : Constants} {rho : Run V P} {t : Time}
