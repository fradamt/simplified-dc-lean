    79	    subst this; exact h
    80	  refutable := .family
    81	
    82	/-- The core floor (design §4): every candidate certifies all four. -/
    83	def core : Profile where
    84	  id := `core.v1
    85	  claims := [safeConfirmed, safeStable, prefixOrder, includedConfirmed]
    86	
    87	/-- A candidate protocol passes the core floor. `Type 1`, matching
