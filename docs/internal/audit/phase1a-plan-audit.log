   121	      ∀ u, height (l₁.foldl World.step w) u ≤ height (l₂.foldl World.step w') u := by
   122	  induction hl with
   123	  | slnil => intro w w' h; exact h
   124	  | cons a _ ih =>
   125	    intro w w' h
   126	    exact ih w (World.step w' a) (fun u => le_trans (h u) (step_mono w' a u))
   127	  | cons_cons a _ ih =>
   128	    intro w w' h
   129	    exact ih (World.step w a) (World.step w' a) (step_le h a)
   130	
   131	/-- The height of a node only grows along the event list. -/
   132	theorem stateBefore_mono (rho : Run V counter) {i j : Nat} (hij : i ≤ j) (v : V) :
   133	    height (Run.stateBefore counter rho i) v ≤ height (Run.stateBefore counter rho j) v :=
   134	  foldl_sublist (List.take_sublist_take_left hij) _ _ (fun _ => le_refl _) v
   135	
   136	end Mono
   137	
   138	theorem counter_hooks : HooksSound counter := by
   139	  refine ⟨fun _ _ h => by simp [counter] at h, ?_, ?_, fun _ _ _ h => Or.inl h⟩
   140	  · intro V _ _ E rho _ v o i j _ h; simp [counter] at h
   141	  · intro V _ _ E rho _ v o i j hij h
   142	    exact decide_eq_true (Nat.le_trans (of_decide_eq_true h) (stateBefore_mono rho hij v))
   143	
   144	def counterInst : Instance where
   145	  n := 1
   146	  P := counter
   147	  Δ := 1
   148	  iface := counterIface
   149	  hooks := counter_hooks
   150	
   151	end AvailableChain.Registry.Counter
