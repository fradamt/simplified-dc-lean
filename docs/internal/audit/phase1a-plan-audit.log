    12	/-- The effect of one handler call on one handled object (design E4). -/
    13	inductive Outcome where
    14	  /-- `processed` changes from false to true. -/
    15	  | accepted
    16	  /-- `excludes` holds after the call; it holds for the rest of the epoch. -/
    17	  | rejected
    18	  /-- No change for the object, and it is not excluded. -/
    19	  | refused
    20	  deriving DecidableEq, Repr
    21	
    22	/-- The effect of the call `process st o` on the handled object `o'`. -/
    23	def classify (P : ProtocolSpec n) (st : P.State) (o o' : P.Object) : Outcome :=
    24	  if P.processed st o' = false ∧ P.processed (P.process st o) o' = true then .accepted
    25	  else if P.excludes (P.process st o) o' = true then .rejected
    26	  else .refused
    27	
    28	/-- E4 obligations on the v1 engine. The v1 engine has no restart, so a run
    29	is one epoch. Stability is stated along runs, because `clock` can move back
    30	in time on states that no run reaches. -/
    31	structure HooksSound (P : ProtocolSpec n) : Prop where
    32	  /-- An excluded object does not change the state. -/
    33	  excludes_inert : ∀ st o, P.excludes st o = true → P.process st o = st
    34	  /-- Exclusion is stable along a run. -/
    35	  excludes_stable : ∀ {V : Type} [DecidableEq V] [Fintype V] (E : Env V)
    36	    (rho : Run V P), ScheduleWellFormed E rho → ∀ v o i j, i ≤ j →
    37	      P.excludes (Run.stateBefore P rho i v) o = true →
    38	      P.excludes (Run.stateBefore P rho j v) o = true
    39	  /-- `processed` is monotone along a run. -/
    40	  processed_stable : ∀ {V : Type} [DecidableEq V] [Fintype V] (E : Env V)
    41	    (rho : Run V P), ScheduleWellFormed E rho → ∀ v o i j, i ≤ j →
    42	      P.processed (Run.stateBefore P rho i v) o = true →
    43	      P.processed (Run.stateBefore P rho j v) o = true
    44	  /-- A handled object is the delivered object or one that it carries. -/
    45	  handles_carries : ∀ st o o', P.handles st o o' → o = o' ∨ P.carries o o'
    46	
