    53	/-- A delivery before a tick has a strictly earlier time: at one time, ticks
    54	come first. -/
    55	theorem deliver_time_lt_tick (hs : ScheduleWellFormed E rho) {q i : Nat} {v u : V}
    56	    {o : counter.Object} {t s : Time} (hq : rho.events[q]? = some (.deliver v o t))
    57	    (hi : rho.events[i]? = some (.tick u s)) (h : q < i) : t < s := by
    58	  rcases Prod.Lex.toLex_le_toLex.mp (key_le_of_index_le hs hq hi h.le) with h | ⟨_, h⟩
    59	  · exact h
    60	  · exact (Nat.not_succ_le_zero 0 h).elim
    61	
    62	/-- The read at `T` includes every event up to an event at a time `≤ T`. -/
    63	theorem stateBefore_le_readAt (hs : ScheduleWellFormed E rho) {j : Nat}
    64	    {f : Event V counter.Object} (hj : rho.events[j]? = some f) {T : Time}
    65	    (hT : f.time ≤ T) (v : V) :
    66	    height (Run.stateBefore counter rho (j + 1)) v ≤ height (Run.readAt counter rho T) v := by
    67	  have hself : (rho.events.take (j + 1)).filter (fun e => decide (e.time ≤ T)) =
    68	      rho.events.take (j + 1) := by
    69	    apply List.filter_eq_self.mpr
    70	    intro x hx
    71	    obtain ⟨q, hq⟩ := List.mem_iff_getElem?.mp hx
    72	    rw [List.getElem?_take] at hq
    73	    split_ifs at hq with hqj
    74	    exact decide_eq_true
    75	      (le_trans (time_le_of_key_le (key_le_of_index_le hs hq hj (by omega))) hT)
    76	  have hsub : (rho.events.take (j + 1)).Sublist
    77	      (rho.events.filter (fun e => decide (e.time ≤ T))) := by
    78	    rw [← hself]
    79	    exact (List.take_sublist _ _).filter _
    80	  exact foldl_sublist hsub _ _ (fun _ => le_refl _) v
