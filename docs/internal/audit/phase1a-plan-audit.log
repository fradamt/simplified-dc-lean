   354	**Files:**
   355	- Create: `AvailableChainFramework/Facets/Strong.lean`, `AvailableChainFramework/CarrierMap.lean`
   356	- Modify: `AvailableChainFramework.lean`, `AvailableChainRegistry/Tests/NewFacet.lean`
   357	
   358	**Interfaces:**
   359	- Consumes: Tasks 1–2.
   360	- Produces: `CarrierMap K' K` (`inst`, `ctx`, `admissible`, `horizon`), `ClaimSpec.pull`, `ClaimSpec.holds_pull`, `ClaimSpec.inhabited_pull`, `Cert.pull`, `StrongInstance` (extends `Instance` with `strong`), `StrongInstance.sface`, `Carrier.strong`, `CarrierMap.strongV1 : CarrierMap Carrier.strong Carrier.v1`.
   361	
   362	- [ ] **Step 1: Write `CarrierMap.lean`.** A map from carrier `K'` to carrier `K` sends each `K'` instance to a `K` instance and identifies their contexts. Base claims then pull back.
   363	
   364	```lean
   365	variable {K K' : Carrier}
   366	
   367	/-- A carrier map from `K'` to `K` (a facet carrier to its base, design G2):
   368	an instance map and an equivalence of contexts that keeps admissibility and
   369	the horizon. -/
   370	structure CarrierMap (K' K : Carrier) where
   371	  inst : K'.Inst → K.Inst
   372	  ctx : ∀ I W, K'.Ctx I W ≃ K.Ctx (inst I) W
   373	  admissible : ∀ I W x, K'.admissible I W x ↔ K.admissible (inst I) W (ctx I W x)
   374	  horizon : ∀ I W x, K'.horizon I W x = K.horizon (inst I) W (ctx I W x)
   375	
   376	namespace ClaimSpec
   377	
   378	/-- The claim `c` over `K`, read on `K'` through `m`. Same id, constants and
   379	points. -/
   380	def pull (m : CarrierMap K' K) (c : ClaimSpec K) : ClaimSpec K' where
   381	  id := c.id
   382	  Const := c.Const
   383	  valid := c.valid
   384	  le := c.le
   385	  le_refl := c.le_refl
   386	  le_trans := c.le_trans
   387	  Point := c.Point
   388	  regime := fun I k W x p => c.regime (m.inst I) k W (m.ctx I W x) p
   389	  conclusion := fun I k W x p => c.conclusion (m.inst I) k W (m.ctx I W x) p
   390	  trigger := fun I k W x p H => c.trigger (m.inst I) k W (m.ctx I W x) p H
   391	  transport := by sorry
   392	  refutable := c.refutable
   393	
   394	theorem holds_pull (m : CarrierMap K' K) (c : ClaimSpec K) (I : K'.Inst) (k : c.Const) :
   395	    (c.pull m).holds I k ↔ c.holds (m.inst I) k := by
   396	  sorry
   397	
   398	theorem inhabited_pull (m : CarrierMap K' K) (c : ClaimSpec K) (I : K'.Inst) (k : c.Const) :
   399	    (c.pull m).inhabited I k ↔ c.inhabited (m.inst I) k := by
   400	  sorry
   401	
   402	end ClaimSpec
   403	
   404	/-- A certificate of the base instance is a certificate of the pulled claim. -/
   405	def Cert.pull (m : CarrierMap K' K) {c : ClaimSpec K} {I : K'.Inst}
   406	    (x : Cert c (m.inst I)) : Cert (c.pull m) I where
   407	  const := x.const
   408	  valid := x.valid
   409	  inhabited := (ClaimSpec.inhabited_pull m c I x.const).2 x.inhabited
   410	  proof := (ClaimSpec.holds_pull m c I x.const).2 x.proof
   411	```
   412	
   413	Proof guides: `transport` — from the `k` form on `K'`, get the `k` form on `K` by `(m.ctx I W).symm` (use `Equiv.apply_symm_apply` and `m.admissible`), apply `c.transport`, and come back with `m.ctx I W x`. `holds_pull` — both directions through the equivalence, as for `transport`. `inhabited_pull` — `→`: map the witness context with `m.ctx`, use `m.admissible` and `m.horizon`; `←`: map back with `(m.ctx I W).symm` and rewrite with `Equiv.apply_symm_apply`.
