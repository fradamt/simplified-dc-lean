     1	module
     2	public import AvailableChainFramework.Instance
     3	
     4	@[expose] public section
     5	
     6	namespace AvailableChain.Framework
     7	
     8	open AvailableChain.Generic
     9	
    10	/-- How a claim can be refuted. -/
    11	inductive RefutationKind where
    12	  /-- One finite run for one constant. -/
    13	  | run
    14	  /-- A parameterized family: no valid constant works. -/
    15	  | family
    16	  /-- The claim has no refutation form. -/
    17	  | none
    18	  deriving DecidableEq, Repr
    19	
    20	/-- A catalog claim (design §4). `le k k'` means that `k'` is at least as
    21	weak as `k`. `Point` holds the run parameters that the claim quantifies
    22	over (for example `t₀`, or `T`, `b₀`, `b₁`). -/
    23	structure ClaimSpec where
    24	  id : Lean.Name
    25	  Const : Type
    26	  valid : Const → Prop
    27	  le : Const → Const → Bool
    28	  le_refl : ∀ k, le k k = true
    29	  le_trans : ∀ a b c, le a b = true → le b c = true → le a c = true
    30	  Point : Type
    31	  /-- The runs that the claim speaks about. -/
    32	  regime : (I : Instance) → Const → (W : Validators) → Env W.V →
    33	    Run W.V I.P → Point → Prop
    34	  /-- What the claim states about such a run. -/
    35	  conclusion : (I : Instance) → Const → (W : Validators) → Env W.V →
    36	    Run W.V I.P → Point → Prop
    37	  /-- The event that makes the claim non-vacuous in a run (design §5). -/
    38	  trigger : (I : Instance) → Const → (W : Validators) → Env W.V →
    39	    Run W.V I.P → Point → Prop
    40	  /-- A weaker constant keeps the claim. A proof, not metadata. -/
    41	  transport : ∀ (I : Instance) (k k' : Const), valid k → valid k' →
    42	    le k k' = true →
    43	    (∀ (W : Validators) (E : Env W.V), E.Δ = I.Δ → ∀ rho x,
    44	      regime I k W E rho x → conclusion I k W E rho x) →
    45	    (∀ (W : Validators) (E : Env W.V), E.Δ = I.Δ → ∀ rho x,
    46	      regime I k' W E rho x → conclusion I k' W E rho x)
    47	  refutable : RefutationKind
    48	
    49	namespace ClaimSpec
    50	
    51	/-- The claim holds for an instance at a constant. -/
    52	def holds (c : ClaimSpec) (I : Instance) (k : c.Const) : Prop :=
    53	  ∀ (W : Validators) (E : Env W.V), E.Δ = I.Δ → ∀ rho x,
    54	    c.regime I k W E rho x → c.conclusion I k W E rho x
    55	
    56	/-- For every horizon bound, the regime has a run of the instance, with a
    57	larger horizon, in which the trigger occurs (design §5). -/
    58	def inhabited (c : ClaimSpec) (I : Instance) (k : c.Const) : Prop :=
    59	  ∀ H : Time, ∃ (W : Validators) (E : Env W.V) (rho : Run W.V I.P) (x : c.Point),
    60	    E.Δ = I.Δ ∧ H ≤ rho.horizon ∧ c.regime I k W E rho x ∧ c.trigger I k W E rho x
    61	
    62	end ClaimSpec
    63	
    64	end AvailableChain.Framework
    65	
    66	end

