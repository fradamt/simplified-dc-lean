     1	module
     2	public import AvailableChainFramework.Claim
     3	
     4	@[expose] public section
     5	
     6	namespace AvailableChain.Framework
     7	
     8	/-- A certificate: one instance satisfies one claim at one constant, and the
     9	claim's trigger occurs in its regime. -/
    10	structure Cert (c : ClaimSpec) (I : Instance) where
    11	  const : c.Const
    12	  valid : c.valid const
    13	  inhabited : c.inhabited I const
    14	  proof : c.holds I const
    15	
    16	/-- A refutation at one constant. -/
    17	structure Refutation (c : ClaimSpec) (I : Instance) where
    18	  const : c.Const
    19	  valid : c.valid const
    20	  proof : ¬ c.holds I const
    21	
    22	/-- No valid constant works. -/
    23	structure RefutationFamily (c : ClaimSpec) (I : Instance) : Prop where
    24	  proof : ∀ k, c.valid k → ¬ c.holds I k
    25	
    26	variable {c : ClaimSpec} {I : Instance}
    27	
    28	/-- Move a certificate to a weaker constant. Inhabitation does not transport,
    29	so the caller supplies it. -/
    30	def Cert.weaken (x : Cert c I) (k' : c.Const) (hv : c.valid k')
    31	    (hle : c.le x.const k' = true) (hi : c.inhabited I k') : Cert c I where
    32	  const := k'
    33	  valid := hv
    34	  inhabited := hi
    35	  proof := c.transport I x.const k' x.valid hv hle x.proof
    36	
    37	theorem Cert.not_refuted (x : Cert c I) (r : RefutationFamily c I) : False :=
    38	  r.proof x.const x.valid x.proof
    39	
    40	theorem Refutation.family_of (r : Refutation c I)
    41	    (h : ∀ k, c.valid k → c.holds I k → c.holds I r.const) :
    42	    RefutationFamily c I :=
    43	  ⟨fun k hk hh => r.proof (h k hk hh)⟩
    44	
    45	end AvailableChain.Framework
    46	
    47	end

