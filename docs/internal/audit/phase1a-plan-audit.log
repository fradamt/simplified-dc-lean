    18	  id := id
    19	  Const := Unit
    20	  valid := fun _ => True
    21	  le := fun _ _ => true
    22	  le_refl := fun _ => rfl
    23	  le_trans := fun _ _ _ _ _ => rfl
    24	  Point := Time
    25	  regime := fun I _ W E rho t₀ => sleepy I W E rho t₀
    26	  conclusion := fun I _ _ _ rho t₀ => SafeFrom I.P rho (g I) t₀
    27	  trigger := fun _ _ _ _ _ _ => True
    28	  transport := by
    29	    intro I k k' _ _ _ h
    30	    cases k; cases k'; exact h
    31	  refutable := .run
    32	
    33	def safeConfirmed : ClaimSpec :=
    34	  safeOf `core.safe.confirmed.v1 (fun I => I.iface.confirmed)
    35	
    36	def safeStable : ClaimSpec :=
    37	  safeOf `core.safe.stable.v1 (fun I => I.iface.stable)
    38	
    39	/-- `stable ⪯ confirmed` at every honest node and time, in every run. -/
    40	def prefixOrder : ClaimSpec where
    41	  id := `core.prefix.stableConfirmed.v1
    42	  Const := Unit
    43	  valid := fun _ => True
    44	  le := fun _ _ => true
    45	  le_refl := fun _ => rfl
    46	  le_trans := fun _ _ _ _ _ => rfl
    47	  Point := Unit
    48	  regime := fun _ _ _ _ _ _ => True
    49	  conclusion := fun I _ _ _ rho _ => OutputOrder I.P I.iface rho
    50	  trigger := fun _ _ _ _ _ _ => True
    51	  transport := by
    52	    intro I k k' _ _ _ h
    53	    cases k; cases k'; exact h
    54	  refutable := .run
    55	
    56	/-- Exact-time inclusion of honest proposals in `confirmed`, Sleepy regime.
    57	`D` is fixed: `le` is equality (design §4). -/
    58	def includedConfirmed : ClaimSpec where
    59	  id := `core.included.confirmed.v1
    60	  Const := Time
    61	  valid := fun D => 0 ≤ D
    62	  le := fun a b => decide (a = b)
    63	  le_refl := fun _ => decide_eq_true rfl
    64	  le_trans := by
    65	    intro a b c hab hbc
    66	    have h1 := of_decide_eq_true hab
    67	    have h2 := of_decide_eq_true hbc
    68	    exact decide_eq_true (h1.trans h2)
    69	  Point := Time
    70	  regime := fun I _ W E rho t₀ => sleepy I W E rho t₀
    71	  conclusion := fun I D _ E rho t₀ =>
