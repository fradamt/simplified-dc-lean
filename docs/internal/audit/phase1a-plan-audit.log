   106	/-- Step 1 finding: no clock evaluation (`expire`, `freeze`, the early save,
   107	`release`, `gate`) changes the stored HEADs. -/
   108	theorem clock_votes (p : Params) {n : Nat} (st : State n) (t : Time) :
   109	    (clock p st t).votes = st.votes := by
   110	  let s0 := expire { st with now := t } t
   111	  let fSlot := ((t - 3 * p.Δ) / (4 * p.Δ)).toNat
   112	  let s1 := if 0 ≤ t - 3 * p.Δ && t == freezeTime p fSlot then
   113	    freeze p s0 fSlot else s0
   114	  let eSlot := ((t - 2 * p.Δ) / (4 * p.Δ)).toNat
   115	  let s2 := if 0 ≤ t - 2 * p.Δ && t == earlyTime p eSlot then
   116	    { s1 with early := s1.early ++ [(eSlot, earlyVotes p s1 eSlot)] }
   117	    else s1
   118	  let qSlot := ((t - 5 * p.Δ) / (4 * p.Δ)).toNat
   119	  let s3 := if 0 ≤ t - 5 * p.Δ && t == releaseTime p qSlot then
   120	    release p s2 qSlot else s2
   121	  let dSlot := ((t - 6 * p.Δ) / (4 * p.Δ)).toNat
   122	  change (if 0 ≤ t - 6 * p.Δ && t == gateTime p dSlot then
