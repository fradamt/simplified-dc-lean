   808	    \Comment{names the chain's own entry}
   809	    \State $\sigma.\progressBit[\valindex]\gets\mathsf{true}$
   810	    \If{not $\tau$}
   811	      \State $\sigma.\targetParticipation[\valindex]\gets\mathsf{true}$
   812	    \EndIf
   813	  \EndIf
   814	  \State \Return $\sigma$
   815	\EndFunction
   816	\vspace{2pt}
