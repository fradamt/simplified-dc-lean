     7	/-- Archive a complete signature once. Only the base projection enters
     8	the shared two-target cache, with its original base receipt stamp. -/
     9	def receiveHead (p : Params) {n : Nat} (st : State n) (o : HeadWire n) : State n :=
    10	  match o.auth with
    11	  | .seat r _ =>
    12	      if (st.base.now / (4 * p.Δ)).toNat < r then st else
    13	        let st := if o ∈ st.receivedHeads then st else
    14	          { st with receivedHeads := st.receivedHeads ++ [o],
    15	                    headStamp := st.headStamp ++ [(o, st.base.now)] }
    16	        { st with base := GridCO.admitVote p.engine st.base (baseWire o) }
    17	  | _ => st
    18	
    19	def admitHead (p : Params) {n : Nat} (st : State n) (o : HeadWire n) : State n :=
