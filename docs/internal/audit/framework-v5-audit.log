   787	\small
   788	\begin{algorithmic}[1]
   789	\Function{state\_transition}{$\sigma,B$}
   790	\State \textbf{assert} $B.\proposer=\operatorname{proposer}(B.\slot)$
   791	  \State \textbf{assert} $B.\parent.\slot<B.\slot$
   792	  \State $\sigma.s\gets B.\slot$
   793	  \ForAll{$a\in B.\mathsf{attestations}$}
   794	    \State $\sigma\gets\Call{process\_attestation}{\sigma,a}$
