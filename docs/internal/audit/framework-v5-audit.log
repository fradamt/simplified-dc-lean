   128	  (rho.events.filter (fun e => decide (e.time < t))).foldl World.step World.init
   129	/-- The returned world includes events up to and including time `t`. -/
   130	def readAt (rho : Run V P) (t : Time) : World V P :=
   131	  (rho.events.filter (fun e => decide (e.time ≤ t))).foldl World.step World.init
   132	/-- The returned world includes the complete event list. -/
   133	def final (rho : Run V P) : World V P :=
   134	  rho.events.foldl World.step World.init
   135	
   136	/-- The objects that the tick of `v` at index `i` and time `t` emits, from the
   137	state after its clock update. An asleep node emits nothing. An awake node
   138	signs, with its own seat of each due label, the label's payload; with the
   139	proposer key of each of its slots due now, the proposal payload; and nothing
   140	else but unsigned gossip. -/
   141	def emittedAt (E : Env V) (rho : Run V P) (i : Nat) (v : V) (t : Time) :
   142	    List P.Object :=
   143	  if E.awake v t then
   144	    let st := P.clock (stateBefore P rho i v) t
   145	    (P.duties t).filterMap (fun ℓ =>
   146	        (P.act st ℓ).map (fun p => ⟨.seat ℓ ((rho.seatOf ℓ).symm v), p⟩)) ++
   147	      (P.slotsAt t).filterMap (fun s =>
   148	        if rho.proposerOf s = v then
   149	          (P.propose st s).map (fun p => ⟨.proposer s, p⟩)
   150	        else none) ++
   151	      (P.gossip st t).map (fun p => ⟨.none, p⟩)
   152	  else []
   153	
   154	/-- Payloads from delivery events only; self-emitted objects are not included. -/
   155	def objects (rho : Run V P) : List P.Object := rho.events.filterMap Event.object?
   156	/-- An object appears in a tick's output. -/
   157	def emits (E : Env V) (rho : Run V P) (v : V) (o : P.Object) (t : Time) : Prop :=
   158	  ∃ i : Nat, rho.events[i]? = some (.tick v t) ∧ o ∈ emittedAt P E rho i v t
   159	
   160	/-- A delivery of the object to the node. Delivery records the handler call
   161	even when the handler rejects; carried children are covered by
   162	`UnforgeableSignatures.carried` and `handlesAt`. -/
   163	def processes (rho : Run V P) (v : V) (o : P.Object) (t : Time) : Prop :=
   164	  ∃ i : Nat, rho.events[i]? = some (.deliver v o t)
   165	
   166	/-- The handler call recorded at index `i`. A handler call may reject the object;
   167	the false-to-true `processed` transition belongs to `acceptsAt`. -/
   168	def handlesAt (rho : Run V P) (i : Nat) (v : V) (o : P.Object)
   169	    (t : Time) : Prop :=
   170	  ∃ o', rho.events[i]? = some (.deliver v o' t) ∧
   171	    P.handles (stateBefore P rho i v) o' o
   172	
   173	/-- An accepted call is a handler call that flips `processed` from `false` to
   174	`true`. -/
   175	def acceptsAt (rho : Run V P) (i : Nat) (v : V) (o : P.Object)
   176	    (t : Time) : Prop :=
   177	  handlesAt P rho i v o t ∧ P.processed (stateBefore P rho i v) o = false ∧
   178	    P.processed (stateBefore P rho (i + 1) v) o = true
   179	
   180	/-- The validator that holds an authentication in this run, if any. -/
   181	def holder (rho : Run V P) : Auth P.Label n → Option V
   182	  | .seat ℓ i => some (rho.seatOf ℓ i)
   183	  | .proposer s => some (rho.proposerOf s)
   184	  | .none => none
   185	end Run
   186	end AvailableChain.Generic
   187	
   188	end

