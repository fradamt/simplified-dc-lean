     1	module
     2	public import Mathlib.Data.Rat.Defs
     3	public import AvailableChainModel.Objects.Time
     4	
     5	@[expose] public section
     6	
     7	namespace AvailableChain.Statements.Generic
     8	
     9	/-- Time bounds are absolute integer time units, normally expressed using `E.Δ`. -/
    10	structure Constants where
    11	  /-- η, the history window. -/
    12	  η : Time
    13	  /-- Confirmed inclusion delay. -/
    14	  D_c : Time
    15	  /-- Stable inclusion delay. -/
    16	  D_s : Time
    17	  /-- Fast stable inclusion delay. -/
    18	  D_f : Time
    19	  /-- A, the lag before an outage can start. -/
    20	  armingLag : Time
    21	  /-- Arming lag with at least half of the seats honestly awake. -/
    22	  fastArmingLag : Time
    23	  /-- Π, the maximum outage duration. -/
    24	  budget : Time
    25	  /-- ρ, the recovery bound after GST. -/
    26	  recoveryBound : Time
    27	  /-- G, the maximum gap between honest awake opening proposers in the
    28	  Recovery regime. A premise parameter; ρ may depend on it. -/
    29	  proposerGap : Time
    30	  /-- θ, the η-sleepy weight threshold. -/
    31	  θ : ℚ
    32	  /-- θrec, the current-participation threshold after GST. -/
    33	  θrec : ℚ
    34	  /-- Whether recovery also requires every honest validator to be awake. -/
    35	  recoveryFull : Bool
    36	
    37	/-- Bounds fixed by the contract. -/
    38	structure Constants.Valid (C : Constants) : Prop where
    39	  theta_lower : (1 / 2 : ℚ) ≤ C.θ
    40	  theta_upper : C.θ ≤ (3 / 4 : ℚ)
    41	  thetaRec_lower : (1 / 2 : ℚ) ≤ C.θrec
    42	  thetaRec_upper : C.θrec ≤ (3 / 4 : ℚ)
    43	  eta_nonneg : 0 ≤ C.η
    44	  delays_nonneg : 0 ≤ C.D_c ∧ 0 ≤ C.D_s ∧ 0 ≤ C.D_f
    45	  armingLag_nonneg : 0 ≤ C.armingLag
    46	  fastArmingLag_nonneg : 0 ≤ C.fastArmingLag
    47	  fastArmingLag_le : C.fastArmingLag ≤ C.armingLag
    48	  budget_nonneg : 0 ≤ C.budget
    49	  budget_le_eta : C.budget ≤ C.η
    50	  recoveryBound_nonneg : 0 ≤ C.recoveryBound
    51	  proposerGap_pos : 0 < C.proposerGap
    52	
    53	end AvailableChain.Statements.Generic
    54	end
