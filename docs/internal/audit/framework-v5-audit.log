   277	## 4. Claim catalog (L3)
   278	
   279	```lean
   280	structure ClaimSpec where
   281	  id         : Lean.Name                     -- immutable, e.g. `ac.safe.v1`
   282	  needs      : FacetNeeds                    -- which facets it reads
   283	  params     : List ParamName                -- which named parameters
   284	  dir        : ParamName → Direction         -- per parameter: `up` or
   285	                                             -- `down` makes the claim weaker
   286	  valid      : ParamBinding → Prop
   287	  holds      : (I : Instance) → Prop         -- over I.facets, I.params
   288	  inhabited  : (I : Instance) → Prop         -- RegimeInhabited (§5)
   289	  refutable  : RefutationKind                -- finite run, or family
