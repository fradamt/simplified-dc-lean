     1	module
     2	public import AvailableChainStatements.Strong.Constants
     3	public import AvailableChainStatements.Strong.Regimes
     4	public import AvailableChainStatements.Generic.Claims
     5	
     6	@[expose] public section
     7	namespace AvailableChain.Statements.Generic
     8	
     9	open AvailableChain
    10	
    11	variable {V : Type} {n : Nat} [DecidableEq V] [Fintype V]
    12	
    13	/-- Additive strong claims, with a fault cap on each run. This does not
    14	replace or restrict any field of the base `AvailableChain` bundle. -/
    15	structure StrongClaims
    16	    (P : AvailableChain.Generic.ProtocolSpec n)
    17	    (E : AvailableChain.Generic.Env V) (I : StrongInterface P)
    18	    (C : Constants) (SC : StrongConstants) : Prop where
    19	  constants : SC.Valid
    20	  strongSafe : ∀ rho t₀,
    21	    SleepyRegime P E I.toInterface rho t₀ →
    22	    FaultBound P SC.faultCap rho → SafeFrom P rho I.strong t₀
    23	  strongIncluded : ∀ rho t₀,
    24	    SleepyRegime P E I.toInterface rho t₀ →
    25	    FaultBound P SC.faultCap rho → FullParticipation E rho t₀ →
    26	    IncludedFrom P E I.toInterface rho I.strong t₀ SC.strongDelay
    27	  strongResilient : ∀ rho T b₀,
    28	    StrongArmedRegime P E I SC.faultCap rho T b₀ →
    29	    PersistsFrom P rho I.strong T b₀
    30	  strongRecoveredSafe : ∀ rho,
    31	    RecoveryRegime P E I.toInterface C rho → FaultBound P SC.faultCap rho →
    32	    SafeFrom P rho I.strong (E.t_GST + C.recoveryBound)
    33	  strongRecoveredIncluded : ∀ rho,
    34	    RecoveryRegime P E I.toInterface C rho → FaultBound P SC.faultCap rho →
    35	    IncludedFrom P E I.toInterface rho I.strong
    36	      (E.t_GST + C.recoveryBound) SC.strongDelay
    37	
    38	end AvailableChain.Statements.Generic
    39	end
