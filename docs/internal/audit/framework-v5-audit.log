    10	variable {V : Type} {n : Nat} [DecidableEq V] [Fintype V]
    11	
    12	def FaultBound (P : AvailableChain.Generic.ProtocolSpec n)
    13	    (f : Nat) (rho : AvailableChain.Generic.Run V P) : Prop :=
    14	  (faulty rho).card ≤ f
    15	
    16	/-- Sound arming from healthy genesis, followed by arbitrary delivery.
    17	The instance must derive common installation from these fields. The
    18	regime has no certificate, budget, or post-`b₀` premise. -/
    19	structure StrongArmedRegime
    20	    (P : AvailableChain.Generic.ProtocolSpec n)
    21	    (E : AvailableChain.Generic.Env V) (I : StrongInterface P)
    22	    (f : Nat) (rho : AvailableChain.Generic.Run V P)
    23	    (T b₀ : Time) : Prop where
    24	  execution : ExecutionValid P E rho
    25	  rootInjective : RootInjective E I.toInterface rho
    26	  healthy : HealthyPrefixDelivery P E rho b₀
    27	  acceptedRelay : HealthyAcceptedObjectRelay P E rho b₀
    28	  faultBound : FaultBound P f rho
    29	  interval : 0 ≤ T ∧ T ≤ b₀ ∧ b₀ ≤ rho.horizon
    30	  armed : T + E.Δ ≤ b₀
    31	  sleepyBefore : ∀ t, 0 ≤ t → t < b₀ → AwakeMajority E rho t
    32	
    33	end AvailableChain.Statements.Generic
    34	end
