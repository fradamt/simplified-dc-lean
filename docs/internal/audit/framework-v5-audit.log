     1	module
     2	public import AvailableChainStatements.Generic.Interface
     3	
     4	@[expose] public section
     5	
     6	namespace AvailableChain.Statements.Generic
     7	
     8	open AvailableChain
     9	
    10	variable {V : Type} {n : Nat} {P : AvailableChain.Generic.ProtocolSpec n} [DecidableEq V]
    11	
    12	/-- Two outputs do not conflict across honest reads from `t₀` to the horizon. -/
    13	def ConsistentFrom (P : AvailableChain.Generic.ProtocolSpec n)
    14	    (rho : AvailableChain.Generic.Run V P) (g₁ g₂ : Output P)
    15	    (t₀ : Time) : Prop :=
    16	  ∀ u ∈ rho.honest, ∀ v ∈ rho.honest, ∀ t t' : Time,
    17	    t₀ ≤ t → t ≤ rho.horizon → t₀ ≤ t' → t' ≤ rho.horizon →
    18	    Block.Compatible (readAt P rho g₁ u t) (readAt P rho g₂ v t')
    19	
    20	/-- No two honest reads of `g` conflict from `t₀` on. -/
    21	def AgreeFrom (P : AvailableChain.Generic.ProtocolSpec n)
    22	    (rho : AvailableChain.Generic.Run V P) (g : Output P)
    23	    (t₀ : Time) : Prop :=
    24	  ConsistentFrom P rho g g t₀
    25	
    26	/-- Each honest node's reads of `g` only extend from `t₀` on. -/
    27	def MonotoneFrom (P : AvailableChain.Generic.ProtocolSpec n)
    28	    (rho : AvailableChain.Generic.Run V P) (g : Output P)
    29	    (t₀ : Time) : Prop :=
    30	  ∀ v ∈ rho.honest, ∀ t t' : Time, t₀ ≤ t → t ≤ t' → t' ≤ rho.horizon →
    31	    Block.Preceq (readAt P rho g v t) (readAt P rho g v t')
    32	
    33	/-- Safety of `g` from `t₀`: honest reads agree and only extend. -/
    34	structure SafeFrom (P : AvailableChain.Generic.ProtocolSpec n)
    35	    (rho : AvailableChain.Generic.Run V P) (g : Output P)
    36	    (t₀ : Time) : Prop where
    37	  agree : AgreeFrom P rho g t₀
    38	  monotone : MonotoneFrom P rho g t₀
    39	
    40	/-- One output is below another at every node and time. -/
    41	def Prefix (P : AvailableChain.Generic.ProtocolSpec n)
    42	    (rho : AvailableChain.Generic.Run V P) (g₁ g₂ : Output P) : Prop :=
    43	  ∀ v ∈ rho.honest, ∀ t, Block.Preceq (readAt P rho g₁ v t) (readAt P rho g₂ v t)
    44	
    45	/-- The stable and confirmed outputs are ordered by prefix. -/
    46	structure OutputOrder (P : AvailableChain.Generic.ProtocolSpec n)
    47	    (I : Interface P) (rho : AvailableChain.Generic.Run V P) : Prop where
    48	  stableBelowConfirmed : Prefix P rho I.stable I.confirmed
    49	
    50	/-- Block `B` is in every honest read of `g` at time `t`. -/
    51	def InBy (P : AvailableChain.Generic.ProtocolSpec n)
    52	    (rho : AvailableChain.Generic.Run V P) (g : Output P)
    53	    (B : Block) (t : Time) : Prop :=
    54	  ∀ v ∈ rho.honest, Block.Preceq B (readAt P rho g v t)
    55	
    56	/-- The honest proposal of slot `s` is `B`: the honest proposer of `s` emitted,
    57	at the proposal time, a proposal object whose payload proposes `B`. -/
    58	def HonestProposalAt (E : AvailableChain.Generic.Env V) (I : Interface P)
    59	    (rho : AvailableChain.Generic.Run V P) (s : Slot)
    60	    (B : Block) : Prop :=
    61	  rho.proposerOf s ∈ rho.honest ∧
    62	    ∃ p, I.block p = some B ∧
    63	      AvailableChain.Generic.Run.emits P E rho (rho.proposerOf s)
    64	        ⟨.proposer s, p⟩ (P.proposalTime s)
    65	
    66	/-- The proposer of slot `s` is honest and awake at the proposal time. -/
    67	def HonestAwakeProposer (E : AvailableChain.Generic.Env V)
    68	    (rho : AvailableChain.Generic.Run V P) (s : Slot) : Prop :=
    69	  rho.proposerOf s ∈ rho.honest ∧ E.awake (rho.proposerOf s) (P.proposalTime s) = true
    70	
    71	/-- A block proposed by an honest proposer strictly after `t`. -/
    72	def honestAfter (E : AvailableChain.Generic.Env V) (I : Interface P)
    73	    (rho : AvailableChain.Generic.Run V P) (t : Time)
    74	    (B : Block) : Prop :=
    75	  ∃ s : Slot, t < P.proposalTime s ∧ HonestProposalAt E I rho s B
    76	
    77	/-- Liveness of `g` from `t₀`: from every time `t ≥ t₀`, some block proposed by an honest proposer
    78	after `t` is strictly above every honest read at `t` and in every honest read by `t + D`. -/
    79	def LiveFrom (P : AvailableChain.Generic.ProtocolSpec n)
    80	    (E : AvailableChain.Generic.Env V) (I : Interface P) (rho : AvailableChain.Generic.Run V P)
    81	    (g : Output P) (t₀ D : Time) : Prop :=
    82	  ∀ t : Time, t₀ ≤ t → t + D ≤ rho.horizon →
    83	    ∃ B : Block, honestAfter E I rho t B ∧
    84	      (∀ v ∈ rho.honest, Block.Prec (readAt P rho g v t) B) ∧ InBy P rho g B (t + D)
    85	
    86	/-- Inclusion into `g` from `t₀`: every slot after `t₀` whose proposer is honest
    87	and awake at the proposal time has an honest proposal, and that block is in
    88	every honest read within `D` of the proposal time. -/
    89	def IncludedFrom (P : AvailableChain.Generic.ProtocolSpec n)
    90	    (E : AvailableChain.Generic.Env V) (I : Interface P)
    91	    (rho : AvailableChain.Generic.Run V P) (g : Output P)
    92	    (t₀ D : Time) : Prop :=
    93	  ∀ s : Slot, t₀ < P.proposalTime s → HonestAwakeProposer E rho s →
    94	    P.proposalTime s + D ≤ rho.horizon →
    95	    ∃ B : Block, HonestProposalAt E I rho s B ∧
    96	      InBy P rho g B (P.proposalTime s + D)
    97	
    98	/-- Persistence of `g`: every block in an honest read of `g` at `T` is in every honest read of `g`
    99	at every time from `b₀` to the horizon. -/
   100	def PersistsFrom (P : AvailableChain.Generic.ProtocolSpec n)
   101	    (rho : AvailableChain.Generic.Run V P) (g : Output P)
   102	    (T b₀ : Time) : Prop :=
   103	  ∀ v ∈ rho.honest, ∀ B, Block.Preceq B (readAt P rho g v T) →
   104	    ∀ t, b₀ ≤ t → t ≤ rho.horizon → InBy P rho g B t
   105	
   106	/-- Persistence only through the half-open interval `[b₀,b₁)`. -/
   107	def PersistsThrough (P : AvailableChain.Generic.ProtocolSpec n)
   108	    (rho : AvailableChain.Generic.Run V P) (g : Output P)
   109	    (T b₀ b₁ : Time) : Prop :=
   110	  ∀ v ∈ rho.honest, ∀ B, Block.Preceq B (readAt P rho g v T) →
   111	    ∀ t, b₀ ≤ t → t < b₁ → InBy P rho g B t
   112	
   113	/-- A proposed block is in no honest read before its proposal time. -/
   114	def NoFutureRead (P : AvailableChain.Generic.ProtocolSpec n)
   115	    (E : AvailableChain.Generic.Env V) (I : Interface P)
   116	    (rho : AvailableChain.Generic.Run V P) (g : Output P) : Prop :=
   117	  ∀ v ∈ rho.honest, ∀ t (s : Slot) (B : Block),
   118	    HonestProposalAt E I rho s B → t < P.proposalTime s →
   119	    ¬ Block.Preceq B (readAt P rho g v t)
   120	
   121	end AvailableChain.Statements.Generic
   122	
   123	end
