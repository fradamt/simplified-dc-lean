    42	theorem honestEmittedHeight_le_localHMaxBeforeTime
    43	    (S : Setup V) {rho : Run V} (adm : AdmissibleCore S rho)
    44	    {v : V} {a : NamedAttestation V}
    45	    {t : Time} {h : Height}
    46	    (hemit : rho.emits S v (Object.attest a) t)
    47	    (hh : a.height_pair.erase.height? = some h) :
    48	    h ≤ (rho.storeBeforeTime S v t).h_max := by
    49	  have sch : ScheduleWellFormed S rho := adm.toNamedScheduleWellFormed
    50	  have htime := (Proofs.Optimistic.emits_attest_shape S hemit).2
    51	  rw [htime] at hemit
    52	  have heq : a = actionAttestationAt S rho v a.round :=
    53	    ((NamedActionSources.action_run_emission S rho sch v a.round a).mp hemit).2.2
    54	  obtain ⟨entry, timeout, hvote⟩ := heightPair_vote_of_height hh
    55	  rw [heq] at hvote
    56	  obtain ⟨Cfg, hCfg, hheight, -⟩ :=
    57	    NamedActionSources.action_source S rho v a.round h entry timeout hvote
    58	  obtain ⟨C, hCmem, -, hCderiv, -⟩ :=
    59	    NamedActionSources.action_witness S rho v a.round Cfg hCfg
    60	  rw [hCderiv] at hheight
    61	  have hbound :=
    62	    Proofs.NamedStoreBridge.heights_le_hMax_stateBeforeTime S rho (S.a a.round) v C hCmem
    63	  rw [hheight] at hbound
    64	  simpa only [htime] using hbound
    65	
    66	theorem honestEmittedHeight_le_localHMax
    67	    (S : Setup V) {rho : Run V} (adm : AdmissibleCore S rho)
    68	    {v : V} {a : NamedAttestation V}
    69	    {t : Time} {h : Height}
    70	    (hemit : rho.emits S v (Object.attest a) t)
    71	    (hh : a.height_pair.erase.height? = some h) :
    72	    h ≤ (rho.storeAt S v t).h_max := by
    73	  have sch : ScheduleWellFormed S rho := adm.toNamedScheduleWellFormed
    74	  exact (honestEmittedHeight_le_localHMaxBeforeTime S adm hemit hh).trans
    75	    (storeBeforeTime_hMax_le_storeAt S sch v t)
    76	
