   122	τ = (n+1) div 2;  q_F = (2n+2) div 3;  f = (n−1) div 3;
   123	k ≥ 2;  L = (4k−1)Δ;  ρ = 2L+G+8Δ;  R ≥ 3;  P = 4RΔ;  θ = 4Δ;
   124	t_s = 4sΔ; v_s = t_s+Δ; e_s = t_s+2Δ; z_s = t_s+3Δ;
