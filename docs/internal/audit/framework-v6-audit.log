    10	variable {V : Type} {n : Nat} {P : AvailableChain.Generic.ProtocolSpec n} [DecidableEq V]
    11	
    12	/-- Two outputs do not conflict across honest reads from `t₀` to the horizon. -/
    13	def ConsistentFrom (P : AvailableChain.Generic.ProtocolSpec n)
    14	    (rho : AvailableChain.Generic.Run V P) (g₁ g₂ : Output P)
    15	    (t₀ : Time) : Prop :=
    16	  ∀ u ∈ rho.honest, ∀ v ∈ rho.honest, ∀ t t' : Time,
    17	    t₀ ≤ t → t ≤ rho.horizon → t₀ ≤ t' → t' ≤ rho.horizon →
    18	    Block.Compatible (readAt P rho g₁ u t) (readAt P rho g₂ v t')
    19	
    20	/-- No two honest reads of `g` conflict from `t₀` on. -/
    21	def AgreeFrom (P : AvailableChain.Generic.ProtocolSpec n)
    22	    (rho : AvailableChain.Generic.Run V P) (g : Output P)
    23	    (t₀ : Time) : Prop :=
    24	  ConsistentFrom P rho g g t₀
    25	
    26	/-- Each honest node's reads of `g` only extend from `t₀` on. -/
    27	def MonotoneFrom (P : AvailableChain.Generic.ProtocolSpec n)
    28	    (rho : AvailableChain.Generic.Run V P) (g : Output P)
    29	    (t₀ : Time) : Prop :=
    30	  ∀ v ∈ rho.honest, ∀ t t' : Time, t₀ ≤ t → t ≤ t' → t' ≤ rho.horizon →
    31	    Block.Preceq (readAt P rho g v t) (readAt P rho g v t')
    32	
    33	/-- Safety of `g` from `t₀`: honest reads agree and only extend. -/
    34	structure SafeFrom (P : AvailableChain.Generic.ProtocolSpec n)
    35	    (rho : AvailableChain.Generic.Run V P) (g : Output P)
    36	    (t₀ : Time) : Prop where
    37	  agree : AgreeFrom P rho g t₀
    38	  monotone : MonotoneFrom P rho g t₀
    39	
    40	/-- One output is below another at every node and time. -/
    41	def Prefix (P : AvailableChain.Generic.ProtocolSpec n)
    42	    (rho : AvailableChain.Generic.Run V P) (g₁ g₂ : Output P) : Prop :=
    43	  ∀ v ∈ rho.honest, ∀ t, Block.Preceq (readAt P rho g₁ v t) (readAt P rho g₂ v t)
    44	
    45	/-- The stable and confirmed outputs are ordered by prefix. -/
    46	structure OutputOrder (P : AvailableChain.Generic.ProtocolSpec n)
    47	    (I : Interface P) (rho : AvailableChain.Generic.Run V P) : Prop where
    48	  stableBelowConfirmed : Prefix P rho I.stable I.confirmed
    49	
    50	/-- Block `B` is in every honest read of `g` at time `t`. -/
    51	def InBy (P : AvailableChain.Generic.ProtocolSpec n)
    52	    (rho : AvailableChain.Generic.Run V P) (g : Output P)
    53	    (B : Block) (t : Time) : Prop :=
    54	  ∀ v ∈ rho.honest, Block.Preceq B (readAt P rho g v t)
    55	
    56	/-- The honest proposal of slot `s` is `B`: the honest proposer of `s` emitted,
    57	at the proposal time, a proposal object whose payload proposes `B`. -/
    58	def HonestProposalAt (E : AvailableChain.Generic.Env V) (I : Interface P)
    59	    (rho : AvailableChain.Generic.Run V P) (s : Slot)
    60	    (B : Block) : Prop :=
