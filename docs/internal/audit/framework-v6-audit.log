    93	/-- The initial state at time zero follows from nonnegative event times. -/
    94	theorem ExecutionValid.cleanStart {E : AvailableChain.Generic.Env V}
    95	    {rho : AvailableChain.Generic.Run V P} (h : ExecutionValid P E rho)
    96	    (v : V) : AvailableChain.Generic.Run.stateBeforeTime P rho 0 v = P.init := by
    97	  unfold AvailableChain.Generic.Run.stateBeforeTime
    98	  have hempty : rho.events.filter (fun e => decide (e.time < 0)) = [] := by
    99	    apply List.filter_eq_nil_iff.mpr
   100	    intro e he
   101	    simpa using (not_lt.mpr (h.in_horizon e he).1)
   102	  simp [hempty, AvailableChain.Generic.World.init]
