   105	
   106	/-- Persistence only through the half-open interval `[b₀,b₁)`. -/
   107	def PersistsThrough (P : AvailableChain.Generic.ProtocolSpec n)
   108	    (rho : AvailableChain.Generic.Run V P) (g : Output P)
   109	    (T b₀ b₁ : Time) : Prop :=
   110	  ∀ v ∈ rho.honest, ∀ B, Block.Preceq B (readAt P rho g v T) →
   111	    ∀ t, b₀ ≤ t → t < b₁ → InBy P rho g B t
   112	
   113	/-- A proposed block is in no honest read before its proposal time. -/
   114	def NoFutureRead (P : AvailableChain.Generic.ProtocolSpec n)
   115	    (E : AvailableChain.Generic.Env V) (I : Interface P)
   116	    (rho : AvailableChain.Generic.Run V P) (g : Output P) : Prop :=
