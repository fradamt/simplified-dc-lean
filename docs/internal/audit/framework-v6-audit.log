   795	  \EndFor
   796	  \State $\sigma.L\gets B$
   797	  \State \Return $\Call{process\_height\_events}{\sigma}$
   798	\EndFunction
   799	\vspace{2pt}
   800	\Function{process\_attestation}{$\sigma,a$}
   801	  \State $\valindex\gets a.\valindex$
   802	  \If{$\sigma.h_j>\sigma.h_F$
   803	      \textbf{and} $a$'s finality pair $=(\sigma.h_j,\sigma.J)$}
   804	    \State $\sigma.\finalityBit[\valindex]\gets\mathsf{true}$
   805	  \EndIf
   806	  \If{$a$'s height pair is $(h,T,\tau)$ with
   807	      $h=\sigma.h$ and $T=\sigma.T_h$}
   808	    \Comment{names the chain's own entry}
   809	    \State $\sigma.\progressBit[\valindex]\gets\mathsf{true}$
   810	    \If{not $\tau$}
   811	      \State $\sigma.\targetParticipation[\valindex]\gets\mathsf{true}$
   812	    \EndIf
   813	  \EndIf
   814	  \State \Return $\sigma$
   815	\EndFunction
   816	\vspace{2pt}
   817	\Function{process\_height\_events}{$\sigma$}
   818	  \If{$\sigma.h_j>\sigma.h_F$
   819	      \textbf{and} $w(\Qfin(\sigma))\geq q$}
   820	    \State $(\sigma.F,\sigma.h_F)\gets(\sigma.J,\sigma.h_j)$
   821	  \EndIf
   822	  \If{$w(\Qtarget(\sigma))\geq q$}
   823	    \If{$\neg\sigma.\nj$}
   824	      \State $(\sigma.J,\sigma.h_j)\gets(\sigma.T_h,\sigma.h)$
   825	      \State $\sigma.\finalityBit\gets\mathsf{false}^{V}$
   826	    \EndIf
   827	    \State \Return $\Call{advance\_height}{\sigma}$
   828	  \EndIf
   829	  \If{$w(\Qprog(\sigma))\geq q$ \textbf{and}
   830	      $\sigma.s\geq\sigma.T_h.\slot+\delta_{\mathrm{t}}$}
   831	    \Comment{timeouts count only after the delay}
   832	    \State \Return $\Call{advance\_height}{\sigma}$
   833	  \EndIf
   834	  \State \Return $\sigma$
   835	\EndFunction
   836	\vspace{2pt}
   837	\Function{advance\_height}{$\sigma$}
   838	  \State $\sigma.h\gets\sigma.h+1$; \quad $\sigma.T_h\gets\sigma.L$
   839	  \State $\sigma.\nj\gets(K\mid\sigma.h)\wedge
   840	    (\sigma.h-\sigma.h_F>D)$
   841	  \State $\sigma.\targetParticipation,
   842	    \sigma.\progressBit\gets\mathsf{false}^{V}$
   843	  \State \Return $\sigma$
   844	\EndFunction
   845	\end{algorithmic}
   846	\end{boxedminipage}
   847	\end{center}
   848	\end{figure}
   849	
   850	\section{Finality gadget in the fork-choice}\label{sec:fg-fork-choice}
   851	
   852	\subsection{Stored states and finality updates}
   853	
   854	The store adds a block state map $\Sigma.\sigma[\cdot]$ and finality state
   855	$(\Sigma.F,\Sigma.J,\Sigma.h_j,\Sigma.\hmax)$.
   856	Figure~\ref{alg:fg-store} extends the block handler: it admits only
   857	descendants of the finalized block, computes and stores
   858	the post-state, then folds it into the finality caches with
   859	$\Call{update\_finality}{\Sigma,\sigma}$.  The pair
   860	$(\Sigma.J,\Sigma.h_j)$ tracks the lex-greatest justification event
   861	compatible with the finalized block.  $\Sigma.F$ advances
   862	only to a viable proper descendant of itself below~$\Sigma.J$, so
   863	$\Sigma.F\preceq\Sigma.J$ always holds and finalization never reverts.
   864	$\Sigma.\hmax$ only grows, and every block that raises it descends the
   865	finalized block at that moment.  When $\Sigma.F$ advances, an admitted
   866	block can stop descending it and its branch freezes: its children now
   867	fail admission.  The viability guard on the advance then keeps
   868	$\Sigma.\hmax$ at most one above the largest state height among the
   869	finalized block's descendants, so $\Sigma.F$ itself is always viable.
   870	The figure follows the viability definitions it uses.
   871	
   872	\subsection{Fork choice}
   873	
   874	\begin{definition}[Viability]
   875	\label{def:fg-candidate-tree}
   876	A descendant of the finalized block is viable when one of its
   877	descendants has state height at most one below the current maximum.
   878	Figure~\ref{alg:fg-store} defines
   879	$\Call{viable\_tree\_from}{\Sigma,\mathit{blocks}}$ over an explicit
   880	processed-block view.  The ordinary
   881	$\Call{viable\_tree}{\Sigma}$ uses $\Sigma.\T$, and in prose
   882	$\viableTree(\Sigma)$ abbreviates it.
   883	\end{definition}
   884	
   885	Fork choice uses two derived views (Figure~\ref{alg:fg-store}):
   886	$\Call{get\_fg\_root}{\Sigma}$, the FG root --- the block the walk
   887	starts from --- and
   888	$\Call{get\_filtered\_block\_tree\_from}{\Sigma,\mathit{blocks}}$,
   889	the viable blocks below it in an explicit processed-block view.
   890	$\Call{get\_filtered\_block\_tree}{\Sigma}$ uses the full
   891	$\Sigma.\T$.  Goldfish starts at the root even if the root is not in
   892	the filtered tree.
   893	
   894	At this layer $\Call{goldfish\_eligible}{}$ gains one clause: a child
   895	of a block whose state height is below $\Sigma.\hmax-1$ is eligible
   896	without a majority.  The majority gate thus applies exactly while the walk
   897	stands inside the band $\{\Sigma.\hmax-1,\Sigma.\hmax\}$: every viable
   898	block below the band has a viable child, so the walk always reaches
   899	height $\Sigma.\hmax-1$, and it never passes through the band without a
   900	majority.  Figure~\ref{alg:fg-store} shows the extended store handler, the
   901	extended eligibility condition, and the redefined $\Call{get\_sg\_root}{}$
   902	and $\Call{get\_head}{}$: the SG root is now the deepest block of the
   903	filtered tree holding a relative majority, and the FG root when none does.  Available confirmation is unchanged at
   904	this layer; the complete protocol re-anchors it at the SG root over the
   905	filtered block tree, with the FG root as the fallback value.
   906	
   907	\captionof{figure}{FG store and fork choice}\label{alg:fg-store}
   908	\nopagebreak
   909	{\footnotesize
   910	\begin{algorithmic}[1]
   911	\Function{viable\_tree\_from}{$\Sigma,\mathit{blocks}$}
   912	  \State \Return $\{B\in\mathit{blocks}:\Sigma.F\preceq B,\
   913	    \exists B'\in\mathit{blocks},\ B\preceq B',\
   914	    \Sigma.\sigma[B'].h\geq\Sigma.\hmax-1\}$
   915	\EndFunction
   916	\vspace{1pt}
   917	\Function{viable\_tree}{$\Sigma$}
   918	  \State \Return $\Call{viable\_tree\_from}{\Sigma,\Sigma.\T}$
   919	\EndFunction
   920	\vspace{1pt}
   921	\Function{on\_block}{$\Sigma,B$}
   922	  \If{$B.\slot>\Sigma.s$ or $B\in\Sigma.\T$ or
   923	      $B.\parent\notin\Sigma.\T$} \State \Return \EndIf
   924	  \If{$\Sigma.F\not\preceq B$} \State \Return
   925	    \Comment{new at this layer: only descendants of $\Sigma.F$} \EndIf
   926	  \State $\Sigma.\sigma[B]\gets
   927	    \Call{state\_transition}{\Sigma.\sigma[B.\parent],B}$
   928	  \Comment{new at this layer}
   929	  \State add $B$ to $\Sigma.\T$; $\Sigma.\timestamp(B)\gets\Sigma.t$
   930	  \ForAll{$\mathit{vote}\in B.\mathsf{votes}$}
   931	    \State \Call{on\_goldfish\_vote}{$\Sigma,\mathit{vote}$}
   932	  \EndFor
   933	  \State \Call{update\_finality}{$\Sigma,\Sigma.\sigma[B]$}
   934	  \Comment{new at this layer}
   935	\EndFunction
   936	\vspace{1pt}
   937	\Function{update\_finality}{$\Sigma,\sigma$}
   938	  \State $\Sigma.\hmax\gets\max(\Sigma.\hmax,\sigma.h)$
   939	  \If{$\Sigma.F\preceq\sigma.J$ \textbf{and}
   940	      $(\sigma.h_j,\sigma.J.\rootf)>(\Sigma.h_j,\Sigma.J.\rootf)$}
   941	    \Comment{lex order}
   942	    \State $(\Sigma.J,\Sigma.h_j)\gets(\sigma.J,\sigma.h_j)$
   943	  \EndIf
   944	  \If{$\Sigma.F\prec\sigma.F$ \textbf{and} $\sigma.F\preceq\Sigma.J$
   945	      \textbf{and} $\sigma.F\in\Call{viable\_tree}{\Sigma}$}
   946	    \State $\Sigma.F\gets\sigma.F$
   947	  \EndIf
   948	\EndFunction
   949	\vspace{1pt}
   950	\Function{get\_fg\_root}{$\Sigma$}
   951	  \If{$\Sigma.\hmax=\Sigma.h_j+1$} \State \Return $\Sigma.J$ \EndIf
   952	  \State \Return $\Sigma.F$
   953	\EndFunction
   954	\vspace{1pt}
   955	\Function{get\_filtered\_block\_tree\_from}{$\Sigma,\mathit{blocks}$}
   956	  \State $\mathit{root}\gets\Call{get\_fg\_root}{\Sigma}$
   957	  \State \Return
   958	    $\{B\in\Call{viable\_tree\_from}{\Sigma,\mathit{blocks}}:
   959	      \mathit{root}\preceq B\}$
   960	\EndFunction
   961	\vspace{1pt}
   962	\Function{get\_filtered\_block\_tree}{$\Sigma$}
   963	  \State \Return
   964	    $\Call{get\_filtered\_block\_tree\_from}{\Sigma,\Sigma.\T}$
   965	\EndFunction
   966	\vspace{1pt}
   967	\Function{goldfish\_eligible}{$\Sigma,\mathit{votes},
   968	  \mathit{support\_votes},s,B$}
   969	  \State $\mathit{voters\_count}\gets
   970	    |\{v:\mathit{votes}\text{ holds a vote by }v\}|$
   971	  \State \Return $\Sigma.\sigma[B.\parent].h<\Sigma.\hmax-1$
   972	    or $2\,\Call{goldfish\_score}{\mathit{votes},
   973	      \mathit{support\_votes},s,B}>\mathit{voters\_count}$
   974	    or $B.\slot=\Sigma.s$
   975	\EndFunction
   976	\vspace{1pt}
   977	\Function{get\_sg\_root}{$\Sigma$}
   978	  \Comment{redefines the \S\ref{sec:majority-sg} majority root over the filtered tree}
   979	  \State $r\gets\round(\Sigma.s)$;\quad
   980	    $\mathit{tree}\gets\Call{get\_filtered\_block\_tree}{\Sigma}$
   981	  \State $\mathit{graded}\gets\{B\in\mathit{tree}:
   982	    \Call{relative\_majority}{\Sigma,r,\Sigma.t,\Sigma.t,B}\}$
   983	  \State \Return the deepest $B\in\mathit{graded}$, or
   984	    $\Call{get\_fg\_root}{\Sigma}$ if $\mathit{graded}=\emptyset$
   985	\EndFunction
   986	\vspace{1pt}
   987	\Function{get\_head\_in\_tree}{$\Sigma,\mathit{tree},
   988	  \mathit{votes},\mathit{support\_votes},k$}
   989	  \State $A\gets\Call{get\_sg\_root}{\Sigma}$
   990	  \State \Return $\Call{goldfish\_fork\_choice}{\Sigma,A,
   991	    \mathit{tree},\mathit{votes},\mathit{support\_votes},k}$
   992	\EndFunction
   993	\vspace{1pt}
   994	\Function{get\_head}{$\Sigma,\mathit{votes},\mathit{support\_votes},k$}
   995	  \State $\mathit{tree}\gets\Call{get\_filtered\_block\_tree}{\Sigma}$
   996	  \State \Return $\Call{get\_head\_in\_tree}{\Sigma,\mathit{tree},
   997	    \mathit{votes},\mathit{support\_votes},k}$
   998	\EndFunction
   999	\end{algorithmic}
  1000	}
  1001	
  1002	\subsection{SG/FG attestation}
  1003	
  1004	\begin{definition}[Anti-slashing record]\label{def:antislashing}
  1005	The record $\Lambda$ holds, for every height~$h$, the validator's first
  1006	target $\Lambda.\mathsf{target}[h]$, whether it emitted a timeout
  1007	$\Lambda.\mathsf{timeout}[h]$, and the target of its first finality
  1008	pair $\Lambda.\mathsf{lock}[h]$; initially
  1009	$(\bot,\mathsf{false},\bot)$.  It also keeps the set
  1010	$\Lambda.\mathsf{timeouts}$ of the $(h,T)$ pairs its timeouts have named,
  1011	so that $\Lambda.\mathsf{timeout}[h]$ holds exactly when some $(h,T)$ is
  1012	in it; a repeated timeout at~$h$ names the current entry, which may differ
  1013	from the one first named.  It belongs to the validator, not to the store,
  1014	and $\Call{record\_attestation}{}$ is the only place that writes it. A validator that never voted at height~$h_j$ may still emit a finality pair for $(h_j,J)$: the pair writes $\Lambda.\mathsf{lock}[h_j]\gets J$ before release, so from then on its height pair at $h_j$ is either $(h_j,J)$ or empty, never a timeout or another target; only a recorded timeout or a different first target at $h_j$ refuses the pair.  A height pair is refused, and left empty, when the record is locked elsewhere at its height.  Together,
  1015	$\Sigma$ and $\Lambda$ determine the combined attestation.  This is modeled
  1016	after the anti-slashing database of today's validators: a minimal, hardened
  1017	component of the validator client, separate from the beacon client that
  1018	keeps~$\Sigma$.  $\Call{create\_attestation}{}$ is its whole interface:
  1019	it takes the record and the vote information, produces the attestation,
  1020	and updates the record before releasing it; it never reads the store.
  1021	\end{definition}
  1022	
  1023	The height pair is built from a confirmed block's height fields: a target
  1024	vote can create a justification, and
  1025	only confirmed blocks may be justified.  The finality pair is built from
  1026	the head's finality fields: its subject is
  1027	already justified, so it may read an unconfirmed chain, and the head
  1028	chain state holds the freshest justification.  Here $C$ is
  1029	$\Sigma.\liveConfirmed$, or the relative-majority anchor when the anchor
  1030	does not precede it: the vote never falls behind or beside the
  1031	represented chain.  $H$ is the fork-choice head; the
  1032	graded action passes its own safe block and head.
  1033	$\Call{attest}{\Sigma,\Lambda}$ is the beacon-client side: it derives
  1034	the safe block, the head, and their chain-state fields from the
  1035	store, and
  1036	broadcasts what $\Call{create\_attestation}{}$ releases.  The pair rules
  1037	only read the record; $\Call{record\_attestation}{\Lambda,a}$ folds the
  1038	emitted attestation into it before release, and
  1039	$\Call{height\_pair}{}$ receives the same attestation's finality pair as
  1040	the lock at its height, so one attestation never forms E1 evidence.
  1041	$\Call{on\_tick}{}$ gains the record argument and, at~$a_r$, runs
  1042	$\Call{attest}{}$ in place of $\Call{sg\_vote}{}$.
  1043	
  1044	\captionof{figure}{FG attestation}\label{alg:pair-rules}
  1045	\nopagebreak
  1046	{\footnotesize
  1047	\begin{algorithmic}[1]
  1048	\Function{finality\_pair}{$\Lambda,h_j,J,h_F$}
  1049	  \If{$h_j>h_F$}
  1050	    \Comment{a justification not yet finalized}
  1051	    \If{$\Lambda.\mathsf{target}[h_j]\in\{\bot,J\}$ and
  1052	        not $\Lambda.\mathsf{timeout}[h_j]$ and
  1053	        $\Lambda.\mathsf{lock}[h_j]\in\{\bot,J\}$}
  1054	      \Comment{the record allows it}
  1055	      \State \Return $(h_j,J)$
  1056	    \EndIf
  1057	  \EndIf
  1058	  \State \Return $(\bot,\bot)$
  1059	\EndFunction
  1060	\vspace{1pt}
  1061	\Function{height\_pair}{$\Lambda,h_c,T_c,\nu,h_f,T_f$}
  1062	  \If{$h_c=\bot$} \State \Return $(\bot,\bot,\bot)$ \EndIf
  1063	  \State $\mathit{lock}\gets\Lambda.\mathsf{lock}[h_c]$;\quad
  1064	    \textbf{if} $h_c=h_f$ \textbf{then} $\mathit{lock}\gets T_f$
  1065	  \Comment{this attestation's own lock}
  1066	  \If{$\Lambda.\mathsf{timeout}[h_c]$}
  1067	    \State \Return $(h_c,T_c,\mathsf{true})$
  1068	    \Comment{a timeout repeats, naming the current entry}
  1069	  \EndIf
  1070	  \If{$\mathit{lock}\neq\bot$}
  1071	    \Comment{a lock repeats}
  1072	    \If{$\mathit{lock}=T_c$}
  1073	      \State \Return $(h_c,T_c,\mathsf{false})$
  1074	    \EndIf
  1075	    \State \Return $(\bot,\bot,\bot)$
  1076	    \Comment{locked elsewhere: wait out the height}
  1077	  \EndIf
  1078	  \If{$\Lambda.\mathsf{target}[h_c]\neq\bot$}
  1079	    \Comment{a recorded target repeats}
  1080	    \If{$\Lambda.\mathsf{target}[h_c]=T_c$}
  1081	      \State \Return $(h_c,T_c,\mathsf{false})$
  1082	    \EndIf
  1083	  \ElsIf{not $\nu$}
  1084	    \State \Return $(h_c,T_c,\mathsf{false})$
  1085	    \Comment{no history: adopt the chain's target}
  1086	  \EndIf
  1087	  \State \Return $(h_c,T_c,\mathsf{true})$
  1088	  \Comment{otherwise time out at $h_c$}
  1089	\EndFunction
  1090	\vspace{1pt}
  1091	\Function{create\_attestation}{$\Lambda,r,\mathit{safe},
  1092	  h_c,T_c,\nu,h_j,J,h_F$}
  1093	  \Comment{validator-client side: no store access}
  1094	  \State $(h_f,T_f)\gets\Call{finality\_pair}{\Lambda,h_j,J,h_F}$
  1095	  \State $(h,T,\tau)\gets\Call{height\_pair}{\Lambda,h_c,T_c,\nu,h_f,T_f}$
  1096	  \State $a\gets(\valindex,r,\mathit{safe},h,T,\tau,h_f,T_f)$
  1097	  \State \Call{record\_attestation}{$\Lambda,a$}; \Return $a$
  1098	  \Comment{record, then release}
  1099	\EndFunction
  1100	\vspace{1pt}
  1101	\Function{record\_attestation}{$\Lambda,a$}
  1102	  \Comment{the only writer of $\Lambda$}
  1103	  \State $(h,T,\tau,h_f,T_f)\gets a$'s height and finality pairs
  1104	  \If{$T_f\neq\bot$} \State $\Lambda.\mathsf{lock}[h_f]\gets T_f$ \EndIf
  1105	  \If{$h\neq\bot$}
  1106	    \If{not $\tau$ and $\Lambda.\mathsf{target}[h]=\bot$}
  1107	      \State $\Lambda.\mathsf{target}[h]\gets T$
  1108	    \EndIf
  1109	    \If{$\tau$}
  1110	      \State $\Lambda.\mathsf{timeout}[h]\gets\mathsf{true}$;
  1111	        add $(h,T)$ to $\Lambda.\mathsf{timeouts}$
  1112	    \EndIf
  1113	  \EndIf
  1114	\EndFunction
  1115	\vspace{1pt}
  1116	\Function{attest}{$\Sigma,\Lambda$}
  1117	  \State $r\gets\round(\Sigma.s)$;\quad $C\gets\Sigma.\liveConfirmed$
  1118	  \Comment{runs at $a_r$}
  1119	  \State $A\gets\Call{get\_sg\_root}{\Sigma}$;\quad
  1120	    \textbf{if} $A\not\preceq C$ \textbf{then} $C\gets A$
  1121	  \Comment{never vote behind the SG root}
  1122	  \State $\mathit{votes}\gets\Sigma.\gfPool[\Sigma.s]$
  1123	  \State $\mathit{support\_votes}\gets\{\mathit{vote}\in\mathit{votes}:
  1124	    \Sigma.\resolutionTime(\mathit{vote})<+\infty\}$
  1125	  \State $H\gets\Call{get\_head}{\Sigma,\mathit{votes},
  1126	    \mathit{support\_votes},\Sigma.s}$
  1127	  \Comment{current-slot votes have arrived by $a_r$}
  1128	  \State $(h_c,T_c,\nu)\gets(\Sigma.\sigma[C].h,\Sigma.\sigma[C].T_h,
  1129	    \Sigma.\sigma[C].\nj)$
  1130	  \State $(h_j,J,h_F)\gets(\Sigma.\sigma[H].h_j,\Sigma.\sigma[H].J,
  1131	    \Sigma.\sigma[H].h_F)$
  1132	  \State $a\gets\Call{create\_attestation}{\Lambda,r,C,h_c,T_c,\nu,
  1133	    h_j,J,h_F}$
  1134	  \State broadcast $a$;
  1135	    \Call{on\_sg\_vote}{$\Sigma,(\valindex,r,C)$}
  1136	  \Comment{the SG-vote projection}
  1137	\EndFunction
  1138	\vspace{1pt}
  1139	\Function{on\_tick}{$\Sigma,\Lambda,t$}
  1140	  \State $s\gets\lfloor t/(4\Delta)\rfloor$; $(\Sigma.t,\Sigma.s)\gets(t,s)$
  1141	  \If{$s>0$ and $t=t_s$ and $\valindex$ is the slot-$s$ proposer}
  1142	    \State \Call{propose\_block}{$\Sigma$}
  1143	  \EndIf
  1144	  \If{$s>0$ and $t=t_s+\Delta$}
  1145	    \State \Call{goldfish\_vote}{$\Sigma$}
  1146	  \EndIf
  1147	  \If{$s>0$ and $t=t_s+2\Delta$}
  1148	    \State \Call{update\_confirmation}{$\Sigma,s-1$}
  1149	  \EndIf
  1150	  \If{$t=a_r$ for the current round $r$}
  1151	    \State \Call{attest}{$\Sigma,\Lambda$}
  1152	    \Comment{in place of $\Call{sg\_vote}{}$}
  1153	  \EndIf
  1154	\EndFunction
  1155	\end{algorithmic}
  1156	}
  1157	

