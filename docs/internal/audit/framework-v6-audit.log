    90	    (E : AvailableChain.Generic.Env V) (I : Interface P)
    91	    (rho : AvailableChain.Generic.Run V P) (g : Output P)
    92	    (t₀ D : Time) : Prop :=
    93	  ∀ s : Slot, t₀ < P.proposalTime s → HonestAwakeProposer E rho s →
