    79	    (S : Setup V) {rho : Run V} (adm : AdmissibleCore S rho)
    80	    {v : V} (hv : v ∈ rho.honest) {a : NamedAttestation V}
    81	    {u t : Time} {h : Height}
    82	    (hemit : rho.emits S v (Object.attest a) u)
    83	    (hh : a.height_pair.erase.height? = some h) (hut : u ≤ t) :
    84	    h ≤ honestHMaxAt S rho t := by
    85	  have sch : ScheduleWellFormed S rho := adm.toNamedScheduleWellFormed
    86	  exact (honestEmittedHeight_le_localHMax S adm hemit hh).trans
    35	    (hm : a.height_pair.matchesEntry h entry = true)
