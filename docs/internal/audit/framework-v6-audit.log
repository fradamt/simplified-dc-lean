    26	private theorem heightPair_vote_of_height {hp : NamedHeightPair} {h : Height}
    27	    (he : hp.erase.height? = some h) :
    28	    ∃ entry timeout, hp = .vote h entry timeout := by
    29	  cases hp with
    30	  | empty => simp [NamedHeightPair.erase, HeightPair.height?] at he
    31	  | vote h' entry timeout =>
    32	      have hEq : h' = h := by
    33	        cases timeout <;>
    34	          simpa [NamedHeightPair.erase, HeightPair.height?] using he
    35	      exact ⟨entry, timeout, by rw [hEq]⟩
    36	
