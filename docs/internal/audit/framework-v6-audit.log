    10	variable {V : Type} {n : Nat} {P : AvailableChain.Generic.ProtocolSpec n}
    11	  [DecidableEq V] [_root_.Fintype V]
    12	
    13	/-- Synchronous from `t₀`, with honest awake weight above faulty weight. -/
    14	structure SleepyRegime
    15	    (P : AvailableChain.Generic.ProtocolSpec n)
    16	    (E : AvailableChain.Generic.Env V) (I : Interface P)
    17	    (rho : AvailableChain.Generic.Run V P) (t₀ : Time) : Prop where
    18	  execution : ExecutionValid P E rho
    19	  rootInjective : RootInjective E I rho
    20	  partialSynchrony : PartialSynchrony P E rho
    21	  acceptedRelay : AcceptedObjectRelay P E rho
    22	  gst_zero : E.t_GST = 0
    23	  start_zero : t₀ = 0
    24	  participation : ∀ t, t₀ ≤ t → t ≤ rho.horizon → AwakeMajority E rho t
    25	
    26	/-- Sleepy, with the η-sleepy inequality on the same interval. -/
    27	structure StableSleepyRegime
    28	    (P : AvailableChain.Generic.ProtocolSpec n)
    29	    (E : AvailableChain.Generic.Env V) (I : Interface P) (C : Constants)
    30	    (rho : AvailableChain.Generic.Run V P) (t₀ : Time) : Prop
    31	    extends SleepyRegime P E I rho t₀ where
    32	  etaSleepy : ∀ t, t₀ ≤ t → t ≤ rho.horizon → EtaSleepy E C rho t
    33	
    34	/-- Sleepy with full honest participation and less than one-quarter faulty weight. -/
    35	structure FastRegime
    36	    (P : AvailableChain.Generic.ProtocolSpec n)
    37	    (E : AvailableChain.Generic.Env V) (I : Interface P)
    38	    (rho : AvailableChain.Generic.Run V P) (t₀ : Time) : Prop
    39	    extends SleepyRegime P E I rho t₀ where
    40	  fullParticipation : FullParticipation E rho t₀
    41	  belowQuarter : BelowQuarter rho
    42	
    43	/-- A healthy prefix followed by arbitrary delivery during `[b₀,b₁)`. -/
    44	structure OutageRegime
    45	    (P : AvailableChain.Generic.ProtocolSpec n)
    46	    (E : AvailableChain.Generic.Env V) (I : Interface P) (C : Constants)
    47	    (rho : AvailableChain.Generic.Run V P)
    48	    (T b₀ b₁ : Time) : Prop where
    49	  execution : ExecutionValid P E rho
    50	  rootInjective : RootInjective E I rho
    51	  healthy : HealthyPrefixDelivery P E rho b₀
    52	  acceptedRelay : HealthyAcceptedObjectRelay P E rho b₀
    53	  interval : 0 ≤ T ∧ T ≤ b₀ ∧ b₀ ≤ b₁ ∧ b₁ ≤ rho.horizon
    54	  armed : T + C.armingLag ≤ b₀
    55	  withinBudget : b₁ - b₀ ≤ C.budget
    56	  sleepyBefore : ∀ t, 0 ≤ t → t < b₀ → AwakeMajority E rho t
    57	  etaSleepyBefore : ∀ t, 0 ≤ t → t < b₀ → EtaSleepy E C rho t
    58	
    59	/-- The fast lag replaces the general lag. The high count holds on the
    60	whole healthy prefix, including times before the protected read. -/
    61	structure FastOutageRegime
    62	    (P : AvailableChain.Generic.ProtocolSpec n)
    63	    (E : AvailableChain.Generic.Env V) (I : Interface P) (C : Constants)
    64	    (rho : AvailableChain.Generic.Run V P)
    65	    (T b₀ b₁ : Time) : Prop
    66	    extends OutageRegime P E I { C with armingLag := C.fastArmingLag } rho T b₀ b₁ where
    67	  highParticipation : ∀ t, 0 ≤ t → t < b₀ →
    68	    (n + 1) / 2 ≤ (awakeAt E rho.honest t).card
    69	
    70	/-- Delivery is arbitrary before GST. After GST, current participation
    71	exceeds θrec and honest opening proposers recur. -/
    72	structure RecoveryRegime
    73	    (P : AvailableChain.Generic.ProtocolSpec n)
    74	    (E : AvailableChain.Generic.Env V) (I : Interface P) (C : Constants)
    75	    (rho : AvailableChain.Generic.Run V P) : Prop where
    76	  execution : ExecutionValid P E rho
    77	  rootInjective : RootInjective E I rho
    78	  partialSynchrony : PartialSynchrony P E rho
    79	  acceptedRelay : AcceptedObjectRelay P E rho
    80	  participation : ∀ t, E.t_GST ≤ t → t ≤ rho.horizon →
    81	    C.θrec * ((awakeAt E rho.honest t).card + (faulty rho).card : ℚ) <
    82	      ((awakeAt E rho.honest t).card : ℚ)
    83	  full : C.recoveryFull = true → FullParticipation E rho E.t_GST
    84	  recurrence : HonestProposerRecurrence E I rho E.t_GST C.proposerGap
    85	  horizon : E.t_GST + C.recoveryBound ≤ rho.horizon
    86	
    87	end AvailableChain.Statements.Generic
    88	end
