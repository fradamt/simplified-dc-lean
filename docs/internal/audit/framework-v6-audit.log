    69	  slotsAt_spec : ∀ s t, s ∈ slotsAt t ↔ proposalTime s = t
    70	  slotsAt_nodup : ∀ t, (slotsAt t).Nodup
    71	  /-- The proposal payload of the proposer of slot `s` in this state. -/
    72	  propose : State → Slot → Option Payload
    73	  /-- Unsigned payloads at a tick. Any node, sampled or not, can send them. -/
    74	  gossip : State → Time → List Payload
