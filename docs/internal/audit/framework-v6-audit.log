    64	        ⟨.proposer s, p⟩ (P.proposalTime s)
    65	
    66	/-- The proposer of slot `s` is honest and awake at the proposal time. -/
    67	def HonestAwakeProposer (E : AvailableChain.Generic.Env V)
    68	    (rho : AvailableChain.Generic.Run V P) (s : Slot) : Prop :=
    69	  rho.proposerOf s ∈ rho.honest ∧ E.awake (rho.proposerOf s) (P.proposalTime s) = true
    70	
    71	/-- A block proposed by an honest proposer strictly after `t`. -/
    72	def honestAfter (E : AvailableChain.Generic.Env V) (I : Interface P)
    73	    (rho : AvailableChain.Generic.Run V P) (t : Time)
    74	    (B : Block) : Prop :=
    75	  ∃ s : Slot, t < P.proposalTime s ∧ HonestProposalAt E I rho s B
    76	
    77	/-- Liveness of `g` from `t₀`: from every time `t ≥ t₀`, some block proposed by an honest proposer
    78	after `t` is strictly above every honest read at `t` and in every honest read by `t + D`. -/
    79	def LiveFrom (P : AvailableChain.Generic.ProtocolSpec n)
    80	    (E : AvailableChain.Generic.Env V) (I : Interface P) (rho : AvailableChain.Generic.Run V P)
    81	    (g : Output P) (t₀ D : Time) : Prop :=
    82	  ∀ t : Time, t₀ ≤ t → t + D ≤ rho.horizon →
