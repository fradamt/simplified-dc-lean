   282	def forkChoice {n : Nat} (st : State n) (tree : List Block)
   283	    (raw support : List (Wire n)) (current : Slot) : Block :=
   284	  ghost (liveRoot st) tree (goldfishScore st.blocks raw support)
   285	    (goldfishEligible st.blocks raw support current)
   286	
   287	def propose (_p : Params) {n : Nat} (st : State n) (s : Slot) : Option (Msg n) :=
   288	  if s == 0 then none else
   289	    let raw := proposerView st s
   290	    let support := proposerSupportView st s
   291	    let parent := forkChoice st st.blocks raw support s
   292	    let b := Block.node parent s ⟨s * (parent.root.value + 1)⟩
   293	    some (.proposal b (raw.filterMap toHead?) (support.filterMap toHead?))
   294	
   295	def act (p : Params) {n : Nat} (st : State n) (s : Slot) : Option (Msg n) :=
   296	  if s == 0 then some (.head .genesis) else
   297	    some (.head (forkChoice st (voterTree p st s)
   298	      (voterView p st s) (voterSupportView p st s) s))
   299	
   300	def admitVote (p : Params) {n : Nat} (st : State n) (o : Wire n) : State n :=
   301	  match o.auth, o.payload with
   302	  | .seat r i, .head _ =>
   303	      let current := (st.now / (4 * p.Δ)).toNat
   304	      -- Retain old-label HEADs for relay and equivocation evidence. Receipt
   305	      -- stamps keep them out of earlier frozen views and snapshots.
   306	      if r < current - 1 || current < r || decide (o ∈ st.votes) ||
   307	          equivocates (votesAt st r) i then st else
   308	        { st with votes := st.votes ++ [o], voteStamp := st.voteStamp ++ [(o, st.now)] }
   309	  | _, _ => st
   310	
   311	/-- Block admission then carried-vote admission, following the source
   312	`Handlers.lean` order. The support subset remains fixed metadata. -/
   313	def admitProposal (p : Params) {n : Nat} (st : State n) (o : Wire n)
   314	    (b : Block) (raw : List (HeadWire n)) : State n :=
   315	  let current := (st.now / (4 * p.Δ)).toNat
   316	  let correctProposer := match o.auth with
   317	    | .proposer s => s == b.slot
   318	    | _ => false
   319	  if b.slot > current || !blockKnown st b.parent || b ∈ st.blocks ||
   320	      !(b.parent.slot < b.slot) || !correctProposer then st else
   321	    let st' := { st with
   322	      blocks := st.blocks ++ [b]
   323	      blockStamp := st.blockStamp ++ [(b, st.now)]
   324	      proposals := st.proposals ++ [o] }
   325	    raw.foldl (fun acc row => admitVote p acc (fromHead row)) st'
   326	
   327	def process (p : Params) {n : Nat} (st : State n) (o : Wire n) : State n :=
   328	  match o.auth, o.payload with
   329	  | .seat _ _, .head _ => admitVote p st o
   330	  | .proposer _, .proposal b raw _ => admitProposal p st o b raw
   331	  | _, _ => st
   332	
   333	def wellFormed {n : Nat} (o : Wire n) : Bool :=
   334	  match o.auth, o.payload with
   335	  | .seat _ _, .head _ => true
   336	  | .proposer s, .proposal b raw support =>
   337	      s == b.slot && b.parent?.isSome && b.parent.slot < s &&
   338	      raw.all (fun v => match v.auth with
   339	        | .seat r _ => r == s - 1
   340	        | _ => false) &&
   341	      support.all (fun v => decide (v ∈ raw))
   342	  | _, _ => false
   343	
   344	def depsPresent {n : Nat} (st : State n) (o : Wire n) : Bool :=
   345	  match o.payload with
   346	  | .head _ => true
   347	  | .proposal b _ _ => blockKnown st b.parent
   348	
   349	def processed {n : Nat} (st : State n) (o : Wire n) : Bool :=
   350	  match o.payload with
   351	  | .head _ => decide (o ∈ st.votes)
   352	  | .proposal b _ _ => blockKnown st b
   353	
   354	def carries {n : Nat} (parent child : Wire n) : Prop :=
   355	  match parent.payload with
   356	  | .head _ => False
   357	  | .proposal _ raw support => child ∈ raw.map fromHead ∨ child ∈ support.map fromHead
   358	
   359	/-- A direct delivery calls its handler. A proposal calls its raw HEAD
   360	handlers only when its block enters the store. This matches the reference
   361	`Execution.handles` / `NamedReceiptCalls.postCore` admission test.
   362	Support metadata alone does not cause a call; `carries` remains structural
   363	for signature checks, including rejected proposals. -/
   364	def handles (p : Params) {n : Nat} (st : State n) (parent child : Wire n) : Prop :=
   365	  parent = child ∨ match parent.payload with
   366	    | .proposal b raw _ =>
   367	        b ∉ st.blocks ∧ b ∈ (process p st parent).blocks ∧ child ∈ raw.map fromHead
   368	    | .head _ => False
