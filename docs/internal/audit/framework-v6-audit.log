     2	public import AvailableChainStatements.Strong.Interface
     3	public import AvailableChainStatements.Generic.Regimes
     4	
     5	@[expose] public section
     6	namespace AvailableChain.Statements.Generic
     7	
     8	open AvailableChain
     9	
    10	variable {V : Type} {n : Nat} [DecidableEq V] [Fintype V]
    11	
    12	def FaultBound (P : AvailableChain.Generic.ProtocolSpec n)
    13	    (f : Nat) (rho : AvailableChain.Generic.Run V P) : Prop :=
    14	  (faulty rho).card ≤ f
    15	
    16	/-- Sound arming from healthy genesis, followed by arbitrary delivery.
    17	The instance must derive common installation from these fields. The
    18	regime has no certificate, budget, or post-`b₀` premise. -/
    19	structure StrongArmedRegime
    20	    (P : AvailableChain.Generic.ProtocolSpec n)
    21	    (E : AvailableChain.Generic.Env V) (I : StrongInterface P)
    22	    (f : Nat) (rho : AvailableChain.Generic.Run V P)
    23	    (T b₀ : Time) : Prop where
    24	  execution : ExecutionValid P E rho
    25	  rootInjective : RootInjective E I.toInterface rho
    26	  healthy : HealthyPrefixDelivery P E rho b₀
    27	  acceptedRelay : HealthyAcceptedObjectRelay P E rho b₀
    28	  faultBound : FaultBound P f rho
    29	  interval : 0 ≤ T ∧ T ≤ b₀ ∧ b₀ ≤ rho.horizon
    30	  armed : T + E.Δ ≤ b₀
    31	  sleepyBefore : ∀ t, 0 ≤ t → t < b₀ → AwakeMajority E rho t
    32	
    33	end AvailableChain.Statements.Generic
    34	end
     1	module
     2	public import AvailableChainModel.Objects.Identifiers
     3	
     4	@[expose] public section
     5	
     6	namespace AvailableChain
     7	
     8	/-- The authentication of a wire object. There are no validator keys.
     9	
    10	* `seat ℓ i`: seat `i` of the committee of label `ℓ`. Every label has a
    11	  committee of all `n` seats. The run assigns seats to validators by a fresh
    12	  bijection per label, which honest code cannot see, so seats of different
    13	  labels are unlinkable.
    14	* `proposer s`: the proposer of slot `s`, a slot-scoped key.
    15	* `none`: an unsigned object. Anyone can create it. -/
    16	inductive Auth (L : Type) (n : Nat) where
    17	  | seat (ℓ : L) (i : Fin n)
    18	  | proposer (s : Slot)
    19	  | none
    20	  deriving DecidableEq, Repr
    21	
    22	/-- A wire object: an authentication and a protocol payload. Honest code
    23	chooses only the payload; the engine attaches the authentication. A payload
    24	can carry other signed objects (a nested inductive through `Signed`). -/
    25	structure Signed (L : Type) (n : Nat) (Payload : Type) where
