     2	public import AvailableChainSAPC.Model.Certificates
     3	
     4	@[expose] public section
     5	namespace AvailableChain.SAPC
     6	
     7	/-- Archive a complete signature once. Only the base projection enters
     8	the shared two-target cache, with its original base receipt stamp. -/
     9	def receiveHead (p : Params) {n : Nat} (st : State n) (o : HeadWire n) : State n :=
    10	  match o.auth with
    11	  | .seat r _ =>
    12	      if (st.base.now / (4 * p.Δ)).toNat < r then st else
    13	        let st := if o ∈ st.receivedHeads then st else
    14	          { st with receivedHeads := st.receivedHeads ++ [o],
    15	                    headStamp := st.headStamp ++ [(o, st.base.now)] }
    16	        { st with base := GridCO.admitVote p.engine st.base (baseWire o) }
    17	  | _ => st
    18	
    19	def admitHead (p : Params) {n : Nat} (st : State n) (o : HeadWire n) : State n :=
    20	  collectPCs p (receiveHead p st o)
    21	
    22	/-- Reuse the exact shared block admission test. The empty final argument
    23	defers carried HEAD calls to the handler for complete signatures. -/
    24	def proposalBase (p : Params) {n : Nat} (st : State n) (o : Wire n)
    25	    (b : Block) (raw support : List (HeadWire n)) : GridCO.State n :=
    26	  GridCO.admitProposal p.engine st.base (baseProposal o b raw support) b []
    27	
    28	def proposalEnters (p : Params) {n : Nat} (st : State n) (o : Wire n)
    29	    (b : Block) (raw support : List (HeadWire n)) : Bool :=
    30	  !(GridCO.blockKnown st.base b) &&
    31	    GridCO.blockKnown (proposalBase p st o b raw support) b
    32	
    33	def pcMembers {n : Nat} (c : Option (PC n)) : List (HeadWire n) :=
    34	  (c.map PC.witnesses).getD []
    35	
    36	def admitProposal (p : Params) {n : Nat} (st : State n) (o : Wire n)
    37	    (b : Block) (raw support : List (HeadWire n)) (c : Option (PC n)) : State n :=
    38	  if proposalEnters p st o b raw support then
    39	    let st := { st with
    40	      base := proposalBase p st o b raw support
    41	      proposals := st.proposals ++ [o] }
    42	    collectPCs p ((raw ++ pcMembers c).foldl (receiveHead p) st)
    43	  else st
    44	
    45	def pcEnvelopeReady (p : Params) {n : Nat} (st : State n) (c : PC n) : Bool :=
    46	  pcWellFormed p c && pcPaths st c &&
    47	    c.slot + 1 ≤ (st.base.now / (4 * p.Δ)).toNat
    48	
    49	def process (p : Params) {n : Nat} (st : State n) (o : Wire n) : State n :=
    50	  match o.auth, o.payload with
    51	  | .seat _ _, .head h => admitHead p st ⟨o.auth, h⟩
    52	  | .proposer _, .proposal b raw support c => admitProposal p st o b raw support c
    53	  | .none, .pc c =>
    54	      if pcEnvelopeReady p st c then
    55	        let st := c.witnesses.foldl (receiveHead p) st
    56	        -- A direct valid encoding takes priority over an assembled tie.
    57	        collectPCs p (installPC st c)
    58	      else st
    59	  | _, _ => st
    60	
    61	def wellFormed (p : Params) {n : Nat} (o : Wire n) : Bool :=
    62	  match o.auth, o.payload with
    63	  | .seat _ _, .head _ => true
    64	  | .proposer s, .proposal b raw support c =>
    65	      s == b.slot && b.parent?.isSome && b.parent.slot < s &&
    66	      raw.all (fun v => match v.auth with
    67	        | .seat r _ => r == s - 1
    68	        | _ => false) &&
    69	      support.all (fun v => v ∈ raw) &&
    70	      (match c with | none => true | some cert => pcWellFormed p cert)
    71	  | .none, .pc c => pcWellFormed p c
    72	  | _, _ => false
    73	
    74	def depsPresent {n : Nat} (st : State n) (o : Wire n) : Bool :=
    75	  match o.payload with
    76	  | .head _ => true
    77	  | .proposal b _ _ _ => GridCO.blockKnown st.base b.parent
    78	  | .pc c => pcPaths st c
    79	
    80	def processed (p : Params) {n : Nat} (st : State n) (o : Wire n) : Bool :=
    81	  match o.payload with
    82	  | .head h => ⟨o.auth, h⟩ ∈ st.receivedHeads
    83	  | .proposal b _ _ _ => GridCO.blockKnown st.base b
    84	  | .pc c => pcValid p st c
    85	
    86	/-- Structural signature obligations include rejected containers. -/
    87	def carries {n : Nat} (parent child : Wire n) : Prop :=
    88	  match parent.payload with
    89	  | .head _ => False
    90	  | .proposal _ raw support c =>
    91	      child ∈ (raw ++ support ++ pcMembers c).map fromHead
    92	  | .pc c => child ∈ c.witnesses.map fromHead
    93	
    94	/-- Member calls follow the actual admission branches, not containment. -/
    95	def handles (p : Params) {n : Nat} (st : State n) (parent child : Wire n) : Prop :=
    96	  parent = child ∨ match parent.auth, parent.payload with
    97	    | .proposer _, .proposal b raw support c =>
    98	        proposalEnters p st parent b raw support = true ∧
    99	          child ∈ (raw ++ pcMembers c).map fromHead
   100	    | .none, .pc c =>
   101	        pcEnvelopeReady p st c = true ∧ child ∈ c.witnesses.map fromHead
   102	    | _, _ => False
   103	
   104	end AvailableChain.SAPC
   105	end
