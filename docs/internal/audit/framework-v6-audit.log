    16	/-- Genesis and every ancestor (including the tip itself) of a block
    17	named by `I.block` in a delivered or emitted payload. -/
    18	def BlockInRun (E : AvailableChain.Generic.Env V) (I : Interface P)
    19	    (rho : AvailableChain.Generic.Run V P) (B : Block) : Prop :=
    20	  B = .genesis ∨ ∃ v o t tip,
    21	    (AvailableChain.Generic.Run.processes P rho v o t ∨
    22	      AvailableChain.Generic.Run.emits P E rho v o t) ∧
    23	    I.block o.payload = some tip ∧ Block.Preceq B tip
    24	
    25	/-- Collision resistance of block roots, idealized as injectivity on
    26	genesis and the ancestors of all blocks named by this run. The raw `Block`
    27	type stays unrestricted; only the run's named scope must be collision-free. -/
    28	def RootInjective (E : AvailableChain.Generic.Env V) (I : Interface P)
    29	    (rho : AvailableChain.Generic.Run V P) : Prop :=
    30	  ∀ B C, BlockInRun E I rho B → BlockInRun E I rho C →
    31	    B.root = C.root → B = C
    32	
    33	/-- A public time is an integer multiple of the environment's time unit. -/
    34	def PublicTime (E : AvailableChain.Generic.Env V) (t : Time) : Prop :=
    35	  ∃ k : Nat, t = (k : Time) * E.Δ
    36	
    37	/-- The event schedule is sorted, finite, honest-only, and total on public times. -/
    38	structure ScheduleWellFormed
    39	    (E : AvailableChain.Generic.Env V)
    40	    (rho : AvailableChain.Generic.Run V P) : Prop where
    41	  horizon_nonneg : 0 ≤ rho.horizon
    42	  sorted : rho.events.Pairwise (fun e f => e.key ≤ f.key)
    43	  nodup : rho.events.Nodup
    44	  in_horizon : ∀ e ∈ rho.events, 0 ≤ e.time ∧ e.time ≤ rho.horizon
    45	  honest_only : ∀ e ∈ rho.events, e.node ∈ rho.honest
    46	  tick_public : ∀ v t,
    47	    AvailableChain.Generic.Event.tick v t ∈ rho.events → PublicTime E t
    48	  tick_total : ∀ v ∈ rho.honest, ∀ t, PublicTime E t → 0 ≤ t → t ≤ rho.horizon →
    49	    AvailableChain.Generic.Event.tick v t ∈ rho.events
    50	
    51	/-- Delivered objects satisfy the wire, dependency, and freshness checks. -/
    52	structure DeliveryWellFormed
    53	    (P : AvailableChain.Generic.ProtocolSpec n)
    54	    (rho : AvailableChain.Generic.Run V P) : Prop where
    55	  wire : ∀ (i : Nat) (v : V) (o : P.Object) (t : Time),
    56	    rho.events[i]? = some (AvailableChain.Generic.Event.deliver v o t) →
    57	      P.wellFormed o = true
    58	  deps : ∀ (i : Nat) (v : V) (o : P.Object) (t : Time),
    59	    rho.events[i]? = some (AvailableChain.Generic.Event.deliver v o t) →
    60	      P.depsPresent (AvailableChain.Generic.Run.stateBefore P rho i v) o = true
    61	  fresh : ∀ (i : Nat) (v : V) (o : P.Object) (t : Time),
    62	    rho.events[i]? = some (AvailableChain.Generic.Event.deliver v o t) →
    63	      P.processed (AvailableChain.Generic.Run.stateBefore P rho i v) o = false
    64	
    65	/-- Signatures are unforgeable: an object whose authentication an honest
    66	validator holds (a seat assigned to it, or its proposer key), delivered
    67	directly or carried by a delivered object, was emitted by that validator.
    68	Faulty holders are unconstrained: they can sign any number of objects at any
    69	time. Unsigned objects are unconstrained. -/
    70	structure UnforgeableSignatures
    71	    (P : AvailableChain.Generic.ProtocolSpec n)
    72	    (E : AvailableChain.Generic.Env V)
    73	    (rho : AvailableChain.Generic.Run V P) : Prop where
    74	  unforgeable : ∀ v o t,
    75	    AvailableChain.Generic.Run.processes P rho v o t →
    76	      ∀ u ∈ rho.honest, AvailableChain.Generic.Run.holder P rho o.auth = some u →
    77	        ∃ t', t' ≤ t ∧ AvailableChain.Generic.Run.emits P E rho u o t'
    78	  carried : ∀ v o t,
    79	    AvailableChain.Generic.Run.processes P rho v o t →
    80	      ∀ o', P.carries o o' → ∀ u ∈ rho.honest,
    81	        AvailableChain.Generic.Run.holder P rho o'.auth = some u →
    82	        ∃ t', t' ≤ t ∧ AvailableChain.Generic.Run.emits P E rho u o' t'
    83	
    84	/-- Valid execution. Asleep nodes need no extra field: the engine gates
    85	emission on `awake`, and a tick changes the state only through `clock`. -/
    86	structure ExecutionValid
    87	    (P : AvailableChain.Generic.ProtocolSpec n)
    88	    (E : AvailableChain.Generic.Env V)
    89	    (rho : AvailableChain.Generic.Run V P) : Prop extends
    90	  ScheduleWellFormed E rho, DeliveryWellFormed P rho, UnforgeableSignatures P E rho
    91	
