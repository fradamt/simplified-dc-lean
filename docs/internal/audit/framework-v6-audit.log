   104	/-- Broadcast and accepted-object relay complete after GST,
   105	except for objects excluded by the receiver at the deadline. -/
   106	structure PartialSynchrony
   107	    (P : AvailableChain.Generic.ProtocolSpec n)
   108	    (E : AvailableChain.Generic.Env V)
   109	    (rho : AvailableChain.Generic.Run V P) : Prop where
   110	  broadcast : ∀ v ∈ rho.honest, ∀ o t,
   111	    AvailableChain.Generic.Run.emits P E rho v o t → ∀ w ∈ rho.honest,
   112	      max t E.t_GST + E.Δ ≤ rho.horizon →
   113	        P.excludes
   114	            (AvailableChain.Generic.Run.stateBeforeTime P rho
   115	              (max t E.t_GST + E.Δ) w) o = false →
   116	        ∃ t', t ≤ t' ∧ t' < max t E.t_GST + E.Δ ∧
   117	          ∃ j, AvailableChain.Generic.Run.handlesAt P rho j w o t'
   118	  relay : ∀ v ∈ rho.honest, ∀ i o t,
   119	    AvailableChain.Generic.Run.acceptsAt P rho i v o t → ∀ w ∈ rho.honest,
   120	      P.processed
   121	          (AvailableChain.Generic.Run.stateBefore P rho (i + 1) w) o = false →
   122	        max t E.t_GST + E.Δ ≤ rho.horizon →
   123	        P.excludes
   124	            (AvailableChain.Generic.Run.stateBeforeTime P rho
   125	              (max t E.t_GST + E.Δ) w) o = false →
   126	        ∃ t', t ≤ t' ∧ t' < max t E.t_GST + E.Δ ∧
   127	            ∃ j, AvailableChain.Generic.Run.handlesAt P rho j w o t'
