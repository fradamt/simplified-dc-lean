   226	  Const     : Type                           -- this claim's constants
   227	  valid     : Const → Prop
   228	  le        : Const → Const → Bool           -- decidable; `le c c'`: c' is
   229	                                             -- at least as weak as c
   230	  le_refl   : ∀ c, le c c
   231	  le_trans  : ∀ a b c, le a b → le b c → le a c
