   842	```lean
   843	/-- [pin fj.frame.v1] The controls of one block set (r148 §2 FJ_FRAME, R1 view
   844	form): H, the lex pair with `F ⪯ J`, and the contest at `H = j+1` when a
   845	height-H block does not extend J. -/
   846	def fjControls (F : FGBlock V) (Vw : View V) : Controls V :=
   847	  let H := frontier E cfg Vw
   848	  let p := lexMax E cfg F Vw
   849	  ⟨F, H, p.1, p.2, decide (H = p.1 + 1) &&
   850	    decide (∃ W ∈ Vw, hOf E cfg W = H ∧ ¬ FGBlock.Preceq p.2 W)⟩
   851	
   852	/-- [pin fj.frame.v3] The filtered tree of any block set under given controls
   853	(`get_filtered_block_tree_from(Σ, blocks)` with `viable_tree_from`, alfs4 lines
   854	988–994, 1013–1020). -/
   855	def filteredFrom (c : Controls V) (blocks : Finset (FGBlock V)) : Finset (FGBlock V) :=
   856	  blocks.filter (fun B => FGBlock.preceq c.F B && FGBlock.preceq c.Z B &&
   857	    decide (∃ W ∈ blocks, FGBlock.Preceq B W ∧ c.lo ≤ hOf E cfg W))
   858	
   859	/-- [pin fj.frame.v1] The special case: controls and filtered tree from one
   860	block set. -/
   861	def fjFrame (F : FGBlock V) (Vw : View V) : Frame V :=
   862	  let c := fjControls E cfg F Vw
   863	  ⟨c.F, c.H, c.j, c.J, c.Z, c.lo, filteredFrom E cfg c Vw, c.contest⟩
   864	```
