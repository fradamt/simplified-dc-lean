+/-- The registry ids in a free text: each word `<layer>.<name>.….v<n>` with
+layer `ap`, `fg`, `fj` or `comp`. A word is a maximal run of letters, digits,
+`.` and `_`; a final `.` is not part of the id. -/
+def idTokens (s : String) : List String :=
+  let isW (c : Char) := c.isAlphanum || c == '.' || c == '_'
+  let step := fun (acc : List (List Char)) (c : Char) =>
+    if isW c then match acc with
+      | w :: ws => (c :: w) :: ws
+      | [] => [[c]]
+    else [] :: acc
+  let words := ((s.toList.foldl step [[]]).map fun w => (w.dropWhile (· == '.')).reverse)
+  words.reverse.filterMap fun w =>
+    match (String.ofList w).splitOn "." with
+    | layer :: rest@(_ :: _ :: _) =>
+      match rest.getLast!.toList with
+      | 'v' :: ds@(_ :: _) =>
+        if ["ap", "fg", "fj", "comp"].contains layer && ds.all Char.isDigit
+        then some (String.ofList w) else none
+      | _ => none
+    | _ => none
+
+/-- The ids that `scripts/check-fg-pins.sh` checks, one per line with a tag: `pin`
+(a pin id), `ap` and `external` (an id in the text of an active `.ap` or
+`.external` clause), and `notFormalized` (a historical entry). The ids come from
+the elaborated values, not from the source text (Astra P01). -/
+def emitIds (ps : List Pin) (nf : List (String × String)) : IO Unit := do
+  for p in ps do
+    IO.println s!"pin {p.id}"
+    for c in p.clauses do
+      match c.cov with
+      | .ap t => for i in idTokens t do IO.println s!"ap {i}"
+      | .external t => for i in idTokens t do IO.println s!"external {i}"
+      | _ => pure ()
+  for (i, _) in nf do IO.println s!"notFormalized {i}"
