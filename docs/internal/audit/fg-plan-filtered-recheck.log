  1330	\captionof{figure}{Complete protocol: attestation client}\label{alg:client}
  1331	\nopagebreak
  1332	{\footnotesize
  1333	\begin{algorithmic}[1]
  1334	\Function{finality\_pair}{$\Lambda,h_j,J,h_F$}
  1335	  \Comment{\DC{7}, unchanged}
  1336	  \If{$h_j>h_F$}
  1337	    \Comment{a justification not yet finalized}
  1338	    \If{$\Lambda.\mathsf{target}[h_j]\in\{\bot,J\}$ and
  1339	        not $\Lambda.\mathsf{timeout}[h_j]$ and
  1340	        $\Lambda.\mathsf{lock}[h_j]\in\{\bot,J\}$}
  1341	      \State \Return $(h_j,J)$
  1342	    \EndIf
  1343	  \EndIf
  1344	  \State \Return $(\bot,\bot)$
  1345	\EndFunction
  1346	\vspace{1pt}
  1347	\Function{height\_pair}{$\Lambda,h_c,T_c,\nu,h_f,T_f$}
  1348	  \Comment{\DC{7}, adapted: flag $\chi$}
  1349	  \If{$h_c=\bot$} \State \Return $(\bot,\bot,\bot)$
  1350	    \Comment{no fresh source}
  1351	  \EndIf
  1352	  \State $\mathit{lock}\gets\Lambda.\mathsf{lock}[h_c]$;\quad
  1353	    \textbf{if} $h_c=h_f$ \textbf{then} $\mathit{lock}\gets T_f$
  1354	  \Comment{this row's own lock}
  1355	  \If{$\Lambda.\mathsf{timeout}[h_c]$}
  1356	    \State \Return $(h_c,T_c,\mathsf{true})$
  1357	    \Comment{a timeout repeats, naming the current entry}
  1358	  \EndIf
  1359	  \If{$\mathit{lock}\neq\bot$}
  1360	    \If{$\mathit{lock}=T_c$}
  1361	      \State \Return $(h_c,T_c,\mathsf{false})$
  1362	    \EndIf
  1363	    \State \Return $(\bot,\bot,\bot)$
  1364	    \Comment{locked elsewhere: wait out the height}
  1365	  \EndIf
  1366	  \If{$\Lambda.\mathsf{target}[h_c]\neq\bot$}
  1367	    \If{$\Lambda.\mathsf{target}[h_c]=T_c$}
  1368	      \State \Return $(h_c,T_c,\mathsf{false})$
  1369	      \Comment{a recorded target repeats}
  1370	    \EndIf
  1371	  \ElsIf{not $\nu$}
  1372	    \State \Return $(h_c,T_c,\mathsf{false})$
  1373	    \Comment{no history: adopt the source's entry}
  1374	  \EndIf
  1375	  \State \Return $(h_c,T_c,\mathsf{true})$
  1376	  \Comment{otherwise time out at $h_c$}
  1377	\EndFunction
  1378	\vspace{1pt}
  1379	\Function{create\_attestation}{$\Lambda,r,h_c,T_c,\nu,h_j,J,h_F$}
  1380	  \Comment{\DC{7}, adapted (b): no safe field}
  1381	  \State $(h_f,T_f)\gets\Call{finality\_pair}{\Lambda,h_j,J,h_F}$
  1382	  \State $(h,T,\chi)\gets\Call{height\_pair}{\Lambda,h_c,T_c,\nu,h_f,T_f}$
  1383	  \State $a\gets(\valindex,r,h,T,\chi,h_f,T_f)$
  1384	  \Comment{signed with the fixed FG identity}
  1385	  \State \Call{record\_attestation}{$\Lambda,a$}; \Return $a$
  1386	  \Comment{record, then release}
  1387	\EndFunction
  1388	\vspace{1pt}
  1389	\Function{record\_attestation}{$\Lambda,a$}
  1390	  \Comment{\DC{7}, unchanged; the only writer of $\Lambda$}
  1391	  \State $(h,T,\chi,h_f,T_f)\gets a$'s height and finality pairs
  1392	  \If{$T_f\neq\bot$} \State $\Lambda.\mathsf{lock}[h_f]\gets T_f$ \EndIf
  1393	  \If{$h\neq\bot$}
  1394	    \If{not $\chi$ and $\Lambda.\mathsf{target}[h]=\bot$}
  1395	      \State $\Lambda.\mathsf{target}[h]\gets T$
  1396	    \EndIf
  1397	    \If{$\chi$}
  1398	      \State $\Lambda.\mathsf{timeout}[h]\gets\mathsf{true}$;
  1399	        add $(h,T)$ to $\Lambda.\mathsf{timeouts}$
  1400	    \EndIf
  1401	  \EndIf
  1402	\EndFunction
  1403	\end{algorithmic}
  1404	}
