  2048	/-- The registry ids in a free text: each word `<layer>.<name>.….v<n>` with
  2049	layer `ap`, `fg`, `fj` or `comp`. A word is a maximal run of letters, digits,
  2050	`.` and `_`; a final `.` is not part of the id. -/
  2051	def idTokens (s : String) : List String :=
  2052	  let isW (c : Char) := c.isAlphanum || c == '.' || c == '_'
  2053	  let step := fun (acc : List (List Char)) (c : Char) =>
  2054	    if isW c then match acc with
  2055	      | w :: ws => (c :: w) :: ws
  2056	      | [] => [[c]]
  2057	    else [] :: acc
  2058	  let words := ((s.toList.foldl step [[]]).map fun w => (w.dropWhile (· == '.')).reverse)
  2059	  words.reverse.filterMap fun w =>
  2060	    match (String.ofList w).splitOn "." with
  2061	    | layer :: rest@(_ :: _ :: _) =>
  2062	      match rest.getLast!.toList with
  2063	      | 'v' :: ds@(_ :: _) =>
  2064	        if ["ap", "fg", "fj", "comp"].contains layer && ds.all Char.isDigit
  2065	        then some (String.ofList w) else none
  2066	      | _ => none
  2067	    | _ => none
  2068	
  2069	/-- The ids that `scripts/check-fg-pins.sh` checks, one per line with a tag: `pin`
  2070	(a pin id), `ap` and `external` (an id in the text of an active `.ap` or
  2071	`.external` clause), and `notFormalized` (a historical entry). The ids come from
  2072	the elaborated values, not from the source text (Astra P01). -/
  2073	def emitIds (ps : List Pin) (nf : List (String × String)) : IO Unit := do
  2074	  for p in ps do
  2075	    IO.println s!"pin {p.id}"
  2076	    for c in p.clauses do
  2077	      match c.cov with
  2078	      | .ap t => for i in idTokens t do IO.println s!"ap {i}"
  2079	      | .external t => for i in idTokens t do IO.println s!"external {i}"
  2080	      | _ => pure ()
  2081	  for (i, _) in nf do IO.println s!"notFormalized {i}"
  2082	```
  2083	
