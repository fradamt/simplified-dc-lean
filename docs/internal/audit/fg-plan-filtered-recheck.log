  1045	    \If{$\mathit{children}=\emptyset$} \State \Return $H$ \EndIf
  1046	    \State $H\gets\arg\max_{B\in\mathit{children}}\mathit{score}(B)$,
  1047	      ties by root order
  1048	  \EndLoop
  1049	\EndFunction
  1050	\vspace{1pt}
  1051	\Function{goldfish\_eligible}{$\Sigma,\mathit{votes},
  1052	  \mathit{support\_votes},s,B$}
  1053	  \Comment{\DC{7}, redefined (a): band floor}
  1054	  \State $\mathit{voters\_count}\gets
  1055	    |\{i:\mathit{votes}\text{ holds a vote by seat }i\}|$
  1056	  \State \Return $\Sigma.\sigma[B.\parent].h<\Call{band\_floor}{\Sigma}$
  1057	    or $2\,\Call{goldfish\_score}{\mathit{votes},
  1058	      \mathit{support\_votes},s,B}>\mathit{voters\_count}$
  1059	    or $B.\slot=\Sigma.s$
  1060	\EndFunction
  1061	\vspace{1pt}
  1062	\Function{goldfish\_fork\_choice}{$\Sigma,\mathit{anchor},\mathit{tree},
  1063	  \mathit{votes},\mathit{support\_votes},s$}
  1064	  \Comment{\DC{7}, unchanged}
  1065	  \State define $\mathit{score}(B)$ as
  1066	    $\Call{goldfish\_score}{\mathit{votes},\mathit{support\_votes},s,B}$
  1067	  \State define $\mathit{eligible}(B)$ as
  1068	    $\Call{goldfish\_eligible}{\Sigma,\mathit{votes},
  1069	      \mathit{support\_votes},s,B}$
  1070	  \State \Return $\Call{ghost}{\mathit{anchor},\mathit{tree},
  1071	    \mathit{score},\mathit{eligible}}$
  1072	\EndFunction
  1073	\vspace{1pt}
  1074	\Function{live\_root}{$\Sigma$}
  1075	  \Comment{\DC{7} \fname{get\_sg\_root}, redefined (b); \SAS{} \fname{live\_root}}
  1076	  \State $\mathit{tree}\gets\Call{get\_filtered\_block\_tree}{\Sigma}$
  1077	  \Comment{the full filtered tree, not a view}
  1078	  \State $\mathit{targets}\gets\{B\in\mathit{tree}:\Sigma.\lease[B]\neq\bot\}$
  1079	  \Comment{they lie on one chain}
  1080	  \If{$\mathit{targets}=\emptyset$}
  1081	    \State \Return $\Call{get\_fg\_root}{\Sigma}$
  1082	    \Comment{no live lease in the tree}
  1083	  \EndIf
  1084	  \State \Return the deepest $B\in\mathit{targets}$
  1085	  \Comment{the deepest live lease in place of grade~1}
  1086	\EndFunction
  1087	\vspace{1pt}
  1088	\Function{get\_head\_in\_tree}{$\Sigma,\mathit{tree},
  1089	  \mathit{votes},\mathit{support\_votes},k$}
  1090	  \Comment{\DC{7}, adapted (b): live root}
  1091	  \State $A\gets\Call{live\_root}{\Sigma}$
  1092	  \Comment{in place of \fname{get\_sg\_root}}
  1093	  \State \Return $\Call{goldfish\_fork\_choice}{\Sigma,A,
  1094	    \mathit{tree},\mathit{votes},\mathit{support\_votes},k}$
  1095	\EndFunction
  1096	\vspace{1pt}
  1097	\Function{get\_head}{$\Sigma,\mathit{votes},\mathit{support\_votes},k$}
  1098	  \Comment{\DC{7}, unchanged}
  1099	  \State $\mathit{tree}\gets\Call{get\_filtered\_block\_tree}{\Sigma}$
  1100	  \State \Return $\Call{get\_head\_in\_tree}{\Sigma,\mathit{tree},
  1101	    \mathit{votes},\mathit{support\_votes},k}$
  1102	\EndFunction
