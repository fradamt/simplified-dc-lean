#!/bin/zsh
# Toolchain-level throttle (2026-09-14). Compiles of .lean files: one of LEAN_SLOTS machine-wide slots AND a hard footprint cap
# enforced by polling `top` (Lean's own -M flag did not stop 76 GB runaways). Non-compile invocations pass through.
REAL="${0:A:h}/lean.orig"
SLOTS=${LEAN_SLOTS:-3}; CAPGB=${LEAN_CAP_GB:-7}
LOCKDIR=/Users/francesco/ethereum/lean/decoupled-consensus-model/collab/orch/locks
compile=0; for a in "$@"; do case "$a" in *.lean) compile=1;; esac; done
# language-server workers/servers are long-lived, not batch compiles: never take a slot (2026-09-16: two --worker processes held 2 of 3 slots for a day)
for a in "$@"; do case "$a" in --worker|--server) compile=0;; esac; done
if [ $compile -eq 0 ]; then exec "$REAL" "$@"; fi
mkdir -p $LOCKDIR
while true; do
  for s in $(seq 1 $SLOTS); do
    if mkdir $LOCKDIR/slot$s 2>/dev/null; then
      echo $$ > $LOCKDIR/slot$s/pid
      echo "$(date +%H:%M:%S) slot$s pid=$$ $*" >> $LOCKDIR/history.log
      "$REAL" "$@" & child=$!; peak=0
      while kill -0 $child 2>/dev/null; do
        sleep 3
        mem=$(top -l 1 -pid $child -stats mem 2>/dev/null | tail -1 | tr -d ' ')
        case "$mem" in *G) g=${mem%G}; g=${g%%[.+]*}; [ "${g:-0}" -gt "$peak" ] && peak=$g;; esac
        case "$mem" in
          *G) gb=${mem%G}; gb=${gb%%[.+]*}
              if [ "${gb:-0}" -ge "$CAPGB" ]; then kill -9 $child; echo "lean-throttle: KILLED compile at ${mem} (cap ${CAPGB} GB): $*" >&2; echo "$(date +%H:%M:%S) KILLED ${mem} $*" >> $LOCKDIR/history.log; fi;;
        esac
      done
      wait $child; rc=$?
      echo "$(date +%H:%M:%S) DONE peak=${peak}G rc=$rc $*" >> $LOCKDIR/history.log
      rm -rf $LOCKDIR/slot$s 2>/dev/null
      exit $rc
    fi
    # stale-lock cleanup (2026-09-15): a slot whose holder is dead is released by the waiter
    hp=$(cat $LOCKDIR/slot$s/pid 2>/dev/null)
    if [ -n "$hp" ] && { ! kill -0 $hp 2>/dev/null || [ "$(ps -o stat= -p $hp 2>/dev/null | cut -c1)" = "Z" ]; }; then rm -rf $LOCKDIR/slot$s; echo "$(date +%H:%M:%S) STALE slot$s pid=$hp cleared by $$" >> $LOCKDIR/history.log; fi
    # a slot dir with no pid file for > 60 s is a leftover (release failed); clear it
    if [ -d $LOCKDIR/slot$s ] && [ ! -f $LOCKDIR/slot$s/pid ] && [ $(( $(date +%s) - $(stat -f %m $LOCKDIR/slot$s 2>/dev/null || date +%s) )) -gt 60 ]; then rm -rf $LOCKDIR/slot$s; echo "$(date +%H:%M:%S) STALE slot$s (no pid) cleared by $$" >> $LOCKDIR/history.log; fi
  done
  sleep 5
done
