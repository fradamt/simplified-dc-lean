   929	carrier). The spec takes `σ = Σ.σ[B]`; here `σ = derive B`. After an F advance
   930	the spec calls `reconcile_with_finality` (lines 862–882), which writes only SA
   931	fields (leases, fastWrite, saved results, S); it is not in this module. -/
   932	def update_finality (st : Store V) (B : FGBlock V) : Store V :=
   933	  let σ := derive E cfg B
   934	  let st := { st with h_max := max st.h_max σ.h }
   935	  let st := if FGBlock.preceq st.F σ.J && decide (lexKey (st.h_j, st.J) < lexKey (σ.h_j, σ.J))
   936	    then { st with J := σ.J, h_j := σ.h_j } else st
   937	  if FGBlock.preceq st.F σ.F && decide (st.F ≠ σ.F) && FGBlock.preceq σ.F st.J &&
