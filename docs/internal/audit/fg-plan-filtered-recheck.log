   781	
   782	```lean
   783	abbrev View (V : Type) := Finset (FGBlock V)
   784	
   785	variable {V : Type} [DecidableEq V] [Fintype V] (E : Electorate V) (cfg : FGConfig)
   786	
   787	def hOf (W : FGBlock V) : Height := (derive E cfg W).h
   788	
   789	/-- `H = max({1} ∪ {h(W) : W ∈ V})`. -/
   790	def frontier (Vw : View V) : Height := Vw.sup (hOf E cfg) ⊔ 1
   791	
   792	/-- Collision freedom on a view: roots identify the blocks of the view and their
   793	ancestors (the collision-free hash idealization; DC `RootInjectiveOnAncestors`).
   794	A hypothesis of every lemma that reads the selected pair; no definition assumes
   795	it. -/
   796	def ViewRootInj (Vw : View V) : Prop :=
   797	  ∀ X Y, (∃ W ∈ Vw, FGBlock.Preceq X W) → (∃ W ∈ Vw, FGBlock.Preceq Y W) →
   798	    X.root = Y.root → X = Y
   799	
   800	/-- The lex key `(h_j, J.root)`. -/
   801	def lexKey (p : Height × FGBlock V) : Lex (ℕ × ℕ) := toLex (p.1, p.2.root.value)
   802	
   803	/-- The frame controls (ALFS: DC's live caches). The root and the band floor
   804	are functions of them (r148 FJ_FRAME table). -/
   805	structure Controls (V : Type) where
   806	  F : FGBlock V
   807	  H : Height
   808	  j : Height
   809	  J : FGBlock V
   810	  contest : Bool
   811	
   812	namespace Controls
   813	/-- The uncontested phase: the root is J. -/
   814	def rootIsJ (c : Controls V) : Bool := decide (c.H = c.j + 1) && !c.contest
   815	def Z (c : Controls V) : FGBlock V := if c.rootIsJ then c.J else c.F
   816	def lo (c : Controls V) : Height := if c.contest then c.H else c.H - 1
   817	end Controls
   818	
   819	structure Frame (V : Type) where
   820	  F : FGBlock V
   821	  H : Height
   822	  j : Height
   823	  J : FGBlock V
   824	  Z : FGBlock V
   825	  lo : Height
   826	  D : Finset (FGBlock V)
   827	  contest : Bool
   828	```
