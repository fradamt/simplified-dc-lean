import AvailableChainFramework
import AvailableChainEngineV2
import AvailableChainKitV2
open Lean

/-! V2 API manifest (plan 2a, Task 7). `docs/V2-API.md` lists the frozen v2
API: every public declaration of the engine v2 modules under
`AvailableChainEngineV2.Engine`, `.Conditions` and `.Laws` (locked through the
anchor), and every public declaration of the Kit v2 modules outside
`AvailableChainKitV2.Tests` (frozen by rule, not locked). "Public" means: Lean
did not generate it, by the rule of `scripts/CatalogLock.lean` (`generated`).
A private declaration has an internal name and is generated by that rule.

The manifest has one `### \`<module>\`` heading per module, followed by one
fenced block. Each non-empty line of the block is `<kind> <name>` for an
engine entry and `<kind> <name> <hash>` for a Kit entry. The hash is 16 hex
digits of `ownHash` (a copy of `scripts/CatalogLock.lean`): the kind, the
name and the type; for a definition also the value; for an inductive also
the constructor names; for a theorem not the proof. Universe parameters are
renamed `u0`, `u1`, … first. The lock does not see the Kit (L5); the hash
makes a changed Kit statement fail `--check`.

Modes:
- `--list`: print the manifest blocks (headings, names and Kit hashes) from
  the environment, in source order.
- `--anchor`: print the body of `AvailableChainFramework/V2/Anchor.lean`: a
  `let` chain over every engine declaration.
- `--check`: exit 1 if the anchor `AvailableChain.Framework.V2.anchor` is
  missing or is not in `AvailableChainFramework.V2.Anchor`; if a manifest name
  does not exist or is not in the module of its heading; if an engine name is
  not in the anchor's closure (the dependency rules of
  `scripts/CatalogLock.lean`: `deps` and `closure` are copies); if a public
  declaration of a scope module, or of a module that has a heading, is not in
  the manifest; if a scope module has no heading; or if a Kit entry has no
  hash or a different hash (an engine entry must have none).

Run: `lake env lean --run scripts/V2Manifest.lean (--list | --anchor |
--check) [--manifest <path>]`. The manifest is `docs/V2-API.md` if
`--manifest` is not given. Exit codes: 0 clean; 1 a check failed; 2 a usage
error or an unreadable manifest. -/

def anchorName : Name := `AvailableChain.Framework.V2.anchor
def anchorModule : Name := `AvailableChainFramework.V2.Anchor

/-- The engine modules (locked through the anchor). -/
def engineScope : List Name :=
  [`AvailableChainEngineV2.Engine, `AvailableChainEngineV2.Conditions,
   `AvailableChainEngineV2.Laws]

def kitLibrary : Name := `AvailableChainKitV2
def kitTests : Name := `AvailableChainKitV2.Tests

def isEngineModule (m : Name) : Bool := engineScope.any (·.isPrefixOf m)

def isKitModule (m : Name) : Bool :=
  kitLibrary.isPrefixOf m && m != kitLibrary && !kitTests.isPrefixOf m

def inScope (m : Name) : Bool := isEngineModule m || isKitModule m

def moduleOf? (env : Environment) (n : Name) : Option Name :=
  (env.getModuleIdxFor? n).map (env.header.moduleNames[·.toNat]!)

/-- Copy of `generated` in `scripts/CatalogLock.lean`. -/
def generated (n : Name) : CoreM Bool := do
  let env ← getEnv
  if n.isInternal || isAuxRecursor env n || isNoConfusion env n ||
      Meta.isMatcherCore env n || (env.find? n matches some (.recInfo _)) then
    return true
  if (← Meta.isEqnThm? n).isSome then return true
  return (← findDeclarationRangesCore? n).isNone

/-- Copy of `deps` in `scripts/CatalogLock.lean`. -/
def deps (ci : ConstantInfo) : Array Name :=
  match ci with
  | .thmInfo _ => ci.type.getUsedConstants
  | _ => ci.getUsedConstantsAsSet.toArray

/-- Every declaration that `n` reaches by `deps`, and `n` (the traversal of
`closure` in `scripts/CatalogLock.lean`, without the hash cache). -/
def closure (env : Environment) (n : Name) : Except String (Std.HashSet Name) := do
  let mut seen : Std.HashSet Name := ({} : Std.HashSet Name).insert n
  let mut stack := #[n]
  while h : stack.size > 0 do
    let m := stack[stack.size - 1]
    stack := stack.pop
    let some ci := env.find? m | throw s!"missing declaration: {m}"
    for d in deps ci do
      unless seen.contains d do
        seen := seen.insert d
        stack := stack.push d
  return seen

/-- Copy of `kindTag` in `scripts/CatalogLock.lean`. -/
def kindTag : ConstantInfo → UInt64
  | .axiomInfo _ => 1 | .defnInfo _ => 2 | .thmInfo _ => 3 | .opaqueInfo _ => 4
  | .quotInfo _ => 5 | .inductInfo _ => 6 | .ctorInfo _ => 7 | .recInfo _ => 8

/-- `ownHash` of `scripts/CatalogLock.lean`, after the universe parameters
are renamed `u0`, `u1`, …, as 16 hex digits. -/
def ownHex (ci : ConstantInfo) : String :=
  let us := (List.range ci.levelParams.length).map fun i => Level.param (.mkSimple s!"u{i}")
  let norm (e : Expr) := e.instantiateLevelParams ci.levelParams us
  let base := mixHash (mixHash (kindTag ci) (hash ci.name)) (hash (norm ci.type))
  let h := match ci with
    | .defnInfo d => mixHash base (hash (norm d.value))
    | .opaqueInfo d => mixHash base (hash (norm d.value))
    | .inductInfo d => d.ctors.foldl (fun h c => mixHash h (hash c)) base
    | _ => base
  let s := String.ofList (Nat.toDigits 16 h.toNat)
  "".pushn '0' (16 - s.length) ++ s

def kindOf (env : Environment) : ConstantInfo → String
  | .axiomInfo _ => "axiom" | .defnInfo _ => "def" | .thmInfo _ => "theorem"
  | .opaqueInfo _ => "opaque" | .quotInfo _ => "quot"
  | .inductInfo d => if isStructure env d.name then "structure" else "inductive"
  | .ctorInfo _ => "ctor" | .recInfo _ => "rec"

/-- The public declarations of the scope modules, per module, in source order
(line, column, then name). -/
def scan : CoreM (Std.HashMap Name (Array (Name × String))) := do
  let env ← getEnv
  let mut found : Std.HashMap Name (Array (Position × Name × String)) := {}
  for (n, ci) in env.constants.toList do
    let some m := moduleOf? env n | continue
    unless inScope m do continue
    if ← generated n then continue
    let pos := (← findDeclarationRangesCore? n).map (·.range.pos) |>.getD ⟨0, 0⟩
    found := found.insert m ((found.getD m #[]).push (pos, n, kindOf env ci))
  let lt (a b : Position × Name × String) : Bool :=
    a.1.line < b.1.line || (a.1.line == b.1.line &&
      (a.1.column < b.1.column || (a.1.column == b.1.column && Name.lt a.2.1 b.2.1)))
  return found.fold (init := {}) fun acc m xs =>
    acc.insert m ((xs.qsort lt).map fun (_, n, k) => (n, k))

/-- The engine modules first (`Engine`, `Conditions`, `Laws`), then the Kit
modules; by name within a group. -/
def sortedModules (s : Std.HashMap Name (Array (Name × String))) : Array Name :=
  let group (m : Name) : Nat := (engineScope.findIdx? (·.isPrefixOf m)).getD engineScope.length
  (s.toArray.map (·.1)).qsort fun a b =>
    group a < group b || (group a == group b && toString a < toString b)

/-- The manifest: per heading module, the listed names (with the hash, if
any) in order. -/
def parseManifest (text : String) :
    Except String (Array (Name × Array (Name × Option String))) := do
  let mut out : Array (Name × Array (Name × Option String)) := #[]
  let mut cur : Option Name := none
  let mut inBlock := false
  for line in text.splitOn "\n" do
    let l := line.trimAscii.toString
    if l.startsWith "```" then
      inBlock := !inBlock
      continue
    if inBlock then
      if l.isEmpty then continue
      if cur.isNone then continue
      let w := (l.splitOn " ").filter (!·.isEmpty)
      let n := (w.getD 1 "").toName
      unless (w.length == 2 || w.length == 3) && !n.isAnonymous do
        throw s!"malformed manifest line: {line}"
      out := out.modify (out.size - 1) fun (m, ns) => (m, ns.push (n, w[2]?))
    else if l.startsWith "### `" then
      let m := ((l.drop 5).takeWhile (· != '`')).toString.toName
      if (out.map (·.1)).contains m then throw s!"duplicate heading: {m}"
      out := out.push (m, #[])
      cur := some m
    else if l.startsWith "#" then
      cur := none
  return out

def runCore (env : Environment) (x : CoreM α) : IO α :=
  Core.CoreM.toIO' x { fileName := "V2Manifest", fileMap := .ofString "" } { env := env }

def main (args : List String) : IO UInt32 := do
  let (mode, manifest) ← match args with
    | [m] => pure (m, ("docs/V2-API.md" : System.FilePath))
    | [m, "--manifest", p] => pure (m, (p : System.FilePath))
    | _ => pure ("", ("" : System.FilePath))
  unless ["--list", "--anchor", "--check"].contains mode do
    IO.eprintln "usage: lake env lean --run scripts/V2Manifest.lean (--list | --anchor | --check) [--manifest <path>]"
    return 2
  initSearchPath (← findSysroot)
  let env ← importModules #[{ module := `AvailableChainFramework },
    { module := `AvailableChainEngineV2 }, { module := `AvailableChainKitV2 }] {}
  let decls ← runCore env scan
  let mods := sortedModules decls
  if mode == "--list" then
    for m in mods do
      IO.println s!"### `{m}`\n"
      IO.println "```text"
      for (n, k) in decls.getD m #[] do
        let h := if isKitModule m then (env.find? n).map (" " ++ ownHex ·) |>.getD "" else ""
        IO.println s!"{k} {n}{h}"
      IO.println "```\n"
    return 0
  if mode == "--anchor" then
    for m in mods.filter isEngineModule do
      IO.println s!"  -- {m}"
      for (n, _) in decls.getD m #[] do IO.println s!"  let _ := @{n}"
    IO.println "  ()"
    return 0
  let text ← match ← (IO.FS.readFile manifest).toBaseIO with
    | .ok s => pure s
    | .error e => IO.eprintln s!"cannot read {manifest}: {e}"; return 2
  let entries ← match parseManifest text with
    | .ok x => pure x
    | .error e => IO.eprintln e; return 2
  let mut fails : Array String := #[]
  match env.find? anchorName, moduleOf? env anchorName with
  | some _, some m =>
      if m != anchorModule then fails := fails.push s!"ANCHOR IN WRONG MODULE {m}"
  | _, _ => fails := fails.push s!"MISSING ANCHOR {anchorName}"
  let anchorClosure : Std.HashSet Name ←
    if env.contains anchorName then
      match closure env anchorName with
      | .ok s => pure s
      | .error e => IO.eprintln e; return 2
    else pure {}
  let headings := entries.map (·.1)
  let mut listed : Std.HashSet Name := {}
  let mut count := 0
  for (m, ns) in entries do
    for (n, h?) in ns do
      count := count + 1
      if listed.contains n then fails := fails.push s!"DUPLICATE ENTRY {n}"
      listed := listed.insert n
      match moduleOf? env n with
      | none => fails := fails.push s!"UNKNOWN {n} (heading {m})"
      | some m' =>
          if m' != m then fails := fails.push s!"WRONG MODULE {n}: {m'}, heading {m}"
          else if isEngineModule m && env.contains anchorName &&
              !anchorClosure.contains n then
            fails := fails.push s!"NOT ANCHORED {n}"
          if isEngineModule m && h?.isSome then fails := fails.push s!"ENGINE ENTRY WITH HASH {n}"
          if isKitModule m then
            match h?, env.find? n with
            | none, _ => fails := fails.push s!"NO HASH {n}"
            | some h, some ci =>
                if h != ownHex ci then fails := fails.push s!"CHANGED {n} {h} -> {ownHex ci}"
            | some _, none => pure ()
  for m in mods do
    unless headings.contains m do fails := fails.push s!"NO HEADING {m}"
  for m in headings do
    unless inScope m do fails := fails.push s!"OUT OF SCOPE HEADING {m}"
    for (n, _) in decls.getD m #[] do
      unless listed.contains n do fails := fails.push s!"NOT LISTED {n}"
  for f in fails do IO.println f
  unless fails.isEmpty do return 1
  IO.println s!"{manifest}: {count} entries in {headings.size} modules; complete; engine entries anchored; Kit hashes match"
  return 0
