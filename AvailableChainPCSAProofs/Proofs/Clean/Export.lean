variable {p : Params} {In V : Type} [DecidableEq V] [Fintype V]
    {c : AppCodec In} {m : FGMode}
omit [Fintype V] in
/-- The predecessor invariant makes the actual proposer root compatible with its results. -/
theorem pcsa_clean_proposer_root_compatible (E : Generic.Env V)
    (rho : V2.D.Run V (pcsaWith m p c)) (h : Base₂ p c E rho)
    (hF : StageOneFrame p c E rho) (s : Slot) (hCI : CleanInvariantAt p c E rho s)
    (k : Nat) (x y : V) (hx : x ∈ rho.honest) (hy : y ∈ rho.honest)
    (hk : rho.events[k]? = some (.tick x (SA.proposalTime p.toParams (s + 1))))
    (X : Block) (hX : gateResultAt p c E rho y s = some (some X)) :
    Block.Compatible
      (liveRoot p (clock p (V2.D.Run.stateBefore E rho k x).st (SA.proposalTime p.toParams (s + 1)))
        (proposerPC p (clock p (V2.D.Run.stateBefore E rho k x).st
          (SA.proposalTime p.toParams (s + 1))))) X := by
  let st := clock p (V2.D.Run.stateBefore E rho k x).st (SA.proposalTime p.toParams (s + 1))
  have hz : (controls p st).Z = .genesis := by
    change (KitFG.storeControlsView (FGSA.heightView p) (clock p _ _).fg).Z = .genesis
    rw [pcsa_body_clock_fg]
    exact (hF x hx k).2.1
  have htime : SA.proposalTime p.toParams (s + 1) - 1 < SA.voteTime p.toParams (s + 1) := by
    have hp : (0 : Int) < p.Δ := p.deltaPos
    change 4 * p.Δ * ((s + 1 : Nat) : Int) - 1 < 4 * p.Δ * ((s + 1 : Nat) : Int) + p.Δ
    linarith
  have hpropVote : SA.proposalTime p.toParams (s + 1) < SA.voteTime p.toParams (s + 1) := by
    change 4 * p.Δ * ((s + 1 : Nat) : Int) < 4 * p.Δ * ((s + 1 : Nat) : Int) + p.Δ
    exact lt_add_of_pos_right _ p.deltaPos
  rcases pcsa_liveRoot_origin p st (proposerPC p st) with he | hm
  · rw [he]
    cases hv : proposerPC p st with
    | none =>
      change Block.Compatible (eraseFG (controls p st).Z) X
      rw [hz]
      exact Bool.or_eq_true_iff.mpr (Or.inl (Gen.Pure.block_genesis_preceq X))
    | some C =>
      change Block.Compatible (if frameActive p st C then C.target else eraseFG (controls p st).Z) X
      split
      · have hC := (List.mem_filter.mp (bestPC_mem _ C hv)).1
        change C ∈ (clock p _ _).pcs at hC
        rw [pcsa_clock_pcs, pcsa_pre_tick_storeAt E rho h k x _ hk] at hC
        exact hCI.pcResults x hx y hy _ C s X htime hC (le_refl _) hX
      · rw [hz]
        exact Bool.or_eq_true_iff.mpr (Or.inl (Gen.Pure.block_genesis_preceq X))
  · obtain ⟨row, hrow, hr, _, _⟩ := (pcsa_walkLocks_mem p st _ _).mp hm
    have hpre := pcsa_proposal_locks_subset p (V2.D.Run.stateBefore E rho k x).st (s + 1) hrow
    have hread := V2.D.Engine.stateBefore_tick_eq_stateBeforeTime h.valid.toScheduleWellFormed
      h.noRestart hk
    rw [← Gen.V2.Duty.stateBefore_idxBefore E rho _ h.valid.toScheduleWellFormed] at hread
    rw [hread] at hpre
    obtain ⟨a, ha, i, Y, hevent, hY, hrowY, _⟩ := pcsa_lock_stateBefore_origin E rho h _ x row hpre
    have hgate := (Gen.V2.Duty.index_lt_idxBefore_iff h.valid.toScheduleWellFormed hevent _).mp ha
    have hi := pcsa_gate_label_lt_next_vote p i s (hgate.trans hpropVote)
    have hYX := (hCI.resultsChain x hx y hy i s Y X hi.le (le_refl _) hY hX).1 hi
    exact Bool.or_eq_true_iff.mpr (Or.inl (Gen.Pure.block_preceq_trans (hr ▸ hrowY) hYX))
/-- The actual proposer walk extends every predecessor-label result. -/
theorem pcsa_clean_proposer_head_above_result (E : Generic.Env V)
    (rho : V2.D.Run V (pcsaWith m p c)) {cut ΔF : Time}
    (h : Clean₂ p c E rho cut ΔF) (hF : StageOneFrame p c E rho)
    (s : Slot) (hCI : CleanInvariantAt p c E rho s) (hc : SA.gateTime p.toParams s ≤ cut)
    (k : Nat) (x y : V) (hx : x ∈ rho.honest) (hy : y ∈ rho.honest)
    (hk : rho.events[k]? = some (.tick x (SA.proposalTime p.toParams (s + 1))))
    (X : Block) (hX : gateResultAt p c E rho y s = some (some X)) :
    let st := clock p (V2.D.Run.stateBefore E rho k x).st (SA.proposalTime p.toParams (s + 1))
    Block.Preceq X (getHead p st (proposerPC p st) (proposerVotes st (s + 1))
      (proposerSupport st (s + 1))) := by
  obtain ⟨a, ha, hresult⟩ := pcsa_gateResultAt_source E rho y s X hX
  have hroot := pcsa_clean_proposer_root_compatible E rho h.base hF s hCI k x y hx hy hk X hX
  have hfcut : SA.freezeTime p.toParams s ≤ cut := by
    apply le_trans _ hc
    change 4 * p.Δ * (s : Int) + 3 * p.Δ ≤ 4 * p.Δ * (s : Int) + 6 * p.Δ
    have hp : (0 : Int) < p.Δ := p.deltaPos
    linarith
  have hidx : V2.D.Run.idxBefore rho (SA.freezeTime p.toParams s) ≤ k := by
    apply Nat.le_of_not_gt
    intro hn
    have ht := (Gen.V2.Duty.index_lt_idxBefore_iff h.base.valid.toScheduleWellFormed hk _).mp hn
    change 4 * p.Δ * ((s + 1 : Nat) : Int) < 4 * p.Δ * (s : Int) + 3 * p.Δ at ht
    push_cast at ht
    have hp : (0 : Int) < p.Δ := p.deltaPos
    nlinarith
  have hpaths := pcsa_result_prefixes_retained E rho h.base hF h.healthy a k y x hy hx
    (SA.gateTime p.toParams s) (SA.proposalTime p.toParams (s + 1)) s X hfcut hidx hresult
  exact pcsa_gate_proposer_walk_counts E rho h.base hF h.healthy a k y x hy hx s X _ _ hc ha hk
    hresult hroot (fun B _ hBX => (hpaths B hBX).1)
end AvailableChain.PCSA.Run

namespace AvailableChain.PCSA.Run
variable {p : Params} {In V : Type} [DecidableEq V] {c : AppCodec In} {m : FGMode}
/-- Predecessor CI bounds every pre-vote lock by each result of that predecessor label. -/
theorem pcsa_clean_pre_vote_lock_below_result (E : Generic.Env V)
    (rho : V2.D.Run V (pcsaWith m p c)) (h : Base₂ p c E rho)
    (s : Slot) (hCI : CleanInvariantAt p c E rho s)
    (k : Nat) (x y : V) (hx : x ∈ rho.honest) (hy : y ∈ rho.honest)
    (hk : k ≤ V2.D.Run.idxBefore rho (SA.voteTime p.toParams (s + 1)))
    (row : Block × Nat × Time) (hr : row ∈ (V2.D.Run.stateBefore E rho k x).st.base.obligations)
    (X : Block) (hX : gateResultAt p c E rho y s = some (some X)) : Block.Preceq row.1 X := by
  obtain ⟨a, ha, i, Y, he, hY, hp, _⟩ := pcsa_lock_stateBefore_origin E rho h k x row hr
  have ht := (Gen.V2.Duty.index_lt_idxBefore_iff h.valid.toScheduleWellFormed he _).mp
    (ha.trans_le hk)
  have hi := pcsa_gate_label_lt_next_vote p i s ht
  exact Gen.Pure.block_preceq_trans hp
    ((hCI.resultsChain x hx y hy i s Y X hi.le (le_refl _) hY hX).1 hi)
end AvailableChain.PCSA.Run

namespace AvailableChain.PCSA.Run
variable {p : Params} {In V : Type} [DecidableEq V] [Fintype V]
    {c : AppCodec In} {m : FGMode}
/-- An honest next-slot proposal fixes every honest HEAD from the predecessor CI. -/
theorem pcsa_clean_emitted_heads_equal (E : Generic.Env V)
    (rho : V2.D.Run V (pcsaWith m p c)) {cut ΔF : Time}
    (h : Clean₂ p c E rho cut ΔF) (hF : StageOneFrame p c E rho)
    (hFault : FaultsBelowQA p c rho) (s : Slot) (hCI : CleanInvariantAt p c E rho s)
    (hc : SA.gateTime p.toParams s ≤ cut) (N : NamedProposal p.n)
    (hx : rho.seatOf (.prop (s + 1)) (0 : Fin 1) ∈ rho.honest)
    (he : V2.D.Run.emits E rho (rho.seatOf (.prop (s + 1)) (0 : Fin 1))
      (⟨.seat (.prop (s + 1)) (0 : Fin 1), .proposal N⟩ : Obj p)
        (SA.proposalTime p.toParams (s + 1)))
    (y : V) (H : Block) (hH : HonestHeadAt p c E rho y (s + 1) H) : H = N.erase := by
  let x := rho.seatOf (.prop (s + 1)) (0 : Fin 1)
  obtain ⟨k, hk, _, hslot, hraw, hsup, hpc, hparent⟩ := pcsa_emitted_proposal_inputs E rho x
    (s + 1) N he
  let a := V2.D.Run.idxBefore rho (SA.voteTime p.toParams (s + 1))
  let src := clock p (V2.D.Run.stateBefore E rho k x).st (SA.proposalTime p.toParams (s + 1))
  let dst := clock p (V2.D.Run.stateBefore E rho a y).st (SA.voteTime p.toParams (s + 1))
  let Ts := erasedList src (fullTree p src)
  let Tt := erasedList dst (KitFG.storeFrameView (FGSA.heightView p) dst.fg (voterBlocks p dst (s
    + 1)))
  let rs := proposerVotes src (s + 1)
  let ss := proposerSupport src (s + 1)
  let rt := headVotes p dst (s + 1)
  let st := headSupport p dst (s + 1)
  let Rsrc := liveRoot p src (proposerPC p src)
  let Rdst := liveRoot p dst (voterPC p dst (s + 1))
  have hy := hH.1
  have hp : (0 : Int) < p.Δ := p.deltaPos
  have hpropVote : SA.proposalTime p.toParams (s + 1) < SA.voteTime p.toParams (s + 1) := by
    change 4 * p.Δ * ((s + 1 : Nat) : Int) < 4 * p.Δ * ((s + 1 : Nat) : Int) + p.Δ
    exact lt_add_of_pos_right _ hp
  have hvcut : SA.voteTime p.toParams (s + 1) ≤ cut := by
    apply le_trans _ hc
    change 4 * p.Δ * ((s + 1 : Nat) : Int) + p.Δ ≤ 4 * p.Δ * (s : Int) + 6 * p.Δ
    push_cast
    nlinarith
  have hkbefore : k ≤ a := Nat.le_of_lt
    ((Gen.V2.Duty.index_lt_idxBefore_iff h.base.valid.toScheduleWellFormed hk _).mpr hpropVote)
  obtain ⟨hNwire, hNbody⟩ := pcsa_honest_proposal_before_vote E rho h.base hF h.healthy x y hx hy
    (s + 1) N he hvcut a (le_refl _)
  have hNdst : N.erase ∈ dst.base.blocks := by
    change N.erase ∈ (clock p _ _).base.blocks
    rwa [pcsa_clock_blocks]
  have hNslot : N.erase.slot = s + 1 := pcsa_proposal_emitted_slot E rho x (s + 1) N _ he
  have hNpositive : 0 < N.slot := by rw [hslot]; exact Nat.succ_pos _
  have hNparent := pcsa_named_parent_of_positive N hNpositive
  have hcount := pcsa_common_walk_counts E rho h.base hF h.healthy a k y hy s
    (SA.voteTime p.toParams (s + 1)) N hx he hk (le_refl _) hslot hNwire hc hraw hsup
  have hviews := pcsa_common_view_targets E rho h.base hF hFault h.healthy k y hy s N hx he hk
    hslot hvcut hNwire hpc
  have frame (i : Nat) (z : V) (hz : z ∈ rho.honest) (t : Time) :
      FrameVacuous p (clock p (V2.D.Run.stateBefore E rho i z).st t) := by
    change (clock p _ t).fg.F = .genesis ∧
      (KitFG.storeControlsView (FGSA.heightView p) (clock p _ t).fg).Z = .genesis ∧
      (KitFG.storeControlsView (FGSA.heightView p) (clock p _ t).fg).lo = 0
    rw [pcsa_body_clock_fg]
    exact hF z hz i
  have hsrcF := frame k x hx (SA.proposalTime p.toParams (s + 1))
  have hdstF := frame a y hy (SA.voteTime p.toParams (s + 1))
  have hslots : src.slot p = dst.slot p :=
    (pcsa_proposal_clock_slot p _ (s + 1)).trans (pcsa_vote_clock_slot p _ (s + 1)).symm
  have heleg := pcsa_eligible_equal_counts p src dst rs ss rt st hsrcF.2.2 hdstF.2.2 hslots
    hcount.1 hcount.2.2
  have hhead : headVote p dst (s + 1) = H := by
    have hh := hH.2.2
    rw [pcsa_voteHeadAt_def] at hh
    obtain ⟨nd, hnd, hh⟩ := Option.map_eq_some_iff.mp hh
    obtain ⟨b, hb, hbSt⟩ := pcsa_postClock_source E rho y _ nd hnd
    have hpre := V2.D.Engine.stateBefore_tick_eq_stateBeforeTime h.base.valid.toScheduleWellFormed
      h.base.noRestart hb
    rw [← Gen.V2.Duty.stateBefore_idxBefore E rho _ h.base.valid.toScheduleWellFormed] at hpre
    rw [hbSt, hpre] at hh
    exact hh
  have hghost : GridCO.ghost Rdst Tt (GridCO.goldfishScore dst.base.blocks rt st)
      (eligible p dst rt st) = H := by
    delta headVote at hhead
    rw [ite_eq_right (Nat.succ_ne_zero s)] at hhead
    exact hhead
  obtain ⟨D, hD⟩ := pcsa_clean_result_exists E rho h hF x hx s hc
  have hDparent : Block.Preceq D N.parent.erase := by
    rw [hparent]
    exact pcsa_clean_proposer_head_above_result E rho h hF s hCI hc k x x hx hx hk D hD
  have hDH : Block.Preceq D H := pcsa_clean_next_head_above E rho h hF s hCI hc x y hx D H hD hH
  have hsrcRootParent : Block.Preceq Rsrc N.parent.erase := by
    rw [hparent]
    exact pcsa_headInTree_extends_root p src _ _ rs ss
  have hsrcLocks : ∀ row ∈ src.base.obligations, Block.Preceq row.1 D := by
    intro row hr
    exact pcsa_clean_pre_vote_lock_below_result E rho h.base s hCI k x x hx hx hkbefore row
      (pcsa_proposal_locks_subset p _ (s + 1) hr) D hD
  have hdstLocks : ∀ row ∈ dst.base.obligations, Block.Preceq row.1 D := by
    intro row hr
    exact pcsa_clean_pre_vote_lock_below_result E rho h.base s hCI a y x hy hx (le_refl _) row
      (pcsa_vote_locks_subset p _ (s + 1) hr) D hD
  have hgeometry := pcsa_proposal_root_geometry p src dst (s + 1) N.parent.erase D H
    (pcsa_selected_walk_bases_eq p src dst (s + 1) hsrcF.2.1 hdstF.2.1 hviews)
    hsrcRootParent hDparent hDH hsrcLocks hdstLocks
  have unique (i : Nat) (z : V) (hz : z ∈ rho.honest) (t : Time) :
      ∀ A ∈ (clock p (V2.D.Run.stateBefore E rho i z).st t).base.blocks,
      ∀ B ∈ (clock p (V2.D.Run.stateBefore E rho i z).st t).base.blocks,
        A.root = B.root → A = B := by
    intro A hA B hB hr
    have scope := pcsa_clean_clock_body_scope p (RootBlockInRun p c E rho) _ t
      (pcsa_clean_body_scope E rho i z hz)
    exact pcsa_clean_scoped_root_eq E rho h.base.idealization A B (scope A hA) (scope B hB) hr
  have hsrcUnique : ∀ A ∈ Ts, ∀ B ∈ Ts, A.root = B.root → A = B := by
    intro A hA B hB hr
    exact unique k x hx _ A (List.mem_filter.mp hA).1 B (List.mem_filter.mp hB).1 hr
  have hdstUnique : ∀ A ∈ Tt, ∀ B ∈ Tt, A.root = B.root → A = B := by
    intro A hA B hB hr
    exact unique a y hy _ A (List.mem_filter.mp hA).1 B (List.mem_filter.mp hB).1 hr
  have hclosed : Gen.Pure.AnchorClosed Rsrc Ts := by
    intro B hB _ A _ hAB
    exact pcsa_full_read_prefix_mem E rho hF k x hx _ B A (List.mem_filter.mp hB).1 hAB
  have hretained (C : Block) (hC : Block.Preceq C N.erase) : C ∈ Tt :=
    pcsa_proposal_prefix_voter_mem E rho hF a y hy _ (s + 1) N.erase C hNdst hNslot hC
  have htree : ∀ C ∈ Tt, C = N.erase ∨ C ∈ Ts := by
    intro C hC
    rcases pcsa_voter_tree_source E rho h.base hF h.healthy a k y hy s
        (SA.voteTime p.toParams (s + 1)) N hx he hk (hpropVote.le.trans hvcut) C hC with
      hs | hpref
    · exact Or.inr hs
    · by_cases hn : C = N.erase
      · exact Or.inl hn
      · exact Or.inr (pcsa_proposal_proper_prefix_source E rho h.base hF k x hx (s + 1) N
          hparent C hpref hn)
  have hstop : Gen.Pure.NoEligibleChild Tt (eligible p dst rt st) N.erase := by
    intro B hB hpar
    have hb : B ∈ (V2.D.Run.stateBefore E rho a y).st.base.blocks := by
      have hb := (List.mem_filter.mp hB).1
      change B ∈ (clock p _ _).base.blocks at hb
      rwa [pcsa_clock_blocks] at hb
    have hg : B ≠ .genesis := by intro heq; rw [heq] at hpar; cases hpar
    have hparentB : B.parent = N.erase := by
      cases B with
      | genesis => cases hpar
      | node Q r root app => exact Option.some.inj hpar
    have hlt := pcsa_body_parent_slot_lt E rho h.base a y B hg hb
    rw [hparentB, hNslot] at hlt
    have htime : SA.voteTime p.toParams (s + 1) ≤ SA.proposalTime p.toParams (s + 1 + 1) := by
      change 4 * p.Δ * ((s + 1 : Nat) : Int) + p.Δ ≤
        4 * p.Δ * ((s + 1 + 1 : Nat) : Int)
      push_cast
      nlinarith
    have hidx : a ≤ V2.D.Run.idxBefore rho (SA.proposalTime p.toParams (s + 1 + 1)) := by
      change V2.D.Run.idxBefore rho _ ≤ V2.D.Run.idxBefore rho _
      rw [V2.D.Run.idxBefore_def, V2.D.Run.idxBefore_def, ← List.countP_eq_length_filter,
        ← List.countP_eq_length_filter]
      exact List.countP_mono_left (fun e _ he =>
        decide_eq_true (lt_of_lt_of_le (of_decide_eq_true he) htime))
    exact (Nat.not_lt_of_ge (pcsa_body_slot_before_next_proposal E rho h.base a y (s + 1)
      hidx B hb) hlt).elim
  have hwalk := pcsa_retained_proposal_walk Rsrc Rdst N.parent.erase N.erase Ts Tt
    (GridCO.goldfishScore src.base.blocks rs ss) (GridCO.goldfishScore dst.base.blocks rt st)
    (eligible p src rs ss) (eligible p dst rt st) hsrcUnique hclosed hdstUnique hparent.symm
    hsrcRootParent hgeometry.1 (by simpa only [hghost] using hgeometry.2) hNparent
    (hretained N.erase (Gen.Pure.block_preceq_refl _))
    (pcsa_eligible_current_slot p dst rt st N.erase
      (hNslot.trans (pcsa_vote_clock_slot p _ (s + 1)).symm))
    (fun C hC => hretained C (Gen.Pure.block_preceq_trans hC (pcsa_named_parent_prefix N)))
    htree hcount.2.2 heleg hstop
  exact hghost.symm.trans hwalk
end AvailableChain.PCSA.Run

namespace AvailableChain.PCSA.Run
variable {p : Params} {In V : Type} [DecidableEq V] [Fintype V]
    {c : AppCodec In} {m : FGMode}
/-- The successor equal-HEAD field follows from the predecessor invariant and actual walks. -/
theorem pcsa_clean_headsEqual_step (E : Generic.Env V)
    (rho : V2.D.Run V (pcsaWith m p c)) {cut ΔF : Time}
    (h : Clean₂ p c E rho cut ΔF) (hF : StageOneFrame p c E rho)
    (hFault : FaultsBelowQA p c rho) (s : Slot) (hCI : CleanInvariantAt p c E rho s)
    (hc : SA.gateTime p.toParams (s + 1) ≤ cut) :
    ∀ i P x H, i ≤ s + 1 →
      Gen.V2.Duty.HonestProposalAt E (pcsaInterface p c (m := m)).toInterface rho i P →
      HonestHeadAt p c E rho x i H → H = P := by
  have hprev : SA.gateTime p.toParams s ≤ cut := by
    apply le_trans _ hc
    change 4 * p.Δ * (s : Int) + 6 * p.Δ ≤ 4 * p.Δ * ((s + 1 : Nat) : Int) + 6 * p.Δ
    push_cast
    have hp : (0 : Int) < p.Δ := p.deltaPos
    nlinarith
  intro i P x H hi hP hH
  by_cases hold : i ≤ s
  · exact hCI.headsEqual i P x H hold hP hH
  · have his : i = s + 1 := Nat.le_antisymm hi (Nat.succ_le_of_lt (Nat.lt_of_not_ge hold))
    subst i
    obtain ⟨hx, N, hN, he⟩ := pcsa_honest_proposal_named E rho (s + 1) P hP
    exact (pcsa_clean_emitted_heads_equal E rho h hF hFault s hCI hprev N hx he x H hH).trans hN
end AvailableChain.PCSA.Run

namespace AvailableChain.PCSA.Run
variable {p : Params} {In V : Type} [DecidableEq V] [Fintype V]
    {c : AppCodec In} {m : FGMode}
/-- The C6 successor record and earlier-ack coverage are constructed together. -/
theorem pcsa_clean_joint_step (E : Generic.Env V)
    (rho : V2.D.Run V (pcsaWith m p c)) {cut ΔF : Time}
    (h : Clean₂ p c E rho cut ΔF) (hF : StageOneFrame p c E rho)
    (hFault : FaultsBelowQA p c rho) (s : Slot) (hCI : CleanInvariantAt p c E rho s)
    (hAux : CleanAckCoverageAt p c E rho s) (hc : SA.gateTime p.toParams (s + 1) ≤ cut) :
    CleanInvariantAt p c E rho (s + 1) ∧ CleanAckCoverageAt p c E rho (s + 1) := by
  have hheads := pcsa_clean_headsAbove_step E rho h hF s hCI hc
  have hchain := pcsa_clean_resultsChain_step E rho h hF s hCI hc
  have hequal := pcsa_clean_headsEqual_step E rho h hF hFault s hCI hc
  have hpast := pcsa_heads_cover_past_results E rho h hF (s + 1) hc hchain hheads
  have hDresults : ∀ i k, i < k → k ≤ s + 1 → ∀ y B, HonestAckAt p c E rho y i B →
      ∀ x ∈ rho.honest, ∀ X, gateResultAt p c E rho x k = some (some X) → Block.Preceq B X := by
    intro i k hik hk y B hB x hx X hX
    by_cases hold : k ≤ s
    · exact hAux.results i k hik hold y B hB x hx X hX
    · have he : k = s + 1 := Nat.le_antisymm hk (Nat.succ_le_of_lt (Nat.lt_of_not_ge hold))
      subst k
      exact pcsa_clean_result_covers_heads E rho h hF x hx (s + 1) B X hc
        (fun z H hH => hAux.heads i (s + 1) hik (le_refl _) y B hB z H hH) hX
  have hAckResults := pcsa_ack_result_compatible E rho h hF hFault (s + 1) hc hpast hDresults
  have hroots : ∀ x ∈ rho.honest, ∀ R,
      liveRootAt p c E rho x (s + 1 + 1) = some R →
      ∀ y ∈ rho.honest, ∀ X, gateResultAt p c E rho y (s + 1) = some (some X) →
        Block.Compatible R X := by
    intro x hx R hR y hy X hX
    rcases pcsa_next_root_source E rho h.base hF hFault x hx (s + 1) R hR with
      hgen | ⟨z, i, hAck, ht⟩ | ⟨i, Y, hi, hY, hRY⟩
    · rw [hgen]
      exact Bool.or_eq_true_iff.mpr (Or.inl (Gen.Pure.block_genesis_preceq X))
    · exact hAckResults i (pcsa_early_label_before_vote p i (s + 1) ht) z R hAck
        (s + 1) (le_refl _) y hy X hX
    · exact Bool.or_eq_true_iff.mpr (Or.inl (Gen.Pure.block_preceq_trans hRY
        ((hchain x hx y hy i (s + 1) Y X hi.le (le_refl _) hY hX).1 hi)))
  have hDheads : ∀ i k, i < k → k ≤ s + 1 + 1 → ∀ y B, HonestAckAt p c E rho y i B →
      ∀ x H, HonestHeadAt p c E rho x k H → Block.Preceq B H := by
    intro i k hik hk y B hB x H hH
    by_cases hold : k ≤ s + 1
    · exact hAux.heads i k hik hold y B hB x H hH
    · have he : k = s + 1 + 1 := Nat.le_antisymm hk
        (Nat.succ_le_of_lt (Nat.lt_of_not_ge hold))
      subst k
      have hi : i ≤ s + 1 := Nat.le_of_lt_succ hik
      rcases hi.lt_or_eq with hi | hi
      · obtain ⟨D, hD⟩ := pcsa_clean_result_exists E rho h hF y hB.1 (s + 1) hc
        have hBD := hDresults i (s + 1) hi (le_refl _) y B hB y hB.1 D hD
        have hDH := pcsa_next_head_above_result_of_root E rho h.base hF h.healthy y x hB.1
          (s + 1) D H hc hD hH (fun R hR => hroots x hH.1 R hR y hB.1 D hD)
        exact Gen.Pure.block_preceq_trans hBD hDH
      · subst i
        exact pcsa_ack_dissemination_step E rho h hF hFault (s + 1) hc
          (hpast (s + 1) (le_refl _))
          (fun i hi y B hB x H hH => hAux.heads i (s + 1) hi (le_refl _) y B hB x H hH)
          y x B H hB hH
  have hresultCompatible : ∀ x ∈ rho.honest, ∀ y ∈ rho.honest, ∀ i i' X Y,
      i ≤ s + 1 → i' ≤ s + 1 → gateResultAt p c E rho x i = some (some X) →
      gateResultAt p c E rho y i' = some (some Y) → Block.Compatible X Y := by
    intro x hx y hy i i' X Y hi hi' hX hY
    rcases le_total i i' with hle | hle
    · rcases hle.lt_or_eq with hlt | he
      · exact Bool.or_eq_true_iff.mpr (Or.inl ((hchain x hx y hy i i' X Y hle hi' hX hY).1 hlt))
      · exact (hchain x hx y hy i i' X Y hle hi' hX hY).2 he
    · rcases hle.lt_or_eq with hlt | he
      · exact Bool.or_eq_true_iff.mpr (Or.inr ((hchain y hy x hx i' i Y X hle hi hY hX).1 hlt))
      · exact (hchain x hx y hy i i' X Y (Nat.le_of_eq he.symm) hi' hX hY).2 he.symm
  refine ⟨{
    resultsChain := hchain
    headsAbove := hheads
    headsEqual := hequal
    pcAck := ?_
    pcChain := ?_
    pcResults := ?_
    leaseBelowResult := ?_
    leaseCompatible := ?_
    lockWriteAll := ?_
    lockKeep := ?_
    recordOrigin := ?_
    recordMono := ?_
    recordCompatible := ?_
    roots := hroots }, ⟨hDheads, hDresults⟩⟩
  · intro x hx t C ht hC
    exact (pcsa_pc_storeAt_ack_slot E rho h.base hFault (s + 1) x hx t ht C hC).2
  · intro x hx y hy t t' C D ht ht' hC hD
    exact pcsa_pc_storeAt_chain E rho h.base hF hFault (s + 1)
      (fun i i' hi hi' y A hA z H hH => hAux.heads i i' hi hi' y A hA z H hH)
      x y hx hy t t' ht ht' C D hC hD
  · intro x hx y hy t C i X ht hC hi hX
    exact pcsa_pc_storeAt_result E rho h hF hFault (s + 1) hc hpast hDresults
      x y hx hy t ht C hC i hi X hX
  · intro x hx t row ht hr
    obtain ⟨i, X, hi, hX, hb, _⟩ := pcsa_lock_storeAt_origin E rho h.base x t (s + 1) ht row hr
    exact ⟨x, hx, i, X, hi, hX, hb⟩
  · intro x hx t B C ht hLive hC
    obtain ⟨row, hr, he, _⟩ := hLive
    obtain ⟨i, X, hi, hX, hb, _⟩ := pcsa_lock_storeAt_origin E rho h.base x t (s + 1) ht row hr
    obtain ⟨hj, y, ha⟩ := pcsa_pc_storeAt_ack_slot E rho h.base hFault (s + 1) x hx t ht C hC
    have hc := hAckResults C.slot hj y C.target ha i hi x hx X hX
    have hBX : Block.Preceq B X := he ▸ hb
    rcases Bool.or_eq_true_iff.mp hc with hCX | hXC
    · exact Gen.Pure.block_compatible_of_common hBX hCX
    · exact Bool.or_eq_true_iff.mpr (Or.inl (Gen.Pure.block_preceq_trans hBX hXC))
  · intro x hx i st X b hi hst hX hb
    exact pcsa_lock_write_all_of_ack_results E rho h.base hFault (s + 1) hAckResults
      x hx i hi st X b hst hX hb
  · intro x hx k e he ht row hr hlive
    exact pcsa_lock_keep_of_chain E rho h.base hF hFault (s + 1) hpast hAckResults
      x hx k e he ht row hr hlive
  · intro x hx t ht
    rcases pcsa_record_storeAt_origin E rho h.base hF x hx t (s + 1) ht with hz | hresult
    · left
      have hf : (storeAt p c E rho x t).fg.F = .genesis := by
        rw [storeAt_def, V2.D.Engine.readAt_eq_stateBefore h.base.valid.toScheduleWellFormed]
        exact (hF x hx _).1
      rw [hz, hf]
      rfl
    · exact Or.inr hresult
  · intro x hx t t' htt ht'
    exact pcsa_record_storeAt_mono E rho h.base hF (s + 1) x hx
      (fun i i' X Y hi hi' hX hY => (hchain x hx x hx i i' X Y hi.le hi' hX hY).1 hi)
      t t' htt ht'
  · intro x hx y hy t t' ht ht'
    exact pcsa_record_storeAt_compatible E rho h.base hF (s + 1) hresultCompatible
      x y hx hy t t' ht ht'
end AvailableChain.PCSA.Run

namespace AvailableChain.PCSA.Run
variable {p : Params} {In V : Type} [DecidableEq V] [Fintype V]
    {c : AppCodec In} {m : FGMode}
/-- The stage-one Clean invariant and ack coverage hold by joint induction over gate labels. -/
theorem pcsa_clean_joint_invariant (E : Generic.Env V)
    (rho : V2.D.Run V (pcsaWith m p c)) {cut ΔF : Time}
    (h : Clean₂ p c E rho cut ΔF) (hF : StageOneFrame p c E rho)
    (hFault : FaultsBelowQA p c rho) :
    ∀ j, SA.gateTime p.toParams j ≤ cut →
      CleanInvariantAt p c E rho j ∧ CleanAckCoverageAt p c E rho j := by
  intro j
  induction j with
  | zero =>
    intro hc
    exact ⟨pcsa_clean_invariant_zero E rho h hFault hF hc,
      pcsa_ack_coverage_zero E rho h.base hF hFault⟩
  | succ j ih =>
    intro hc
    obtain ⟨hCI, hAux⟩ := ih ((pcsa_gate_time_mono p (Nat.le_succ j)).trans hc)
    exact pcsa_clean_joint_step E rho h hF hFault j hCI hAux hc
/-- C6: the full stage-one Clean invariant holds at every gate inside the healthy prefix. -/
theorem pcsa_clean_invariant (p : Params) : CleanInvariantClaim p := by
  intro V _ _ In c m E rho cut ΔF h hFault hF j hc
  exact (pcsa_clean_joint_invariant E rho h hF hFault j hc).1
end AvailableChain.PCSA.Run

end
