/-! The joint step of the CI restart from label `a` (pcsa34-r5 §5.5): the proposer
reads, the emitted-HEAD step, and the successor restart state. Every label
quantifier starts at `a`; the delivery window replaces CLEAN. -/
namespace AvailableChain.PCSA.Run
variable {p : Params} {In V : Type} [DecidableEq V] [Fintype V]
    {c : AppCodec In} {m : FGMode}

/-- From label `a`: the restart state makes the actual proposer root for `s + 1`
compatible with each result of label `s`. -/
theorem pcsa_restart_proposer_root_compatible (E : Generic.Env V)
    (rho : V2.D.Run V (pcsaWith m p c)) (h : Base₂ p c E rho)
    (hF : StageOneFrame p c E rho) {j₀ : Slot} {A : Block}
    (hS : CleanRestartSeed p c E rho j₀ A) (s : Slot) (hjs : j₀ ≤ s)
    (hst : CleanStateFrom p c E rho j₀ s)
    (hseed : ∃ w ∈ rho.honest, ∃ W, gateResultAt p c E rho w j₀ = some (some W))
    (k : Nat) (x y : V) (hx : x ∈ rho.honest) (hy : y ∈ rho.honest)
    (hk : rho.events[k]? = some (.tick x (SA.proposalTime p.toParams (s + 1))))
    (X : Block) (hX : gateResultAt p c E rho y s = some (some X)) :
    Block.Compatible
      (liveRoot p (clock p (V2.D.Run.stateBefore E rho k x).st (SA.proposalTime p.toParams (s + 1)))
        (proposerPC p (clock p (V2.D.Run.stateBefore E rho k x).st
          (SA.proposalTime p.toParams (s + 1))))) X := by
  have hs := h.valid.toScheduleWellFormed
  have hp : (0 : Int) < p.Δ := p.deltaPos
  let st := clock p (V2.D.Run.stateBefore E rho k x).st (SA.proposalTime p.toParams (s + 1))
  have hz : (controls p st).Z = .genesis := by
    change (KitFG.storeControlsView (FGSA.heightView p) (clock p _ _).fg).Z = .genesis
    rw [pcsa_body_clock_fg]
    exact (hF x hx k).2.1
  have htime : SA.proposalTime p.toParams (s + 1) - 1 < SA.voteTime p.toParams (s + 1) := by
    change 4 * p.Δ * ((s + 1 : Nat) : Int) - 1 < 4 * p.Δ * ((s + 1 : Nat) : Int) + p.Δ
    linarith
  have hpropVote : SA.proposalTime p.toParams (s + 1) < SA.voteTime p.toParams (s + 1) := by
    change 4 * p.Δ * ((s + 1 : Nat) : Int) < 4 * p.Δ * ((s + 1 : Nat) : Int) + p.Δ
    exact lt_add_of_pos_right _ hp
  have hzt : SA.freezeTime p.toParams j₀ < SA.proposalTime p.toParams (s + 1) := by
    change 4 * p.Δ * (j₀ : Int) + 3 * p.Δ < 4 * p.Δ * ((s + 1 : Nat) : Int)
    have hj : (j₀ : Int) ≤ s := by exact_mod_cast hjs
    push_cast
    nlinarith
  have hzk : V2.D.Run.idxBefore rho (SA.freezeTime p.toParams j₀) ≤ k := by
    apply Nat.le_of_not_gt
    intro hn
    have ht := (Gen.V2.Duty.index_lt_idxBefore_iff hs hk _).mp hn
    exact absurd hzt (not_lt.mpr ht.le)
  rcases pcsa_liveRoot_origin p st (proposerPC p st) with he | hm
  · rw [he]
    cases hv : proposerPC p st with
    | none =>
      change Block.Compatible (eraseFG (controls p st).Z) X
      rw [hz]
      exact Bool.or_eq_true_iff.mpr (Or.inl (Gen.Pure.block_genesis_preceq X))
    | some C =>
      change Block.Compatible (if frameActive p st C then C.target else eraseFG (controls p st).Z) X
      split
      · have hCs : j₀ ≤ C.slot := by
          obtain ⟨D, hD, hDs⟩ := pcsa_restart_proposerPC_slot E rho hs h.noRestart hF x hx j₀ A
            (hS.stamped x hx) (k + 1) ((pcsa_afterTicksIdx_le_tick E rho hs hk hzt).trans
              (Nat.le_succ k))
          have hk1 : (V2.D.Run.stateBefore E rho (k + 1) x).st = st := by
            rw [V2.D.Run.stateBefore_succ E rho hk, pcsa_tick_step]
          rw [hk1, hv] at hD
          rw [Option.some.inj hD]
          exact hDs
        have hC := (List.mem_filter.mp (bestPC_mem _ C hv)).1
        change C ∈ (clock p _ _).pcs at hC
        rw [pcsa_clock_pcs, pcsa_pre_tick_storeAt E rho h k x _ hk] at hC
        exact hst.pcResults x hx y hy _ C s X htime hCs hC hjs (le_refl _) hX
      · rw [hz]
        exact Bool.or_eq_true_iff.mpr (Or.inl (Gen.Pure.block_genesis_preceq X))
  · obtain ⟨row, hrow, hr, _, _⟩ := (pcsa_walkLocks_mem p st _ _).mp hm
    have hpre := pcsa_proposal_locks_subset p (V2.D.Run.stateBefore E rho k x).st (s + 1) hrow
    have hkv : k ≤ V2.D.Run.idxBefore rho (SA.voteTime p.toParams (s + 1)) :=
      Nat.le_of_lt ((Gen.V2.Duty.index_lt_idxBefore_iff hs hk _).mpr hpropVote)
    have hb := pcsa_restart_pre_vote_lock_below_result E rho h hS s hjs hst hseed k x y hx hy
      hzk hkv row hpre X hX
    exact Bool.or_eq_true_iff.mpr (Or.inl (hr ▸ hb))

/-- From label `a`: the actual proposer walk for `s + 1` extends every result of
label `s`. -/
theorem pcsa_restart_proposer_head_above_result (E : Generic.Env V)
    (rho : V2.D.Run V (pcsaWith m p c)) {T₀ cut : Time} {j₀ : Slot} {A : Block}
    (h : CleanWindow E rho j₀ T₀ cut) (hF : StageOneFrame p c E rho)
    (hS : CleanRestartSeed p c E rho j₀ A) (s : Slot) (hjs : j₀ ≤ s)
    (hst : CleanStateFrom p c E rho j₀ s)
    (hseed : ∃ w ∈ rho.honest, ∃ W, gateResultAt p c E rho w j₀ = some (some W))
    (hc : SA.gateTime p.toParams s ≤ cut)
    (k : Nat) (x y : V) (hx : x ∈ rho.honest) (hy : y ∈ rho.honest)
    (hk : rho.events[k]? = some (.tick x (SA.proposalTime p.toParams (s + 1))))
    (X : Block) (hX : gateResultAt p c E rho y s = some (some X)) :
    let st := clock p (V2.D.Run.stateBefore E rho k x).st (SA.proposalTime p.toParams (s + 1))
    Block.Preceq X (getHead p st (proposerPC p st) (proposerVotes st (s + 1))
      (proposerSupport st (s + 1))) := by
  have hTs := pcsa_cleanWindow_floor E rho h s hjs
  obtain ⟨a, ha, hresult⟩ := pcsa_gateResultAt_source E rho y s X hX
  have hroot := pcsa_restart_proposer_root_compatible E rho h.base hF hS s hjs hst hseed k x y
    hx hy hk X hX
  have hfcut : SA.freezeTime p.toParams s ≤ cut := by
    apply le_trans _ hc
    change 4 * p.Δ * (s : Int) + 3 * p.Δ ≤ 4 * p.Δ * (s : Int) + 6 * p.Δ
    have hp : (0 : Int) < p.Δ := p.deltaPos
    linarith
  have hidx : V2.D.Run.idxBefore rho (SA.freezeTime p.toParams s) ≤ k := by
    apply Nat.le_of_not_gt
    intro hn
    have ht := (Gen.V2.Duty.index_lt_idxBefore_iff h.base.valid.toScheduleWellFormed hk _).mp hn
    change 4 * p.Δ * ((s + 1 : Nat) : Int) < 4 * p.Δ * (s : Int) + 3 * p.Δ at ht
    push_cast at ht
    have hp : (0 : Int) < p.Δ := p.deltaPos
    nlinarith
  have hpaths := pcsa_result_prefixes_retained_win E rho h.base hF h.strict a k y x hy hx
    (SA.gateTime p.toParams s) (SA.proposalTime p.toParams (s + 1)) s X (pcsa_floor_early hTs)
    hfcut hidx hresult
  exact pcsa_gate_proposer_walk_counts_win E rho h.base hF h.strict a k y x hy hx s X _ _
    (pcsa_floor_early hTs) hc ha hk hresult hroot (fun B _ hBX => (hpaths B hBX).1)

/-- From label `a`: an honest proposal for `s + 1` fixes every honest HEAD of
`s + 1`. -/
theorem pcsa_restart_emitted_heads_equal (E : Generic.Env V)
    (rho : V2.D.Run V (pcsaWith m p c)) {T₀ cut : Time} {j₀ : Slot} {A : Block}
    (h : CleanWindow E rho j₀ T₀ cut) (hF : StageOneFrame p c E rho)
    (hFault : FaultsBelowQA p c rho) (hS : CleanRestartSeed p c E rho j₀ A)
    (s : Slot) (hjs : j₀ ≤ s) (hst : CleanStateFrom p c E rho j₀ s)
    (hseed : ∃ w ∈ rho.honest, ∃ W, gateResultAt p c E rho w j₀ = some (some W))
    (hc : SA.gateTime p.toParams s ≤ cut) (N : NamedProposal p.n)
    (hx : rho.seatOf (.prop (s + 1)) (0 : Fin 1) ∈ rho.honest)
    (he : V2.D.Run.emits E rho (rho.seatOf (.prop (s + 1)) (0 : Fin 1))
      (⟨.seat (.prop (s + 1)) (0 : Fin 1), .proposal N⟩ : Obj p)
        (SA.proposalTime p.toParams (s + 1)))
    (y : V) (H : Block) (hH : HonestHeadAt p c E rho y (s + 1) H) : H = N.erase := by
  let x := rho.seatOf (.prop (s + 1)) (0 : Fin 1)
  obtain ⟨k, hk, _, hslot, hraw, hsup, hpc, hparent⟩ := pcsa_emitted_proposal_inputs E rho x
    (s + 1) N he
  let a := V2.D.Run.idxBefore rho (SA.voteTime p.toParams (s + 1))
  let src := clock p (V2.D.Run.stateBefore E rho k x).st (SA.proposalTime p.toParams (s + 1))
  let dst := clock p (V2.D.Run.stateBefore E rho a y).st (SA.voteTime p.toParams (s + 1))
  let Ts := erasedList src (fullTree p src)
  let Tt := erasedList dst (KitFG.storeFrameView (FGSA.heightView p) dst.fg (voterBlocks p dst (s
    + 1)))
  let rs := proposerVotes src (s + 1)
  let ss := proposerSupport src (s + 1)
  let rt := headVotes p dst (s + 1)
  let st := headSupport p dst (s + 1)
  let Rsrc := liveRoot p src (proposerPC p src)
  let Rdst := liveRoot p dst (voterPC p dst (s + 1))
  have hy := hH.1
  have hp : (0 : Int) < p.Δ := p.deltaPos
  have hTs := pcsa_cleanWindow_floor E rho h s hjs
  have hpropVote : SA.proposalTime p.toParams (s + 1) < SA.voteTime p.toParams (s + 1) := by
    change 4 * p.Δ * ((s + 1 : Nat) : Int) < 4 * p.Δ * ((s + 1 : Nat) : Int) + p.Δ
    exact lt_add_of_pos_right _ hp
  have hvcut : SA.voteTime p.toParams (s + 1) ≤ cut := by
    apply le_trans _ hc
    change 4 * p.Δ * ((s + 1 : Nat) : Int) + p.Δ ≤ 4 * p.Δ * (s : Int) + 6 * p.Δ
    push_cast
    nlinarith
  have hkbefore : k ≤ a := Nat.le_of_lt
    ((Gen.V2.Duty.index_lt_idxBefore_iff h.base.valid.toScheduleWellFormed hk _).mpr hpropVote)
  have hzk : V2.D.Run.idxBefore rho (SA.freezeTime p.toParams j₀) ≤ k := by
    apply Nat.le_of_not_gt
    intro hn
    have ht := (Gen.V2.Duty.index_lt_idxBefore_iff h.base.valid.toScheduleWellFormed hk _).mp hn
    change 4 * p.Δ * ((s + 1 : Nat) : Int) < 4 * p.Δ * (j₀ : Int) + 3 * p.Δ at ht
    have hj : (j₀ : Int) ≤ s := by exact_mod_cast hjs
    push_cast at ht
    nlinarith
  obtain ⟨hNwire, hNbody⟩ := pcsa_honest_proposal_before_vote_win E rho h.base hF h.strict x y
    hx hy (s + 1) N he (pcsa_cleanWindow_floor E rho h (s + 1) (Nat.le_succ_of_le hjs)) hvcut a
    (le_refl _)
  have hNdst : N.erase ∈ dst.base.blocks := by
    change N.erase ∈ (clock p _ _).base.blocks
    rwa [pcsa_clock_blocks]
  have hNslot : N.erase.slot = s + 1 := pcsa_proposal_emitted_slot E rho x (s + 1) N _ he
  have hNpositive : 0 < N.slot := by rw [hslot]; exact Nat.succ_pos _
  have hNparent := pcsa_named_parent_of_positive N hNpositive
  have hcount := pcsa_common_walk_counts_win E rho h.base hF h.strict a k y hy s
    (SA.voteTime p.toParams (s + 1)) N hx he hk (le_refl _) hslot hNwire hTs hc hraw hsup
  have hviews := pcsa_common_view_targets_win E rho h.base hF hFault h.strict k y hy s N hx he hk
    hslot (pcsa_floor_freeze hTs) hvcut hNwire hpc
  have frame (i : Nat) (z : V) (hz : z ∈ rho.honest) (t : Time) :
      FrameVacuous p (clock p (V2.D.Run.stateBefore E rho i z).st t) := by
    change (clock p _ t).fg.F = .genesis ∧
      (KitFG.storeControlsView (FGSA.heightView p) (clock p _ t).fg).Z = .genesis ∧
      (KitFG.storeControlsView (FGSA.heightView p) (clock p _ t).fg).lo = 0
    rw [pcsa_body_clock_fg]
    exact hF z hz i
  have hsrcF := frame k x hx (SA.proposalTime p.toParams (s + 1))
  have hdstF := frame a y hy (SA.voteTime p.toParams (s + 1))
  have hslots : src.slot p = dst.slot p :=
    (pcsa_proposal_clock_slot p _ (s + 1)).trans (pcsa_vote_clock_slot p _ (s + 1)).symm
  have heleg := pcsa_eligible_equal_counts p src dst rs ss rt st hsrcF.2.2 hdstF.2.2 hslots
    hcount.1 hcount.2.2
  have hhead : headVote p dst (s + 1) = H := by
    have hh := hH.2.2
    rw [pcsa_voteHeadAt_def] at hh
    obtain ⟨nd, hnd, hh⟩ := Option.map_eq_some_iff.mp hh
    obtain ⟨b, hb, hbSt⟩ := pcsa_postClock_source E rho y _ nd hnd
    have hpre := V2.D.Engine.stateBefore_tick_eq_stateBeforeTime h.base.valid.toScheduleWellFormed
      h.base.noRestart hb
    rw [← Gen.V2.Duty.stateBefore_idxBefore E rho _ h.base.valid.toScheduleWellFormed] at hpre
    rw [hbSt, hpre] at hh
    exact hh
  have hghost : GridCO.ghost Rdst Tt (GridCO.goldfishScore dst.base.blocks rt st)
      (eligible p dst rt st) = H := by
    delta headVote at hhead
    rw [ite_eq_right (Nat.succ_ne_zero s)] at hhead
    exact hhead
  obtain ⟨D, hD⟩ := pcsa_clean_result_exists_win E rho h hF x hx s hjs hc
  have hDparent : Block.Preceq D N.parent.erase := by
    rw [hparent]
    exact pcsa_restart_proposer_head_above_result E rho h hF hS s hjs hst hseed hc k x x
      hx hx hk D hD
  have hDH : Block.Preceq D H := pcsa_next_head_above_result_of_root_win E rho h.base hF
    h.strict x y hx s D H hTs hc hD hH (fun R hR => hst.roots y hH.1 R hR x hx D hD)
  have hsrcRootParent : Block.Preceq Rsrc N.parent.erase := by
    rw [hparent]
    exact pcsa_headInTree_extends_root p src _ _ rs ss
  have hsrcLocks : ∀ row ∈ src.base.obligations, Block.Preceq row.1 D := by
    intro row hr
    exact pcsa_restart_pre_vote_lock_below_result E rho h.base hS s hjs hst hseed k x x hx hx
      hzk hkbefore row
      (pcsa_proposal_locks_subset p _ (s + 1) hr) D hD
  have hdstLocks : ∀ row ∈ dst.base.obligations, Block.Preceq row.1 D := by
    intro row hr
    exact pcsa_restart_pre_vote_lock_below_result E rho h.base hS s hjs hst hseed a y x hy hx
      (hzk.trans hkbefore) (le_refl _) row
      (pcsa_vote_locks_subset p _ (s + 1) hr) D hD
  have hgeometry := pcsa_proposal_root_geometry p src dst (s + 1) N.parent.erase D H
    (pcsa_selected_walk_bases_eq p src dst (s + 1) hsrcF.2.1 hdstF.2.1 hviews)
    hsrcRootParent hDparent hDH hsrcLocks hdstLocks
  have unique (i : Nat) (z : V) (hz : z ∈ rho.honest) (t : Time) :
      ∀ A ∈ (clock p (V2.D.Run.stateBefore E rho i z).st t).base.blocks,
      ∀ B ∈ (clock p (V2.D.Run.stateBefore E rho i z).st t).base.blocks,
        A.root = B.root → A = B := by
    intro A hA B hB hr
    have scope := pcsa_clock_body_scope p (RootBlockInRun p c E rho) _ t
      (pcsa_body_scope E rho i z hz)
    exact pcsa_scoped_root_eq E rho h.base.idealization A B (scope A hA) (scope B hB) hr
  have hsrcUnique : ∀ A ∈ Ts, ∀ B ∈ Ts, A.root = B.root → A = B := by
    intro A hA B hB hr
    exact unique k x hx _ A (List.mem_filter.mp hA).1 B (List.mem_filter.mp hB).1 hr
  have hdstUnique : ∀ A ∈ Tt, ∀ B ∈ Tt, A.root = B.root → A = B := by
    intro A hA B hB hr
    exact unique a y hy _ A (List.mem_filter.mp hA).1 B (List.mem_filter.mp hB).1 hr
  have hclosed : Gen.Pure.AnchorClosed Rsrc Ts := by
    intro B hB _ A _ hAB
    exact pcsa_full_read_prefix_mem E rho hF k x hx _ B A (List.mem_filter.mp hB).1 hAB
  have hretained (C : Block) (hC : Block.Preceq C N.erase) : C ∈ Tt :=
    pcsa_proposal_prefix_voter_mem E rho hF a y hy _ (s + 1) N.erase C hNdst hNslot hC
  have htree : ∀ C ∈ Tt, C = N.erase ∨ C ∈ Ts := by
    intro C hC
    rcases pcsa_voter_tree_source_win E rho h.base hF h.strict a k y hy s
        (SA.voteTime p.toParams (s + 1)) N hx he hk (pcsa_floor_freeze hTs)
        (hpropVote.le.trans hvcut) C hC with
      hs | hpref
    · exact Or.inr hs
    · by_cases hn : C = N.erase
      · exact Or.inl hn
      · exact Or.inr (pcsa_proposal_proper_prefix_source E rho h.base hF k x hx (s + 1) N
          hparent C hpref hn)
  have hstop : Gen.Pure.NoEligibleChild Tt (eligible p dst rt st) N.erase := by
    intro B hB hpar
    have hb : B ∈ (V2.D.Run.stateBefore E rho a y).st.base.blocks := by
      have hb := (List.mem_filter.mp hB).1
      change B ∈ (clock p _ _).base.blocks at hb
      rwa [pcsa_clock_blocks] at hb
    have hg : B ≠ .genesis := by intro heq; rw [heq] at hpar; cases hpar
    have hparentB : B.parent = N.erase := by
      cases B with
      | genesis => cases hpar
      | node Q r root app => exact Option.some.inj hpar
    have hlt := pcsa_body_parent_slot_lt E rho h.base a y B hg hb
    rw [hparentB, hNslot] at hlt
    have htime : SA.voteTime p.toParams (s + 1) ≤ SA.proposalTime p.toParams (s + 1 + 1) := by
      change 4 * p.Δ * ((s + 1 : Nat) : Int) + p.Δ ≤
        4 * p.Δ * ((s + 1 + 1 : Nat) : Int)
      push_cast
      nlinarith
    have hidx : a ≤ V2.D.Run.idxBefore rho (SA.proposalTime p.toParams (s + 1 + 1)) := by
      change V2.D.Run.idxBefore rho _ ≤ V2.D.Run.idxBefore rho _
      rw [V2.D.Run.idxBefore_def, V2.D.Run.idxBefore_def, ← List.countP_eq_length_filter,
        ← List.countP_eq_length_filter]
      exact List.countP_mono_left (fun e _ he =>
        decide_eq_true (lt_of_lt_of_le (of_decide_eq_true he) htime))
    exact (Nat.not_lt_of_ge (pcsa_body_slot_before_next_proposal E rho h.base a y (s + 1)
      hidx B hb) hlt).elim
  have hwalk := pcsa_retained_proposal_walk Rsrc Rdst N.parent.erase N.erase Ts Tt
    (GridCO.goldfishScore src.base.blocks rs ss) (GridCO.goldfishScore dst.base.blocks rt st)
    (eligible p src rs ss) (eligible p dst rt st) hsrcUnique hclosed hdstUnique hparent.symm
    hsrcRootParent hgeometry.1 (by simpa only [hghost] using hgeometry.2) hNparent
    (hretained N.erase (Gen.Pure.block_preceq_refl _))
    (pcsa_eligible_current_slot p dst rt st N.erase
      (hNslot.trans (pcsa_vote_clock_slot p _ (s + 1)).symm))
    (fun C hC => hretained C (Gen.Pure.block_preceq_trans hC (pcsa_named_parent_prefix N)))
    htree hcount.2.2 heleg hstop
  exact hghost.symm.trans hwalk

/-- The successor restart state from label `a`: results, HEADs, PCs, roots and ack
coverage of label `s + 1` follow from the restart state of label `s`. -/
theorem pcsa_restart_joint_step (E : Generic.Env V)
    (rho : V2.D.Run V (pcsaWith m p c)) {T₀ cut : Time} {a : Slot} {A : Block}
    (h : CleanWindow E rho a T₀ cut) (hF : StageOneFrame p c E rho)
    (hFault : FaultsBelowQA p c rho) (hS : CleanRestartSeed p c E rho a A)
    (s : Slot) (has : a ≤ s) (hst : CleanStateFrom p c E rho a s)
    (hc : SA.gateTime p.toParams (s + 1) ≤ cut) :
    CleanStateFrom p c E rho a (s + 1) := by
  have hp : (0 : Int) < p.Δ := p.deltaPos
  have has' : a ≤ s + 1 := Nat.le_succ_of_le has
  have hprev : SA.gateTime p.toParams s ≤ cut :=
    (pcsa_gate_time_mono p (Nat.le_succ s)).trans hc
  have hTs := pcsa_cleanWindow_floor E rho h s has
  have hTs' := pcsa_cleanWindow_floor E rho h (s + 1) has'
  have seedOf (w : V) (hw : w ∈ rho.honest) :
      ∃ W, gateResultAt p c E rho w a = some (some W) :=
    pcsa_clean_result_exists_win E rho h hF w hw a le_rfl
      ((pcsa_gate_time_mono p has).trans hprev)
  have seedEq (w : V) (hw : w ∈ rho.honest) (W : Block)
      (hW : gateResultAt p c E rho w a = some (some W)) : W = A :=
    Option.some.inj (hS.result w hw _ hW)
  have hheads : ∀ (i : Slot) (x y : V) (H X : Block), a < i → i ≤ s + 1 →
      HonestHeadAt p c E rho x i H → y ∈ rho.honest →
      gateResultAt p c E rho y (i - 1) = some (some X) → Block.Preceq X H := by
    intro i x y H X hai hi hH hy hX
    by_cases hold : i ≤ s
    · exact hst.headsAbove i x y H X hai hold hH hy hX
    · have he : i = s + 1 := Nat.le_antisymm hi (Nat.succ_le_of_lt (Nat.lt_of_not_ge hold))
      subst i
      rw [Nat.add_sub_cancel] at hX
      exact pcsa_next_head_above_result_of_root_win E rho h.base hF h.strict y x hy s X H hTs
        hprev hX hH (fun R hR => hst.roots x hH.1 R hR y hy X hX)
  have hchain : ∀ x ∈ rho.honest, ∀ y ∈ rho.honest, ∀ (i i' : Slot) (X Y : Block),
      a ≤ i → i ≤ i' → i' ≤ s + 1 → gateResultAt p c E rho x i = some (some X) →
      gateResultAt p c E rho y i' = some (some Y) →
      (i < i' → Block.Preceq X Y) ∧ (i = i' → Block.Compatible X Y) := by
    intro x hx y hy i i' X Y hai hii' hi' hX hY
    by_cases hold : i' ≤ s
    · exact hst.results x hx y hy i i' X Y hai hii' hold hX hY
    · have he : i' = s + 1 := Nat.le_antisymm hi' (Nat.succ_le_of_lt (Nat.lt_of_not_ge hold))
      subst i'
      rcases Nat.lt_or_eq_of_le hii' with hi | he
      · have his : i ≤ s := Nat.le_of_lt_succ hi
        obtain ⟨D, hD⟩ := pcsa_clean_result_exists_win E rho h hF x hx s has hprev
        have hXD : Block.Preceq X D := by
          rcases his.lt_or_eq with his' | his'
          · exact (hst.results x hx x hx i s X D hai his (le_refl _) hX hD).1 his'
          · subst i
            have hEq : X = D := Option.some.inj (Option.some.inj (hX.symm.trans hD))
            rw [hEq]
            exact Gen.Pure.block_preceq_refl _
        have hXY : Block.Preceq X Y := pcsa_clean_result_covers_heads_win E rho h hF y hy
          (s + 1) X Y has' hc (fun z H hH => Gen.Pure.block_preceq_trans hXD
            (hheads (s + 1) z x H D (Nat.lt_succ_of_le has) le_rfl hH hx
              (by rw [Nat.add_sub_cancel]; exact hD))) hY
        exact ⟨fun _ => hXY, fun heq => (Nat.ne_of_lt hi heq).elim⟩
      · subst i
        exact ⟨fun hi => (Nat.lt_irrefl _ hi).elim,
          fun _ => pcsa_clean_same_label_results_win E rho h.base hF h.strict x y hx hy
            (s + 1) X Y hTs' hc hX hY⟩
  have hequal : ∀ (i : Slot) (P : Block) (x : V) (H : Block), a ≤ i → i ≤ s + 1 →
      Gen.V2.Duty.HonestProposalAt E (pcsaInterface p c (m := m)).toInterface rho i P →
      HonestHeadAt p c E rho x i H → H = P := by
    intro i P x H hai hi hP hH
    by_cases hold : i ≤ s
    · exact hst.headsEqual i P x H hai hold hP hH
    · have his : i = s + 1 := Nat.le_antisymm hi (Nat.succ_le_of_lt (Nat.lt_of_not_ge hold))
      subst i
      obtain ⟨hx, N, hN, he⟩ := pcsa_honest_proposal_named E rho (s + 1) P hP
      have hseed : ∃ w ∈ rho.honest, ∃ W, gateResultAt p c E rho w a = some (some W) :=
        ⟨_, hx, seedOf _ hx⟩
      exact (pcsa_restart_emitted_heads_equal E rho h hF hFault hS s has hst hseed hprev N hx he
        x H hH).trans hN
  have hpast := pcsa_heads_cover_past_results_from E rho h hF (s + 1) hc hchain hheads
  have hDresults : ∀ i k, a ≤ i → i < k → k ≤ s + 1 → ∀ y B, HonestAckAt p c E rho y i B →
      ∀ x ∈ rho.honest, ∀ X, gateResultAt p c E rho x k = some (some X) →
        Block.Preceq B X := by
    intro i k hai hik hk y B hB x hx X hX
    by_cases hold : k ≤ s
    · exact hst.ackResults i k hai hik hold y B hB x hx X hX
    · have he : k = s + 1 := Nat.le_antisymm hk (Nat.succ_le_of_lt (Nat.lt_of_not_ge hold))
      subst k
      exact pcsa_clean_result_covers_heads_win E rho h hF x hx (s + 1) B X has' hc
        (fun z H hH => hst.ackHeads i (s + 1) hai hik (le_refl _) y B hB z H hH) hX
  have hAckResults := pcsa_ack_result_compatible_from E rho h hF hFault (s + 1) hc hpast
    hDresults
  have hzs : SA.freezeTime p.toParams (s + 1) ≤ rho.horizon := by
    apply le_trans _ (hc.trans h.cut.2)
    change 4 * p.Δ * ((s + 1 : Nat) : Int) + 3 * p.Δ ≤ 4 * p.Δ * ((s + 1 : Nat) : Int) + 6 * p.Δ
    linarith
  have hroots : ∀ x ∈ rho.honest, ∀ R : Block,
      liveRootAt p c E rho x (s + 1 + 1) = some R →
      ∀ y ∈ rho.honest, ∀ X, gateResultAt p c E rho y (s + 1) = some (some X) →
        Block.Compatible R X := by
    intro x hx R hR y hy X hX
    rcases pcsa_next_root_source_from E rho h.base hF hFault hS x hx (s + 1) has' hzs R hR with
      hRA | ⟨z, i, hai, hAck, ht⟩ | ⟨i, Y, hai, hi, hY, hRY⟩
    · obtain ⟨W, hW⟩ := seedOf y hy
      have hAX : Block.Preceq A X := by
        rw [← seedEq y hy W hW]
        exact (hchain y hy y hy a (s + 1) W X le_rfl has' le_rfl hW hX).1
          (Nat.lt_succ_of_le has)
      exact Bool.or_eq_true_iff.mpr (Or.inl (Gen.Pure.block_preceq_trans hRA hAX))
    · exact hAckResults i hai (pcsa_early_label_before_vote p i (s + 1) ht) z R hAck
        (s + 1) has' (le_refl _) y hy X hX
    · exact Bool.or_eq_true_iff.mpr (Or.inl (Gen.Pure.block_preceq_trans hRY
        ((hchain x hx y hy i (s + 1) Y X hai hi.le (le_refl _) hY hX).1 hi)))
  have hDheads : ∀ i k, a ≤ i → i < k → k ≤ s + 1 + 1 → ∀ y B, HonestAckAt p c E rho y i B →
      ∀ x H, HonestHeadAt p c E rho x k H → Block.Preceq B H := by
    intro i k hai hik hk y B hB x H hH
    by_cases hold : k ≤ s + 1
    · exact hst.ackHeads i k hai hik hold y B hB x H hH
    · have he : k = s + 1 + 1 := Nat.le_antisymm hk
        (Nat.succ_le_of_lt (Nat.lt_of_not_ge hold))
      subst k
      have hi : i ≤ s + 1 := Nat.le_of_lt_succ hik
      rcases hi.lt_or_eq with hi | hi
      · obtain ⟨D, hD⟩ := pcsa_clean_result_exists_win E rho h hF y hB.1 (s + 1) has' hc
        have hBD := hDresults i (s + 1) hai hi (le_refl _) y B hB y hB.1 D hD
        have hDH := pcsa_next_head_above_result_of_root_win E rho h.base hF h.strict y x hB.1
          (s + 1) D H hTs' hc hD hH (fun R hR => hroots x hH.1 R hR y hB.1 D hD)
        exact Gen.Pure.block_preceq_trans hBD hDH
      · subst i
        exact pcsa_ack_dissemination_step_from E rho h hF hFault hS (s + 1) has' hc
          (hpast (s + 1) (le_refl _))
          (fun i hai hi y B hB x H hH => hst.ackHeads i (s + 1) hai hi (le_refl _) y B hB x H hH)
          y x B H hB hH
  refine ⟨hchain, hheads, hequal, ?_, hroots, hDheads, hDresults⟩
  intro x hx y hy t C i X ht hC hCm hi hi' hX
  exact pcsa_pc_storeAt_result_from E rho h hF hFault (s + 1) hc hpast hDresults x y hx hy t ht
    C hC hCm i hi hi' X hX

/-- The restart state holds at every label from `a` whose gate is in the window. -/
theorem pcsa_restart_state_from (E : Generic.Env V)
    (rho : V2.D.Run V (pcsaWith m p c)) {T₀ cut : Time} {a : Slot} {A : Block}
    (h : CleanWindow E rho a T₀ cut) (hF : StageOneFrame p c E rho)
    (hFault : FaultsBelowQA p c rho) (hS : CleanRestartSeed p c E rho a A) :
    ∀ j, a ≤ j → SA.gateTime p.toParams j ≤ cut → CleanStateFrom p c E rho a j := by
  intro j haj
  induction j, haj using Nat.le_induction with
  | base =>
    intro hc
    apply pcsa_restart_state_base E rho h.base hF hFault hS
    apply le_trans _ (hc.trans h.cut.2)
    change 4 * p.Δ * (a : Int) + 3 * p.Δ ≤ 4 * p.Δ * (a : Int) + 6 * p.Δ
    linarith [p.deltaPos]
  | succ j haj ih =>
    intro hc
    exact pcsa_restart_joint_step E rho h hF hFault hS j haj
      (ih ((pcsa_gate_time_mono p (Nat.le_succ j)).trans hc)) hc
end AvailableChain.PCSA.Run

